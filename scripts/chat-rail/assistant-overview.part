  notion: <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"/></svg>,
};
const commandGlyph = (d: string) => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.1" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d={d} vectorEffect="non-scaling-stroke"/></svg>;
const overviewCommands: CommandMenuGroup[] = [
  { id: "suggestions", label: "Suggestions", commands: [
    { id: "email", label: "Write an email", description: "Gmail", logo: overviewLogos.gmail, keywords: "mail send compose" },
    { id: "ask", label: "Ask assistant", description: "Summaries, drafts, answers", logo: assistantSpark, keywords: "ai chat question" },
    { id: "task", label: "Create a task", description: "ClickUp", logo: overviewLogos.clickup, keywords: "todo issue" },
    { id: "crm", label: "Add contact to CRM", description: "HubSpot", logo: overviewLogos.hubspot, keywords: "lead deal company" },
    { id: "meet", label: "Schedule a meeting", description: "Google Calendar", logo: overviewLogos.calendar, keywords: "call invite event" },
  ] },
  { id: "share", label: "Share", commands: [
    { id: "slack", label: "Post an update", description: "#team-updates", logo: overviewLogos.slack, keywords: "message channel" },
    { id: "notion", label: "Save as page", description: "Notion · Meeting notes", logo: overviewLogos.notion, keywords: "doc wiki" },
  ] },
  { id: "general", label: "General", commands: [
    { id: "new-doc", label: "New document", icon: commandGlyph("M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h4"), shortcut: "N" },
    { id: "invite", label: "Invite teammates", icon: commandGlyph("M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20a7.5 7.5 0 0 1 15 0M19 8v4M17 10h4"), shortcut: "I" },
    { id: "upload", label: "Upload files", icon: commandGlyph("M12 16V4M7 9l5-5 5 5M5 20h14"), shortcut: "U" },
    { id: "theme", label: "Switch to dark mode", icon: commandGlyph("M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"), keywords: "theme appearance light", shortcut: "⇧ D" },
  ] },
];
function OverviewBrand() {
  return <span className="ui-aov__brand"><svg width="22" height="22" viewBox="0 0 107 107" fill="currentColor" aria-hidden="true"><path d="M106.4 67.3c0 2.4-1.9 4.3-4.3 4.3H75.9c-2.4 0-4.3 1.9-4.3 4.3v26.2c0 2.4-1.9 4.3-4.3 4.3H4.3c-2.4 0-4.3-1.9-4.3-4.3v-63c0-2.4 1.9-4.3 4.3-4.3h26.2c2.4 0 4.3-1.9 4.3-4.3V4.3C34.8 1.9 36.7 0 39.1 0h63c2.4 0 4.3 1.9 4.3 4.3ZM35.8 66.3c0 2.4 1.9 4.3 4.3 4.3h26.2c2.4 0 4.3-1.9 4.3-4.3V40.1c0-2.4-1.9-4.3-4.3-4.3H40.1c-2.4 0-4.3 1.9-4.3 4.3Z"/></svg>affectUI</span>;
}

/** An AI workspace start page: a composer with folder and app context, the user's numbers below it and a work-area tab beside it. */
export function AssistantOverviewScreen({ title, overview, onSend, composerProps, folders = defaultOverviewFolders, folder: folderProp, defaultFolder = "", onFolderChange, apps = defaultOverviewApps, connectedApps, defaultConnectedApps = ["gmail"], onConnectedAppsChange, suggested = defaultOverviewSources, onOpenSource, onOpenTool, onOpenUrl, onNavigate, workspace = "Acme", user = { name: "Alex Morgan", email: "alex@acme.com" }, defaultActive = "New chat", defaultPanelOpen = false, defaultPanelWidth = 348, className, ...shellProps }: AssistantOverviewScreenProps) {
  const [folder, setFolder] = useControllable(folderProp, defaultFolder, onFolderChange);
  const [navActive, setNavActive] = useControllable(shellProps.active, defaultActive, shellProps.onActiveChange);
  const commands: CommandMenuGroup[] = [...overviewCommands, { id: "go", label: "Go to", commands: overviewNavigation.filter(item => !item.section || item.section === "Projects").map(item => ({ id: `go:${item.label}`, label: item.label, icon: item.icon, onSelect: () => { setNavActive(item.label); onNavigate?.(item.label); } })) }];
  const [connected, setConnected] = useControllable(connectedApps, defaultConnectedApps, onConnectedAppsChange);
  const [menu, setMenu] = useState<"folder" | "apps" | null>(null);
  const [tabs, setTabs] = useState<{ id: string; tool?: WorkspaceToolKind }[]>([{ id: "start-1" }]), [active, setActive] = useState("start-1");
  const [panelOpen, setPanelOpen] = useControllable(shellProps.panelOpen, defaultPanelOpen, shellProps.onPanelOpenChange);
  const root = useRef<HTMLDivElement>(null), anchor = useRef<HTMLElement>(null), folderRef = useRef<HTMLButtonElement>(null), appsRef = useRef<HTMLButtonElement>(null), sequence = useRef(1), id = useId();
  const toggle = (next: "folder" | "apps", button: HTMLButtonElement | null) => { anchor.current = button; setMenu(menu === next ? null : next); };
  const newTab = () => { const tab = `start-${++sequence.current}`; setTabs([...tabs, { id: tab }]); setActive(tab); setPanelOpen(true); };
  const openTool = (tab: string, tool: WorkspaceToolKind) => { setTabs(tabs.map(item => item.id === tab ? { ...item, tool } : item)); onOpenTool?.(tool); };
  const changeOpened = (ids: string[]) => { const next = tabs.filter(tab => ids.includes(tab.id)); if (next.length) { setTabs(next); return; } setPanelOpen(false); setTabs([{ id: `start-${++sequence.current}` }]); };
  const toolLabel = (tool: WorkspaceToolKind) => tool === "terminal" ? "Terminal" : tool === "browser" ? "Browser" : "Notes";
  const workTabs: ArtifactWorkspaceTab[] = tabs.map(tab => tab.tool ? { id: tab.id, label: toolLabel(tab.tool), icon: <Icon name={tab.tool === "terminal" ? "terminal" : tab.tool === "browser" ? "globe" : "compose"} size={14}/>, content: <WorkspaceTool kind={tab.tool} onOpenUrl={onOpenUrl}/> } : { id: tab.id, label: "New tab", icon: <Icon name="globe" size={14}/>, content: <WorkspaceStart suggested={suggested} onOpenSource={onOpenSource} onOpenTool={tool => openTool(tab.id, tool)} onOpenUrl={url => { openTool(tab.id, "browser"); onOpenUrl?.(url); }}/> });
  const appList = apps.filter(Boolean), shown = appList.filter(app => connected.includes(app.id)).concat(appList.filter(app => !connected.includes(app.id))).slice(0, 3);
  const tray = <div className="ui-aov__tray">
    <button ref={folderRef} type="button" className="ui-aov__tray-link" aria-haspopup="menu" aria-expanded={menu === "folder"} aria-controls={menu === "folder" ? `${id}-menu` : undefined} onClick={() => toggle("folder", folderRef.current)}><Icon name="folder" size={14}/><span title={folder || "Work in a folder"}>{folder || "Work in a folder"}</span></button>
    <button ref={appsRef} type="button" className="ui-aov__tray-link ui-aov__tray-link--apps" aria-haspopup="menu" aria-expanded={menu === "apps"} aria-controls={menu === "apps" ? `${id}-menu` : undefined} onClick={() => toggle("apps", appsRef.current)}>Connect apps<span className="ui-aov__apps" aria-hidden="true">{shown.map(app => <i key={app.id} style={{ background: app.color }}>{app.name.slice(0, 1)}</i>)}</span></button>
  </div>;
  return <AppShell {...shellProps} className={["ui-aov", className].filter(Boolean).join(" ")} workspace={workspace} user={user} navigation={overviewNavigation} active={navActive} onActiveChange={setNavActive} commands={commands} onAsk={shellProps.onAsk ?? (() => {})} onNavigate={onNavigate} panelOpen={panelOpen} onPanelOpenChange={setPanelOpen} defaultPanelWidth={defaultPanelWidth} panelTitle="Workspace" panel={<ArtifactWorkspace defaultFiles={[]} openFiles={tabs.map(tab => tab.id)} onOpenFilesChange={changeOpened} activeFile={active} onActiveFileChange={setActive} tabs={workTabs} onNewTab={newTab} onClose={() => setPanelOpen(false)} closeLabel="Close workspace"/>}>
    <style href="ui-assistant-overview" precedence="default">{css}</style>
    <div className="ui-aov__scroll"><section className="ui-aov__start" aria-label="Start">
      <h1 className="ui-aov__title">{title ?? <OverviewBrand/>}</h1>
      <div ref={root} className="ui-aov__composer">
        <ChatComposer placeholder="Help me brainstorm ideas for…" {...composerProps} onSend={onSend} footer={tray}/>
        {menu && <FloatingMenu key={menu} anchor={anchor} root={root} className="ui-aov__menu" id={`${id}-menu`} label={menu === "folder" ? "Work in a folder" : "Apps"} align={menu === "apps" ? "end" : "start"} onClose={() => setMenu(null)}>
          {menu === "folder" ? <><div className="ui-aov__menu-title">Work in a folder</div>{folders.map(name => <button type="button" role="menuitemradio" aria-checked={folder === name} key={name} onClick={() => { setFolder(folder === name ? "" : name); setMenu(null); folderRef.current?.focus(); }}><Icon name={folder === name ? "folder-open" : "folder"} size={15}/><span title={name}>{name}</span>{folder === name && <Icon name="check" size={13}/>}</button>)}</>
            : <><div className="ui-aov__menu-title">Apps</div>{appList.map(app => <button type="button" role="menuitemcheckbox" aria-checked={connected.includes(app.id)} key={app.id} onClick={() => setConnected(connected.includes(app.id) ? connected.filter(item => item !== app.id) : [...connected, app.id])}><i className="ui-aov__logo" aria-hidden="true" style={{ background: app.color }}>{app.name.slice(0, 1)}</i><span title={app.name}>{app.name}</span>{connected.includes(app.id) && <Icon name="check" size={13}/>}</button>)}</>}
        </FloatingMenu>}
      </div>
      <div className="ui-aov__below"><OverviewCards {...overview} onNavigate={onNavigate}/></div>
    </section></div>
  </AppShell>;
}

/* ---------- Styles ---------- */
.ui-aov{min-height:480px}.ui-aov .ui-as__main{overflow:hidden}.ui-aov__scroll{height:100%;overflow:auto;container:ui-aov / inline-size}
.ui-aov__start{display:flex;flex-direction:column;align-items:center;justify-content:center;width:min(880px,100% - 48px);min-height:100%;margin:0 auto;padding:64px 0}
.ui-aov__title{margin:0;font-size:28px;font-weight:500;line-height:34px;letter-spacing:-.025em;color:var(--ui-as-ink);text-align:center;text-wrap:balance}.ui-aov__brand{display:inline-flex;align-items:center;gap:9px;font-size:22px;font-weight:600;line-height:28px;letter-spacing:-.02em}
.ui-aov__composer{position:relative;width:100%;max-width:672px;margin-top:30px}.ui-aov__composer .ui-cc{border-radius:18px;background:var(--ui-cc-tray);box-shadow:0 0 0 .5px var(--ui-cc-line)}.ui-aov__composer .ui-cc__footer{padding:0}
.ui-aov__tray{display:flex;align-items:center;justify-content:space-between;gap:8px;height:37px;padding:0 6px}.ui-aov__tray-link{display:inline-flex!important;align-items:center;gap:6px;min-width:0;height:26px;padding:0 8px!important;border-radius:8px;font-size:12px;color:var(--ui-as-muted)!important;transition:background-color 120ms ease,color 120ms ease}.ui-aov__tray-link>span:not(.ui-aov__apps){overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-aov__tray-link>svg{color:#00a1ff}.ui-aov__tray-link:hover,.ui-aov__tray-link[aria-expanded="true"]{background:var(--ui-as-fill)!important;color:var(--ui-as-ink)!important}.ui-aov__tray-link--apps{flex:none}
.ui-aov__apps{display:inline-flex;gap:3px;margin-left:4px}.ui-aov__apps i,.ui-aov__logo{display:inline-grid;place-items:center;width:14px;height:14px;border-radius:4px;color:#fff;font:600 9px/1 inherit;font-style:normal}
.ui-aov__menu{min-width:220px;padding:4px;border-radius:12px;background:var(--ui-as-card);box-shadow:var(--ui-as-shadow);font-size:13px;overflow:auto;animation:ui-aov-pop 160ms var(--ui-as-ease)}.ui-aov__menu-title{padding:6px 10px 4px;font-size:12px;color:var(--ui-as-faint)}.ui-aov__menu button{display:flex;align-items:center;gap:10px;width:100%;min-height:32px;padding:0 10px!important;border-radius:8px;text-align:left;color:var(--ui-as-ink)}.ui-aov__menu button:hover,.ui-aov__menu button:focus-visible{background:var(--ui-as-fill)!important;outline:none}.ui-aov__menu button>span{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-aov__menu button>svg{color:var(--ui-as-muted)}.ui-aov__logo{width:16px;height:16px}
.ui-aov__below{width:100%;margin-top:28px}
@keyframes ui-aov-pop{from{opacity:0;transform:translateY(-4px) scale(.98)}}
@container ui-aov (max-width:600px){.ui-aov__start{width:calc(100% - 24px);padding:56px 0 40px}.ui-aov__title{font-size:23px;line-height:29px}.ui-aov__composer{margin-top:22px}}
@media(pointer:coarse){.ui-aov__tray-link{height:34px}.ui-aov__menu button{min-height:44px}}
@media(prefers-reduced-motion:reduce){.ui-aov *{animation:none!important;transition:none!important}}
