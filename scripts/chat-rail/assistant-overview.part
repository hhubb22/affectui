export type AssistantOverviewApp = { id: string; name: string; color?: string };
export type AssistantOverviewScreenProps = Omit<AppShellProps, "children" | "panel" | "panelTitle" | "navigation"> & {
  /** Start-page heading. Defaults to the affectUI mark. */
  title?: ReactNode;
  /** Data for the cards under the composer. Rows and “N more” buttons fall back to onNavigate. */
  overview?: Omit<OverviewCardsProps, "onNavigate">;
  onSend?: (message: string, options: ChatComposerSendOptions) => void;
  composerProps?: Omit<ChatComposerProps, "onSend" | "footer">;
  folders?: string[];
  folder?: string;
  defaultFolder?: string;
  onFolderChange?: (folder: string) => void;
  apps?: AssistantOverviewApp[];
  connectedApps?: string[];
  defaultConnectedApps?: string[];
  onConnectedAppsChange?: (ids: string[]) => void;
  suggested?: WorkspaceSource[];
  onOpenSource?: (source: WorkspaceSource) => void;
  onOpenTool?: (tool: WorkspaceToolKind) => void;
  onOpenUrl?: (url: string) => void;
};

export const defaultOverviewFolders = ["Q3 Campaign", "Brand assets", "Hiring", "Research"];
export const defaultOverviewApps: AssistantOverviewApp[] = [{ id: "gmail", name: "Gmail", color: "#ea4335" }, { id: "slack", name: "Slack", color: "#4a154b" }, { id: "clickup", name: "ClickUp", color: "#7b68ee" }];
export const defaultOverviewSources: WorkspaceSource[] = [
  { name: "GEO: Generative Engine Optimization", description: "arxiv.org", kind: "document" },
  { name: "Design tokens – naming guide", description: "notion.so", kind: "document" },
  { name: "Q3 launch checklist", description: "linear.app", kind: "document" },
  { name: "Q3 launch budget", description: "sheets.google.com", kind: "table" },
];
const overviewNavigation: AppRailItem[] = [
  { label: "New chat", icon: <Icon name="compose"/> }, { label: "Folders", icon: <Icon name="folder"/> }, { label: "Integrations", icon: <Icon name="plug"/> },
  { label: "Q3 launch messaging", icon: <Icon name="chat"/>, section: "Pinned" },
  ...defaultOverviewFolders.map(label => ({ label, icon: <Icon name="folder"/>, section: "Projects" })),
  { label: "Onboarding email draft", icon: <Icon name="chat"/>, section: "Chats" }, { label: "August content calendar", icon: <Icon name="chat"/>, section: "Chats" },
];
const overviewLogos = {
  gmail: <svg aria-hidden="true" viewBox="0 0 56.4108 44.8722" fill="none"><path d="M44.2255 5.76727H56.4051V41.0239C56.4051 43.148 54.683 44.8701 52.5589 44.8701H46.1486C45.8961 44.8701 45.646 44.8204 45.4127 44.7237C45.1794 44.6271 44.9674 44.4854 44.7888 44.3069C44.6102 44.1283 44.4686 43.9163 44.3719 43.683C44.2753 43.4497 44.2255 43.1996 44.2255 42.947V5.76727Z" fill="url(#ui-aov-gmail-0)"/><path d="M12.1796 5.76727H0V41.0239C0 43.148 1.72213 44.8701 3.84618 44.8701H10.2565C10.509 44.8701 10.7591 44.8204 10.9924 44.7237C11.2257 44.6271 11.4377 44.4854 11.6163 44.3069C11.7949 44.1283 11.9365 43.9163 12.0332 43.683C12.1298 43.4497 12.1796 43.1996 12.1796 42.947V5.76727Z" fill="#FC413D"/><path d="M10.0085 1.42778C7.43377 -0.736342 3.5924 -0.403647 1.42828 2.17105C-0.735843 4.74543 -0.403148 8.58681 2.17155 10.7512L26.5557 31.2479C27.0178 31.6362 27.602 31.8492 28.2056 31.8492C28.8091 31.8492 29.3934 31.6362 29.8554 31.2479L54.2396 10.7509C56.814 8.58681 57.1467 4.74543 54.9825 2.17073C52.8184 -0.403648 48.977 -0.736342 46.4027 1.42778L28.2054 16.724L10.0085 1.42778Z" fill="url(#ui-aov-gmail-1)"/><defs><linearGradient id="ui-aov-gmail-0" x1="50.3153" y1="5.76727" x2="50.3153" y2="44.8701" gradientUnits="userSpaceOnUse"><stop stopColor="#60D673"/><stop offset="0.17" stopColor="#42C868"/><stop offset="0.39" stopColor="#0EBC5F"/><stop offset="0.62" stopColor="#00A9BB"/><stop offset="0.86" stopColor="#3C90FF"/><stop offset="1" stopColor="#3186FF"/></linearGradient><linearGradient id="ui-aov-gmail-1" x1="6.04194e-05" y1="6.45153" x2="56.4107" y2="6.45153" gradientUnits="userSpaceOnUse"><stop offset="0.08" stopColor="#FF63A0"/><stop offset="0.3" stopColor="#FC413D"/><stop offset="0.5" stopColor="#FC413D"/><stop offset="0.65" stopColor="#FC413D"/><stop offset="0.72" stopColor="#FC5C30"/><stop offset="0.86" stopColor="#FEB10C"/><stop offset="0.91" stopColor="#FEC700"/><stop offset="0.96" stopColor="#FFDB0F"/></linearGradient></defs></svg>,
  clickup: <svg aria-hidden="true" viewBox="0 0 49.7096 59.6884" fill="none"><path fillRule="evenodd" clipRule="evenodd" d="M0 45.9002L9.1618 38.8247C14.0602 45.1745 19.2307 48.1679 24.9455 48.1679C30.6603 48.1679 35.7401 45.2652 40.3663 38.9154L49.7096 45.8094C42.997 54.8805 34.6516 59.6882 24.9455 59.6882C15.3301 59.6882 6.89403 54.8805 0 45.9002Z" fill="url(#ui-aov-clickup-0)"/><path fillRule="evenodd" clipRule="evenodd" d="M24.9535 15.3301L8.62558 29.3903L1.09657 20.5914L25.0442 0L48.8105 20.5914L41.1908 29.2996L24.9535 15.3301Z" fill="url(#ui-aov-clickup-1)"/><defs><linearGradient id="ui-aov-clickup-0" x1="0" y1="49.2666" x2="49.75" y2="49.2666" gradientUnits="userSpaceOnUse"><stop stopColor="#8930FD"/><stop offset="1" stopColor="#49CCF9"/></linearGradient><linearGradient id="ui-aov-clickup-1" x1="1.09231" y1="14.6901" x2="48.7603" y2="14.6901" gradientUnits="userSpaceOnUse"><stop stopColor="#FF02F0"/><stop offset="1" stopColor="#FFC800"/></linearGradient></defs></svg>,
  hubspot: <svg aria-hidden="true" viewBox="0 0 24 24" fill="#FF7A59"><path d="M18.164 7.93V5.084a2.198 2.198 0 001.267-1.978v-.067A2.2 2.2 0 0017.238.845h-.067a2.2 2.2 0 00-2.193 2.193v.067a2.196 2.196 0 001.252 1.973l.013.006v2.852a6.22 6.22 0 00-2.969 1.31l.012-.01-7.828-6.095A2.497 2.497 0 104.3 4.656l-.012.006 7.697 5.991a6.176 6.176 0 00-1.038 3.446c0 1.343.425 2.588 1.147 3.607l-.013-.02-2.342 2.343a1.968 1.968 0 00-.58-.095h-.002a2.033 2.033 0 102.033 2.033 1.978 1.978 0 00-.1-.595l.005.014 2.317-2.317a6.247 6.247 0 104.782-11.134l-.036-.005zm-.964 9.378a3.206 3.206 0 113.215-3.207v.002a3.206 3.206 0 01-3.207 3.207z"/></svg>,
  calendar: <svg aria-hidden="true" viewBox="0 0 24 24" fill="#4285F4"><path d="M18.316 5.684H24v12.632h-5.684V5.684zM5.684 24h12.632v-5.684H5.684V24zM18.316 5.684V0H1.895A1.894 1.894 0 0 0 0 1.895v16.421h5.684V5.684h12.632zm-7.207 6.25v-.065c.272-.144.5-.349.687-.617s.279-.595.279-.982c0-.379-.099-.72-.3-1.025a2.05 2.05 0 0 0-.832-.714 2.703 2.703 0 0 0-1.197-.257c-.6 0-1.094.156-1.481.467-.386.311-.65.671-.793 1.078l1.085.452c.086-.249.224-.461.413-.633.189-.172.445-.257.767-.257.33 0 .602.088.816.264a.86.86 0 0 1 .322.703c0 .33-.12.589-.36.778-.24.19-.535.284-.886.284h-.567v1.085h.633c.407 0 .748.109 1.02.327.272.218.407.499.407.843 0 .336-.129.614-.387.832s-.565.327-.924.327c-.351 0-.651-.103-.897-.311-.248-.208-.422-.502-.521-.881l-1.096.452c.178.616.505 1.082.977 1.401.472.319.984.478 1.538.477a2.84 2.84 0 0 0 1.293-.291c.382-.193.684-.458.902-.794.218-.336.327-.72.327-1.149 0-.429-.115-.797-.344-1.105a2.067 2.067 0 0 0-.881-.689zm2.093-1.931l.602.913L15 10.045v5.744h1.187V8.446h-.827l-2.158 1.557zM22.105 0h-3.289v5.184H24V1.895A1.894 1.894 0 0 0 22.105 0zm-3.289 23.5l4.684-4.684h-4.684V23.5zM0 22.105C0 23.152.848 24 1.895 24h3.289v-5.184H0v3.289z"/></svg>,
