export type ThreadTask = {
  id: string;
  title: string;
  status: string;
  steps?: { done: number; total: number };
  done?: boolean;
  tone?: "active" | "waiting" | "done" | "error";
};
export type ThreadTaskCardProps = { task: ThreadTask; onOpen?: (id: string) => void; className?: string };

/** A compact task mention; opening it keeps the conversation in place. */
export function ThreadTaskCard({ task, onOpen, className }: ThreadTaskCardProps) {
  const tone = task.done ? "done" : ["active", "waiting", "done", "error"].includes(task.tone ?? "") ? task.tone : "waiting";
  const total = Math.max(0, safeNumber(task.steps?.total, 0));
  const done = clamp(safeNumber(task.steps?.done, 0), 0, total);
  return <div className={["ui-tk", className].filter(Boolean).join(" ")} data-tone={tone}>
    <style href="ui-thread-task-card" precedence="default">{css}</style>
    <span className="ui-tk__mark" aria-hidden="true">{tone === "done" ? <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.5" stroke="currentColor"/><circle cx="8" cy="8" r="4.5" fill="currentColor"/></svg> : tone === "error" ? <Icon name="warning" size={14}/> : <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.5" stroke="currentColor"/><path d="M8 3v5l-2.5 4.3A5 5 0 0 0 8 3Z" fill="currentColor"/></svg>}</span>
    <span className="ui-tk__text"><strong dir="auto" title={task.title}>{task.title}</strong><small dir="auto" title={task.status}>{task.status}</small></span>
    {task.steps && <span className="ui-tk__count" aria-label={`${done} of ${total} steps`}>{done}/{total}</span>}
    <button type="button" disabled={!onOpen} onClick={() => onOpen?.(task.id)} aria-label={`Open ${task.title} – ${task.status}${task.steps ? `, ${done} of ${total} steps` : ""}`}>Open</button>
  </div>;
}

/* ---------- Styles ---------- */
.ui-tk{--ui-tk-card:#fff;--ui-tk-ink:rgba(0,0,0,.88);--ui-tk-muted:rgba(0,0,0,.45);--ui-tk-faint:rgba(0,0,0,.27);--ui-tk-line:rgba(0,0,0,.06);--ui-tk-fill:rgba(0,0,0,.025);--ui-tk-focus:rgba(0,96,226,.35);display:flex;align-items:center;gap:12px;width:100%;min-height:52px;padding:8px 12px;background:var(--ui-tk-card);border-radius:12px;box-shadow:0 0 0 .5px var(--ui-tk-line);font:13px/1.45 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-tk-ink);container-type:inline-size;-webkit-font-smoothing:antialiased;animation:ui-tk-in 420ms cubic-bezier(.22,1,.36,1) both}
.ui-tk,.ui-tk *,.ui-tk *::before,.ui-tk *::after{box-sizing:border-box}.ui-tk__mark{display:flex;flex:none;color:#e8a20c}.ui-tk[data-tone="active"] .ui-tk__mark{color:#ff7c3c}.ui-tk[data-tone="done"] .ui-tk__mark{color:#0095ff}.ui-tk[data-tone="error"] .ui-tk__mark{color:#e5484d}.ui-tk__text{display:flex;flex:1;min-width:0;flex-direction:column}.ui-tk__text strong{font-weight:500;font-size:13px;line-height:18px}.ui-tk__text small{font-size:12px;line-height:16px;color:var(--ui-tk-muted)}.ui-tk__text>*{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-tk__count{font-size:12px;color:var(--ui-tk-faint);font-variant-numeric:tabular-nums}.ui-tk button{font:inherit;font-size:12px;background:none;border:0;border-radius:6px;color:var(--ui-tk-muted);height:28px;padding:0 6px;cursor:pointer;flex:none}.ui-tk button:hover{background:var(--ui-tk-fill);color:var(--ui-tk-ink)}.ui-tk button:disabled{opacity:.4;cursor:default}.ui-tk button:focus-visible{outline:2px solid var(--ui-tk-focus);outline-offset:2px}.ui-tk button:active:not(:disabled){transform:scale(.97)}
@keyframes ui-tk-in{from{opacity:0;transform:translateY(8px)}}
@container(max-width:320px){.ui-tk__text small{font-size:11px}.ui-tk__count{display:none}}
@media(pointer:coarse){.ui-tk{min-height:56px}.ui-tk button{height:36px}}
@media(prefers-reduced-motion:reduce){.ui-tk,.ui-tk *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-tk{--ui-tk-card:#1c1c1e;--ui-tk-ink:rgba(255,255,255,.9);--ui-tk-muted:rgba(255,255,255,.46);--ui-tk-faint:rgba(255,255,255,.3);--ui-tk-line:rgba(255,255,255,.08);--ui-tk-fill:rgba(255,255,255,.04);--ui-tk-focus:rgba(77,141,255,.5)}
