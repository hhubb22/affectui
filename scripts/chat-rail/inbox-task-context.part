export type InboxTaskContextLabels = { status?: string; project?: string; started?: string; steps?: string; artifacts?: string; decided?: string; needs?: string; waiting?: string; working?: string };
export type InboxTaskContextProps = { name?: string; task?: InboxTask; items?: InboxItem[]; activeId?: string|null; onOpenItem?: (id: string) => void; onOpenArtifact?: (name: string) => void; labels?: InboxTaskContextLabels; now?: number; className?: string };

/** The task behind a question, with its steps, files and previously answered questions. */
export function InboxTaskContext({name,task,items=[],activeId,onOpenItem,onOpenArtifact,labels={},now=Date.now(),className}:InboxTaskContextProps) {
  const waiting=items.some(item=>item.task===name&&!item.done),steps=task?.steps??[],complete=steps.filter(step=>step.done).length,first=steps.findIndex(step=>!step.done),decided=items.filter(item=>item.task===name&&item.done&&item.id!==activeId);
  return <section className={["ui-ibx",className].filter(Boolean).join(" ")} aria-label={name?`${name}, task context`:"Task context"}><style href="ui-inbox-task-context" precedence="default">{css}</style>{name&&task?<>
    {task.goal&&<p className="ui-ibx__goal" dir="auto">{task.goal}</p>}
    <dl className="ui-ibx__properties"><div><dt>{labels.status??"Status"}</dt><dd><svg className="ui-ibx__ring" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" strokeWidth="1.4"/><circle cx="8" cy="8" r="3" pathLength="1" fill="none" stroke="currentColor" strokeWidth="6" strokeDasharray={`${steps.length?complete/steps.length:0} 1`} transform="rotate(-90 8 8)"/></svg><span>{waiting?labels.waiting??"Waiting on you":task.status??labels.working??"Running"}</span>{!!steps.length&&<span className="ui-ibx__count">{complete}/{steps.length}</span>}</dd></div>{task.project&&<div><dt>{labels.project??"Project"}</dt><dd dir="auto">{task.project}</dd></div>}{task.started&&<div><dt>{labels.started??"Started"}</dt><dd>{task.started}</dd></div>}</dl>
    {!!steps.length&&<section className="ui-ibx__section"><h3>{labels.steps??"Steps"}</h3><ol className="ui-ibx__steps">{steps.map((step,index)=><li key={index} data-done={step.done||undefined} data-current={index===first||undefined} data-waiting={index===first&&waiting||undefined}><span className="ui-ibx__step-mark">{step.done&&<Icon name="check" size={10}/>}</span><span dir="auto">{step.label}</span>{index===first&&waiting&&<span className="ui-ibx__needs">{labels.needs??"Needs you"}</span>}</li>)}</ol></section>}
    {!!task.artifacts?.length&&<section className="ui-ibx__section"><h3>{labels.artifacts??"Artifacts"}<span>{task.artifacts.length}</span></h3><div className="ui-ibx__files">{task.artifacts.map(file=><button type="button" key={file} title={file} onClick={()=>onOpenArtifact?.(file)}><span data-kind={file.endsWith(".csv")?"table":file.endsWith(".json")?"code":file.includes(".")?"document":"folder"}><Icon name={file.endsWith(".csv")?"table":file.endsWith(".json")?"document":file.includes(".")?"document":"folder"} size={12}/></span><span dir="auto">{file}</span></button>)}</div></section>}
    {!!decided.length&&<section className="ui-ibx__section"><h3>{labels.decided??"Decided"}</h3><div className="ui-ibx__decided">{decided.map(item=><button type="button" key={item.id} onClick={()=>onOpenItem?.(item.id)}><InboxGlyph kind="done" size={14}/><span><span dir="auto" title={item.question}>{item.question}</span><span dir="auto" title={item.done!.label??inboxAnswerLabel(item,item.done!.answer)}>{item.done!.label??inboxAnswerLabel(item,item.done!.answer)} · {inboxAge(item.done!.at,now).long}</span></span><Icon name="chevron" size={12}/></button>)}</div></section>}
  </>:null}</section>;
}

/* ---------- Styles ---------- */
.ui-ibx{--ui-ibx-card:#fff;--ui-ibx-ink:rgba(0,0,0,.88);--ui-ibx-text:rgba(0,0,0,.61);--ui-ibx-muted:rgba(0,0,0,.45);--ui-ibx-faint:rgba(0,0,0,.27);--ui-ibx-line:rgba(0,0,0,.06);--ui-ibx-fill:rgba(0,0,0,.025);--ui-ibx-focus:rgba(0,96,226,.7);width:100%;padding:18px;color:var(--ui-ibx-ink);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-ibx / inline-size;-webkit-font-smoothing:antialiased}.ui-ibx,.ui-ibx *,.ui-ibx *::before,.ui-ibx *::after{box-sizing:border-box}.ui-ibx__goal{margin:0 0 24px;color:var(--ui-ibx-text);font-size:13px;line-height:20px;overflow-wrap:anywhere}.ui-ibx__properties{display:flex;flex-direction:column;gap:10px;margin:0}.ui-ibx__properties>div{display:grid;grid-template-columns:64px minmax(0,1fr);gap:12px;align-items:start}.ui-ibx dt{font-size:12px;color:var(--ui-ibx-muted)}.ui-ibx dd{display:flex;align-items:center;gap:6px;margin:0;min-width:0;overflow-wrap:anywhere}.ui-ibx__ring{flex:none;width:14px;height:14px;color:var(--ui-ibx-muted)}.ui-ibx__count{color:var(--ui-ibx-faint);font-variant-numeric:tabular-nums}.ui-ibx__section{margin-top:24px}.ui-ibx__section+.ui-ibx__section{margin-top:20px}.ui-ibx h3{display:flex;align-items:center;gap:6px;margin:0 0 8px;font-size:12px;font-weight:400;line-height:16px;color:var(--ui-ibx-muted)}.ui-ibx h3>span{color:var(--ui-ibx-faint);font-variant-numeric:tabular-nums}.ui-ibx__steps{display:flex;flex-direction:column;gap:0;list-style:none;margin:0 -10px;padding:6px 10px;border-radius:12px;background:var(--ui-ibx-fill)}.ui-ibx__steps li{display:flex;align-items:center;gap:10px;min-height:28px;color:var(--ui-ibx-muted)}.ui-ibx__steps li>span:nth-child(2){flex:1;min-width:0;overflow-wrap:anywhere}.ui-ibx__step-mark{display:grid;place-items:center;flex:none;width:14px;height:14px;border-radius:50%;box-shadow:inset 0 0 0 1px var(--ui-ibx-line)}.ui-ibx__steps li[data-done] .ui-ibx__step-mark{background:#0190fe;color:#fff;box-shadow:none}.ui-ibx__steps li[data-current]{color:var(--ui-ibx-ink)}.ui-ibx__steps li[data-current] .ui-ibx__step-mark{box-shadow:inset 0 0 0 1px #0190fe}.ui-ibx__steps li[data-waiting] .ui-ibx__step-mark{box-shadow:inset 0 0 0 1px #f76b00}.ui-ibx__needs{flex:none;font-size:11px;font-weight:500;line-height:18px;padding:0 6px;border-radius:4px;color:#eb5600;background:rgba(255,156,0,.16)}.ui-ibx__files{display:flex;flex-wrap:wrap;gap:6px}.ui-ibx :where(button){border:0;font:inherit;color:inherit;cursor:pointer}.ui-ibx button:focus-visible{outline:2px solid var(--ui-ibx-focus);outline-offset:2px}.ui-ibx button:active{transform:scale(.97)}.ui-ibx__files>button{display:flex;align-items:center;gap:6px;max-width:100%;min-height:26px;padding:3px 8px;border-radius:6px;background:var(--ui-ibx-fill);font-size:12px;line-height:20px}.ui-ibx__files>button>span:last-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-ibx__files>button>span:first-child{display:flex;flex:none;color:#68b1ee}.ui-ibx__files [data-kind="table"]{color:#89d4aa!important}.ui-ibx__files [data-kind="code"]{color:#f4b17e!important}.ui-ibx__files [data-kind="folder"]{color:#ecd16e!important}.ui-ibx__decided{margin:0 -10px;display:flex;flex-direction:column;gap:4px}.ui-ibx__decided>button{display:flex;align-items:center;gap:10px;width:100%;min-height:58px;padding:8px 10px;border-radius:12px;background:var(--ui-ibx-card);box-shadow:0 0 0 .5px var(--ui-ibx-line);text-align:left}.ui-ibx__decided>button>svg:first-child{flex:none;color:#5fc88a}.ui-ibx__decided>button>span{display:flex;flex-direction:column;flex:1;min-width:0}.ui-ibx__decided>button>span>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-ibx__decided>button>span>span:last-child{font-size:12px;color:var(--ui-ibx-muted)}.ui-ibx__decided>button>svg:last-child{display:none}.ui-ibx__placeholder{color:var(--ui-ibx-muted)}
@container ui-ibx (max-width:270px){.ui-ibx__properties>div{grid-template-columns:56px minmax(0,1fr);gap:8px}.ui-ibx__needs{padding:0 4px}}
@media(pointer:coarse){.ui-ibx__files>button,.ui-ibx__decided>button{min-height:36px}}
@media(prefers-reduced-motion:reduce){.ui-ibx,.ui-ibx *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-ibx{--ui-ibx-card:#1c1c1e;--ui-ibx-ink:rgba(255,255,255,.9);--ui-ibx-text:rgba(255,255,255,.62);--ui-ibx-muted:rgba(255,255,255,.46);--ui-ibx-faint:rgba(255,255,255,.3);--ui-ibx-line:rgba(255,255,255,.08);--ui-ibx-fill:rgba(255,255,255,.025);--ui-ibx-focus:rgba(77,141,255,.8)}
:where(.dark,[data-theme="dark"]) .ui-ibx__needs{background:rgba(251,106,0,.15);color:#ffa057}
