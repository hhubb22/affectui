export const defaultTaskSources: WorkspaceSource[] = [{name:"staging",description:"Ingest pipeline",artifact:"staging",kind:"folder"},{name:"benchmarks.csv",description:"Benchmark suite",artifact:"benchmarks.csv",kind:"table"},{name:"migration-plan.md",description:"API migration",artifact:"migration-plan.md",kind:"document"}];
export type AgentTasksLabels = TaskListLabels & TaskInspectorLabels & { create?: string; placeholder?: string };
export type AgentTasksScreenProps = Omit<AppShellProps,"children"|"panel"|"panelTitle"|"navigation"|"project"|"defaultProject"|"onProjectChange"> & {
  tasks?: AgentTask[]; defaultTasks?: AgentTask[]; onTasksChange?: (tasks: AgentTask[]) => void;
  projects?: string[];
  tab?: TaskListTab; defaultTab?: TaskListTab; onTabChange?: (tab: TaskListTab) => void;
  selected?: string | null; defaultSelected?: string | null; onSelectedChange?: (id: string | null) => void; onSelect?: (id: string) => void;
  onCreate?: (task: AgentTask) => void;
  createOpen?: boolean; defaultCreateOpen?: boolean; onCreateOpenChange?: (open: boolean) => void;
  project?: string; defaultProject?: string; onProjectChange?: (project: string) => void;
  collapsedProjects?: string[]; defaultCollapsedProjects?: string[]; onCollapsedProjectsChange?: (projects: string[]) => void;
  onOpenInbox?: (taskId: string,itemId?: string) => void;
  onOpenArtifact?: (taskId: string,name: string) => void;
  onArtifactChange?: (name: string,file: ArtifactFile) => void;
  files?: ArtifactFile[]; defaultFiles?: ArtifactFile[]; onFilesChange?: (files: ArtifactFile[]) => void;
  openFiles?: string[]; defaultOpenFiles?: string[]; onOpenFilesChange?: (names: string[]) => void;
  activeFile?: string; defaultActiveFile?: string; onActiveFileChange?: (name: string) => void;
  suggested?: WorkspaceSource[]; labels?: AgentTasksLabels;
  onOpenTool?: (tool: WorkspaceToolKind) => void; renderTool?: (tool: WorkspaceToolKind) => ReactNode; onOpenUrl?: (url: string) => void;
};

/** A task/project overview with a persistent task tab and editable artifact tabs in the shell's work area. */
export function AgentTasksScreen({tasks:tasksProp,defaultTasks,onTasksChange,projects:projectOrder,tab:tabProp,defaultTab="active",onTabChange,selected:selectedProp,defaultSelected="ingest",onSelectedChange,onSelect,onCreate,createOpen:createProp,defaultCreateOpen=false,onCreateOpenChange,project:projectProp,defaultProject,onProjectChange,collapsedProjects,defaultCollapsedProjects,onCollapsedProjectsChange,onOpenInbox,onOpenArtifact,onArtifactChange,files:filesProp,defaultFiles=defaultAgentTaskFiles,onFilesChange,openFiles:openedProp,defaultOpenFiles, onOpenFilesChange,activeFile:activeProp,defaultActiveFile,onActiveFileChange,panelOpen:panelProp,defaultPanelOpen=true,onPanelOpenChange,suggested=defaultTaskSources,labels={},onOpenTool,renderTool,onOpenUrl,onNavigate,className,style,...shellProps}:AgentTasksScreenProps) {
  const [initialTasks]=useState(()=>defaultTasks??createDefaultAgentTasks());
  const [tasks,setTasks]=useControllable(tasksProp,initialTasks,onTasksChange),[tab,setTab]=useControllable(tabProp,defaultTab,onTabChange),[selected,setSelected]=useControllable<string|null>(selectedProp,defaultSelected,onSelectedChange),[creating,setCreating]=useControllable(createProp,defaultCreateOpen,onCreateOpenChange);
  const projects=[...new Set([...(projectOrder??[]),...tasks.map(task=>task.project||"Workspace")])];
  const [project,setProject]=useControllable(projectProp,defaultProject??projects[0]??"Workspace",onProjectChange);
  const [files,setFiles]=useControllable(filesProp,defaultFiles,onFilesChange),[opened,setOpened]=useControllable(openedProp,defaultOpenFiles??(defaultSelected?["task"]:[]),onOpenFilesChange),[active,setActive]=useControllable(activeProp,defaultActiveFile??defaultOpenFiles?.[0]??(defaultSelected?"task":""),onActiveFileChange),[panelOpen,setPanelOpen]=useControllable(panelProp,false,onPanelOpenChange);
  const [focusRequest,setFocusRequest]=useState(0),[freshIds,setFreshIds]=useState<string[]>([]),[notice,setNotice]=useState("");
  const [startTabs,setStartTabs]=useState<string[]>([]),[toolTabs,setToolTabs]=useState<{id:string;kind:WorkspaceToolKind}[]>([]),[toolValues,setToolValues]=useState<Record<string,string>>({}),[toolLines,setToolLines]=useState<Record<string,string[]>>({});
  const root=useRef<HTMLDivElement>(null),sequence=useRef(0),layout=useRef<boolean|undefined>(undefined),fileRef=useRef(files);fileRef.current=files;
  const current=tasks.find(task=>task.id===selected)??null;
  useLayoutEffect(()=>{const el=root.current;if(!el)return;const measure=()=>{const narrow=el.getBoundingClientRect().width<900;if(panelProp===undefined){if(layout.current===undefined)setPanelOpen(defaultPanelOpen&&opened.some(name=>name!=="task"||!!current)&&!narrow);else if(narrow&&!layout.current)setPanelOpen(false);}layout.current=narrow;};measure();const observer=new ResizeObserver(measure);observer.observe(el);return()=>observer.disconnect();},[panelProp]);
  useEffect(()=>{if(!freshIds.length)return;const timer=setTimeout(()=>setFreshIds([]),500);return()=>clearTimeout(timer);},[freshIds]);
  const closePanel=()=>{setPanelOpen(false);requestAnimationFrame(()=>{const rows=[...(root.current?.querySelectorAll<HTMLButtonElement>("[data-task-key]")??[])];rows.find(row=>row.dataset.taskKey===`task:${selected}`)?.focus({preventScroll:true});});};
  const openInbox=(taskId:string,itemId?:string)=>onOpenInbox?onOpenInbox(taskId,itemId):onNavigate?.("Inbox");
  const openTask=(id:string,keyboard=false)=>{setSelected(id);if(!opened.includes("task"))setOpened([...opened,"task"]);setActive("task");setPanelOpen(true);setFocusRequest(previous=>keyboard?previous+1:0);onSelect?.(id);};
  const updateFiles=(next:ArtifactFile[])=>{const previous=fileRef.current;fileRef.current=next;setFiles(next);next.forEach(file=>{if(JSON.stringify(previous.find(item=>item.name===file.name))!==JSON.stringify(file))onArtifactChange?.(file.name,file);});};
  const openArtifact=(name:string,replace?:string)=>{if(!fileRef.current.some(file=>file.name===name)){const file:ArtifactFile={kind:"document",name,content:`# ${name}\n\n`,updated:"Just now"};updateFiles([...fileRef.current,file]);}const next=replace?opened.map(id=>id===replace?name:id):[...opened,name];setOpened([...new Set(next)]);if(replace)setStartTabs(tabs=>tabs.filter(id=>id!==replace));setActive(name);setPanelOpen(true);onOpenArtifact?.(selected??"",name);};
  const changeOpened=(next:string[])=>{setOpened(next);setStartTabs(tabs=>tabs.filter(id=>next.includes(id)));setToolTabs(tabs=>tabs.filter(tab=>next.includes(tab.id)));if(!next.length)closePanel();};
  const newTab=()=>{const id=`new-${++sequence.current}`;setStartTabs(tabs=>[...tabs,id]);setOpened([...opened,id]);setActive(id);setPanelOpen(true);};
  const openTool=(kind:WorkspaceToolKind,replace?:string)=>{const id=replace??`tool-${++sequence.current}`;if(replace)setStartTabs(tabs=>tabs.filter(tab=>tab!==replace));else setOpened([...opened,id]);setToolTabs(tabs=>[...tabs.filter(tab=>tab.id!==id),{id,kind}]);setActive(id);setPanelOpen(true);onOpenTool?.(kind);};
  const openUrl=(value:string)=>{try{const url=new URL(/^[a-z][a-z\d+.-]*:/i.test(value)?value:`https://${value}`);if(!["http:","https:"].includes(url.protocol))throw new Error("Invalid address");if(onOpenUrl)onOpenUrl(url.href);else window.open(url.href,"_blank","noopener,noreferrer");}catch{setNotice("Enter a valid web address");}};
  const create=(draft:TaskDraft)=>{const now=Date.now(),task:AgentTask={id:`task-${now}-${++sequence.current}`,title:draft.title.split("\n")[0],goal:draft.title,project:draft.project,status:"planning",updatedAt:now,started:"Today",history:["You asked for it – the orchestrator is planning the steps"]};const index=tasks.findIndex(item=>item.project===task.project);setTasks(index<0?[...tasks,task]:[...tasks.slice(0,index),task,...tasks.slice(index)]);setTab("active");setSelected(task.id);setFreshIds([task.id]);if(!opened.includes("task"))setOpened([...opened,"task"]);setActive("task");setPanelOpen(true);setFocusRequest(0);setNotice(`Task created in ${task.project}`);onCreate?.(task);};
  const toggleCreate=()=>{if(creating)root.current?.querySelector<HTMLTextAreaElement>(".ui-tcr textarea")?.focus({preventScroll:true});else setCreating(true);};
  const closeCreate=()=>{setCreating(false);requestAnimationFrame(()=>root.current?.querySelector<HTMLButtonElement>(".ui-tls__new")?.focus({preventScroll:true}));};
  const navigation:AppRailItem[]=[{label:"Thread",icon:<Icon name="chat"/>},{label:"Inbox",icon:<Icon name="inbox"/>,count:tasks.reduce((count,task)=>count+agentTaskNeeds(task),0)},{label:"Tasks",icon:<Icon name="tasks"/>},{label:"Memory",icon:<Icon name="memory"/>},{label:"Settings",icon:<Icon name="settings"/>,section:"Workspace"}];
  const searchGroups:CommandMenuGroup[]=[{id:"tasks",label:labels.tasks??"Tasks",commands:[{id:"create-task",label:labels.newTask??"New task",icon:<Icon name="plus"/>,onSelect:toggleCreate},...tasks.map(task=>({id:`task:${task.id}`,label:task.title,description:`${task.project} · ${agentTaskStatus(task,Date.now())}`,icon:<Icon name="tasks"/>,onSelect:()=>openTask(task.id,true)}))]},{id:"workspace",label:"Workspace",commands:navigation.map(item=>({id:`navigate:${item.label}`,label:item.label,icon:item.icon,onSelect:()=>onNavigate?.(item.label)}))}];
  const extraTabs:ArtifactWorkspaceTab[]=[{id:"task",label:current?.title??"Task",icon:<Icon name="tasks" size={14}/>,content:<TaskInspector task={current} labels={labels} onOpenInbox={openInbox} onOpenArtifact={openArtifact} onShowAgents={()=>onNavigate?.("Agent Orchestration")} focusRequest={focusRequest}/>} ,...startTabs.map(id=>({id,label:"New tab",icon:<Icon name="globe" size={14}/>,content:<WorkspaceStart suggested={suggested} onOpenSource={source=>openArtifact(source.artifact??source.name,id)} onOpenTool={kind=>openTool(kind,id)} onOpenUrl={value=>{openTool("browser",id);setToolValues(values=>({...values,[id]:value}));openUrl(value);}}/>})),...toolTabs.map(({id,kind})=>({id,label:kind==="terminal"?"Terminal":kind==="browser"?"Browser":"Notes",icon:<Icon name={kind==="terminal"?"terminal":kind==="browser"?"globe":"compose"} size={14}/>,content:renderTool?.(kind)??<WorkspaceTool kind={kind} value={toolValues[id]??""} onValueChange={value=>setToolValues(values=>({...values,[id]:value}))} lines={toolLines[id]} onLinesChange={lines=>setToolLines(values=>({...values,[id]:lines}))} onOpenUrl={openUrl}/>}))];
  return <div ref={root} data-task-shortcuts="" className={["ui-ats",className].filter(Boolean).join(" ")} style={style}><style href="ui-agent-tasks" precedence="default">{css}</style><AppShell {...shellProps} defaultChats={shellProps.defaultChats??[]} className="ui-ats__shell" defaultActive={shellProps.defaultActive??"Tasks"} navigation={navigation} commands={shellProps.commands??searchGroups} onNavigate={onNavigate} panelOpen={panelOpen} onPanelOpenChange={setPanelOpen} defaultPanelWidth={shellProps.defaultPanelWidth??410} panelTitle="Task" panel={<ArtifactWorkspace files={files} onFilesChange={updateFiles} openFiles={opened} onOpenFilesChange={changeOpened} activeFile={active} onActiveFileChange={setActive} tabs={extraTabs} onNewTab={newTab} onClose={closePanel} closeLabel="Close task" onOpenFile={name=>onOpenArtifact?.(selected??"",name)}/> }><TaskList tasks={tasks} projects={projectOrder} tab={tab} onTabChange={setTab} selected={selected} onSelect={(id,options)=>openTask(id,options.keyboard)} collapsedProjects={collapsedProjects} defaultCollapsedProjects={defaultCollapsedProjects} onCollapsedProjectsChange={onCollapsedProjectsChange} onOpenInbox={openInbox} onNewTask={toggleCreate} createOpen={creating} freshIds={freshIds} labels={labels} createForm={creating?<TaskCreate projects={projects} project={project} onProjectChange={setProject} onCreate={create} onClose={closeCreate} createLabel={labels.create} placeholder={labels.placeholder}/>:undefined}/></AppShell><span className="ui-ats__sr" role="status" aria-live="polite">{notice}</span></div>;
}

/* ---------- Styles ---------- */
.ui-ats{width:100%;height:100%;min-height:0;box-sizing:border-box;container:ui-ats / inline-size;font-family:"Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}.ui-ats,.ui-ats *,.ui-ats *::before,.ui-ats *::after{box-sizing:border-box}.ui-ats__shell{height:100%}.ui-ats .ui-aw__tab{font-size:13px!important;padding-right:28px}.ui-ats__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(prefers-reduced-motion:reduce){.ui-ats,.ui-ats *{scroll-behavior:auto!important}}
