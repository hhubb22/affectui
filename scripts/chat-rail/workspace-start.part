export type WorkspaceToolKind = "terminal" | "browser" | "notes";
export type WorkspaceSource = { id?: string; name: string; description?: string; artifact?: string; kind?: "folder" | "table" | "document" | "code" | "image"; icon?: ReactNode };
export type WorkspaceStartProps = { suggested?: WorkspaceSource[]; query?: string; defaultQuery?: string; onQueryChange?: (query: string) => void; onOpenSource?: (source: WorkspaceSource) => void; onOpenTool?: (tool: WorkspaceToolKind) => void; onOpenUrl?: (url: string) => void; className?: string };

/** A new work-area tab: search or enter a URL, launch a tool, or open a suggested artifact. */
export function WorkspaceStart({suggested=[],query:queryProp,defaultQuery="",onQueryChange,onOpenSource,onOpenTool,onOpenUrl,className}:WorkspaceStartProps) {
  const [query,setQuery]=useControllable(queryProp,defaultQuery,onQueryChange);
  const sources=suggested.filter(source=>`${source.name} ${source.description??""}`.toLocaleLowerCase().includes(query.toLocaleLowerCase()));
  const tools:{kind:WorkspaceToolKind;label:string;hint:string;icon:IconName}[]=[{kind:"terminal",label:"Terminal",hint:"⌃`",icon:"terminal"},{kind:"browser",label:"Browser",hint:"⌘⇧B",icon:"globe"},{kind:"notes",label:"Notes",hint:"⌘⇧N",icon:"compose"}];
  return <section className={["ui-wst",className].filter(Boolean).join(" ")} aria-label="New workspace tab"><style href="ui-workspace-start" precedence="default">{css}</style><form className="ui-wst__search" onSubmit={event=>{event.preventDefault();if(query.trim())onOpenUrl?.(query.trim());}}><Icon name="search" size={14}/><input aria-label="Search or enter URL" placeholder="Search or enter URL" value={query} onChange={event=>setQuery(event.target.value)}/></form><h2>Tools</h2><div className="ui-wst__card">{tools.filter(tool=>tool.label.toLocaleLowerCase().includes(query.toLocaleLowerCase())).map(tool=><button type="button" className="ui-wst__tool" key={tool.kind} onClick={()=>onOpenTool?.(tool.kind)}><span className="ui-wst__icon"><Icon name={tool.icon} size={15}/></span><span>{tool.label}</span><kbd>{tool.hint}</kbd></button>)}</div><h2>Suggested</h2><div className="ui-wst__card">{sources.map(source=><button type="button" className="ui-wst__source" key={source.id??source.artifact??source.name} onClick={()=>onOpenSource?.(source)}><span className="ui-wst__icon" data-kind={source.kind} onErrorCapture={event=>{if(event.target instanceof HTMLImageElement)event.target.style.visibility="hidden";}}>{source.icon??<Icon name={source.kind==="folder"?"folder":source.kind==="table"?"table":"document"} size={15}/>}</span><span><strong dir="auto" title={source.name}>{source.name}</strong>{source.description&&<small dir="auto">{source.description}</small>}</span></button>)}{sources.length===0&&<p className="ui-wst__empty">No matching sources</p>}</div></section>;
}

export type WorkspaceToolProps = { kind: WorkspaceToolKind; value?: string; defaultValue?: string; onValueChange?: (value: string) => void; lines?: string[]; defaultLines?: string[]; onLinesChange?: (lines: string[]) => void; onOpenUrl?: (url: string) => void; className?: string };

/** Frontend tool surfaces; connect onOpenUrl or replace this tab with the application's real tools. */
export function WorkspaceTool({kind:rawKind,value:valueProp,defaultValue="",onValueChange,lines:linesProp,defaultLines=["Fieldwork","Type help to see available commands."],onLinesChange,onOpenUrl,className}:WorkspaceToolProps) {
  const kind=["terminal","browser","notes"].includes(rawKind)?rawKind:"notes";
  const [value,setValue]=useControllable(valueProp,defaultValue,onValueChange),[lines,setLines]=useControllable(linesProp,defaultLines,onLinesChange);
  const output=useRef<HTMLDivElement>(null);
  useEffect(()=>{if(output.current)output.current.scrollTop=output.current.scrollHeight;},[lines]);
  const run=()=>{const command=value.trim();if(!command)return;setValue("");if(command==="clear"){setLines([]);return;}const result=command==="help"?"Commands: help, pwd, ls, echo <text>, clear":command==="pwd"?"/workspace/fieldwork":command==="ls"?"Northwind  Platform  Evalkit":command.startsWith("echo ")?command.slice(5):`${command.split(" ")[0]}: command not found. Type help for available commands.`;setLines([...lines,`$ ${command}`,result]);};
  return <section className={["ui-wst", "ui-wst__tool-pane",className].filter(Boolean).join(" ")} data-tool={kind} aria-label={kind==="terminal"?"Terminal":kind==="browser"?"Browser":"Notes"}><style href="ui-workspace-start" precedence="default">{css}</style>{kind==="notes"?<textarea aria-label="Notes" placeholder="Write a note…" value={value} onChange={event=>setValue(event.target.value)}/>:kind==="terminal"?<><div className="ui-wst__terminal-output" ref={output} role="log" aria-live="polite">{lines.map((line,index)=><div key={index}>{line}</div>)}</div><form className="ui-wst__command" onSubmit={event=>{event.preventDefault();run();}}><span aria-hidden="true">$</span><input aria-label="Terminal command" value={value} onChange={event=>setValue(event.target.value)} autoComplete="off" spellCheck={false}/></form></>:<><form className="ui-wst__search" onSubmit={event=>{event.preventDefault();if(value.trim())onOpenUrl?.(value.trim());}}><Icon name="globe" size={14}/><input aria-label="Browser address" placeholder="Search or enter URL" value={value} onChange={event=>setValue(event.target.value)}/><button type="submit" aria-label="Open URL"><Icon name="arrow" size={14}/></button></form><div className="ui-wst__browser-home"><Icon name="globe" size={36}/><h2>Browser</h2><p>Enter an address to open it.</p></div></>}</section>;
}

/* ---------- Styles ---------- */
.ui-wst{--ui-wst-card:#fff;--ui-wst-ink:rgba(0,0,0,.88);--ui-wst-muted:rgba(0,0,0,.45);--ui-wst-faint:rgba(0,0,0,.27);--ui-wst-line:rgba(0,0,0,.06);--ui-wst-fill:rgba(0,0,0,.04);--ui-wst-focus:#0060e2;height:100%;min-height:0;overflow:auto;padding:16px;color:var(--ui-wst-ink);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-wst / inline-size;-webkit-font-smoothing:antialiased}
.ui-wst,.ui-wst *,.ui-wst *::before,.ui-wst *::after{box-sizing:border-box}.ui-wst button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}.ui-wst button:focus-visible{outline:2px solid var(--ui-wst-focus);outline-offset:-2px}.ui-wst button:active:not(:disabled){transform:scale(.97)}.ui-wst__search{display:flex;align-items:center;gap:8px;min-height:34px;padding:0 10px;border-radius:10px;background:var(--ui-wst-card);box-shadow:0 0 0 .5px var(--ui-wst-line),0 1px 2px rgba(0,0,0,.04);color:var(--ui-wst-faint);margin-bottom:22px}.ui-wst__search input{flex:1;min-width:0;width:0;border:0;outline:none;background:none;color:var(--ui-wst-ink);font:inherit}.ui-wst__search:focus-within{box-shadow:0 0 0 .5px var(--ui-wst-muted)}.ui-wst__search input::placeholder{color:var(--ui-wst-faint)}.ui-wst h2{font-size:12px;font-weight:500;color:var(--ui-wst-muted);margin:0 4px 8px}.ui-wst__card{border-radius:12px;box-shadow:0 0 0 .5px var(--ui-wst-line),0 1px 2px rgba(0,0,0,.03);padding:2px 10px;margin-bottom:22px}.ui-wst__tool,.ui-wst__source{display:flex;align-items:center;gap:10px;width:100%;min-height:42px;text-align:left;padding:8px 0!important}.ui-wst__tool+.ui-wst__tool,.ui-wst__source+.ui-wst__source{border-top:.5px solid var(--ui-wst-line)!important}.ui-wst__tool:hover,.ui-wst__source:hover{background:var(--ui-wst-fill)}.ui-wst__icon{display:grid;place-items:center;flex:none;width:26px;height:26px;border-radius:7px;background:var(--ui-wst-fill);color:var(--ui-wst-muted)}.ui-wst__icon[data-kind="folder"]{color:#e8b000}.ui-wst__icon[data-kind="table"]{color:#44ad76}.ui-wst__icon[data-kind="document"]{color:#2989df}.ui-wst__tool>kbd{font:11px/20px inherit;font-family:inherit;background:var(--ui-wst-fill);border-radius:5px;padding:0 5px;color:var(--ui-wst-faint);margin-left:auto}.ui-wst__source>span:last-child{display:flex;flex-direction:column;min-width:0}.ui-wst__source strong{font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-wst__source small{font-size:12px;line-height:16px;color:var(--ui-wst-muted)}.ui-wst__empty{font-size:12px;color:var(--ui-wst-muted);padding:12px 0;margin:0}.ui-wst__tool-pane{display:flex;flex-direction:column}.ui-wst__tool-pane[data-tool="notes"] textarea{width:100%;flex:1;min-height:0;border:0;background:none;resize:none;outline:none;font:13px/1.7 "Inter",ui-sans-serif,system-ui,sans-serif;color:var(--ui-wst-ink)}.ui-wst__terminal-output{flex:1;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.8 ui-monospace,"SF Mono",Menlo,monospace}.ui-wst__command{display:flex;align-items:center;gap:8px;font:12px/1.8 ui-monospace,"SF Mono",Menlo,monospace;padding-top:8px}.ui-wst__command input{width:0;flex:1;border:0;outline:none;background:none;color:inherit;font:inherit}.ui-wst__browser-home{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ui-wst-faint);gap:12px}.ui-wst__browser-home h2{font-size:18px;margin:0}.ui-wst__browser-home p{font-size:12px;margin:0}.ui-wst__search>button{display:grid;place-items:center;width:28px;height:28px;border-radius:5px}
@media(pointer:coarse){.ui-wst__search{min-height:40px}.ui-wst input,.ui-wst textarea{font-size:16px}.ui-wst__tool,.ui-wst__source{min-height:48px}.ui-wst__tool>kbd{display:none}}
@media(prefers-reduced-motion:reduce){.ui-wst,.ui-wst *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-wst{--ui-wst-card:#1c1c1e;--ui-wst-ink:rgba(255,255,255,.9);--ui-wst-muted:rgba(255,255,255,.46);--ui-wst-faint:rgba(255,255,255,.3);--ui-wst-line:rgba(255,255,255,.08);--ui-wst-fill:rgba(255,255,255,.06);--ui-wst-focus:#4d8dff}
