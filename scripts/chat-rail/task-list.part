export type TaskListTab = "active" | "done";
export type TaskListLabels = { tasks?: string; active?: string; done?: string; newTask?: string; needsYou?: string; emptyActive?: string; emptyDone?: string; emptyProject?: string };
export type TaskListProps = {
  tasks?: AgentTask[];
  projects?: string[];
  tab?: TaskListTab;
  defaultTab?: TaskListTab;
  onTabChange?: (tab: TaskListTab) => void;
  selected?: string | null;
  defaultSelected?: string | null;
  onSelectedChange?: (id: string | null) => void;
  onSelect?: (id: string, options: { keyboard: boolean }) => void;
  collapsedProjects?: string[];
  defaultCollapsedProjects?: string[];
  onCollapsedProjectsChange?: (projects: string[]) => void;
  onOpenInbox?: (taskId: string, itemId?: string) => void;
  onNewTask?: () => void;
  createOpen?: boolean;
  createForm?: ReactNode;
  freshIds?: string[];
  labels?: TaskListLabels;
  now?: number;
  className?: string;
};

/** A project tree with roving focus, Active/Done lists and a fixed set of quiet metadata columns. */
export function TaskList({tasks: rawTasks = [], projects: projectOrder, tab: tabProp, defaultTab = "active", onTabChange, selected: selectedProp, defaultSelected = null, onSelectedChange, onSelect, collapsedProjects: collapsedProp, defaultCollapsedProjects = [], onCollapsedProjectsChange, onOpenInbox, onNewTask, createOpen = false, createForm, freshIds = [], labels = {}, now: nowProp, className}: TaskListProps) {
  const tasks=(Array.isArray(rawTasks)?rawTasks:[]).filter(Boolean);
  const [tabState,setTab]=useControllable(tabProp,defaultTab,onTabChange), [selected,setSelected]=useControllable(selectedProp,defaultSelected,onSelectedChange), [collapsed,setCollapsed]=useControllable(collapsedProp,defaultCollapsedProjects,onCollapsedProjectsChange);
  const tab=tabState==="done"?"done":"active";
  const [focusKey,setFocusKey]=useState(""), [keyboard,setKeyboard]=useState(false), [clock,setClock]=useState(()=>Date.now());
  const root=useRef<HTMLElement>(null), id=useId();
  const projects=[...new Set([...(projectOrder??[]),...tasks.map(task=>task.project || "Workspace")])];
  const visible=tasks.filter(task=>!!task.done===(tab==="done"));
  const groups=projects.map(project=>({project,rows:visible.filter(task=>(task.project||"Workspace")===project)})).filter(group=>group.rows.length || projectOrder?.includes(group.project));
  const entries=groups.flatMap(group=>[{key:`group:${group.project}`,project:group.project},...collapsed.includes(group.project)?[]:group.rows.map(task=>({key:`task:${task.id}`,project:group.project}))]);
  const activeFocus=entries.some(entry=>entry.key===focusKey)?focusKey:entries.find(entry=>entry.key===`task:${selected}`)?.key??entries[0]?.key??"";
  const now=nowProp??clock;
  useEffect(()=>{if(nowProp!==undefined)return;const interval=setInterval(()=>setClock(Date.now()),60000);return()=>clearInterval(interval);},[nowProp]);
  useEffect(()=>{const unfolding=tasks.filter(task=>freshIds.includes(task.id)).map(task=>task.project);if(collapsed.some(project=>unfolding.includes(project)))setCollapsed(collapsed.filter(project=>!unfolding.includes(project)));},[freshIds,rawTasks]);
  const focus=(key:string)=>{setKeyboard(true);setFocusKey(key);const el=[...(root.current?.querySelectorAll<HTMLButtonElement>("[data-task-key]")??[])].find(el=>el.dataset.taskKey===key);el?.focus({preventScroll:true});el?.scrollIntoView({block:"nearest"});};
  const toggle=(project:string,open?:boolean)=>{const isOpen=!collapsed.includes(project),next=open??!isOpen;if(isOpen===next)return;setCollapsed(next?collapsed.filter(name=>name!==project):[...collapsed,project]);};
  const moveRow=(direction:number)=>{const rows=entries.filter(entry=>entry.key.startsWith("task:"));if(!rows.length)return;const current=rows.findIndex(entry=>entry.key===(document.activeElement as HTMLElement)?.dataset.taskKey);const next=current<0?(direction>0?0:rows.length-1):clamp(current+direction,0,rows.length-1);focus(rows[next].key);};
  const shortcuts=useRef({moveRow,onNewTask});shortcuts.current={moveRow,onNewTask};
  useEffect(()=>{const key=(event:globalThis.KeyboardEvent)=>{if(event.defaultPrevented||event.metaKey||event.ctrlKey||event.altKey||isEditing(event.target)||(event.target as HTMLElement)?.closest('[role="menu"],[role="dialog"]'))return;const area=root.current?.closest("[data-task-shortcuts]")??root.current;if(document.activeElement===document.body){if(document.querySelector("[data-task-list]")!==root.current)return;}else if(!area?.contains(document.activeElement))return;if(root.current?.closest("[inert]"))return;if(event.key==="Tab"){setKeyboard(true);return;}const key=event.key.toLowerCase();if(key==="j"||key==="k"){event.preventDefault();shortcuts.current.moveRow(key==="j"?1:-1);}if((key==="c"||key==="n")&&shortcuts.current.onNewTask){event.preventDefault();shortcuts.current.onNewTask();}};document.addEventListener("keydown",key);return()=>document.removeEventListener("keydown",key);},[]);
  const treeKey=(event:KeyboardEvent<HTMLDivElement>)=>{if(isEditing(event.target))return;const entry=entries.find(item=>item.key===(event.target as HTMLElement).dataset.taskKey);if(!entry)return;const index=entries.indexOf(entry);const next=event.key==="ArrowDown"?Math.min(entries.length-1,index+1):event.key==="ArrowUp"?Math.max(0,index-1):event.key==="Home"?0:event.key==="End"?entries.length-1:null;if(next!==null){event.preventDefault();focus(entries[next].key);return;}if(event.key==="ArrowLeft"){event.preventDefault();if(entry.key.startsWith("task:"))focus(`group:${entry.project}`);else toggle(entry.project,false);}if(event.key==="ArrowRight"&&entry.key.startsWith("group:")){event.preventDefault();if(collapsed.includes(entry.project))toggle(entry.project,true);else{const child=entries[index+1];if(child?.project===entry.project)focus(child.key);}}};
  const tabKey=(event:KeyboardEvent<HTMLButtonElement>)=>{if(!["ArrowLeft","ArrowRight","Home","End"].includes(event.key))return;event.preventDefault();const next=event.key==="Home"?"active":event.key==="End"?"done":tab==="active"?"done":"active";setTab(next);root.current?.querySelector<HTMLButtonElement>(`[data-list-tab="${next}"]`)?.focus();};
  return <section ref={root} data-task-list="" className={["ui-tls",className].filter(Boolean).join(" ")} data-keyboard={keyboard||undefined}>
    <style href="ui-task-list" precedence="default">{css}</style>
    <header className="ui-tls__head"><h1>{labels.tasks??"Tasks"}<span>{visible.length}</span></h1><div role="tablist" aria-label="Task status" className="ui-tls__tabs">{(["active","done"] as const).map(value=><button type="button" role="tab" data-list-tab={value} aria-selected={tab===value} aria-controls={`${id}-tree`} id={`${id}-${value}`} tabIndex={tab===value?0:-1} key={value} onClick={()=>setTab(value)} onKeyDown={tabKey}>{value==="active"?labels.active??"Active":labels.done??"Done"}</button>)}</div><button type="button" className="ui-tls__new" aria-label={labels.newTask??"New task"} aria-keyshortcuts="C N" aria-expanded={createOpen} aria-controls={`${id}-create`} disabled={!onNewTask} onClick={onNewTask}><Icon name="plus" size={14}/><span>{labels.newTask??"New task"}</span><kbd>C</kbd></button></header>
    <div id={`${id}-create`} className="ui-tls__create" hidden={!createOpen}>{createForm}</div>
    <div className="ui-tls__scroll"><div role="tree" aria-label={tab==="active"?labels.active??"Active tasks":labels.done??"Done tasks"} aria-labelledby={`${id}-${tab}`} id={`${id}-tree`} className="ui-tls__tree" onKeyDown={treeKey} onPointerDown={()=>setKeyboard(false)}>
      {groups.map((group,groupIndex)=>{const expanded=!collapsed.includes(group.project),groupKey=`group:${group.project}`;return <div className="ui-tls__group" role="none" key={group.project}>
        <button type="button" role="treeitem" aria-level={1} aria-expanded={expanded} aria-controls={`${id}-group-${groupIndex}`} aria-owns={expanded?`${id}-group-${groupIndex}`:undefined} aria-setsize={groups.length} aria-posinset={groupIndex+1} aria-label={`${group.project}, ${group.rows.length} ${group.rows.length===1?"task":"tasks"}`} tabIndex={activeFocus===groupKey?0:-1} data-task-key={groupKey} className="ui-tls__group-head" onFocus={()=>setFocusKey(groupKey)} onClick={()=>toggle(group.project)}><span className="ui-tls__chevron"><Icon name="chevron" size={12}/></span><Icon name="folder" size={14}/><strong title={group.project} dir="auto">{group.project}</strong><span>{group.rows.length}</span></button>
        <div className="ui-tls__collapse" data-open={expanded||undefined} inert={!expanded} aria-hidden={!expanded}><div className="ui-tls__clip" role="group" id={`${id}-group-${groupIndex}`}>{group.rows.map((task,index)=>{const needs=agentTaskNeeds(task),done=task.steps?.filter(step=>step.done).length??0,total=task.steps?.length??0,age=agentTaskAge(task.updatedAt,now),status=agentTaskStatus(task,now);const key=`task:${task.id}`;return <button type="button" role="treeitem" aria-level={2} aria-setsize={group.rows.length} aria-posinset={index+1} aria-selected={selected===task.id} aria-label={`${task.title}, ${status}${needs?`, ${labels.needsYou??"Needs you"}${needs>1?` (${needs})`:""}`:""}${total?`, ${done} of ${total} steps`:""}${task.artifacts?.length?`, ${task.artifacts.length} ${task.artifacts.length===1?"artifact":"artifacts"}`:""}, updated ${age.long}`} key={task.id} data-task-key={key} data-done={task.done||undefined} data-fresh={freshIds.includes(task.id)||undefined} tabIndex={activeFocus===key?0:-1} className="ui-tls__row" onFocus={()=>setFocusKey(key)} onClick={event=>{if((event.target as HTMLElement).closest("[data-task-needs]")){onOpenInbox?.(task.id,task.asks?.[0]?.id);return;}setSelected(task.id);onSelect?.(task.id,{keyboard:event.detail===0});}}>
          <TaskProgressRing status={task.status} value={done} max={total} done={task.done} needs={!!needs}/><span className="ui-tls__main"><span className="ui-tls__title" title={task.title} dir="auto">{task.title}</span><span className="ui-tls__status" title={status} dir="auto">{status}</span></span>{needs>0&&<span data-task-needs="" className="ui-tls__needs" aria-hidden="true" title={task.asks?.[0]?.question??`${needs} questions waiting`}>{labels.needsYou??"Needs you"}{needs>1?` ${needs}`:""}</span>}<span aria-hidden="true" className="ui-tls__steps">{total?`${done}/${total}`:""}</span><span aria-hidden="true" className="ui-tls__files">{!!task.artifacts?.length&&<><Icon name="document" size={12}/>{task.artifacts.length}</>}</span><span aria-hidden="true" className="ui-tls__time" title={`Updated ${age.long}`}>{age.short}</span>
        </button>;})}{group.rows.length===0&&<p className="ui-tls__empty-group">{labels.emptyProject??"No tasks"}</p>}</div></div>
      </div>;})}
      {visible.length===0&&groups.length===0&&<div className="ui-tls__empty"><Icon name="tasks" size={28}/><h2>{tab==="done"?labels.emptyDone??"No completed tasks yet":labels.emptyActive??"No active tasks"}</h2><p>{tab==="active"?"Create a task to get started.":"Completed work will appear here."}</p></div>}
    </div></div>
  </section>;
}

/* ---------- Styles ---------- */
.ui-tls{--ui-tls-card:#fff;--ui-tls-ink:rgba(0,0,0,.88);--ui-tls-text:rgba(0,0,0,.61);--ui-tls-muted:rgba(0,0,0,.45);--ui-tls-faint:rgba(0,0,0,.27);--ui-tls-line:rgba(0,0,0,.06);--ui-tls-fill:rgba(0,0,0,.04);--ui-tls-hover:rgba(0,0,0,.02);--ui-tls-focus:#0060e2;--ui-tls-row-height:40px;--ui-tls-ease:cubic-bezier(.22,1,.36,1);height:100%;min-height:0;border-radius:inherit;display:flex;flex-direction:column;overflow:hidden;background:var(--ui-tls-card);color:var(--ui-tls-ink);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-tls / inline-size;-webkit-font-smoothing:antialiased}
.ui-tls,.ui-tls *,.ui-tls *::before,.ui-tls *::after{box-sizing:border-box}.ui-tls button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-tls button:disabled{opacity:.4;cursor:default}.ui-tls button:active:not(:disabled){transform:scale(.97)}.ui-tls button:focus-visible{outline:2px solid var(--ui-tls-focus);outline-offset:-2px}.ui-tls__head{display:flex;align-items:center;gap:12px;flex:none;height:48px;padding:0 12px 0 20px;box-shadow:inset 0 -.5px var(--ui-tls-line)}.ui-tls__head h1{display:flex;align-items:baseline;gap:8px;margin:0;font-size:13px;font-weight:500;white-space:nowrap}.ui-tls__head h1>span{font-weight:400;color:var(--ui-tls-faint);font-variant-numeric:tabular-nums}.ui-tls__tabs{display:flex;gap:2px}.ui-tls__tabs button{height:28px;padding:0 8px;border-radius:6px;color:var(--ui-tls-muted)}.ui-tls__tabs button[aria-selected="true"]{background:var(--ui-tls-fill);color:var(--ui-tls-ink)}.ui-tls__new{display:flex;align-items:center;justify-content:center;gap:6px;margin-left:auto;height:28px;padding:0 8px;border-radius:6px;box-shadow:0 0 0 .5px var(--ui-tls-line),0 1px 2px rgba(0,0,0,.04);font-weight:500!important;white-space:nowrap}.ui-tls__new>svg,.ui-tls__new>kbd{color:var(--ui-tls-faint)}.ui-tls__new>kbd{font:12px/1 inherit;font-family:inherit;font-weight:400}.ui-tls__create{margin:8px 8px 0;flex:none}.ui-tls__create[hidden]{display:none}.ui-tls__scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--ui-tls-line) transparent}.ui-tls__tree{padding:8px 8px 24px}.ui-tls__group+.ui-tls__group{margin-top:12px}.ui-tls__group-head{display:flex;align-items:center;gap:6px;width:100%;height:32px;padding:0 12px 0 8px;border-radius:8px;text-align:left}.ui-tls__group-head:hover{background:var(--ui-tls-hover)}.ui-tls__group-head>strong{min-width:0;font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tls__group-head>span:last-child{color:var(--ui-tls-faint);font-size:12px;font-variant-numeric:tabular-nums}.ui-tls__chevron{display:grid;place-items:center;flex:none;width:16px;color:var(--ui-tls-faint);transition:rotate 200ms var(--ui-tls-ease)}.ui-tls__group-head[aria-expanded="false"] .ui-tls__chevron{rotate:-90deg}.ui-tls__collapse{display:grid;grid-template-rows:0fr;transition:grid-template-rows 240ms var(--ui-tls-ease)}.ui-tls__collapse[data-open]{grid-template-rows:1fr}.ui-tls__clip{min-height:0;overflow:hidden}.ui-tls__row{display:flex;align-items:center;gap:12px;width:100%;height:var(--ui-tls-row-height);padding:0 12px;border-radius:8px;text-align:left;transition:background-color 140ms}.ui-tls__row>.ui-tpr{margin:0 1px}.ui-tls__row:hover{background:var(--ui-tls-hover)}.ui-tls__row[aria-selected="true"]{background:var(--ui-tls-fill)}.ui-tls__main{display:flex;flex:1;align-items:baseline;gap:10px;min-width:0}.ui-tls__title{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tls__status{flex:0 100 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ui-tls-muted)}.ui-tls__row[data-done] .ui-tls__title{color:var(--ui-tls-text)}.ui-tls__needs{flex:none;font-size:11px;font-weight:500;line-height:18px;padding:0 6px;border-radius:4px;white-space:nowrap;background:rgba(255,156,0,.16);color:#cc4e00}.ui-tls__needs:hover{filter:saturate(1.4)}.ui-tls__steps,.ui-tls__files,.ui-tls__time{flex:none;text-align:right;font-size:12px;font-variant-numeric:tabular-nums;color:var(--ui-tls-faint)}.ui-tls__steps,.ui-tls__time{width:28px}.ui-tls__files{display:flex;align-items:center;justify-content:flex-end;gap:4px;width:34px}.ui-tls__time{color:var(--ui-tls-muted)}.ui-tls__row[data-fresh]{overflow:hidden;animation:ui-tls-glide 420ms var(--ui-tls-ease) both}.ui-tls__empty-group{display:flex;align-items:center;height:var(--ui-tls-row-height);padding:0 12px 0 38px;margin:0;color:var(--ui-tls-faint)}.ui-tls__empty{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px;padding:40px 24px;color:var(--ui-tls-muted);text-align:center}.ui-tls__empty h2{font-size:16px;font-weight:500;margin:12px 0 6px;color:var(--ui-tls-ink)}.ui-tls__empty p{margin:0;font-size:13px}.ui-tls:not([data-keyboard]) :is(.ui-tls__row,.ui-tls__group-head):focus{outline:none}
@keyframes ui-tls-glide{from{height:0;opacity:0;transform:translateY(-6px)}to{height:var(--ui-tls-row-height);opacity:1;transform:none}}
@container ui-as (max-width:899.99px){.ui-tls__head{padding-left:46px;padding-right:52px}}
@container ui-tls (max-width:560px){.ui-tls__row{height:52px;gap:10px;padding-inline:10px}.ui-tls__row>.ui-tpr{align-self:flex-start;margin-top:10px}.ui-tls__main{flex-direction:column;align-items:stretch;gap:0}.ui-tls__status{font-size:12px;line-height:16px;flex:none}.ui-tls__steps,.ui-tls__files{display:none}.ui-tls__new kbd{display:none}.ui-tls__head{gap:8px}}
@container ui-tls (max-width:400px){.ui-tls__new{width:28px;padding:0}.ui-tls__new>span{display:none}}
@media(pointer:coarse){.ui-tls__tabs button,.ui-tls__new{min-height:36px}.ui-tls__row{min-height:52px}.ui-tls__group-head{min-height:36px}.ui-tls__new kbd{display:none}}
@media(prefers-reduced-motion:reduce){.ui-tls,.ui-tls *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
:where(.dark,[data-theme="dark"]) .ui-tls{--ui-tls-card:#1c1c1e;--ui-tls-ink:rgba(255,255,255,.9);--ui-tls-text:rgba(255,255,255,.62);--ui-tls-muted:rgba(255,255,255,.46);--ui-tls-faint:rgba(255,255,255,.3);--ui-tls-line:rgba(255,255,255,.08);--ui-tls-fill:rgba(255,255,255,.06);--ui-tls-hover:rgba(255,255,255,.03);--ui-tls-focus:#4d8dff}
:where(.dark,[data-theme="dark"]) .ui-tls__needs{background:rgba(251,106,0,.15);color:#ffa057}
