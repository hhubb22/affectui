export type CampaignChatMessage = { id: string; role: "user" | "assistant"; text: string; worked?: string; steps?: string[]; agents?: boolean };
export type AgentChatScreenProps = Omit<AppShellProps, "children" | "panel" | "panelTitle" | "navigation" | "showChatHistory"> & {
  title?: string; defaultTitle?: string; onTitleChange?: (title: string) => void;
  messages?: CampaignChatMessage[]; defaultMessages?: CampaignChatMessage[]; onMessagesChange?: (messages: CampaignChatMessage[]) => void;
  onSend?: (text: string, options: ChatComposerSendOptions) => void; onStop?: () => void; busy?: boolean; simulate?: boolean;
  composerProps?: Omit<ChatComposerProps, "onSend">; briefProps?: CampaignBriefProps;
  files?: ArtifactFile[]; defaultFiles?: ArtifactFile[]; onFilesChange?: (files: ArtifactFile[]) => void;
  onOpenFile?: (name: string) => void; onOpenUrl?: (url: string) => void;
};
export const defaultCampaignMessages: CampaignChatMessage[] = [
  { id: "angle", role: "user", text: "Desire-driven" },
  { id: "intro", role: "assistant", text: "I'll pull your bestseller first, then line up the creative generation." },
  { id: "bestseller", role: "assistant", worked: "3m 38s", text: "Your bestseller is the Linen Overshirt (the only product synced so far – Shopify is still importing, so treat that ranking as provisional).\n\nBefore I brief and generate the ads, I need one thing I can't infer, because it drives the whole copy structure: how should we sell this shirt?", agents: true },
];
const campaignChats: AppChat[] = [
  { id: "launch", title: "Q3 launch messaging", pinned: true },
  { id: "hooks", title: "Ad hooks for the linen overshirt", project: "Q3 Campaign", unread: true },
  { id: "budget", title: "Q3 budget split by channel", project: "Q3 Campaign" },
  { id: "campaign", title: "Generate on-brand creative" },
  { id: "onboarding", title: "Onboarding email draft" },
  { id: "calendar", title: "August content calendar" },
];
const campaignPhoto = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80"><rect x=".5" y=".5" width="119" height="79" rx="6" fill="#f5f5f5" stroke="#dedede"/><rect x="26" y="14" width="44" height="54" rx="8" fill="#d4d4d4"/><rect x="40" y="14" width="16" height="10" rx="3" fill="#a3a3a3"/></svg>')}`;
export const defaultCampaignFiles: ArtifactFile[] = [
  { kind: "document", name: "brand-guide.md", updated: "Summer launch · 2 days ago", content: "# Brand guide – summer\n\nWarm, unhurried and a little sun-faded. We show the moment first and the product second; the copy talks like a friend who knows fabric.\n\n- Sand, olive, off-white and ink – nothing neon\n- Real people outdoors, late light, no studio white\n- Short lines; one idea per ad" },
  { kind: "table", name: "launch-budget.csv", updated: "Summer launch · 2 days ago", rows: [["Channel", "Weekly", "Weeks", "Total"], ["Instagram", "1200", "4", "$4,800"], ["TikTok", "800", "4", "$3,200"], ["Facebook", "400", "2", "$800"], ["Total", "2400", "", "$8,800"]] },
  { kind: "folder", name: "product-photos", updated: "Summer launch", entries: [
    { name: "overshirt-back.png", kind: "image", size: "398 KB", bytes: 407552, modified: "Nov 4" },
    { name: "overshirt-detail.png", kind: "image", size: "276 KB", bytes: 282624, modified: "Nov 4" },
    { name: "overshirt-front.png", kind: "image", size: "412 KB", bytes: 421888, modified: "Nov 4" },
  ] },
  ...["back", "detail", "front"].map(view => ({ kind: "image" as const, name: `overshirt-${view}.png`, src: campaignPhoto, updated: "Summer launch · 2 days ago" })),
];
const campaignAgents = ["Campaign manager", "Brand research", "Creative pipeline", "Audience research", "Creative direction"];
function CampaignAgentIcon({ index, size = 14 }: { index: number; size?: number }) {
  const paths = [
    "M9 14V6H6a4 4 0 0 0 0 8h3Zm0 0 .965 4.823A1.66 1.66 0 0 1 8.34 21a1.66 1.66 0 0 1-1.62-1.31L5.5 14M9 6h1c1.298 0 2.561-.421 3.6-1.2l2.147-1.61A.95.95 0 0 1 17.21 3.65C17.55 4.79 18 6.73 18 10s-.45 5.21-.79 6.35a.95.95 0 0 1-1.463.46L13.6 15.2A6 6 0 0 0 10 14H9m12-4h1m-1.5-4 1-.594m-1 8.594 1 .648",
    "M17 12a5 5 0 1 1-5-5m2-4.8A10 10 0 1 0 21.8 10m-9.77 1.963 4.553-4.553m3.157-3.065-.553-1.987c-.102-.328-.496-.458-.761-.241-1.436 1.173-3 2.754-1.723 5.248 2.574 1.2 4.044-.419 5.17-1.78a.49.49 0 0 0-.249-.775l-1.884-.465Z",
    "M22 12a10 10 0 1 0-10 10c.842 0 2 .116 2-1 0-.609-.317-1.079-.631-1.546-.46-.682-.917-1.359-.369-2.454.667-1.333 1.778-1.333 3.482-1.333.851 0 1.851 0 3.018-.167 2.101-.3 2.5-1.592 2.5-3.5ZM11 8.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm7 1a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0ZM7 15h.125",
    "M18.5 20.5c-.234-2.932-2.658-5.252-5.692-5.448L12 15l-.812.03c-3.007.142-5.458 2.567-5.688 5.47m9.75-11.25a3.25 3.25 0 1 1-6.5 0 3.25 3.25 0 0 1 6.5 0Zm-9.747-.75A3.25 3.25 0 0 1 9.5 3.752m8.997 4.748a3.25 3.25 0 0 0-3.997-4.748M22 18c-.18-2.263-2.001-4.5-4.001-5M2 18c.18-2.263 2-4.5 4-5",
    "M7 4.5a3 3 0 0 0-2.567 4.554 3 3 0 0 0 0 5.892M7 4.5a2.5 2.5 0 0 1 5 0v15a2.5 2.5 0 0 1-5 0 3 3 0 0 1-2.567-4.554M7 4.5c0 .818.393 1.544 1 2m-3.567 8.446A3 3 0 0 1 6 13.67m11 5.83a3 3 0 0 0 2.567-4.554 3 3 0 0 0 0-5.892M17 19.5a2.5 2.5 0 0 1-5 0v-15a2.5 2.5 0 0 1 5 0 3 3 0 0 1 2.567 4.554M17 19.5c0-.818-.393-1.544-1-2m3.567-8.446A3 3 0 0 1 18 10.33",
  ];
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d={paths[index]}/></svg>;
}
/** AI Chat / Agents: the orchestrator conversation beside the Summer launch brief and editable files. */
export function AgentChatScreen({ title: titleProp, defaultTitle = "Generate on-brand creative", onTitleChange, messages: messagesProp, defaultMessages = defaultCampaignMessages, onMessagesChange, onSend, onStop, busy: busyProp, simulate = onSend === undefined && messagesProp === undefined, composerProps, briefProps = {}, files: filesProp, defaultFiles = defaultCampaignFiles, onFilesChange, onOpenFile, onOpenUrl, workspace = "Acme", user = { name: "Alex Morgan", email: "alex@acme.com" }, chats: chatsProp, defaultChats = campaignChats, onChatsChange, defaultProjects = ["Q3 Campaign", "Brand assets", "Hiring", "Research"], defaultActiveChat = "campaign", defaultActive = "", defaultPanelWidth = 368, panelOpen: panelOpenProp, defaultPanelOpen = true, onPanelOpenChange, sidebarFooter, onNavigate, onChatAction, className, ...shellProps }: AgentChatScreenProps) {
  const [title, setTitle] = useControllable(titleProp, defaultTitle, onTitleChange), [messages, setMessages] = useControllable(messagesProp, defaultMessages, onMessagesChange), [files, setFiles] = useControllable(filesProp, defaultFiles, onFilesChange);
  const [chats, setChats] = useControllable(chatsProp, defaultChats, onChatsChange), pinned = chats.find(chat => chat.id === "campaign")?.pinned ?? false;
  const [angle, setAngle] = useControllable(briefProps.angle, briefProps.defaultAngle ?? "Desire-driven", briefProps.onAngleChange), [channels, setChannels] = useControllable(briefProps.channels, briefProps.defaultChannels ?? { instagram: true, tiktok: true, facebook: false }, briefProps.onChannelsChange), [section, setSection] = useControllable(briefProps.section, briefProps.defaultSection ?? "brief", briefProps.onSectionChange);
  const [panelOpen, setPanelOpen] = useControllable(panelOpenProp, defaultPanelOpen, onPanelOpenChange);
  const [opened, setOpened] = useState(["__brief"]), [activeFile, setActiveFile] = useState("__brief"), [assets, setAssets] = useState<CampaignAsset[]>([]), [generating, setGenerating] = useState(false), [thinking, setThinking] = useState(false), [menu, setMenu] = useState(false), [renaming, setRenaming] = useState(false), [draft, setDraft] = useState(title), [notice, setNotice] = useState("");
  const [toolValues, setToolValues] = useState<Record<string, string>>({}), [terminalLines, setTerminalLines] = useState(["Acme", "Type help to see available commands."]);
  const root = useRef<HTMLDivElement>(null), menuButton = useRef<HTMLButtonElement>(null), renameInput = useRef<HTMLInputElement>(null), scroll = useRef<HTMLDivElement>(null), input = useRef<HTMLTextAreaElement>(null), sequence = useRef(0), replyTimer = useRef<number | undefined>(undefined), generateTimer = useRef<number | undefined>(undefined), id = useId();
  const busy = busyProp ?? thinking, liveMessages = useRef(messages), previousMessages = useRef(messages); liveMessages.current = messages;
  useEffect(() => () => { window.clearTimeout(replyTimer.current); window.clearTimeout(generateTimer.current); }, []);
  useEffect(() => { if (renaming) renameInput.current?.select(); }, [renaming]);
  useEffect(() => { if (previousMessages.current !== messages) { if (scroll.current) scroll.current.scrollTop = scroll.current.scrollHeight; previousMessages.current = messages; } }, [messages]);
  useEffect(() => { if (!notice) return; const timer = window.setTimeout(() => setNotice(""), 2500); return () => window.clearTimeout(timer); }, [notice]);
  const openFile = (name: string) => { setOpened(previous => previous.includes(name) ? previous : [...previous, name]); setActiveFile(name); setPanelOpen(true); onOpenFile?.(name); briefProps.onOpenFile?.(name); };
  const generate = () => {
    if (briefProps.onGenerate) { briefProps.onGenerate(); return; }
    if (generating || briefProps.assets !== undefined || briefProps.generating !== undefined) return;
    setGenerating(true); generateTimer.current = window.setTimeout(() => { setAssets(defaultCampaignAssets); setGenerating(false); setSection("assets"); }, 1600);
  };
  const stop = () => { window.clearTimeout(replyTimer.current); setThinking(false); onStop?.(); input.current?.focus(); };
  const send = (text: string, options: ChatComposerSendOptions) => {
    setMessages([...messages, { id: `user-${++sequence.current}`, role: "user", text }]); onSend?.(text, options);
    if (!simulate) return;
    setThinking(true); replyTimer.current = window.setTimeout(() => {
      setThinking(false); setMessages([...liveMessages.current, { id: `assistant-${++sequence.current}`, role: "assistant", worked: "2s", steps: ["Reading the brief", "Checking 412 orders of the Linen Overshirt", "Lining up the creative pipeline", "Ready"], text: `Good call. I'll go with ${angle.toLowerCase()} – it fits the bestseller and the summer launch.\n\nCopy will lead with the moment, the product follows; every ad ends on the same offer.\n\nHit Generate ads in the brief when you're ready – six ads take about two minutes.` }]);
    }, 2000);
  };
  const rename = () => { if (draft.trim()) { setTitle(draft.trim()); setChats(chats.map(chat => chat.id === "campaign" ? { ...chat, title: draft.trim() } : chat)); } setRenaming(false); requestAnimationFrame(() => menuButton.current?.focus()); };
  const action = (value: string) => {
    setMenu(false); onChatAction?.(value, "campaign");
    if (value === "rename") { setDraft(title); setRenaming(true); }
    else if (value === "pin" || value === "unpin") setChats(chats.map(chat => chat.id === "campaign" ? { ...chat, pinned: !pinned } : chat));
    else if (value === "delete") { stop(); setMessages([]); setChats(chats.filter(chat => chat.id !== "campaign")); }
    else if (value === "share") navigator.clipboard?.writeText(title).then(() => setNotice("Conversation title copied")).catch(() => setNotice("Couldn't copy. Please try again."));
    if (value !== "rename") menuButton.current?.focus();
  };
  const brief = <div className="ui-agc__brief-scroll"><CampaignBrief {...briefProps} angle={angle} onAngleChange={setAngle} channels={channels} onChannelsChange={setChannels} section={section} onSectionChange={setSection} assets={briefProps.assets ?? assets} generating={briefProps.generating ?? generating} onGenerate={generate} onOpenFile={openFile}/></div>;
  const openTab = (name: string) => { setOpened(previous => previous.includes(name) ? previous : [...previous, name]); setActiveFile(name); };
  const workspaceTabs: ArtifactWorkspaceTab[] = [
    { id: "__brief", label: "Summer launch", icon: <Icon name="tasks" size={14}/>, content: brief },
    { id: "__start", label: "New tab", icon: <Icon name="plus" size={14}/>, content: <WorkspaceStart suggested={files.filter(file => file.kind !== "image").map(file => ({ name: file.name, artifact: file.name, kind: file.kind }))} onOpenSource={source => openFile(source.artifact ?? source.name)} onOpenTool={tool => openTab(`__${tool}`)} onOpenUrl={onOpenUrl}/> },
    ...(["terminal", "browser", "notes"] as WorkspaceToolKind[]).map(kind => ({ id: `__${kind}`, label: kind[0].toUpperCase() + kind.slice(1), icon: <Icon name={kind === "terminal" ? "terminal" : kind === "browser" ? "globe" : "compose"} size={14}/>, content: <WorkspaceTool kind={kind} value={toolValues[kind] ?? ""} onValueChange={value => setToolValues(previous => ({ ...previous, [kind]: value }))} lines={terminalLines} onLinesChange={setTerminalLines} onOpenUrl={onOpenUrl}/> })),
  ];
  const panel = <ArtifactWorkspace files={files} onFilesChange={setFiles} openFiles={opened} onOpenFilesChange={setOpened} activeFile={activeFile} onActiveFileChange={setActiveFile} tabs={workspaceTabs} onNewTab={() => openTab("__start")} onClose={() => setPanelOpen(false)} closeLabel="Close brief" onOpenFile={onOpenFile}/>;
  return <AppShell {...shellProps} workspace={workspace} user={user} chats={chats} onChatsChange={next => { setChats(next); const current = next.find(chat => chat.id === "campaign"); if (current && current.title !== chats.find(chat => chat.id === "campaign")?.title) setTitle(current.title); }} defaultProjects={defaultProjects} defaultActiveChat={defaultActiveChat} defaultActive={defaultActive} navigation={defaultWorkspaceNavigation} showChatHistory defaultPanelWidth={defaultPanelWidth} panelTitle="Brief" panel={panel} panelOpen={panelOpen} onPanelOpenChange={setPanelOpen} onNavigate={onNavigate} onChatAction={onChatAction} sidebarFooter={sidebarFooter === undefined ? <WorkspaceSidebarFooter workspace={workspace} onNavigate={onNavigate}/> : sidebarFooter} className={["ui-agc", className].filter(Boolean).join(" ")}>
    <style href="ui-agent-chat" precedence="default">{css}</style>
    <div className="ui-agc__main" ref={root} onKeyDown={event => { if (event.key === "Escape" && busy && !isEditing(event.target)) { event.preventDefault(); stop(); } }}>
      <header className="ui-agc__bar"><div className="ui-agc__crumbs"><button type="button" className="ui-agc__home" onClick={() => onNavigate?.("Home")}><WorkspaceNavGlyph name="compose"/>Home</button><i>/</i>{renaming ? <input ref={renameInput} aria-label="Chat name" value={draft} onChange={event => setDraft(event.target.value)} onBlur={rename} onKeyDown={event => { if (event.key === "Enter") rename(); if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); setRenaming(false); requestAnimationFrame(() => menuButton.current?.focus()); } }}/> : <b>{title}</b>}<button ref={menuButton} type="button" className="ui-agc__options" aria-label="Chat options" aria-haspopup="menu" aria-expanded={menu} aria-controls={menu ? `${id}-options` : undefined} onClick={() => setMenu(!menu)}><Icon name="more" size={16}/></button></div></header>
      <div className="ui-agc__thread" ref={scroll} role="log" aria-label="Campaign conversation" aria-live="polite"><div className="ui-agc__column">{messages.map(message => message.role === "user" ? <p className="ui-agc__user" key={message.id}>{message.text}</p> : <div className="ui-agc__answer" key={message.id}>
        {message.worked && (message.steps?.length ? <details className="ui-agc__trace"><summary><span className="ui-agc__mark" aria-hidden="true">{Array.from({ length: 9 }, (_, index) => <i key={index}/>)}</span>Worked for {message.worked}<Icon name="chevron" size={12}/></summary><ol>{message.steps.map(step => <li key={step}><Icon name="check" size={12}/>{step}</li>)}</ol></details> : <div className="ui-agc__worked"><span className="ui-agc__mark" aria-hidden="true">{Array.from({ length: 9 }, (_, index) => <i key={index}/>)}</span>Worked for {message.worked}</div>)}
        {message.text.split("\n\n").map((text, index) => <p key={index}>{text}</p>)}
        {message.agents && <><span className="ui-agc__label">Agents working</span><div className="ui-agc__agents">{campaignAgents.map((agent, index) => <span className="ui-agc__agent" data-active={index === 0 || undefined} key={agent}><CampaignAgentIcon index={index}/><span>{agent}</span></span>)}</div></>}
      </div>)}{busy && <div className="ui-agc__answer" role="status"><div className="ui-agc__worked"><span className="ui-agc__mark" data-thinking="" aria-hidden="true">{Array.from({ length: 9 }, (_, index) => <i key={index}/>)}</span>Thinking</div><span className="ui-agc__label">Reading the brief</span></div>}</div></div>
      <div className="ui-agc__composer"><div className="ui-agc__route"><CampaignAgentIcon index={4} size={12}/><b>Orchestrator</b><span>Routes each request</span>{busy && <button type="button" aria-label="Stop response" onClick={stop}><Icon name="stop" size={12}/>Stop</button>}</div><ChatComposer placeholder="Ask anything or @ to add context" {...composerProps} textareaProps={{ ref: input, ...composerProps?.textareaProps }} busy={busy} onSend={send}/></div>
      {menu && <FloatingMenu anchor={menuButton} root={root} id={`${id}-options`} label="Chat options" className="ui-agc__menu" align="end" onClose={() => setMenu(false)}>{[[pinned ? "unpin" : "pin", pinned ? "Unpin chat" : "Pin chat", "pin"], ["rename", "Rename", "compose"], ["share", "Share", "link"], ["delete", "Delete chat", "trash"]].map(([value, label, icon]) => <button type="button" role="menuitem" data-danger={value === "delete" || undefined} key={value} onClick={() => action(value)}><Icon name={icon as IconName} size={14}/>{label}</button>)}</FloatingMenu>}
      {notice && <output className="ui-agc__notice">{notice}</output>}
    </div>
  </AppShell>;
}

/* ---------- Styles ---------- */
.ui-agc{line-height:1.4286}.ui-agc .ui-as__main{overflow:hidden}.ui-agc .ui-as__main,.ui-agc .ui-as__panel{border-width:1px;box-shadow:none}.ui-agc__main{display:flex;flex-direction:column;height:100%;min-width:0;min-height:0;position:relative}.ui-agc__bar{display:flex;flex:none;align-items:center;justify-content:space-between;gap:12px;height:48px;padding:0 12px 0 20px;color:var(--ui-as-muted);transition:padding 420ms var(--ui-as-ease)}.ui-agc__crumbs{display:flex;align-items:center;gap:8px;min-width:0;font-size:13px}.ui-agc__crumbs i{font-style:normal;color:var(--ui-as-faint)}.ui-agc__crumbs>b{flex:0 1 auto;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:var(--ui-as-ink);font-weight:500}.ui-agc__crumbs>input{min-width:0;width:260px;background:var(--ui-as-card);border:1px solid var(--ui-as-focus);border-radius:5px;font:inherit;padding:3px 6px;outline:0}.ui-agc__home{display:inline-flex;align-items:center;gap:8px;flex:none;padding:0;color:inherit!important}.ui-agc__home:hover{color:var(--ui-as-ink)!important}.ui-agc__options{display:grid;place-items:center;width:24px;height:24px;flex:none;border-radius:6px;color:var(--ui-as-muted)!important}.ui-agc__options:hover{background:var(--ui-as-fill)}
.ui-agc__thread{flex:1;min-height:0;overflow-y:auto;padding:40px 32px 16px;overscroll-behavior:contain}.ui-agc__column{display:flex;flex-direction:column;gap:22px;max-width:680px;margin:0 auto}.ui-agc__user{align-self:flex-end;max-width:80%;overflow-wrap:anywhere;margin:0;padding:8px 14px;border-radius:12px;background:var(--ui-as-fill);font-size:14px;line-height:18.571px;color:var(--ui-as-ink)}.ui-agc__answer{display:flex;flex-direction:column;align-items:flex-start;gap:14px;font-size:14px;line-height:1.6;color:var(--ui-as-ink)}.ui-agc__answer+.ui-agc__answer{margin-top:-8px}.ui-agc__answer p{margin:0;overflow-wrap:anywhere}.ui-agc__worked,.ui-agc__trace summary{display:flex;align-items:center;gap:10px;height:33px;margin:-4px 0;font-size:12px;font-weight:500;list-style:none}.ui-agc__mark{display:grid;grid-template-columns:repeat(3,3px);grid-auto-rows:3px;gap:1.5px;place-content:center;width:15px;height:15px}.ui-agc__mark i{border-radius:.75px;background:rgba(0,96,226,.765)}.ui-agc__mark[data-thinking] i{animation:ui-agc-think 800ms ease-in-out infinite alternate}.ui-agc__mark[data-thinking] i:nth-child(even){animation-delay:240ms}.ui-agc__label{padding-top:4px;font-size:12.5px;color:var(--ui-as-muted)}.ui-agc__agents{display:flex;flex-wrap:wrap;gap:6px;max-width:100%;margin-top:-6px}.ui-agc__agent{display:inline-flex;align-items:center;gap:7px;height:30px;max-width:100%;padding:0 12px 0 10px;border-radius:999px;box-shadow:inset 0 0 0 .5px var(--ui-as-line);font-size:13px;color:var(--ui-as-text)}.ui-agc__agent svg{flex:none;color:var(--ui-as-muted)}.ui-agc__agent>span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-agc__agent[data-active]{background:var(--ui-as-fill);box-shadow:none;color:var(--ui-as-ink)}.ui-agc__agent[data-active] svg{color:var(--ui-as-ink)}
.ui-agc__composer{display:flex;flex-direction:column;gap:8px;width:100%;max-width:744px;margin:0 auto;padding:8px 32px 24px}.ui-agc__route{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:400;color:var(--ui-as-muted)}.ui-agc__route>svg{box-sizing:content-box;flex:none;padding:5px;border-radius:50%;background:var(--ui-as-fill)}.ui-agc__route b{font-weight:500;color:var(--ui-as-ink)}.ui-agc__route>button{display:flex;align-items:center;gap:5px;margin-left:auto;padding:2px 6px;border-radius:5px;background:var(--ui-as-fill)}.ui-agc__composer>.ui-cc{max-width:none}.ui-agc__trace{width:100%}.ui-agc__trace summary{cursor:pointer;width:fit-content}.ui-agc__trace summary::-webkit-details-marker{display:none}.ui-agc__trace[open] summary>svg{rotate:180deg}.ui-agc__trace ol{display:grid;gap:8px;padding:12px 0 0 24px;margin:0;list-style:none;font-size:12px;color:var(--ui-as-muted)}.ui-agc__trace li{display:flex;align-items:center;gap:8px}
.ui-agc__brief-scroll{height:100%;overflow:auto;padding:16px 14px 14px;overscroll-behavior:contain}.ui-agc .ui-aw__bar{height:48px;min-height:48px}.ui-agc:not([data-panel-open]) .ui-agc__bar{padding-right:52px}
.ui-agc__menu{width:210px;max-width:calc(100% - 16px);padding:5px;overflow:auto;border-radius:12px;background:var(--ui-as-card);box-shadow:var(--ui-as-shadow);animation:ui-agc-pop 230ms var(--ui-as-ease)}.ui-agc__menu>button{display:flex;align-items:center;gap:9px;width:100%;min-height:32px;padding:6px 9px;border-radius:6px;text-align:left;font-size:12px}.ui-agc__menu>button:hover{background:var(--ui-as-fill)}.ui-agc__menu [data-danger]{color:#e5484d}.ui-agc__notice{position:absolute;bottom:170px;left:50%;translate:-50% 0;padding:6px 12px;border-radius:999px;background:var(--ui-as-ink);color:var(--ui-as-card);font-size:12px;z-index:10}
@keyframes ui-agc-think{from{opacity:.3}to{opacity:1}}@keyframes ui-agc-pop{from{opacity:0;transform:translateY(-4px) scale(.98)}}
@container ui-as (max-width:899.99px){.ui-agc__bar{padding-left:52px;padding-right:52px}}
@container ui-as (max-width:600px){.ui-agc__crumbs>:is(i,.ui-agc__home){display:none}.ui-agc__thread{padding:24px 16px 12px}.ui-agc__composer{padding:6px 8px 8px}.ui-agc__route{padding-left:6px}.ui-agc__route>span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}}
@media(pointer:coarse){.ui-agc__options,.ui-agc__menu>button{min-height:36px}.ui-agc__trace summary{min-height:40px}}
@media(prefers-reduced-motion:reduce){.ui-agc__main *{animation:none!important;transition:none!important}}
