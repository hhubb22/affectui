export type InboxTab = "open" | "done";
export type InboxListLabels = { inbox?: string; open?: string; done?: string; emptyOpen?: string; emptyDone?: string };
export type InboxListProps = { items: InboxItem[]; tab?: InboxTab; defaultTab?: InboxTab; onTabChange?: (tab: InboxTab) => void; selected?: string|null; defaultSelected?: string|null; onSelectedChange?: (id: string|null) => void; onSelect?: (id: string) => void; sendingId?: string; collapsingId?: string; disabled?: boolean; labels?: InboxListLabels; now?: number; className?: string };

/** Inbox rows, a single roving Tab stop, and Open/Done tabs. Arrow and J/K navigation also selects. */
export function InboxList({items:rawItems,tab:tabProp,defaultTab="open",onTabChange,selected:selectedProp,defaultSelected,onSelectedChange,onSelect,sendingId,collapsingId,disabled=false,labels={},now:nowProp,className}:InboxListProps) {
  const items=(Array.isArray(rawItems)?rawItems:[]).filter(Boolean);
  const [tabValue,setTab]=useControllable(tabProp,defaultTab,onTabChange),[selected,setSelected]=useControllable<string|null>(selectedProp,defaultSelected??items.find(item=>!!item.done===(defaultTab==="done"))?.id??null,onSelectedChange),[clock,setClock]=useState(()=>Date.now());
  const tab=tabValue==="done"?"done":"open",list=items.filter(item=>!!item.done===(tab==="done")),now=safeNumber(nowProp,clock),id=useId(),root=useRef<HTMLElement>(null);
  const active=list.some(item=>item.id===selected)?selected:selectedProp===null?null:list[0]?.id??null,focusId=active??list[0]?.id;
  useEffect(()=>{if(nowProp!==undefined)return;const timer=setInterval(()=>setClock(Date.now()),60000);return()=>clearInterval(timer);},[nowProp]);
  useEffect(()=>{if(selectedProp===undefined&&selected!==active)setSelected(active);},[active,selectedProp]);
  const choose=(item:InboxItem,focus=false)=>{if(disabled)return;setSelected(item.id);onSelect?.(item.id);if(focus){const row=[...(root.current?.querySelectorAll<HTMLButtonElement>("[data-inbox-row]")??[])].find(el=>el.dataset.inboxRow===item.id);row?.focus({preventScroll:true});row?.scrollIntoView({block:"nearest"});}};
  const move=(direction:number)=>{const index=list.findIndex(item=>item.id===active),next=clamp((index<0?0:index)+direction,0,list.length-1);if(list[next])choose(list[next],true);};
  const actions=useRef({move,disabled});actions.current={move,disabled};
  useEffect(()=>{const key=(event:globalThis.KeyboardEvent)=>{if(actions.current.disabled||event.defaultPrevented||event.ctrlKey||event.metaKey||event.altKey||isEditing(event.target)||(event.target as HTMLElement)?.closest('[role="menu"],[role="dialog"]'))return;const area=root.current?.closest("[data-inbox-scope]")??root.current;if(document.activeElement===document.body){if(document.querySelector("[data-inbox-list]")!==root.current)return;}else if(!area?.contains(document.activeElement))return;if(root.current?.closest("[inert]"))return;const value=event.key.toLowerCase();if(value==="j"||value==="k"){event.preventDefault();actions.current.move(value==="j"?1:-1);}};document.addEventListener("keydown",key);return()=>document.removeEventListener("keydown",key);},[]);
  const rowKey=(event:KeyboardEvent<HTMLButtonElement>,index:number)=>{const next=event.key==="ArrowDown"?Math.min(list.length-1,index+1):event.key==="ArrowUp"?Math.max(0,index-1):event.key==="Home"?0:event.key==="End"?list.length-1:null;if(next!==null){event.preventDefault();choose(list[next],true);}};
  const tabKey=(event:KeyboardEvent<HTMLButtonElement>)=>{if(!["ArrowLeft","ArrowRight","Home","End"].includes(event.key))return;event.preventDefault();const next=event.key==="Home"?"open":event.key==="End"?"done":tab==="open"?"done":"open";setTab(next);root.current?.querySelector<HTMLButtonElement>(`[data-inbox-tab="${next}"]`)?.focus();};
  return <section ref={root} data-inbox-list="" className={["ui-ibl",className].filter(Boolean).join(" ")} aria-busy={disabled}>
    <style href="ui-inbox-list" precedence="default">{css}</style>
    <header className="ui-ibl__head"><h1>{labels.inbox??"Inbox"}<span>{items.filter(item=>!item.done).length||null}</span></h1><div className="ui-ibl__tabs" role="tablist" aria-label="Inbox status">{(["open","done"] as const).map(value=><button type="button" role="tab" id={`${id}-${value}`} aria-selected={tab===value} aria-controls={`${id}-items`} data-inbox-tab={value} tabIndex={tab===value?0:-1} disabled={disabled} key={value} onClick={()=>setTab(value)} onKeyDown={tabKey}>{value==="open"?labels.open??"Open":labels.done??"Done"}</button>)}</div></header>
    <div className="ui-ibl__rows" role="listbox" aria-label={tab==="open"?"Open inbox items":"Answered inbox items"} id={`${id}-items`} aria-labelledby={`${id}-${tab}`}>{list.map(item=>{const age=inboxAge(item.done?.at??item.at,now),kind=item.done?"done":inboxKind(item.kind),kindLabel=inboxKind(item.kind)==="pick"?"Variant":`${inboxKind(item.kind)[0].toUpperCase()}${inboxKind(item.kind).slice(1)}`;return <div className="ui-ibl__wrap" data-gone={collapsingId===item.id||undefined} aria-hidden={collapsingId===item.id} inert={collapsingId===item.id} key={item.id}><button type="button" role="option" data-inbox-row={item.id} aria-selected={active===item.id} aria-label={`${item.done?"Answered":kindLabel}: ${item.question}. ${item.task}, ${age.long}${item.unread&&!item.done?", unread":""}`} title={item.question} tabIndex={focusId===item.id?0:-1} disabled={disabled} className="ui-ibl__row" data-sending={sendingId===item.id||undefined} onClick={()=>choose(item)} onKeyDown={event=>rowKey(event,list.indexOf(item))}><span className="ui-ibl__glyph" data-kind={kind}><InboxGlyph kind={kind}/></span><span className="ui-ibl__text"><span className="ui-ibl__question" dir="auto">{item.question}</span><span className="ui-ibl__meta"><span title={item.task} dir="auto">{item.task}</span><i>·</i><span>{age.short}</span></span></span><span className="ui-ibl__dot" data-on={item.unread&&!item.done||undefined} aria-hidden="true"/></button></div>;})}{!list.length&&<p className="ui-ibl__empty">{tab==="done"?labels.emptyDone??"No answered items yet":labels.emptyOpen??"Nothing waiting on you"}</p>}</div>
  </section>;
}

/* ---------- Styles ---------- */
.ui-ibl{--ui-ibl-card:#fff;--ui-ibl-ink:rgba(0,0,0,.88);--ui-ibl-muted:rgba(0,0,0,.45);--ui-ibl-faint:rgba(0,0,0,.27);--ui-ibl-line:rgba(0,0,0,.06);--ui-ibl-fill:rgba(0,0,0,.04);--ui-ibl-hover:rgba(0,0,0,.02);--ui-ibl-focus:rgba(0,96,226,.7);--ui-ibl-purple:#a651f0;--ui-ibl-blue:#0190fe;--ui-ibl-green:#5fc88a;--ui-ibl-orange:#f28a2e;display:flex;flex-direction:column;min-width:0;min-height:0;width:100%;height:100%;box-shadow:inset -.5px 0 var(--ui-ibl-line);color:var(--ui-ibl-ink);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-ibl / inline-size;-webkit-font-smoothing:antialiased}
.ui-ibl,.ui-ibl *,.ui-ibl *::before,.ui-ibl *::after{box-sizing:border-box}.ui-ibl button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-ibl button:focus-visible{outline:2px solid var(--ui-ibl-focus);outline-offset:-2px}.ui-ibl button:active:not(:disabled){transform:scale(.97)}.ui-ibl button:disabled{cursor:default}.ui-ibl__head{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;height:48px;padding:0 12px 0 20px;box-shadow:inset 0 -.5px var(--ui-ibl-line)}.ui-ibl h1{display:flex;align-items:baseline;gap:8px;margin:0;font-size:13px;font-weight:500;line-height:20px;min-width:0}.ui-ibl h1>span{font-size:13px;font-weight:400;color:var(--ui-ibl-faint);font-variant-numeric:tabular-nums}.ui-ibl__tabs{display:flex;gap:2px;flex:none}.ui-ibl__tabs button{height:28px;padding:0 8px;border-radius:6px;color:var(--ui-ibl-muted)}.ui-ibl__tabs button[aria-selected="true"]{background:var(--ui-ibl-fill);color:var(--ui-ibl-ink)}.ui-ibl__rows{flex:1;min-height:0;overflow:auto;padding:6px 8px 16px;scrollbar-width:thin;scrollbar-color:var(--ui-ibl-line) transparent;overscroll-behavior:contain}.ui-ibl__wrap{overflow:hidden;display:grid;grid-template-rows:1fr;transition:grid-template-rows 280ms cubic-bezier(.22,1,.36,1),opacity 200ms}.ui-ibl__wrap[data-gone]{grid-template-rows:0fr;opacity:0;pointer-events:none}.ui-ibl__row{display:grid;grid-template-columns:16px minmax(0,1fr) 6px;align-items:start;column-gap:12px;height:56px;min-height:0;width:100%;padding:10px 12px;overflow:hidden;border-radius:8px;text-align:left;transition:background-color 140ms,opacity 200ms}.ui-ibl__row:hover{background:var(--ui-ibl-hover)}.ui-ibl__row[aria-selected="true"]{background:var(--ui-ibl-fill)}.ui-ibl__row[data-sending]{opacity:.55}.ui-ibl__glyph{display:grid;place-items:center;height:20px;color:var(--ui-ibl-faint)}.ui-ibl__glyph[data-kind="decision"]{color:var(--ui-ibl-purple)}.ui-ibl__glyph[data-kind="pick"]{color:var(--ui-ibl-blue)}.ui-ibl__glyph:is([data-kind="approval"],[data-kind="done"]){color:var(--ui-ibl-green)}.ui-ibl__glyph[data-kind="question"]{color:var(--ui-ibl-orange)}.ui-ibl__text{display:flex;flex-direction:column;min-width:0}.ui-ibl__question{font-size:13px;line-height:20px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-ibl__meta{display:flex;gap:6px;font-size:12px;line-height:16px;color:var(--ui-ibl-muted);white-space:nowrap;min-width:0}.ui-ibl__meta>span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis}.ui-ibl__meta>span:last-child{flex:none;font-variant-numeric:tabular-nums}.ui-ibl__meta i{font-style:normal;color:var(--ui-ibl-faint)}.ui-ibl__dot{width:6px;height:6px;margin-top:7px;border-radius:50%;background:#0060e2;opacity:0;transform:scale(.4);transition:opacity 240ms,transform 240ms cubic-bezier(.22,1,.36,1)}.ui-ibl__dot[data-on]{opacity:1;transform:none}.ui-ibl__empty{margin:0;padding:10px 12px;font-size:13px;line-height:20px;color:var(--ui-ibl-muted)}
@container ui-as (max-width:899.99px){.ui-ibl__head{padding-left:46px;padding-right:52px}}
@media(pointer:coarse){.ui-ibl__tabs button{min-height:36px}}
@media(prefers-reduced-motion:reduce){.ui-ibl,.ui-ibl *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
:where(.dark,[data-theme="dark"]) .ui-ibl{--ui-ibl-card:#1c1c1e;--ui-ibl-ink:rgba(255,255,255,.9);--ui-ibl-muted:rgba(255,255,255,.46);--ui-ibl-faint:rgba(255,255,255,.3);--ui-ibl-line:rgba(255,255,255,.08);--ui-ibl-fill:rgba(255,255,255,.06);--ui-ibl-hover:rgba(255,255,255,.03);--ui-ibl-focus:rgba(77,141,255,.8);--ui-ibl-purple:#b98af0;--ui-ibl-blue:#4fb0fe;--ui-ibl-green:#7dcf9f;--ui-ibl-orange:#f2a15c}
