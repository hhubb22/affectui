export type AgentScheduleTone = "purple" | "orange" | "teal" | "blue" | "amber" | "pink" | "green" | "gray" | (string & {});
export type AgentScheduleOutcome = "done" | "needs" | "failed";
export type AgentScheduleHistoryEntry = {
  id?: string;
  at: number;
  outcome: AgentScheduleOutcome;
  summary: string;
  cost?: number;
  action?: ReactNode;
};
export type AgentSchedule = {
  id: string;
  name: string;
  project?: string;
  tone?: AgentScheduleTone;
  prompt?: string;
  cadence: string;
  panelCadence?: string;
  runs: number[];
  nextRunNode?: ReactNode;
  duration?: number;
  paused?: boolean;
  running?: boolean;
  cost?: number;
  facts?: { label: string; value: ReactNode }[];
  history?: AgentScheduleHistoryEntry[];
};
export type AgentSchedulesLabels = {
  schedules?: string;
  listHeading?: string;
  aroundNow?: string;
  now?: string;
  runningNow?: string;
  next?: string;
  nothingNext?: string;
  more?: string;
  less?: string;
  activity?: string;
  perTen?: string;
  perTenOne?: string;
  paused?: string;
  pause?: string;
  resume?: string;
  panelPause?: string;
  panelResume?: string;
  runNow?: string;
  skip?: string;
  skipped?: string;
  restore?: string;
  nextRuns?: string;
  lastRuns?: string;
  perRun?: string;
  what?: string;
  details?: string;
  done?: string;
  needs?: string;
  failed?: string;
  noRuns?: string;
  noSchedule?: string;
  noScheduleText?: string;
  empty?: string;
  emptyText?: string;
};

const defaultAgentScheduleLabels: Required<AgentSchedulesLabels> = {
  schedules: "Schedules",
  listHeading: "Schedules",
  aroundNow: "Around now",
  now: "Now",
  runningNow: "Running now",
  next: "Next",
  nothingNext: "Nothing else in the next 8 hours",
  more: "Show all",
  less: "Show less",
  activity: "Agent activity",
  perTen: "actions / 10 min",
  perTenOne: "action / 10 min",
  paused: "Paused",
  pause: "Pause",
  resume: "Resume",
  panelPause: "Pause",
  panelResume: "Resume",
  runNow: "Run now",
  skip: "Skip",
  skipped: "Skipped",
  restore: "Restore",
  nextRuns: "Next runs",
  lastRuns: "Last runs",
  perRun: "per run",
  what: "What it does",
  details: "Details",
  done: "Done",
  needs: "Needs you",
  failed: "Failed",
  noRuns: "No runs yet",
  noSchedule: "Nothing open",
  noScheduleText: "Pick a schedule to see its next runs and how the last ones went.",
  empty: "No schedules yet",
  emptyText: "Ask your agent in the Thread to do something every day, week or month – it shows up here.",
};

const SCHEDULE_MIN = 60000;
const SCHEDULE_HOUR = 60 * SCHEDULE_MIN;
const SCHEDULE_DAY = 24 * SCHEDULE_HOUR;
const scheduleTones: Record<string, string> = {
  purple: "var(--ui-ags-c-purple)",
  orange: "var(--ui-ags-c-orange)",
  teal: "var(--ui-ags-c-teal)",
  blue: "var(--ui-ags-c-blue)",
  amber: "var(--ui-ags-c-amber)",
  pink: "var(--ui-ags-c-pink)",
  green: "var(--ui-ags-c-green)",
  gray: "var(--ui-ags-c-gray)",
};
const scheduleTone = (tone?: string) => (tone ? scheduleTones[tone] ?? tone : scheduleTones.gray ?? "rgba(0,0,0,.3)");
const scheduleClock = new Intl.DateTimeFormat("en", { hour: "2-digit", minute: "2-digit", hour12: false });
const scheduleWeekday = new Intl.DateTimeFormat("en", { weekday: "short" });
const scheduleMonthDay = new Intl.DateTimeFormat("en", { month: "short", day: "numeric" });
const scheduleCurrency = new Intl.NumberFormat("en", { style: "currency", currency: "EUR" });
const scheduleCurrencyCompact = new Intl.NumberFormat("en", {
  style: "currency",
  currency: "EUR",
  notation: "compact",
  maximumFractionDigits: 1,
});

function scheduleStartOfDay(ms: number) {
  const d = new Date(ms);
  d.setHours(0, 0, 0, 0);
  return d.getTime();
}
function scheduleWhen(at: number, now: number) {
  const diff = Math.round((scheduleStartOfDay(at) - scheduleStartOfDay(now)) / SCHEDULE_DAY);
  const day =
    diff === 0
      ? "Today"
      : diff === 1
        ? "Tomorrow"
        : diff === -1
          ? "Yesterday"
          : Math.abs(diff) < 7
            ? scheduleWeekday.format(at)
            : scheduleMonthDay.format(at);
  return `${day} ${scheduleClock.format(at)}`;
}
function scheduleRelative(at: number, now: number) {
  const minutes = Math.round((at - now) / SCHEDULE_MIN);
  const abs = Math.abs(minutes);
  const unit =
    abs < 1
      ? "now"
      : abs < 60
        ? `${abs} min`
        : abs < 2880
          ? `${Math.round(abs / 60)} h`
          : `${Math.round(abs / 1440)} days`;
  return abs < 1 ? (at > now ? "in a moment" : "just now") : minutes > 0 ? `in ${unit}` : `${unit} ago`;
}
function scheduleSkipKey(id: string, at: number) {
  return `${id}@${at}`;
}
function scheduleNextRun(schedule: AgentSchedule, now: number, skipped: readonly string[]) {
  if (schedule.paused) return undefined;
  return schedule.runs.filter((at) => at > now && !skipped.includes(scheduleSkipKey(schedule.id, at))).sort((a, b) => a - b)[0];
}
function scheduleActivityAt(at: number, schedules: readonly AgentSchedule[]) {
  const slot = at / (10 * SCHEDULE_MIN);
  let rate = 1.3 + 0.45 * Math.sin(slot * 0.7) + 0.25 * Math.sin(slot * 1.9 + 1) + 0.12 * Math.sin(slot * 4.3 + 2);
  for (const s of schedules) {
    for (const runAt of s.runs) {
      const span = Math.max(s.duration ?? 0, 25 * SCHEDULE_MIN);
      if (at >= runAt && at <= runAt + span) {
        rate += (3 + Math.min(6, (s.cost ?? 0.3) * 1.6)) * Math.sin((Math.PI * (at - runAt)) / span);
      }
    }
  }
  return Math.max(0.2, rate);
}
function scheduleSpline(points: readonly (readonly [number, number])[]) {
  return points
    .map(([x, y], index) => {
      if (index === 0) return `M${x.toFixed(1)},${y.toFixed(1)}`;
      const p0 = points[Math.max(0, index - 2)] ?? [x, y];
      const p1 = points[index - 1] ?? [x, y];
      const p2 = points[Math.min(points.length - 1, index + 1)] ?? [x, y];
      const c1x = p1[0] + (x - p0[0]) / 6;
      const c1y = p1[1] + (y - p0[1]) / 6;
      const c2x = x - (p2[0] - p1[0]) / 6;
      const c2y = y - (p2[1] - p1[1]) / 6;
      return `C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join("");
}
function mergeScheduleLabels(labels?: AgentSchedulesLabels): Required<AgentSchedulesLabels> {
  const merged = { ...defaultAgentScheduleLabels, ...labels };
  if (!labels?.listHeading && labels?.schedules) merged.listHeading = labels.schedules;
  if (!labels?.panelPause && labels?.pause) merged.panelPause = labels.pause;
  if (!labels?.panelResume && labels?.resume) merged.panelResume = labels.resume;
  return merged;
}

function ScheduleSkel({ width, height = 10, radius = 4, className }: { width: number | string; height?: number | string; radius?: number; className?: string }) {
  return <span className={["ui-ags__skel", className].filter(Boolean).join(" ")} style={{ width, height, borderRadius: radius }} aria-hidden="true" />;
}

function ScheduleAroundNow({
  schedules,
  now,
  skipped,
  labels,
  onOpen,
}: {
  schedules: readonly AgentSchedule[];
  now: number;
  skipped: readonly string[];
  labels: Required<AgentSchedulesLabels>;
  onOpen: (id: string) => void;
}) {
  const chartRef = useRef<HTMLDivElement>(null);
  const gradientId = useId();
  const headingId = useId();
  const [width, setWidth] = useState(600);

  useLayoutEffect(() => {
    const el = chartRef.current;
    if (!el) return;
    setWidth(Math.max(240, el.clientWidth));
    const observer = new ResizeObserver(([entry]) => {
      if (entry) setWidth(Math.max(240, Math.round(entry.contentRect.width)));
    });
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  const start = now - 4 * SCHEDULE_HOUR;
  const end = now + 8 * SCHEDULE_HOUR;
  const xAt = (ms: number) => ((ms - start) / (end - start)) * width;
  const marks = schedules
    .flatMap((s) =>
      s.runs
        .filter((at) => at >= start && at <= end && !skipped.includes(scheduleSkipKey(s.id, at)) && !(s.paused && at > now))
        .map((at) => {
          const span = s.duration ?? 0;
          const state = at > now ? ("next" as const) : now - at < span ? ("running" as const) : ("ran" as const);
          return {
            s,
            t: at,
            state,
            failed: Boolean(s.history?.some((entry) => Math.abs(entry.at - at) < SCHEDULE_MIN && entry.outcome === "failed")),
            progress: state === "running" && span > 0 ? (now - at) / span : state === "ran" ? 1 : 0,
          };
        }),
    )
    .sort((a, b) => a.t - b.t);

  const running = marks.filter((m) => m.state === "running");
  const upcoming = marks.find((m) => m.state === "next");
  const samples: number[] = [];
  const step = width < 520 ? 20 * SCHEDULE_MIN : 10 * SCHEDULE_MIN;
  for (let ms = Math.ceil(start / step) * step; ms < now; ms += step) samples.push(ms);
  const boost = running.reduce(
    (sum, m) => sum + 5 * Math.min(1, (now - m.t) / 1500) * (1 - Math.max(0, (m.progress - 0.85) / 0.15)),
    0,
  );
  const values = [...samples.map((ms) => scheduleActivityAt(ms, schedules)), scheduleActivityAt(now, schedules) + boost];
  const peak = Math.max(8, ...values) * 1.15;
  const yAt = (v: number) => 114 - (v / peak) * 76;
  const grids = [0.25, 0.5, 0.75].map((ratio) => 114 - ratio * 104);
  const points = [...samples, now].map((ms, index) => [xAt(ms), yAt(values[index] ?? 1)] as const);
  const linePath = scheduleSpline(points);
  const firstPt = points[0] ?? [0, 114];
  const headPt = points[points.length - 1] ?? [width, 114];
  const areaPath = `${linePath}L${headPt[0].toFixed(1)},114L${firstPt[0].toFixed(1)},114Z`;
  const currentRate = Math.round(values[values.length - 1] ?? 1);

  const ticks: number[] = [];
  const hourStep = width < 420 ? 4 : 2;
  const tickBase = new Date(start);
  tickBase.setMinutes(0, 0, 0);
  for (let ms = tickBase.getTime() + SCHEDULE_HOUR; ms < end; ms += SCHEDULE_HOUR) {
    if (new Date(ms).getHours() % hourStep === 0) ticks.push(ms);
  }
  const flipChip = headPt[0] + 190 > width && headPt[0] > width / 2;
  const chipWidth = Math.max(80, Math.min(220, flipChip ? headPt[0] - 14 : width - headPt[0] - 14));
  const firstRunning = running[0];

  return (
    <section className="ui-ags__section" aria-labelledby={headingId}>
      <h2 id={headingId} className="ui-ags__label">
        {labels.aroundNow}
      </h2>
      <div className="ui-ags__card ui-ags__line">
        <div className="ui-ags__line-top">
          <span>{labels.activity}</span>
          <span className="ui-ags__num">
            <b>{currentRate}</b> {currentRate === 1 ? labels.perTenOne : labels.perTen}
          </span>
        </div>
        <div ref={chartRef} className="ui-ags__chart">
          <svg width={width} height={136} viewBox={`0 0 ${width} 136`} aria-hidden="true">
            <defs>
              <linearGradient id={gradientId} x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stopColor="var(--ui-ags-blue)" stopOpacity="0.14" />
                <stop offset="1" stopColor="var(--ui-ags-blue)" stopOpacity="0" />
              </linearGradient>
            </defs>
            {grids.map((y) => (
              <line key={y} className="ui-ags__chart-grid" x1="0" x2={width} y1={y} y2={y} />
            ))}
            <line className="ui-ags__chart-base" x1="0" x2={width} y1={114} y2={114} />
            {marks.map((m) => (
              <g
                key={`${m.s.id}@${m.t}`}
                className="ui-ags__marker"
                data-state={m.state}
                data-failed={m.failed || undefined}
                style={{ "--ui-ags-tone": scheduleTone(m.s.tone) } as CSSProperties}
              >
                <line x1={xAt(m.t)} x2={xAt(m.t)} y1={32} y2={114} />
                {m.state === "next" ? (
                  <circle cx={xAt(m.t)} cy={32} r="3" />
                ) : (
                  <rect x={xAt(m.t) - 2.5} y={29.5} width="5" height="5" rx="1" />
                )}
              </g>
            ))}
            <path className="ui-ags__chart-area" d={areaPath} style={{ fill: `url(#${gradientId})` }} />
            <path className="ui-ags__chart-line" d={linePath} />
            <circle className="ui-ags__chart-glow" cx={headPt[0]} cy={headPt[1]} r="9" />
            <circle className="ui-ags__chart-head" cx={headPt[0]} cy={headPt[1]} r="3.5" />
            {ticks.map((ms) => (
              <text key={ms} className="ui-ags__tick" x={xAt(ms)} y={132} textAnchor="middle">
                {scheduleClock.format(ms)}
              </text>
            ))}
          </svg>
          {marks.map((m) => (
            <button
              key={`b-${m.s.id}@${m.t}`}
              type="button"
              className="ui-ags__mark"
              style={{ left: xAt(m.t), top: 32 }}
              aria-label={`${m.s.name}, ${scheduleClock.format(m.t)}, ${
                m.state === "running"
                  ? `${labels.runningNow}, ${Math.round(m.progress * 100)}%`
                  : m.state === "ran"
                    ? m.failed
                      ? labels.failed
                      : labels.done
                    : scheduleRelative(m.t, now)
              }`}
              title={`${m.s.name} · ${scheduleClock.format(m.t)}`}
              onClick={() => onOpen(m.s.id)}
            />
          ))}
          {firstRunning && (
            <span
              className="ui-ags__chip"
              data-flip={flipChip || undefined}
              style={{ left: headPt[0], top: Math.max(4, headPt[1] - 46), maxWidth: chipWidth }}
              aria-hidden="true"
            >
              <span className="ui-ags__live" />
              <span className="ui-ags__chip-name">{firstRunning.s.name}</span>
              <span className="ui-ags__num ui-ags__faint">{Math.round(firstRunning.progress * 100)}%</span>
            </span>
          )}
        </div>
        <p className="ui-ags__line-say" role="status">
          {firstRunning ? (
            <>
              <span className="ui-ags__live" aria-hidden="true" />
              <b>{labels.runningNow}:</b>
              <span className="ui-ags__line-name">{running.map((m) => m.s.name).join(", ")}</span>
              <span className="ui-ags__num ui-ags__faint">· {Math.round(firstRunning.progress * 100)}%</span>
            </>
          ) : upcoming ? (
            <>
              <b>{labels.next}:</b>
              <span className="ui-ags__line-name">{upcoming.s.name}</span>
              <span className="ui-ags__num ui-ags__faint">
                · {scheduleClock.format(upcoming.t)}, {scheduleRelative(upcoming.t, now)}
              </span>
            </>
          ) : (
            <span className="ui-ags__faint">{labels.nothingNext}</span>
          )}
        </p>
      </div>
    </section>
  );
}

function SchedulePromptExcerpt({ text, labels }: { text: string; labels: Required<AgentSchedulesLabels> }) {
  const [open, setOpen] = useState(false);
  const [clamped, setClamped] = useState(false);
  const ref = useRef<HTMLQuoteElement>(null);

  useEffect(() => {
    const el = ref.current;
    if (el) setClamped(el.scrollHeight > el.clientHeight + 1);
  }, [text]);

  return (
    <div className="ui-ags__prompt-wrap">
      <blockquote ref={ref} className="ui-ags__prompt" data-open={open || undefined} dir="auto">
        {text}
      </blockquote>
      {(clamped || open) && (
        <button type="button" className="ui-ags__link" aria-expanded={open} onClick={() => setOpen((v) => !v)}>
          {open ? labels.less : labels.more}
        </button>
      )}
    </div>
  );
}

export type ScheduleBoardProps = {
  schedules: AgentSchedule[];
  selected?: string | null;
  defaultSelected?: string | null;
  onSelectedChange?: (id: string | null) => void;
  onSelect?: (id: string) => void;
  onPause?: (id: string, paused: boolean) => void;
  skipped?: string[];
  labels?: AgentSchedulesLabels;
  loading?: boolean;
  now?: number;
  headerAction?: ReactNode;
  banner?: ReactNode;
  editor?: ReactNode;
  showTimeline?: boolean;
  shortcuts?: boolean;
  notice?: string;
  className?: string;
};

/** Schedule timeline around now and interactive schedule list with pause switches and J/K navigation. */
export function ScheduleBoard({
  schedules: rawSchedules,
  selected: selectedProp,
  defaultSelected = null,
  onSelectedChange,
  onSelect,
  onPause,
  skipped = [],
  labels: rawLabels,
  loading = false,
  now: nowProp,
  headerAction,
  banner,
  editor,
  showTimeline = true,
  shortcuts = true,
  notice,
  className,
}: ScheduleBoardProps) {
  const schedules = (Array.isArray(rawSchedules) ? rawSchedules : []).filter(Boolean);
  const labels = mergeScheduleLabels(rawLabels);
  const [selected, setSelected] = useControllable<string | null>(
    selectedProp,
    defaultSelected ?? schedules[0]?.id ?? null,
    onSelectedChange,
  );
  const [clock, setClock] = useState(() => Date.now());
  const now = safeNumber(nowProp, clock);
  const rootRef = useRef<HTMLDivElement>(null);
  const listRef = useRef<HTMLUListElement>(null);
  const listHeadingId = useId();

  const hasLiveWindow =
    !loading &&
    nowProp === undefined &&
    schedules.some((s) => !s.paused && s.runs.some((at) => at > now - (s.duration ?? 0) && at < now + 30000));

  useEffect(() => {
    if (loading || nowProp !== undefined) return;
    if (!hasLiveWindow) {
      const id = window.setInterval(() => setClock(Date.now()), 20000);
      return () => window.clearInterval(id);
    }
    let frame = 0;
    let last = 0;
    const tick = (ts: number) => {
      if (ts - last > 50) {
        last = ts;
        setClock(Date.now());
      }
      frame = window.requestAnimationFrame(tick);
    };
    frame = window.requestAnimationFrame(tick);
    return () => window.cancelAnimationFrame(frame);
  }, [hasLiveWindow, loading, nowProp]);

  const sorted = [...schedules].sort(
    (a, b) => (scheduleNextRun(a, now, skipped) ?? Number.POSITIVE_INFINITY) - (scheduleNextRun(b, now, skipped) ?? Number.POSITIVE_INFINITY),
  );
  const activeCount = schedules.filter((s) => !s.paused).length;

  const choose = (id: string) => {
    setSelected(id);
    onSelect?.(id);
  };

  const moveFocus = (delta: 1 | -1) => {
    const buttons = [...(listRef.current?.querySelectorAll<HTMLButtonElement>(".ui-ags__row-main") ?? [])];
    if (!buttons.length) return;
    const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
    const target =
      current < 0
        ? buttons.find((el) => el.dataset.id === selected) ?? buttons[0]
        : buttons[clamp(current + delta, 0, buttons.length - 1)];
    target?.focus();
  };

  const keyHandler = useRef<(event: WindowEventMap["keydown"]) => void>(() => {});
  keyHandler.current = (event: WindowEventMap["keydown"]) => {
    if (!shortcuts || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.isComposing) return;
    const active = document.activeElement;
    if (
      (active && active !== document.body && !rootRef.current?.contains(active)) ||
      isEditing(active) ||
      (active as HTMLElement | null)?.closest('[role="menu"],[role="dialog"],[role="alertdialog"],[role="listbox"]')
    )
      return;
    const k = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    if (k === "j" || k === "k") {
      event.preventDefault();
      moveFocus(k === "j" ? 1 : -1);
    }
  };

  useEffect(() => {
    if (!shortcuts) return;
    const listener = (e: WindowEventMap["keydown"]) => keyHandler.current(e);
    window.addEventListener("keydown", listener);
    return () => window.removeEventListener("keydown", listener);
  }, [shortcuts]);

  return (
    <div ref={rootRef} className={["ui-ags", className].filter(Boolean).join(" ")}>
      <style href="ui-schedule-board" precedence="default">{css}</style>
      <header className="ui-ags__head">
        <div className="ui-ags__head-main">
          <h1 className="ui-ags__title">{labels.schedules}</h1>
          {!loading && schedules.length > 0 && (
            <span className="ui-ags__num ui-ags__faint">
              {activeCount} / {schedules.length}
            </span>
          )}
        </div>
        {headerAction && <div className="ui-ags__head-actions">{headerAction}</div>}
      </header>
      <div className="ui-ags__scroll">
        <div className="ui-ags__page">
          {banner}
          {editor}
          {loading ? (
            <>
              {showTimeline && (
                <section className="ui-ags__section" aria-label={labels.aroundNow}>
                  <h2 className="ui-ags__label">{labels.aroundNow}</h2>
                  <div className="ui-ags__card ui-ags__line" data-skel="">
                    <div className="ui-ags__line-top">
                      <span>{labels.activity}</span>
                      <ScheduleSkel width={88} height={8} />
                    </div>
                    <div className="ui-ags__chart ui-ags__skel-chart">
                      <ScheduleSkel width="100%" height="100%" radius={6} />
                    </div>
                    <ScheduleSkel width={220} height={10} />
                  </div>
                </section>
              )}
              <section className="ui-ags__section" aria-label={labels.listHeading}>
                <h2 className="ui-ags__label">{labels.listHeading}</h2>
                <div className="ui-ags__rows" data-skel="">
                  {[124, 96, 140, 112, 104].map((w, idx) => (
                    <div key={idx} className="ui-ags__row">
                      <div className="ui-ags__row-main">
                        <ScheduleSkel width={8} height={8} radius={2} />
                        <span className="ui-ags__row-text">
                          <ScheduleSkel width={w} height={10} />
                          <ScheduleSkel width={[132, 176, 148, 160, 120][idx] ?? 140} height={10} />
                        </span>
                        <span className="ui-ags__row-next">
                          <ScheduleSkel width={112} height={10} />
                        </span>
                      </div>
                      <ScheduleSkel width={30} height={18} radius={9} />
                    </div>
                  ))}
                </div>
              </section>
            </>
          ) : schedules.length === 0 ? (
            !editor && (
              <div className="ui-ags__card ui-ags__empty">
                <div className="ui-ags__empty-body">
                  <p className="ui-ags__empty-title">{labels.empty}</p>
                  {labels.emptyText && <p className="ui-ags__empty-text">{labels.emptyText}</p>}
                </div>
              </div>
            )
          ) : (
            <>
              {showTimeline && (
                <ScheduleAroundNow
                  schedules={schedules}
                  now={now}
                  skipped={skipped}
                  labels={labels}
                  onOpen={choose}
                />
              )}
              <section className="ui-ags__section" aria-labelledby={listHeadingId}>
                <h2 id={listHeadingId} className="ui-ags__label">
                  {labels.listHeading}
                </h2>
                <ul
                  ref={listRef}
                  className="ui-ags__rows"
                  onKeyDown={(e) => {
                    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                      e.preventDefault();
                      moveFocus(e.key === "ArrowDown" ? 1 : -1);
                    }
                  }}
                >
                  {sorted.map((s) => {
                    const next = scheduleNextRun(s, now, skipped);
                    const latest = s.history?.[0];
                    const outcomeText = latest
                      ? latest.outcome === "done"
                        ? labels.done
                        : latest.outcome === "needs"
                          ? labels.needs
                          : labels.failed
                      : null;
                    const isSelected = s.id === selected;
                    return (
                      <li
                        key={s.id}
                        className="ui-ags__row"
                        data-selected={isSelected || undefined}
                        data-paused={s.paused || undefined}
                        style={{ "--ui-ags-tone": scheduleTone(s.tone) } as CSSProperties}
                      >
                        <button
                          type="button"
                          className="ui-ags__row-main"
                          data-id={s.id}
                          aria-current={isSelected || undefined}
                          aria-label={`${s.name}, ${s.cadence}, ${
                            s.paused ? labels.paused : next ? `next ${scheduleWhen(next, now)}` : ""
                          }${outcomeText ? `, last run ${outcomeText}` : ""}`}
                          onClick={() => choose(s.id)}
                        >
                          <span className="ui-ags__row-mark" aria-hidden="true" />
                          <span className="ui-ags__row-text">
                            <span className="ui-ags__row-name" dir="auto" title={s.name}>
                              {s.name}
                            </span>
                            <span className="ui-ags__row-cadence" dir="auto" title={s.cadence}>
                              {s.cadence}
                            </span>
                            <span className="ui-ags__row-nextline ui-ags__num" aria-hidden="true">
                              {s.paused ? labels.paused : next ? `${scheduleWhen(next, now)} · ${scheduleRelative(next, now)}` : ""}
                            </span>
                          </span>
                          <span className="ui-ags__row-next ui-ags__num">
                            {s.paused ? (
                              <span className="ui-ags__faint">{labels.paused}</span>
                            ) : next ? (
                              <>
                                <span>{scheduleWhen(next, now)}</span>
                                <span className="ui-ags__faint ui-ags__row-rel">{scheduleRelative(next, now)}</span>
                              </>
                            ) : null}
                          </span>
                          <span className="ui-ags__row-last">
                            {latest && outcomeText && (
                              <span className="ui-ags__badge" data-outcome={latest.outcome}>
                                {outcomeText}
                              </span>
                            )}
                          </span>
                          {s.cost != null && (
                            <span className="ui-ags__row-cost ui-ags__num" title={scheduleCurrency.format(s.cost)}>
                              {s.cost >= 1000 ? scheduleCurrencyCompact.format(s.cost) : scheduleCurrency.format(s.cost)}
                            </span>
                          )}
                        </button>
                        {onPause && (
                          <button
                            type="button"
                            role="switch"
                            aria-checked={!s.paused}
                            aria-label={`${s.name}: ${s.paused ? labels.resume : labels.pause}`}
                            className="ui-ags__switch"
                            onClick={() => onPause(s.id, !s.paused)}
                          >
                            <span className="ui-ags__switch-knob" aria-hidden="true" />
                          </button>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </section>
            </>
          )}
        </div>
      </div>
      {notice != null && (
        <p className="ui-ags__sr" role="status" aria-live="polite">
          {notice}
        </p>
      )}
    </div>
  );
}

export type ScheduleInspectorProps = {
  schedule?: AgentSchedule | null;
  onPause?: (paused: boolean) => void;
  onRunNow?: () => void;
  onSkip?: (at: number) => void;
  skipped?: string[];
  labels?: AgentSchedulesLabels;
  loading?: boolean;
  runDisabled?: boolean;
  actionsDisabled?: boolean;
  extraActions?: ReactNode;
  error?: ReactNode;
  now?: number;
  className?: string;
};

/** Right-rail schedule inspector with Run now, Pause/Resume, prompt excerpt, upcoming triggers, and run history. */
export function ScheduleInspector({
  schedule,
  onPause,
  onRunNow,
  onSkip,
  skipped = [],
  labels: rawLabels,
  loading = false,
  runDisabled,
  actionsDisabled = false,
  extraActions,
  error,
  now = Date.now(),
  className,
}: ScheduleInspectorProps) {
  const labels = mergeScheduleLabels(rawLabels);

  if (loading) {
    return (
      <div className={["ui-ags__panel", className].filter(Boolean).join(" ")} data-skel="">
        <style href="ui-schedule-board" precedence="default">{css}</style>
        <div className="ui-ags__panel-head">
          <ScheduleSkel width={8} height={8} radius={2} className="ui-ags__skel-mark" />
          <span className="ui-ags__panel-titles">
            <ScheduleSkel width={136} height={12} />
            <ScheduleSkel width={184} height={8} />
          </span>
        </div>
        <div className="ui-ags__panel-acts">
          <ScheduleSkel width={92} height={28} radius={6} />
          <ScheduleSkel width={72} height={28} radius={6} />
        </div>
        <section className="ui-ags__section">
          <h3 className="ui-ags__label">{labels.what}</h3>
          <ScheduleSkel width="96%" height={10} />
          <ScheduleSkel width="72%" height={10} />
        </section>
      </div>
    );
  }

  if (!schedule) {
    return (
      <div className={["ui-ags__panel", "ui-ags__panel--empty", className].filter(Boolean).join(" ")}>
        <style href="ui-schedule-board" precedence="default">{css}</style>
        <div className="ui-ags__empty-body">
          <p className="ui-ags__empty-title">{labels.noSchedule}</p>
          <p className="ui-ags__empty-text">{labels.noScheduleText}</p>
        </div>
      </div>
    );
  }

  const upcoming = schedule.runs
    .filter((at) => at > now)
    .sort((a, b) => a - b)
    .slice(0, 5);
  const history = (schedule.history ?? []).slice(0, 5);
  const isRunning =
    schedule.running ?? schedule.runs.some((at) => at <= now && now - at < (schedule.duration ?? 0));
  const disableRun = runDisabled !== undefined ? runDisabled : isRunning || actionsDisabled;

  return (
    <div
      className={["ui-ags__panel", className].filter(Boolean).join(" ")}
      style={{ "--ui-ags-tone": scheduleTone(schedule.tone) } as CSSProperties}
      aria-label={schedule.name}
    >
      <style href="ui-schedule-board" precedence="default">{css}</style>
      <div className="ui-ags__panel-head">
        <span className="ui-ags__row-mark" aria-hidden="true" data-paused={schedule.paused || undefined} />
        <span className="ui-ags__panel-titles">
          <h2 className="ui-ags__panel-title" dir="auto">
            {schedule.name}
          </h2>
          <span className="ui-ags__panel-sub" dir="auto">
            <Icon name="repeat" size={12} />
            <span>
              {schedule.panelCadence ?? schedule.cadence}
              {schedule.project ? ` · ${schedule.project}` : ""}
            </span>
          </span>
        </span>
      </div>

      <div className="ui-ags__panel-acts">
        {onRunNow && (
          <button
            type="button"
            className="ui-ags__btn ui-ags__btn--dark"
            disabled={disableRun}
            onClick={onRunNow}
          >
            <Icon name="play" size={14} />
            <span>{isRunning && runDisabled === undefined ? labels.runningNow : labels.runNow}</span>
          </button>
        )}
        {onPause && (
          <button
            type="button"
            className="ui-ags__btn"
            disabled={actionsDisabled}
            onClick={() => onPause(!schedule.paused)}
          >
            <Icon name={schedule.paused ? "play" : "pause"} size={14} />
            <span>{schedule.paused ? labels.panelResume : labels.panelPause}</span>
          </button>
        )}
        {extraActions}
        {schedule.cost != null && (
          <span className="ui-ags__faint ui-ags__num ui-ags__panel-cost">
            {scheduleCurrency.format(schedule.cost)} {labels.perRun}
          </span>
        )}
      </div>

      {error != null && (
        <div className="ui-ags__panel-error" role="alert">
          {error}
        </div>
      )}

      {schedule.facts && schedule.facts.length > 0 && (
        <section className="ui-ags__section" aria-label={labels.details}>
          <h3 className="ui-ags__label">{labels.details}</h3>
          <dl className="ui-ags__card ui-ags__facts">
            {schedule.facts.map((fact) => (
              <div key={fact.label}>
                <dt>{fact.label}</dt>
                <dd dir="auto">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {schedule.prompt && (
        <section className="ui-ags__section" aria-label={labels.what}>
          <h3 className="ui-ags__label">{labels.what}</h3>
          <SchedulePromptExcerpt text={schedule.prompt} labels={labels} />
        </section>
      )}

      <section className="ui-ags__section" aria-label={labels.nextRuns}>
        <h3 className="ui-ags__label">{labels.nextRuns}</h3>
        {schedule.paused ? (
          <p className="ui-ags__note">{labels.paused}</p>
        ) : schedule.nextRunNode ? (
          <div className="ui-ags__card ui-ags__list">
            <div className="ui-ags__list-single">{schedule.nextRunNode}</div>
          </div>
        ) : upcoming.length > 0 ? (
          <ul className="ui-ags__card ui-ags__list">
            {upcoming.map((at) => {
              const isSkipped = skipped.includes(scheduleSkipKey(schedule.id, at));
              return (
                <li key={at} data-skipped={isSkipped || undefined}>
                  <span className="ui-ags__list-when ui-ags__num">{scheduleWhen(at, now)}</span>
                  <span className="ui-ags__faint ui-ags__num">
                    {isSkipped ? labels.skipped : scheduleRelative(at, now)}
                  </span>
                  {onSkip && (
                    <button
                      type="button"
                      className="ui-ags__link"
                      aria-label={`${isSkipped ? labels.restore : labels.skip}: ${scheduleWhen(at, now)}`}
                      onClick={() => onSkip(at)}
                    >
                      {isSkipped ? (
                        <>
                          <Icon name="undo" size={12} />
                          {labels.restore}
                        </>
                      ) : (
                        labels.skip
                      )}
                    </button>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p className="ui-ags__note">{labels.noRuns}</p>
        )}
      </section>

      <section className="ui-ags__section" aria-label={labels.lastRuns}>
        <h3 className="ui-ags__label">{labels.lastRuns}</h3>
        {history.length > 0 ? (
          <ul className="ui-ags__card ui-ags__history">
            {history.map((entry, idx) => (
              <li key={entry.id ?? `${entry.at}-${idx}`}>
                <span className="ui-ags__history-text">
                  <span className="ui-ags__history-summary" dir="auto" title={entry.summary}>
                    {entry.summary}
                  </span>
                  <span className="ui-ags__faint ui-ags__num">
                    {scheduleWhen(entry.at, now)}
                    {entry.cost == null ? "" : ` · ${scheduleCurrency.format(entry.cost)}`}
                  </span>
                </span>
                {entry.action}
                <span className="ui-ags__badge" data-outcome={entry.outcome}>
                  {entry.outcome === "done"
                    ? labels.done
                    : entry.outcome === "needs"
                      ? labels.needs
                      : labels.failed}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p className="ui-ags__note">{labels.noRuns}</p>
        )}
      </section>
    </div>
  );
}

/* ---------- Styles ---------- */
.ui-ags,.ui-ags__panel{
  --ui-ags-card:#fff;
  --ui-ags-panel:#fcfcfc;
  --ui-ags-ink:rgba(0,0,0,.88);
  --ui-ags-text:rgba(0,0,0,.61);
  --ui-ags-muted:rgba(0,0,0,.45);
  --ui-ags-faint:rgba(0,0,0,.27);
  --ui-ags-line:rgba(0,0,0,.06);
  --ui-ags-chip-bg:rgba(0,0,0,.04);
  --ui-ags-hover:rgba(0,0,0,.025);
  --ui-ags-focus:rgba(0,96,226,.7);
  --ui-ags-out:cubic-bezier(.23,1,.32,1);
  --ui-ags-card-shadow:0 0 0 .5px var(--ui-ags-line),0 1px 1px -1px rgba(0,0,0,.1),0 1px 2px 0 rgba(0,0,0,.05);
  --ui-ags-blue:#0190fe;
  --ui-ags-c-purple:#a651f0;
  --ui-ags-c-orange:#f28a2e;
  --ui-ags-c-teal:#13b3a0;
  --ui-ags-c-blue:#0190fe;
  --ui-ags-c-amber:#e8b000;
  --ui-ags-c-pink:#ee3e9e;
  --ui-ags-c-green:#5fc88a;
  --ui-ags-c-gray:rgba(0,0,0,.3);
  font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  color:var(--ui-ags-ink);
  -webkit-font-smoothing:antialiased;
}
.ui-ags,.ui-ags *,.ui-ags *::before,.ui-ags *::after,.ui-ags__panel,.ui-ags__panel *,.ui-ags__panel *::before,.ui-ags__panel *::after{box-sizing:border-box}
:is(.ui-ags,.ui-ags__panel) :where(button){font:inherit;color:inherit;border:0;background:none;cursor:pointer}
:is(.ui-ags,.ui-ags__panel) :focus-visible{outline:2px solid var(--ui-ags-focus);outline-offset:2px}
.ui-ags{position:relative;container:ui-ags / inline-size;display:flex;flex-direction:column;width:100%;height:100%;min-height:0;overflow:hidden;background:var(--ui-ags-panel)}
.ui-ags__num{font-variant-numeric:tabular-nums}
.ui-ags__faint{color:var(--ui-ags-faint)}
.ui-ags__sr{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.ui-ags__head{display:flex;flex:none;align-items:center;justify-content:space-between;gap:12px;height:48px;padding:0 16px 0 20px;box-shadow:inset 0 -.5px 0 var(--ui-ags-line);font-size:13px}
.ui-ags__head-main{display:flex;align-items:center;gap:10px;min-width:0}
.ui-ags__head-actions{display:flex;align-items:center;gap:8px;flex:none}
.ui-ags__title{margin:0;font-size:13px;font-weight:500;line-height:20px;color:var(--ui-ags-ink)}
.ui-ags__scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--ui-ags-line) transparent}
.ui-ags__page{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;max-width:760px;margin:0 auto;padding:24px 24px 48px}
.ui-ags__section{display:grid;grid-template-columns:minmax(0,1fr);gap:8px}
.ui-ags__label{margin:0;font-size:12px;font-weight:500;line-height:16px;color:var(--ui-ags-muted)}
.ui-ags__card{margin:0;padding:0;list-style:none;border-radius:10px;background:var(--ui-ags-card);box-shadow:var(--ui-ags-card-shadow)}
.ui-ags__empty{display:grid;place-items:center;padding:40px 16px}
.ui-ags__empty-body{display:grid;gap:4px;max-width:360px;text-align:center}
.ui-ags__empty-title{margin:0;font-size:14px;font-weight:500;line-height:20px;color:var(--ui-ags-ink)}
.ui-ags__empty-text{margin:0;font-size:13px;line-height:20px;color:var(--ui-ags-muted)}
.ui-ags__line{display:grid;gap:10px;padding:14px 16px}
.ui-ags__line-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-size:12px;color:var(--ui-ags-muted)}
.ui-ags__line-top b{font-weight:500;color:var(--ui-ags-ink)}
.ui-ags__chart{position:relative;contain:inline-size}
.ui-ags__chart svg{display:block;overflow:visible}
.ui-ags__chart-grid{stroke:var(--ui-ags-line);stroke-width:1;opacity:.4}
.ui-ags__chart-base{stroke:var(--ui-ags-line);stroke-width:1}
.ui-ags__chart-line{fill:none;stroke:var(--ui-ags-blue);stroke-width:1.75;stroke-linejoin:round;stroke-linecap:round}
.ui-ags__chart-head{fill:var(--ui-ags-blue);stroke:var(--ui-ags-card);stroke-width:1.5}
.ui-ags__chart-glow{fill:var(--ui-ags-blue);opacity:.18;transform-box:fill-box;transform-origin:center;animation:ui-ags-glow 2200ms ease-in-out infinite}
.ui-ags__tick{font:400 11px "Inter",ui-sans-serif,system-ui,sans-serif;fill:var(--ui-ags-faint)}
.ui-ags__marker line{stroke:var(--ui-ags-tone);stroke-width:1;opacity:.55}
.ui-ags__marker rect{fill:var(--ui-ags-tone)}
.ui-ags__marker[data-failed] line{stroke:#f04438;opacity:.8}
.ui-ags__marker[data-failed] rect{fill:#f04438}
.ui-ags__marker[data-state="next"] line{stroke-dasharray:2 3;opacity:.45}
.ui-ags__marker[data-state="next"] circle{fill:var(--ui-ags-card);stroke:var(--ui-ags-tone);stroke-width:1.5}
.ui-ags__marker[data-state="running"] line{opacity:.9}
.ui-ags__mark{position:absolute;width:20px;height:20px;margin:-10px 0 0 -10px;padding:0;border-radius:6px}
.ui-ags__mark:hover{background:color-mix(in srgb,var(--ui-ags-ink) 6%,transparent)}
.ui-ags__mark:focus-visible{outline-offset:-2px}
.ui-ags__chip{position:absolute;display:inline-flex;align-items:center;gap:6px;max-width:220px;padding:3px 9px 3px 8px;border-radius:7px;background:var(--ui-ags-card);box-shadow:0 0 0 .5px var(--ui-ags-line),0 6px 16px -6px rgba(0,0,0,.2);font-size:12px;line-height:18px;color:var(--ui-ags-ink);white-space:nowrap;transform:translateX(10px);animation:ui-ags-chip 320ms var(--ui-ags-out) both;pointer-events:none}
.ui-ags__chip[data-flip]{transform:translateX(calc(-100% - 10px))}
.ui-ags__chip-name{min-width:0;overflow:hidden;text-overflow:ellipsis;font-weight:500}
.ui-ags__line-say{display:flex;align-items:center;gap:6px;min-width:0;margin:0;font-size:13px;line-height:20px;color:var(--ui-ags-text);white-space:nowrap}
.ui-ags__line-say b{font-weight:500;color:var(--ui-ags-ink)}
.ui-ags__line-name{min-width:0;overflow:hidden;text-overflow:ellipsis}
.ui-ags__live{flex:none;width:7px;height:7px;border-radius:50%;background:var(--ui-ags-blue);animation:ui-ags-blink 1200ms ease-in-out infinite}
.ui-ags__rows{display:grid;grid-template-columns:minmax(0,1fr);gap:2px;margin:0 -10px;padding:0;list-style:none}
.ui-ags__row{display:flex;align-items:center;gap:8px;padding-right:10px;border-radius:10px;transition:background-color 140ms ease}
.ui-ags__row:hover{background:var(--ui-ags-hover)}
.ui-ags__row[data-selected]{background:color-mix(in srgb,var(--ui-ags-ink) 4%,var(--ui-ags-card))}
.ui-ags__row-main{display:flex;flex:1;align-items:center;gap:12px;min-width:0;min-height:42px;padding:0 0 0 12px;border-radius:10px;text-align:left}
.ui-ags__row-main:focus-visible{outline-offset:-2px}
.ui-ags__row-mark{flex:none;width:8px;height:8px;border-radius:2px;background:var(--ui-ags-tone)}
.ui-ags__row[data-paused] .ui-ags__row-mark,.ui-ags__row-mark[data-paused]{background:none;box-shadow:inset 0 0 0 1.5px var(--ui-ags-tone)}
.ui-ags__row-text{display:flex;flex:1;align-items:baseline;gap:10px;min-width:0}
.ui-ags__row-name{flex:0 1 auto;min-width:0;overflow:hidden;font-size:13px;font-weight:500;line-height:20px;color:var(--ui-ags-ink);white-space:nowrap;text-overflow:ellipsis}
.ui-ags__row[data-paused] .ui-ags__row-name{color:var(--ui-ags-text)}
.ui-ags__row-cadence{flex:0 100 auto;min-width:0;overflow:hidden;font-size:13px;line-height:20px;color:var(--ui-ags-muted);white-space:nowrap;text-overflow:ellipsis}
.ui-ags__row-nextline{display:none;font-size:12px;line-height:16px;color:var(--ui-ags-ink)}
.ui-ags__row-next{display:flex;flex:none;align-items:baseline;justify-content:flex-end;gap:6px;width:184px;font-size:13px;line-height:20px;color:var(--ui-ags-ink);white-space:nowrap}
.ui-ags__row-rel{font-size:12px}
.ui-ags__row-last{display:flex;flex:none;justify-content:flex-end;width:78px}
.ui-ags__row-cost{flex:none;width:60px;white-space:nowrap;font-size:12px;color:var(--ui-ags-muted);text-align:right}
.ui-ags__badge{flex:none;padding:0 6px;border-radius:4px;background:var(--ui-ags-chip-bg);font-size:11px;font-weight:500;line-height:18px;color:var(--ui-ags-muted);white-space:nowrap}
.ui-ags__badge[data-outcome="needs"]{background:rgba(255,156,0,.14);color:#b25e00}
.ui-ags__badge[data-outcome="failed"]{background:color-mix(in srgb,#f04438 13%,var(--ui-ags-card));color:#c4320a}
.ui-ags__switch{position:relative;flex:none;width:30px;height:18px;padding:0;border-radius:9px;background:color-mix(in srgb,var(--ui-ags-ink) 16%,var(--ui-ags-card));transition:background-color 200ms ease}
.ui-ags__switch[aria-checked="true"]{background:var(--ui-ags-blue)}
.ui-ags__switch-knob{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.2);transition:transform 240ms var(--ui-ags-out)}
.ui-ags__switch[aria-checked="true"] .ui-ags__switch-knob{transform:translateX(12px)}
.ui-ags__btn{display:inline-flex;flex:none;align-items:center;justify-content:center;gap:6px;height:28px;padding:0 10px 0 8px;border-radius:6px;background:var(--ui-ags-card);box-shadow:var(--ui-ags-card-shadow);font-size:13px;font-weight:500;color:var(--ui-ags-ink);text-decoration:none;white-space:nowrap;transition:box-shadow 140ms ease,filter 140ms ease,opacity 140ms ease,transform 140ms ease}
.ui-ags__btn:hover{box-shadow:0 0 0 .5px rgba(0,0,0,.12),0 2px 4px rgba(0,0,0,.06)}
.ui-ags__btn>svg{flex:none;color:var(--ui-ags-muted)}
.ui-ags__btn--dark{background:var(--ui-ags-ink);box-shadow:none;color:var(--ui-ags-card)}
.ui-ags__btn--dark>svg{color:inherit}
.ui-ags__btn--dark:hover{box-shadow:none;filter:brightness(1.15)}
.ui-ags__btn:disabled{opacity:.5;cursor:default;filter:none}
.ui-ags__btn:active:not(:disabled){transform:scale(.97)}
.ui-ags__panel{display:flex;flex-direction:column;gap:22px;width:100%;min-height:0;padding:16px 18px 24px;overflow-y:auto;overscroll-behavior:contain;container:ui-ags-panel / inline-size}
.ui-ags__panel--empty{display:grid;min-height:240px;place-items:center}
.ui-ags__panel :focus-visible{outline-offset:-2px}
.ui-ags__panel-head{display:flex;align-items:flex-start;gap:10px}
.ui-ags__panel-head .ui-ags__row-mark{margin-top:7px}
.ui-ags__panel-titles{display:grid;gap:2px;min-width:0}
.ui-ags__panel-title{margin:0;font-size:15px;font-weight:500;line-height:22px;color:var(--ui-ags-ink);overflow-wrap:anywhere}
.ui-ags__panel-sub{display:flex;align-items:center;gap:5px;min-width:0;font-size:12px;line-height:16px;color:var(--ui-ags-muted)}
.ui-ags__panel-sub>svg{flex:none}
.ui-ags__panel-sub>span{min-width:0;overflow-wrap:anywhere}
.ui-ags__panel-acts{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:-6px}
.ui-ags__panel-cost{margin-left:auto;font-size:12px}
.ui-ags__panel-error{margin-top:-6px;font-size:13px;line-height:20px;color:#c4320a}
.ui-ags__facts{padding:4px 12px}
.ui-ags__facts>div{display:grid;grid-template-columns:88px minmax(0,1fr);column-gap:10px;align-items:center;min-height:34px;font-size:12px}
.ui-ags__facts>div+div{box-shadow:inset 0 .5px 0 var(--ui-ags-line)}
.ui-ags__facts dt{color:var(--ui-ags-muted)}
.ui-ags__facts dd{margin:0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ui-ags-ink)}
.ui-ags__prompt-wrap{display:grid;justify-items:start;gap:4px}
.ui-ags__prompt-wrap .ui-ags__link{margin-left:2px}
.ui-ags__prompt:not([data-open]){display:-webkit-box;overflow:hidden;-webkit-line-clamp:6;-webkit-box-orient:vertical}
.ui-ags__prompt{margin:0;padding-left:10px;box-shadow:inset 2px 0 0 var(--ui-ags-line);font-size:13px;line-height:20px;color:var(--ui-ags-text);overflow-wrap:anywhere;white-space:pre-line}
.ui-ags__list{padding:2px 12px}
.ui-ags__list li,.ui-ags__list-single{display:flex;align-items:center;gap:10px;min-height:40px;font-size:13px}
.ui-ags__list li+li{box-shadow:inset 0 .5px 0 var(--ui-ags-line)}
.ui-ags__list-when{color:var(--ui-ags-ink)}
.ui-ags__list li[data-skipped] .ui-ags__list-when{color:var(--ui-ags-faint);text-decoration:line-through}
.ui-ags__list li>.ui-ags__faint{flex:1;font-size:12px}
.ui-ags__link{display:inline-flex;flex:none;align-items:center;gap:4px;height:26px;padding:0 8px;border-radius:6px;font-size:12px;color:var(--ui-ags-muted);text-decoration:none;transition:background-color 140ms ease,color 140ms ease}
.ui-ags__link:hover{background:var(--ui-ags-chip-bg);color:var(--ui-ags-ink)}
.ui-ags__history{padding:2px 12px}
.ui-ags__history li{display:flex;align-items:center;gap:10px;padding:8px 0}
.ui-ags__history li+li{box-shadow:inset 0 .5px 0 var(--ui-ags-line)}
.ui-ags__history-text{display:grid;flex:1;min-width:0;font-size:12px;line-height:16px}
.ui-ags__history-summary{overflow:hidden;font-size:13px;line-height:20px;color:var(--ui-ags-ink);white-space:nowrap;text-overflow:ellipsis}
.ui-ags__note{margin:0;font-size:13px;color:var(--ui-ags-faint)}
:is(.ui-ags,.ui-ags__panel) [data-skel]{pointer-events:none}
.ui-ags__skel{display:inline-block;background:var(--ui-ags-chip-bg);animation:ui-ags-blink 1400ms ease-in-out infinite}
.ui-ags__skel-mark{margin-top:7px}
.ui-ags__skel-chart{height:136px;padding:10px 0 22px}
@container ui-as (max-width:899.99px){.ui-ags__head{padding-left:46px;padding-right:52px}}
@container ui-ags (max-width:639.99px){.ui-ags__page{padding:16px 16px 40px;gap:24px}.ui-ags__row-cost,.ui-ags__row-last,.ui-ags__row-rel{display:none}.ui-ags__row-next{width:auto}}
@container ui-ags (max-width:439.99px){.ui-ags__row-main{min-height:56px;padding:8px 0 8px 12px}.ui-ags__row-main>.ui-ags__row-mark{align-self:flex-start;margin-top:6px}.ui-ags__row-text{flex-direction:column;align-items:stretch;gap:0}.ui-ags__row-cadence,.ui-ags__row-nextline{font-size:12px;line-height:16px}.ui-ags__row-next{display:none}.ui-ags__row-nextline{display:block}}
@keyframes ui-ags-glow{0%,100%{transform:scale(.7);opacity:.25}50%{transform:scale(1.25);opacity:.08}}
@keyframes ui-ags-chip{from{opacity:0}}
@keyframes ui-ags-blink{50%{opacity:.35}}
@media(prefers-reduced-motion:reduce){.ui-ags,.ui-ags *,.ui-ags__panel,.ui-ags__panel *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(pointer:coarse){.ui-ags__btn,.ui-ags__link{min-height:36px}.ui-ags__switch{width:40px;height:24px;border-radius:12px}.ui-ags__switch-knob{width:20px;height:20px}.ui-ags__switch[aria-checked="true"] .ui-ags__switch-knob{transform:translateX(16px)}}
:where(.dark,[data-theme="dark"]) :is(.ui-ags,.ui-ags__panel){
  --ui-ags-card:#1c1c1e;
  --ui-ags-panel:#161618;
  --ui-ags-ink:rgba(255,255,255,.9);
  --ui-ags-text:rgba(255,255,255,.62);
  --ui-ags-muted:rgba(255,255,255,.46);
  --ui-ags-faint:rgba(255,255,255,.3);
  --ui-ags-line:rgba(255,255,255,.08);
  --ui-ags-chip-bg:rgba(255,255,255,.06);
  --ui-ags-hover:rgba(255,255,255,.03);
  --ui-ags-focus:rgba(77,141,255,.8);
  --ui-ags-card-shadow:0 0 0 .5px var(--ui-ags-line),0 1px 2px 0 rgba(0,0,0,.3);
  --ui-ags-blue:#4fb0fe;
  --ui-ags-c-purple:#b98af0;
  --ui-ags-c-orange:#f2a15c;
  --ui-ags-c-teal:#4fc3b4;
  --ui-ags-c-blue:#4fb0fe;
  --ui-ags-c-amber:#e6c24d;
  --ui-ags-c-pink:#f06db5;
  --ui-ags-c-green:#7dcf9f;
  --ui-ags-c-gray:rgba(255,255,255,.32);
}
:where(.dark,[data-theme="dark"]) .ui-ags__badge[data-outcome="needs"]{color:#ffb35c}
:where(.dark,[data-theme="dark"]) .ui-ags__badge[data-outcome="failed"]{color:#ff8a7a}
:where(.dark,[data-theme="dark"]) .ui-ags__panel-error{color:#ff8a7a}
