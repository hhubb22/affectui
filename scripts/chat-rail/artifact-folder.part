export type ArtifactFolderEntry = { name: string; size?: string; bytes?: number; modified?: string; kind?: "document" | "table" | "code" | "image" | "folder" };
export type ArtifactFolderSort = { key: "name" | "size" | "modified"; direction: "asc" | "desc" };
export type ArtifactFolderProps = {
  name?: string; entries?: ArtifactFolderEntry[]; defaultEntries?: ArtifactFolderEntry[]; onEntriesChange?: (entries: ArtifactFolderEntry[]) => void;
  selected?: string[]; defaultSelected?: string[]; onSelectedChange?: (names: string[]) => void;
  view?: "list" | "icons"; defaultView?: "list" | "icons"; onViewChange?: (view: "list" | "icons") => void;
  sort?: ArtifactFolderSort; defaultSort?: ArtifactFolderSort; onSortChange?: (sort: ArtifactFolderSort) => void;
  query?: string; defaultQuery?: string; onQueryChange?: (query: string) => void;
  onOpen?: (entry: ArtifactFolderEntry) => void; className?: string;
};

/** A searchable folder with list/icon views, sorting, selection and native keyboard/context-menu actions. */
export function ArtifactFolder({name="Folder",entries:entriesProp,defaultEntries=[],onEntriesChange,selected:selectedProp,defaultSelected=[],onSelectedChange,view:viewProp,defaultView="list",onViewChange,sort:sortProp,defaultSort={key:"name",direction:"asc"},onSortChange,query:queryProp,defaultQuery="",onQueryChange,onOpen,className}:ArtifactFolderProps) {
  const [entries,setEntries]=useControllable(entriesProp,defaultEntries,onEntriesChange),[selected,setSelected]=useControllable(selectedProp,defaultSelected,onSelectedChange),[view,setView]=useControllable(viewProp,defaultView,onViewChange),[sort,setSort]=useControllable(sortProp,defaultSort,onSortChange),[query,setQuery]=useControllable(queryProp,defaultQuery,onQueryChange);
  const [menu,setMenu]=useState<string|null>(null),[renaming,setRenaming]=useState<string|null>(null),[draft,setDraft]=useState(""),[focusName,setFocusName]=useState(""),[notice,setNotice]=useState("");
  const root=useRef<HTMLDivElement>(null),anchor=useRef<HTMLElement>(null),renameInput=useRef<HTMLInputElement>(null),id=useId();
  const list=(Array.isArray(entries)?entries:[]).filter(entry=>entry.name.toLocaleLowerCase().includes(query.toLocaleLowerCase())).slice().sort((a,b)=>{const value=sort.key==="size"?(a.bytes??0)-(b.bytes??0):String(sort.key==="modified"?a.modified??"":a.name).localeCompare(String(sort.key==="modified"?b.modified??"":b.name),undefined,{numeric:true});return value*(sort.direction==="desc"?-1:1);});
  useEffect(()=>{if(renaming)renameInput.current?.select();},[renaming]);
  const open=(entry:ArtifactFolderEntry)=>onOpen?.(entry);
  const restoreFocus=(name:string)=>{setFocusName(name);requestAnimationFrame(()=>{const rows=[...(root.current?.querySelectorAll<HTMLButtonElement>("[data-folder-name]")??[])];rows.find(row=>row.dataset.folderName===name)?.focus({preventScroll:true});});};
  const changeSort=(key:ArtifactFolderSort["key"])=>setSort({key,direction:sort.key===key&&sort.direction==="asc"?"desc":"asc"});
  const context=(el:HTMLElement,names:string[])=>{anchor.current=el;setSelected(names);setMenu(names[0]??null);};
  const rename=()=>{const entry=entries.find(item=>item.name===menu);if(!entry)return;setDraft(entry.name);setRenaming(entry.name);setMenu(null);};
  const commit=()=>{const value=draft.trim();if(renaming&&value&&!entries.some(entry=>entry.name===value&&entry.name!==renaming)){setEntries(entries.map(entry=>entry.name===renaming?{...entry,name:value}:entry));setSelected([value]);setNotice(`Renamed to ${value}`);}setRenaming(null);restoreFocus(value||renaming||"");};
  const remove=()=>{setEntries(entries.filter(entry=>!selected.includes(entry.name)));setNotice(`${selected.length} ${selected.length===1?"item":"items"} removed`);setSelected([]);setMenu(null);};
  const duplicate=()=>{const extra=entries.filter(entry=>selected.includes(entry.name)).map(entry=>{let n=1;let next=`${entry.name} copy`;while(entries.some(item=>item.name===next))next=`${entry.name} copy ${++n}`;return{...entry,name:next};});setEntries([...entries,...extra]);setMenu(null);setNotice("Items duplicated");};
  const key=(event:KeyboardEvent<HTMLButtonElement>,entry:ArtifactFolderEntry)=>{const index=list.indexOf(entry),next=event.key==="ArrowDown"||view==="icons"&&event.key==="ArrowRight"?Math.min(list.length-1,index+1):event.key==="ArrowUp"||view==="icons"&&event.key==="ArrowLeft"?Math.max(0,index-1):event.key==="Home"?0:event.key==="End"?list.length-1:null;if(next!==null){event.preventDefault();setSelected([list[next].name]);root.current?.querySelectorAll<HTMLButtonElement>('[role="option"]')[next]?.focus();}if(event.key==="Enter"){event.preventDefault();open(entry);}if(event.key==="F2"){event.preventDefault();setSelected([entry.name]);setDraft(entry.name);setRenaming(entry.name);}if(event.key==="Delete"){event.preventDefault();setEntries(entries.filter(item=>!selected.includes(item.name)&&item.name!==entry.name));setSelected([]);}if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==="a"){event.preventDefault();setSelected(list.map(item=>item.name));}if(event.key==="ContextMenu"||event.shiftKey&&event.key==="F10"){event.preventDefault();context(event.currentTarget,selected.includes(entry.name)?selected:[entry.name]);}};
  return <div ref={root} className={["ui-afd",className].filter(Boolean).join(" ")}>
    <style href="ui-artifact-folder" precedence="default">{css}</style>
    <div className="ui-afd__toolbar"><button type="button" aria-label="Back" disabled><Icon name="chevron" size={14}/></button><button type="button" aria-label="Forward" disabled><Icon name="chevron" size={14}/></button><strong dir="auto">{name}</strong><button type="button" aria-label="As list" aria-pressed={view!=="icons"} onClick={()=>setView("list")}><Icon name="row" size={14}/></button><button type="button" aria-label="As icons" aria-pressed={view==="icons"} onClick={()=>setView("icons")}><Icon name="column" size={14}/></button><button type="button" aria-label="Sort by" aria-haspopup="menu" aria-expanded={menu==="__sort"} onClick={event=>{anchor.current=event.currentTarget;setMenu(menu==="__sort"?null:"__sort");}}><Icon name="sort" size={14}/></button></div>
    <label className="ui-afd__search"><Icon name="search" size={13}/><input aria-label={`Search ${name}`} placeholder={`Search ${name}`} value={query} onChange={event=>setQuery(event.target.value)}/></label>
    {view!=="icons"&&<div className="ui-afd__columns">{(["name","size","modified"] as const).map(field=><button type="button" key={field} aria-label={`${field[0].toUpperCase()+field.slice(1)}${sort.key===field?`, sorted ${sort.direction==="asc"?"ascending":"descending"}`:""}`} onClick={()=>changeSort(field)}>{field[0].toUpperCase()+field.slice(1)}{sort.key===field&&<span aria-hidden="true">{sort.direction==="asc"?"⌃":"⌄"}</span>}</button>)}</div>}
    <div className="ui-afd__items" data-view={view==="icons"?"icons":"list"} role="listbox" aria-label={`${name} files`} aria-multiselectable="true">{list.map(entry=>renaming===entry.name?<div className="ui-afd__rename" key={entry.name}><Icon name="document" size={14}/><input ref={renameInput} aria-label="File name" value={draft} onChange={event=>setDraft(event.target.value)} onBlur={commit} onKeyDown={event=>{if(event.key==="Enter"){event.preventDefault();commit();}if(event.key==="Escape"){event.preventDefault();setRenaming(null);restoreFocus(renaming??"");}}}/></div>:<button type="button" role="option" aria-selected={selected.includes(entry.name)} tabIndex={entry.name===(list.some(item=>item.name===focusName)?focusName:list[0]?.name)?0:-1} data-folder-name={entry.name} onFocus={()=>setFocusName(entry.name)} className="ui-afd__item" key={entry.name} aria-label={`${entry.name}${entry.size?`, ${entry.size}`:""}`} onClick={event=>setSelected(event.metaKey||event.ctrlKey?selected.includes(entry.name)?selected.filter(name=>name!==entry.name):[...selected,entry.name]:[entry.name])} onDoubleClick={()=>open(entry)} onKeyDown={event=>key(event,entry)} onContextMenu={event=>{event.preventDefault();context(event.currentTarget,selected.includes(entry.name)?selected:[entry.name]);}}><span className="ui-afd__name"><span data-kind={entry.kind??(entry.name.endsWith(".csv")?"table":/\.(json|ya?ml)$/.test(entry.name)?"code":"document")}><Icon name={entry.kind==="folder"?"folder":entry.name.endsWith(".csv")?"table":"document"} size={14}/></span><span title={entry.name} dir="auto">{entry.name}</span></span><span>{entry.size??"—"}</span><span>{entry.modified??"—"}</span></button>)}</div>
    {!list.length&&<p className="ui-afd__empty">{query?"No matching files":"This folder is empty"}</p>}<footer>{list.length} {list.length===1?"item":"items"}{selected.length?` · ${selected.length} selected`:""}</footer>
    {menu&&<FloatingMenu anchor={anchor} root={root} id={`${id}-menu`} label={menu==="__sort"?"Sort files":"File actions"} className="ui-afd__menu" onClose={()=>setMenu(null)}>{menu==="__sort"?(["name","size","modified"] as const).map(field=><button type="button" role="menuitemradio" aria-checked={sort.key===field} key={field} onClick={()=>{changeSort(field);setMenu(null);}}>{field[0].toUpperCase()+field.slice(1)}{sort.key===field&&<Icon name="check" size={13}/>}</button>):<><button type="button" role="menuitem" onClick={()=>{const entry=entries.find(entry=>entry.name===menu);if(entry)open(entry);setMenu(null);}}>Open<Icon name="arrow" size={13}/></button><button type="button" role="menuitem" onClick={rename}>Rename<kbd>F2</kbd></button><button type="button" role="menuitem" onClick={duplicate}>Duplicate</button><button type="button" role="menuitem" data-danger="" onClick={remove}>Delete<Icon name="trash" size={13}/></button></>}</FloatingMenu>}<span role="status" className="ui-afd__sr">{notice}</span>
  </div>;
}

/* ---------- Styles ---------- */
.ui-afd{--ui-afd-card:#fff;--ui-afd-ink:rgba(0,0,0,.88);--ui-afd-text:rgba(0,0,0,.61);--ui-afd-muted:rgba(0,0,0,.45);--ui-afd-faint:rgba(0,0,0,.27);--ui-afd-line:rgba(0,0,0,.06);--ui-afd-fill:rgba(0,0,0,.04);--ui-afd-focus:#0060e2;display:flex;flex:1;flex-direction:column;position:relative;min-height:0;width:100%;padding:0 16px;font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-afd-ink);container:ui-afd / inline-size;-webkit-font-smoothing:antialiased}
.ui-afd,.ui-afd *,.ui-afd *::before,.ui-afd *::after{box-sizing:border-box}.ui-afd button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-afd button:disabled{opacity:.3;cursor:default}.ui-afd button:active:not(:disabled){transform:scale(.97)}.ui-afd button:focus-visible{outline:2px solid var(--ui-afd-focus);outline-offset:-2px}.ui-afd__toolbar{display:flex;align-items:center;gap:4px;min-height:40px;flex:none}.ui-afd__toolbar>button{display:grid;place-items:center;width:28px;height:28px;border-radius:6px;color:var(--ui-afd-muted)}.ui-afd__toolbar>button:first-child{rotate:90deg}.ui-afd__toolbar>button:nth-child(2){rotate:-90deg}.ui-afd__toolbar>button[aria-pressed="true"],.ui-afd__toolbar>button:hover:not(:disabled){background:var(--ui-afd-fill)}.ui-afd__toolbar>strong{font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-left:8px}.ui-afd__search{display:flex;align-items:center;gap:6px;height:28px;border:.5px solid var(--ui-afd-line);border-radius:6px;padding:0 8px;margin:8px 0 6px;color:var(--ui-afd-faint);flex:none}.ui-afd__search input{width:0;flex:1;min-width:0;border:0;outline:0;font:inherit;color:var(--ui-afd-ink);background:none}.ui-afd__search:focus-within{border-color:var(--ui-afd-muted)}.ui-afd__search input::placeholder{color:var(--ui-afd-faint)}.ui-afd__columns,.ui-afd__item{display:grid;grid-template-columns:minmax(0,1fr) 58px 72px;gap:4px;align-items:center}.ui-afd__columns{height:26px;flex:none;border-bottom:.5px solid var(--ui-afd-line)}.ui-afd__columns button{display:flex;gap:3px;font-size:12px;text-align:left;color:var(--ui-afd-muted);padding:0 8px}.ui-afd__columns button:not(:first-child){justify-content:flex-end}.ui-afd__items{overflow:auto;min-height:0;max-height:100%;flex:1}.ui-afd__item{width:100%;height:30px;padding:0 8px;text-align:left;border-bottom:.5px solid var(--ui-afd-line)!important;border-radius:3px}.ui-afd__item:hover,.ui-afd__item[aria-selected="true"]{background:var(--ui-afd-fill)}.ui-afd__name{display:flex;align-items:center;gap:8px;min-width:0}.ui-afd__name>span:first-child{display:flex;color:#2989df;flex:none}.ui-afd__name>[data-kind="table"]{color:#44ad76!important}.ui-afd__name>[data-kind="code"]{color:#ed9540!important}.ui-afd__name>[data-kind="folder"]{color:#e8b000!important}.ui-afd__name>span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-afd__item>span:not(:first-child){font-size:12px;color:var(--ui-afd-muted);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.ui-afd__items[data-view="icons"]{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));align-content:start;gap:8px;padding-block:10px}.ui-afd__items[data-view="icons"] .ui-afd__item{display:flex;flex-direction:column;justify-content:center;height:94px;border:0!important;gap:3px;border-radius:8px}.ui-afd__items[data-view="icons"] .ui-afd__name{flex-direction:column;gap:8px;max-width:100%}.ui-afd__items[data-view="icons"] .ui-afd__name svg{width:28px;height:28px}.ui-afd__items[data-view="icons"] .ui-afd__item>span:not(:first-child){display:none}.ui-afd__rename{display:flex;align-items:center;gap:8px;height:30px;padding:0 8px}.ui-afd__rename input{min-width:0;flex:1;font:inherit;color:inherit;background:var(--ui-afd-card);border:.5px solid var(--ui-afd-muted);border-radius:4px;outline:none}.ui-afd footer{padding:8px 0;font-size:12px;text-align:center;border-top:.5px solid var(--ui-afd-line);color:var(--ui-afd-faint);font-variant-numeric:tabular-nums;flex:none}.ui-afd__empty{text-align:center;font-size:12px;padding:24px;color:var(--ui-afd-muted)}.ui-afd__menu{width:200px;overflow:auto;padding:5px;border-radius:10px;background:var(--ui-afd-card);box-shadow:0 0 0 .5px var(--ui-afd-line),0 6px 20px rgba(0,0,0,.12)}.ui-afd__menu button{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:32px;padding:5px 8px;text-align:left;border-radius:5px;font-size:12px}.ui-afd__menu button:hover{background:var(--ui-afd-fill)}.ui-afd__menu [data-danger]{color:#e5484d}.ui-afd__menu kbd{font:10px ui-monospace,monospace;color:var(--ui-afd-muted)}.ui-afd__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@container ui-afd (max-width:300px){.ui-afd__columns,.ui-afd__item{grid-template-columns:minmax(0,1fr) 58px}.ui-afd__columns>button:last-child,.ui-afd__item>span:last-child{display:none}}
@media(pointer:coarse){.ui-afd__item,.ui-afd__toolbar>button,.ui-afd__menu button{min-height:36px}.ui-afd__search{height:36px}.ui-afd__search input{font-size:16px}}
@media(prefers-reduced-motion:reduce){.ui-afd,.ui-afd *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-afd{--ui-afd-card:#1c1c1e;--ui-afd-ink:rgba(255,255,255,.9);--ui-afd-text:rgba(255,255,255,.62);--ui-afd-muted:rgba(255,255,255,.46);--ui-afd-faint:rgba(255,255,255,.3);--ui-afd-line:rgba(255,255,255,.08);--ui-afd-fill:rgba(255,255,255,.06);--ui-afd-focus:#4d8dff}
