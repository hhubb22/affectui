export type CampaignAngle = "Desire-driven" | "Problem–solution" | "Social proof";
export type CampaignSection = "brief" | "assets" | "activity";
export type CampaignChannels = { instagram: boolean; tiktok: boolean; facebook: boolean };
export type CampaignAsset = { id: string; title: string; format: string; channel: string; color: string; ink?: string };
export type CampaignBriefProps = {
  angle?: CampaignAngle; defaultAngle?: CampaignAngle; onAngleChange?: (angle: CampaignAngle) => void;
  channels?: CampaignChannels; defaultChannels?: CampaignChannels; onChannelsChange?: (channels: CampaignChannels) => void;
  section?: CampaignSection; defaultSection?: CampaignSection; onSectionChange?: (section: CampaignSection) => void;
  assets?: CampaignAsset[]; generating?: boolean; onGenerate?: () => void;
  onOpenFile?: (name: string) => void; className?: string;
};
export const defaultCampaignAssets: CampaignAsset[] = [
  { id: "evening", title: "The first warm evening", format: "Feed", channel: "Instagram", color: "#e3d3b8" },
  { id: "july", title: "Made for July", format: "Story", channel: "TikTok", color: "#7c8458", ink: "#f4f1ea" },
  { id: "linen", title: "Linen, finally", format: "Feed", channel: "Instagram", color: "#f4f1ea" },
  { id: "orders", title: "412 people can't be wrong", format: "Story", channel: "Instagram", color: "#1f2328", ink: "#f4f1ea" },
  { id: "breathe", title: "Breathe out", format: "Banner", channel: "Facebook", color: "#c9b48f" },
  { id: "summer", title: "Summer, unbuttoned", format: "Feed", channel: "TikTok", color: "#a3a77f" },
];
const campaignAngles: { name: CampaignAngle; detail: string; signal: number }[] = [
  { name: "Desire-driven", detail: "The first warm evening", signal: 3 },
  { name: "Problem–solution", detail: "Heat, itchy fabrics", signal: 2 },
  { name: "Social proof", detail: "412 sold, top reviews", signal: 1 },
];
function CampaignShirt({ size = 18 }: { size?: number }) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M6 12v5.684c0 1.811 0 2.717.583 3.28.665.639 3.033 1.015 5.41 1.035 2.316.02 4.641-.297 5.409-1.035.586-.563.586-1.469.586-3.28V12"/><path d="M5.722 14.022c-.865-.314-2.492-.583-3.226-1.319-1.01-1.013-.357-2.383.881-4.964.557-1.162 1.624-2.017 2.867-2.355.168-.046.315-.151.412-.296l1.283-1.999a.5.5 0 0 1 .142-.138C8.659 2.602 10.092 2 11.993 2s3.239.602 3.818.951a.5.5 0 0 1 .141.138l1.32 1.98c.097.145.244.251.412.297 1.243.338 2.261 1.084 2.819 2.246 1.391 2.529 2.008 4.059.998 5.072-.734.736-2.383 1.028-3.249 1.341"/><path d="m6.501 5.5 4.233 3.293c.607.471.91.707 1.267.707s.66-.236 1.267-.707L17.501 5.5M9.501 3l1.5 6M14.501 3l-1.5 6"/></svg>;
}
function CampaignChannelIcon({ name }: { name: keyof CampaignChannels }) {
  return <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="6"/>{name === "instagram" ? <><circle cx="12" cy="12" r="4"/><circle cx="17.25" cy="6.75" r=".25"/></> : name === "tiktok" ? <path d="M10.536 11.008c-.82-.116-2.689.075-3.606 1.77s.007 3.459.584 4.129c.569.627 2.378 1.814 4.297.655.476-.287 1.068-.502 1.741-2.747l-.078-8.834c-.13.973.945 3.255 4.004 3.525"/> : <path d="M16.927 8.026h-2.945a1.9 1.9 0 0 0-1.9 1.886l-.086 11.515M10.082 14.002h4.803"/>}</svg>;
}
/** The campaign brief, generated-ad gallery and activity timeline. Generation is caller-owned. */
export function CampaignBrief({ angle: angleProp, defaultAngle = "Desire-driven", onAngleChange, channels: channelsProp, defaultChannels = { instagram: true, tiktok: true, facebook: false }, onChannelsChange, section: sectionProp, defaultSection = "brief", onSectionChange, assets = [], generating = false, onGenerate, onOpenFile, className }: CampaignBriefProps) {
  const [angle, setAngle] = useControllable(angleProp, defaultAngle, onAngleChange), [channels, setChannels] = useControllable(channelsProp, defaultChannels, onChannelsChange), [section, setSection] = useControllable(sectionProp, defaultSection, onSectionChange);
  const tabs = useRef<HTMLDivElement>(null), radios = useRef<HTMLDivElement>(null), button = useMorph(String(generating)), id = useId();
  const sections: CampaignSection[] = ["brief", "assets", "activity"];
  const selectKey = (event: KeyboardEvent<HTMLButtonElement>, index: number, count: number, select: (index: number) => void) => {
    const next = event.key === "ArrowRight" || event.key === "ArrowDown" ? (index + 1) % count : event.key === "ArrowLeft" || event.key === "ArrowUp" ? (index - 1 + count) % count : event.key === "Home" ? 0 : event.key === "End" ? count - 1 : null;
    if (next !== null) { event.preventDefault(); select(next); }
  };
  const generate = <button ref={button} type="button" className="ui-cbr__generate" disabled={generating} onClick={onGenerate}><span key={String(generating)}>{generating ? "Generating…" : "Generate ads"}</span></button>;
  return <section className={["ui-cbr", className].filter(Boolean).join(" ")} aria-label="Campaign brief">
    <style href="ui-campaign-brief" precedence="default">{css}</style>
    <div ref={tabs} className="ui-cbr__seg" role="tablist" aria-label="Brief sections">{sections.map((value, index) => <button type="button" role="tab" id={`${id}-${value}`} aria-selected={section === value} aria-controls={`${id}-panel`} tabIndex={section === value ? 0 : -1} key={value} onClick={() => setSection(value)} onKeyDown={event => selectKey(event, index, sections.length, next => { setSection(sections[next]); tabs.current?.querySelectorAll<HTMLButtonElement>('[role="tab"]')[next]?.focus(); })}>{value[0].toUpperCase() + value.slice(1)}</button>)}</div>
    <div className="ui-cbr__panel" key={section} role="tabpanel" id={`${id}-panel`} aria-labelledby={`${id}-${section}`}>
      {section === "brief" ? <>
        <div className="ui-cbr__product"><span className="ui-cbr__thumb"><CampaignShirt/></span><span className="ui-cbr__pinfo"><b>Linen Overshirt</b><span>$89 · 412 sold this month</span></span><span className="ui-cbr__chip">Bestseller</span></div>
        <div className="ui-cbr__section"><span className="ui-cbr__label" id={`${id}-angle`}>Selling angle</span><div className="ui-cbr__card" ref={radios} role="radiogroup" aria-labelledby={`${id}-angle`}>{campaignAngles.map((option, index) => <button type="button" role="radio" aria-checked={angle === option.name} tabIndex={angle === option.name ? 0 : -1} className="ui-cbr__option" key={option.name} onClick={() => setAngle(option.name)} onKeyDown={event => selectKey(event, index, campaignAngles.length, next => { setAngle(campaignAngles[next].name); radios.current?.querySelectorAll<HTMLButtonElement>('[role="radio"]')[next]?.focus(); })}><span className="ui-cbr__radio" aria-hidden="true"/><span className="ui-cbr__name"><span>{option.name}</span><small>{option.detail}</small></span><span className="ui-cbr__signal" aria-label={`${option.signal} of 3 signals`}>{[0, 1, 2].map(signal => <i key={signal} data-on={signal < option.signal || undefined}/>)}</span></button>)}</div></div>
        <div className="ui-cbr__section"><span className="ui-cbr__label">Audience</span><div className="ui-cbr__card"><div className="ui-cbr__pills">{["Women 25–34", "Urban", "Warm climates", "Linen & natural fabrics"].map(value => <span key={value}>{value}</span>)}</div></div></div>
        <div className="ui-cbr__section"><span className="ui-cbr__label">Channels</span><div className="ui-cbr__card">{([{ id: "instagram", name: "Instagram", detail: "Feed and Stories" }, { id: "tiktok", name: "TikTok", detail: "Story format only" }, { id: "facebook", name: "Facebook", detail: "Feed and Banner" }] as const).map(channel => <label className="ui-cbr__channel" key={channel.id}><CampaignChannelIcon name={channel.id}/><span className="ui-cbr__name"><span>{channel.name}</span><small>{channel.detail}</small></span><span className="ui-cbr__switch"><input type="checkbox" role="switch" aria-label={channel.name} checked={channels[channel.id]} onChange={event => setChannels({ ...channels, [channel.id]: event.target.checked })}/><span className="ui-cbr__track"><span/></span></span></label>)}</div></div>
        <div className="ui-cbr__card ui-cbr__split"><div><span className="ui-cbr__label">Palette</span><div className="ui-cbr__swatches">{[["Sand", "#e3d3b8"], ["Olive", "#7c8458"], ["Off-white", "#f4f1ea"], ["Ink", "#1f2328"]].map(([name, color]) => <span key={name}><i style={{ background: color }}/>{name}</span>)}</div></div><div><span className="ui-cbr__label">Formats</span><div className="ui-cbr__formats">{[["Feed", "1"], ["Story", "9/16"], ["Banner", "16/9"]].map(([name, ratio]) => <span key={name}><i style={{ aspectRatio: ratio }}/>{name}</span>)}</div></div></div>
        <div className="ui-cbr__section"><span className="ui-cbr__label">Details</span><div className="ui-cbr__card"><dl className="ui-cbr__details">{[["Launch", "Mon, Jun 2", "tasks"], ["Budget", "$2,400 / week", "table"], ["Markets", "US, UK, AU", "globe"]].map(([name, value, icon]) => <div key={name}><dt><Icon name={icon as IconName} size={15}/>{name}</dt><dd>{value}</dd></div>)}</dl></div></div>
        <div className="ui-cbr__section"><span className="ui-cbr__label">Files</span><div className="ui-cbr__files">{["brand-guide.md", "launch-budget.csv", "product-photos"].map(name => <button type="button" key={name} onClick={() => onOpenFile?.(name)}><Icon name={name.endsWith("csv") ? "table" : name === "product-photos" ? "folder" : "document"} size={13}/>{name}</button>)}</div></div>
        <footer className="ui-cbr__go"><div className="ui-cbr__tags"><span>6 ads</span><span>~2 min</span></div>{generate}</footer>
      </> : section === "assets" ? assets.length ? <div className="ui-cbr__section"><span className="ui-cbr__label">{assets.length} ads · {angle}</span><div className="ui-cbr__ads">{assets.map((asset, index) => <figure className="ui-cbr__ad" key={asset.id} style={{ "--ui-cbr-index": index } as CSSProperties}><div className="ui-cbr__art" style={{ background: asset.color, color: asset.ink ?? "#1f2328" }}><CampaignShirt size={22}/><b>{asset.title}</b></div><figcaption><b>{asset.format}</b><span>{asset.channel}</span></figcaption></figure>)}</div></div> : <div className="ui-cbr__empty"><span><Icon name="image" size={22}/></span><b>No assets yet</b><p>Fill in the brief and generate ads – they show up here.</p>{generate}</div> : <ol className="ui-cbr__activity">{[
        [`Angle set to ${angle}`, "2 min ago", "spark"], ["Brand research checked the palette", "3 min ago", "search"], ["Linen Overshirt picked as bestseller", "4 min ago", "check"], ["Shopify import started", "6 min ago", "plug"], ["Brief “Summer launch” created", "7 min ago", "document"],
      ].map(([text, time, icon], index) => <li key={text} style={{ "--ui-cbr-index": index } as CSSProperties}><span className="ui-cbr__activity-icon"><Icon name={icon as IconName} size={13}/></span><span>{text}<small>{time}</small></span></li>)}</ol>}
    </div>
  </section>;
}

/* ---------- Styles ---------- */
.ui-cbr{--ui-cbr-card:#fff;--ui-cbr-ink:rgba(0,0,0,.88);--ui-cbr-text:rgba(0,0,0,.61);--ui-cbr-muted:rgba(0,0,0,.45);--ui-cbr-faint:rgba(0,0,0,.27);--ui-cbr-line:rgba(0,0,0,.12);--ui-cbr-chip:rgba(0,0,0,.04);--ui-cbr-hover:rgba(0,0,0,.025);--ui-cbr-focus:#0060e2;--ui-cbr-ease:cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column;gap:18px;min-height:100%;padding:0 2px;color:var(--ui-cbr-ink);font:13px/18.571px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
.ui-cbr,.ui-cbr *,.ui-cbr *::before,.ui-cbr *::after{box-sizing:border-box}.ui-cbr button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-cbr button:focus-visible,.ui-cbr input:focus-visible+.ui-cbr__track{outline:2px solid var(--ui-cbr-focus);outline-offset:2px}.ui-cbr button:disabled{opacity:.4;cursor:default}.ui-cbr button:active:not(:disabled){transform:scale(.97)}
.ui-cbr__seg{display:flex;flex:none;gap:2px;padding:3px;border-radius:10px;background:var(--ui-cbr-chip)}.ui-cbr__seg button{flex:1;height:26px;border-radius:7px;font-weight:500;color:var(--ui-cbr-muted);transition:background-color 140ms ease,color 140ms ease}.ui-cbr__seg button:hover{color:var(--ui-cbr-ink)}.ui-cbr__seg button[aria-selected="true"]{background:var(--ui-cbr-card);box-shadow:0 0 0 .5px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.05);color:var(--ui-cbr-ink)}
.ui-cbr__panel{display:flex;flex:1 0 auto;flex-direction:column;gap:18px;animation:ui-cbr-rise 380ms var(--ui-cbr-ease) both}.ui-cbr__card,.ui-cbr__product,.ui-cbr__go,.ui-cbr__activity{border-radius:12px;background:var(--ui-cbr-card);box-shadow:inset 0 0 0 .5px var(--ui-cbr-line),0 1px 2px rgba(0,0,0,.025)}.ui-cbr__card{display:flex;flex-direction:column;padding:4px 12px}.ui-cbr__card:has(>.ui-cbr__pills),.ui-cbr__card:has(>.ui-cbr__details){padding:12px}.ui-cbr__product{display:flex;align-items:center;gap:12px;padding:10px 12px}.ui-cbr__thumb{display:grid;flex:none;place-items:center;width:40px;height:40px;border-radius:10px;background:#efe7da;color:#7c6a4f}.ui-cbr__pinfo{display:flex;flex:1;flex-direction:column;min-width:0;font-size:12px;line-height:17px;color:var(--ui-cbr-muted)}.ui-cbr__pinfo b{font-size:13px;font-weight:500;line-height:20px;color:var(--ui-cbr-ink);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-cbr__pinfo>span{overflow-wrap:anywhere}.ui-cbr__chip{flex:none;max-width:40%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:2px 8px;border-radius:999px;background:rgba(22,163,74,.1);font-size:12px;font-weight:500;color:#15803d}
.ui-cbr__section{display:flex;flex-direction:column;gap:8px}.ui-cbr__label{padding:0 4px;font-size:12px;font-weight:500;line-height:16px;color:var(--ui-cbr-muted)}.ui-cbr__option{display:flex;align-items:center;gap:10px;min-height:46px;margin:0 -8px;padding:0 8px;border-radius:10px;color:var(--ui-cbr-muted)!important;text-align:left;transition:background-color 140ms ease,color 140ms ease,box-shadow 140ms ease}.ui-cbr__option:hover{background:var(--ui-cbr-hover)!important;color:var(--ui-cbr-ink)!important}.ui-cbr__option[aria-checked="true"]{background:var(--ui-cbr-chip);color:var(--ui-cbr-ink)!important}.ui-cbr__radio{flex:none;width:14px;height:14px;border-radius:50%;box-shadow:inset 0 0 0 1.5px var(--ui-cbr-line);transition:box-shadow 160ms ease}.ui-cbr__option[aria-checked="true"] .ui-cbr__radio{box-shadow:inset 0 0 0 4px var(--ui-cbr-ink)}.ui-cbr__name{display:flex;flex:1;flex-direction:column;min-width:0;font-size:13px;font-weight:500;line-height:18px}.ui-cbr__name>*{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-cbr__name small{font-size:12.5px;font-weight:400;line-height:17px;color:var(--ui-cbr-faint)}.ui-cbr__signal{display:flex;flex:none;align-items:flex-end;gap:2px;height:11px}.ui-cbr__signal i{width:3px;border-radius:1px;background:#d9d9d9}.ui-cbr__signal i:nth-child(1){height:5px}.ui-cbr__signal i:nth-child(2){height:8px}.ui-cbr__signal i:nth-child(3){height:11px}.ui-cbr__signal i[data-on]{background:#16a34a}
.ui-cbr__pills{display:flex;flex-wrap:wrap;gap:8px}.ui-cbr__pills span{max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:4px 10px;border-radius:999px;box-shadow:inset 0 0 0 .5px var(--ui-cbr-line);font-size:12.5px;color:var(--ui-cbr-text)}.ui-cbr__channel{display:flex;align-items:center;gap:12px;min-height:44px;cursor:pointer}.ui-cbr__channel>svg{flex:none;color:var(--ui-cbr-muted)}.ui-cbr__switch{display:inline-flex;position:relative;flex:none}.ui-cbr__switch input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer;z-index:1}.ui-cbr__track{display:block;width:26px;height:16px;border-radius:999px;background:rgba(0,0,0,.12);transition:background-color 200ms ease}.ui-cbr__track>span{position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.15);transition:transform 260ms var(--ui-cbr-ease),width 160ms var(--ui-cbr-ease)}.ui-cbr__switch input:checked+.ui-cbr__track{background:var(--ui-cbr-ink)}.ui-cbr__switch input:checked+.ui-cbr__track>span{transform:translateX(10px)}
.ui-cbr__card.ui-cbr__split{flex-direction:row;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:12px}.ui-cbr__split .ui-cbr__label{display:block;padding:0 0 10px}.ui-cbr__swatches,.ui-cbr__formats{display:flex;flex-wrap:wrap;gap:10px 14px;font-size:12px;line-height:16px;color:var(--ui-cbr-muted)}.ui-cbr__swatches span,.ui-cbr__formats span{display:flex;flex-direction:column;align-items:center;gap:6px;max-width:100%;text-align:center;overflow-wrap:anywhere}.ui-cbr__swatches i{width:22px;height:22px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}.ui-cbr__formats span{justify-content:flex-end;min-height:44px}.ui-cbr__formats i{height:24px;max-width:36px;border:1.5px solid var(--ui-cbr-faint);border-radius:4px}.ui-cbr__details{display:grid;gap:12px;margin:0}.ui-cbr__details div{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:13px}.ui-cbr__details dt{display:flex;flex:none;align-items:center;gap:8px;color:var(--ui-cbr-muted)}.ui-cbr__details dd{min-width:0;margin:0;text-align:right;overflow-wrap:anywhere;font-weight:500;font-variant-numeric:tabular-nums}.ui-cbr__files{display:flex;flex-wrap:wrap;gap:6px}.ui-cbr__files button{display:flex;align-items:center;gap:5px;max-width:100%;padding:4px 8px;border-radius:6px;box-shadow:inset 0 0 0 .5px var(--ui-cbr-line);font-size:12px;color:var(--ui-cbr-text)}.ui-cbr__files button:hover{background:var(--ui-cbr-chip)}
.ui-cbr__go{display:flex;align-items:center;justify-content:space-between;position:sticky;bottom:0;z-index:1;margin-top:auto;padding:10px 10px 10px 12px;box-shadow:inset 0 0 0 .5px var(--ui-cbr-line),0 1px 2px rgba(0,0,0,.025),0 0 0 12px var(--ui-cbr-card)}.ui-cbr__go::before{content:"";position:absolute;left:-8px;right:-8px;bottom:calc(100% + .5px);height:28px;background:linear-gradient(to bottom,transparent,var(--ui-cbr-card) 85%);pointer-events:none}.ui-cbr__panel>:nth-last-child(2){margin-bottom:12px}.ui-cbr__tags{display:flex;gap:4px}.ui-cbr__tags span{padding:3px 9px;border-radius:999px;box-shadow:inset 0 0 0 .5px var(--ui-cbr-line);font-size:12.5px;font-weight:500;color:var(--ui-cbr-text)}.ui-cbr .ui-cbr__generate{display:inline-flex;justify-content:center;align-items:center;flex:none;height:24px;padding:0 8px;border-radius:6px;background:var(--ui-cbr-ink);color:var(--ui-cbr-card);font-size:12px;line-height:16px;font-weight:500;white-space:nowrap;transition:opacity 140ms ease,transform 160ms var(--ui-cbr-ease)}.ui-cbr__generate>span{animation:ui-cbr-label 480ms cubic-bezier(.25,1,.5,1) both}
.ui-cbr__empty{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;animation:ui-cbr-rise 420ms var(--ui-cbr-ease) both}.ui-cbr__empty>span{display:grid;place-items:center;width:42px;height:42px;margin-bottom:8px;border-radius:12px;background:var(--ui-cbr-card);box-shadow:0 0 0 .5px var(--ui-cbr-line);color:var(--ui-cbr-muted)}.ui-cbr__empty>b{font-size:14px;font-weight:500}.ui-cbr__empty p{max-width:240px;margin:0 0 10px;font-size:13px;line-height:19px;color:var(--ui-cbr-muted)}.ui-cbr__ads{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ui-cbr__ad{margin:0;animation:ui-cbr-rise 420ms var(--ui-cbr-ease) both;animation-delay:calc(var(--ui-cbr-index,0)*35ms)}.ui-cbr__art{display:flex;flex-direction:column;justify-content:space-between;aspect-ratio:1;padding:12px;border-radius:12px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}.ui-cbr__art b{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:4;font-size:15px;font-weight:500;line-height:1.2;letter-spacing:-.01em;overflow-wrap:anywhere}.ui-cbr__ad figcaption{display:flex;justify-content:space-between;gap:8px;margin-top:6px;font-size:12.5px;font-weight:500}.ui-cbr__ad figcaption>*{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-cbr__ad figcaption b{flex:none;max-width:60%;font-weight:500}.ui-cbr__ad figcaption span{font-weight:400;color:var(--ui-cbr-muted)}
.ui-cbr__activity{flex:none;margin:0;padding:14px 12px 0;list-style:none}.ui-cbr__activity li{position:relative;display:flex;gap:12px;padding-bottom:18px;animation:ui-cbr-rise 420ms var(--ui-cbr-ease) both;animation-delay:calc(var(--ui-cbr-index,0)*35ms)}.ui-cbr__activity li:not(:last-child)::before{content:"";position:absolute;top:28px;bottom:2px;left:13px;width:1px;background:var(--ui-cbr-line)}.ui-cbr__activity-icon{display:grid;flex:none;place-items:center;width:27px;height:27px;border-radius:50%;box-shadow:inset 0 0 0 .5px var(--ui-cbr-line);color:var(--ui-cbr-muted)}.ui-cbr__activity li>span:last-child{display:flex;flex-direction:column;min-width:0;padding-top:3px;overflow-wrap:anywhere;font-size:13px;line-height:19px}.ui-cbr__activity small{font-size:12.5px;color:var(--ui-cbr-faint)}
@keyframes ui-cbr-rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes ui-cbr-label{from{opacity:0;filter:blur(3px);transform:translateY(25%)}to{opacity:1;filter:blur(0);transform:none}}
:where(.dark,[data-theme="dark"]) .ui-cbr{--ui-cbr-card:#1c1c1e;--ui-cbr-ink:rgba(255,255,255,.9);--ui-cbr-text:rgba(255,255,255,.62);--ui-cbr-muted:rgba(255,255,255,.46);--ui-cbr-faint:rgba(255,255,255,.3);--ui-cbr-line:rgba(255,255,255,.14);--ui-cbr-chip:rgba(255,255,255,.06);--ui-cbr-hover:rgba(255,255,255,.04);--ui-cbr-focus:#4d8dff}.ui-cbr__switch input:checked+.ui-cbr__track>span{background:var(--ui-cbr-card)}:where(.dark,[data-theme="dark"]) .ui-cbr__thumb{background:#3a3329;color:#d9c6a5}:where(.dark,[data-theme="dark"]) .ui-cbr__signal i:not([data-on]){background:#3a3a3f}
@media(pointer:coarse){.ui-cbr__seg button{height:34px}.ui-cbr__option{min-height:52px}.ui-cbr__channel{min-height:48px}.ui-cbr .ui-cbr__generate{height:34px}.ui-cbr__files button{min-height:36px}.ui-cbr__switch::before{content:"";position:absolute;inset:-12px}}
@media(prefers-reduced-motion:reduce){.ui-cbr,.ui-cbr *{animation:none!important;transition:none!important}}
