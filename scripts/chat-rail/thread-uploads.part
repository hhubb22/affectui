export type ThreadAttachment = { id: string; name: string; size: number; kind?: "file" | "voice"; file?: File; seconds?: number };
export type ThreadUpload = ThreadAttachment & { progress: number; state: "uploading" | "paused" | "done" | "failed" | "transcribing" | "waiting" };
export type ThreadUploadsProps = { uploads: ThreadUpload[]; onRemove?: (id: string) => void; onRetry?: (id: string) => void; className?: string };

/** Upload progress, paused transfers, retryable failures and voice notes waiting for a connection. */
export function ThreadUploads({ uploads: rawUploads, onRemove, onRetry, className }: ThreadUploadsProps) {
  const uploads = (Array.isArray(rawUploads) ? rawUploads : []).filter(Boolean);
  const size = (bytes: number) => bytes >= 1e6 ? `${Math.round(bytes / 1e6)} MB` : bytes >= 1000 ? `${Math.round(bytes / 1000)} KB` : `${Math.max(0, bytes)} B`;
  return <ul className={["ui-up", className].filter(Boolean).join(" ")} aria-label="Attachments">
    <style href="ui-thread-uploads" precedence="default">{css}</style>
    {uploads.map(upload => {
      const status = ["uploading", "paused", "done", "failed", "transcribing", "waiting"].includes(upload.state) ? upload.state : "done";
      const progress = clamp(safeNumber(upload.progress, 0), 0, 1);
      return <li key={upload.id} className="ui-up__file" data-state={status} data-kind={upload.kind === "voice" ? "voice" : undefined}>
        <span className="ui-up__icon" data-kind={upload.kind === "voice" ? "voice" : /\.(mov|mp4|webm)$/i.test(upload.name) ? "video" : /\.(csv|xlsx?)$/i.test(upload.name) ? "table" : "file"}><Icon name={upload.kind === "voice" ? "mic" : /\.(mov|mp4|webm)$/i.test(upload.name) ? "video" : /\.(csv|xlsx?)$/i.test(upload.name) ? "table" : "document"} size={14}/></span>
        <span className="ui-up__info"><strong title={upload.name} dir="auto">{upload.name}{upload.kind === "voice" && upload.seconds != null ? ` · ${Math.floor(upload.seconds / 60)}:${String(upload.seconds % 60).padStart(2, "0")}` : ""}</strong><span className="ui-up__status">{status === "failed" ? <>{upload.kind === "voice" ? "Transcription failed" : "Upload failed"} · <button type="button" aria-label={`Retry ${upload.name}`} onClick={() => onRetry?.(upload.id)}>Retry</button></> : status === "waiting" ? "Saved – will transcribe when you're back online" : status === "transcribing" ? "Transcribing…" : status === "paused" ? `Paused – waiting for connection · ${size(upload.size)}` : status === "uploading" ? `${Math.round(progress * 100)}% · ${size(upload.size)}` : size(upload.size)}</span>{(status === "uploading" || status === "paused") && <span className="ui-up__bar" role="progressbar" aria-label={`Uploading ${upload.name}`} aria-valuenow={Math.round(progress * 100)} aria-valuemin={0} aria-valuemax={100}><span style={{ transform: `scaleX(${progress})` }}/></span>}</span>
        <button type="button" className="ui-up__remove" aria-label={`${status === "uploading" || status === "paused" ? "Cancel upload" : "Remove"} ${upload.name}`} onClick={() => onRemove?.(upload.id)}><Icon name="close" size={12}/></button>
      </li>;
    })}
  </ul>;
}

export type ThreadVoiceInputProps = { seconds: number; onDiscard: () => void; onDone: () => void; className?: string };
/** Preview-friendly dictation controls, also useful with a caller-owned recorder. */
export function ThreadVoiceInput({ seconds, onDiscard, onDone, className }: ThreadVoiceInputProps) {
  const value = Math.max(0, Math.floor(safeNumber(seconds, 0)));
  return <div className={["ui-up", "ui-up__voice", className].filter(Boolean).join(" ")} role="group" aria-label="Dictating">
    <style href="ui-thread-uploads" precedence="default">{css}</style>
    <button type="button" aria-label="Discard recording" onClick={onDiscard}><Icon name="close" size={16}/></button><span className="ui-up__red-dot"/><span className="ui-up__wave" aria-hidden="true">{Array.from({ length: 56 }, (_, index) => <i key={index} style={{ height: `${3 + (index * 7 % 17)}px`, animationDelay: `${index * -83}ms` }}/>)}</span><span className="ui-up__time">{Math.floor(value / 60)}:{String(value % 60).padStart(2, "0")}</span><button type="button" aria-label="Done" onClick={onDone}><Icon name="check" size={16}/></button>
  </div>;
}

/* ---------- Styles ---------- */
.ui-up{--ui-up-card:#fff;--ui-up-ink:rgba(0,0,0,.88);--ui-up-muted:rgba(0,0,0,.45);--ui-up-faint:rgba(0,0,0,.27);--ui-up-line:rgba(0,0,0,.06);--ui-up-fill:rgba(0,0,0,.025);--ui-up-accent:#0060e2;--ui-up-focus:rgba(0,96,226,.35);display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none;width:100%;font:12px/1.5 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-up-ink);container-type:inline-size;-webkit-font-smoothing:antialiased}
.ui-up,.ui-up *,.ui-up *::before,.ui-up *::after{box-sizing:border-box}.ui-up button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-up button:focus-visible{outline:2px solid var(--ui-up-focus);outline-offset:2px}.ui-up button:active:not(:disabled){transform:scale(.97)}.ui-up__file{display:flex;align-items:center;gap:8px;position:relative;min-width:0;max-width:280px;flex:none;min-height:40px;padding:4px 4px 4px 6px;overflow:hidden;border-radius:10px;box-shadow:0 0 0 .5px var(--ui-up-line);background:var(--ui-up-fill);animation:ui-up-in 280ms cubic-bezier(.22,1,.36,1) both}.ui-up__icon{display:grid;place-items:center;flex:none;width:28px;height:28px;border-radius:7px;background:var(--ui-up-fill);color:var(--ui-up-muted)}.ui-up__icon[data-kind="voice"]{color:#a367d1}.ui-up__icon[data-kind="video"]{color:#db5e9d}.ui-up__icon[data-kind="table"]{color:#44ad76}.ui-up__info{display:flex;min-width:0;flex:1;flex-direction:column;gap:0}.ui-up__info strong{font-size:12px;line-height:16px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-up__status{font-size:11px;line-height:16px;color:var(--ui-up-muted);font-variant-numeric:tabular-nums}.ui-up__status button{font-size:11px;text-decoration:underline;padding:0}.ui-up__file[data-state="failed"] .ui-up__status{color:#e5484d}.ui-up__remove{display:grid;place-items:center;width:24px;height:24px;border-radius:5px;color:var(--ui-up-muted)!important}.ui-up__remove:hover{background:var(--ui-up-fill)}.ui-up__bar{position:absolute;bottom:0;left:10px;right:10px;display:block;height:2px;border-radius:2px;background:var(--ui-up-fill);overflow:hidden;margin-top:3px}.ui-up__bar>span{display:block;transform-origin:left;width:100%;height:100%;background:var(--ui-up-accent);transition:transform 200ms linear}.ui-up__file[data-state="paused"] .ui-up__bar>span{background:var(--ui-up-faint)}.ui-up__voice{flex-wrap:nowrap;align-items:center;padding:4px 6px;gap:8px;border-radius:14px;height:36px;background:var(--ui-up-card);box-shadow:0 0 0 .5px var(--ui-up-line)}.ui-up__voice>button{display:grid;place-items:center;width:28px;height:28px;border-radius:6px;color:var(--ui-up-muted)}.ui-up__voice>button:hover{background:var(--ui-up-fill)}.ui-up__red-dot{width:5px;height:5px;background:#e5484d;border-radius:50%;animation:ui-up-pulse 1s ease-in-out infinite}.ui-up__wave{flex:1;display:flex;align-items:center;gap:2px;justify-content:flex-start;height:20px;overflow:hidden}.ui-up__wave i{display:block;flex:none;width:2px;border-radius:2px;background:var(--ui-up-accent);animation:ui-up-wave 600ms ease-in-out infinite alternate}.ui-up__time{font-variant-numeric:tabular-nums;font-size:11px;color:var(--ui-up-muted)}
@keyframes ui-up-wave{to{transform:scaleY(.2)}}@keyframes ui-up-pulse{50%{opacity:.3}}@keyframes ui-up-in{from{opacity:0;transform:translateY(5px)}}
@container(max-width:400px){.ui-up__file{max-width:100%}}
@media(pointer:coarse){.ui-up__remove,.ui-up__voice>button{width:36px;height:36px}.ui-up__status button{min-height:32px}}
@media(prefers-reduced-motion:reduce){.ui-up,.ui-up *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-up{--ui-up-card:#1c1c1e;--ui-up-ink:rgba(255,255,255,.9);--ui-up-muted:rgba(255,255,255,.46);--ui-up-faint:rgba(255,255,255,.3);--ui-up-line:rgba(255,255,255,.08);--ui-up-fill:rgba(255,255,255,.04);--ui-up-accent:#4d8dff;--ui-up-focus:rgba(77,141,255,.5)}

.ui-up__file[data-kind="voice"]{max-width:380px}.ui-up__file[data-kind="voice"][data-state="waiting"]{padding-block:6px}.ui-up__file[data-kind="voice"] .ui-up__status{white-space:normal}
