export type InboxConfirmationProps = { answer?: string; message?: string; className?: string };
/** The sent state: a short check draw followed by the answer that was sent. */
export function InboxConfirmation({answer,message="Sent – it'll take it from here",className}:InboxConfirmationProps) {
  return <div className={["ui-ibf", "ui-ibf__sent",className].filter(Boolean).join(" ")}><style href="ui-inbox-feedback" precedence="default">{css}</style><svg className="ui-ibf__mark" viewBox="0 0 24 24" aria-hidden="true"><circle className="ui-ibf__ring" cx="12" cy="12" r="12"/><path className="ui-ibf__tick" pathLength="1" d="m6.5 12 3.5 3.5 7.5-7.5"/></svg><span className="ui-ibf__text"><strong>{message}</strong>{answer&&<span dir="auto" title={answer}>{answer}</span>}</span></div>;
}
export type InboxEmptyStateProps = { running?: number; variant?: "open"|"done"; title?: string; description?: string; tasksLabel?: string; onOpenTasks?: () => void; focusRequest?: number; className?: string };
/** The end of the queue, with a keyboard focus target and a route back to Tasks. */
export function InboxEmptyState({running=3,variant="open",title,description,tasksLabel="View tasks",onOpenTasks,focusRequest,className}:InboxEmptyStateProps) {
  const heading=useRef<HTMLHeadingElement>(null);
  useEffect(()=>{if(focusRequest){const frame=requestAnimationFrame(()=>heading.current?.focus({preventScroll:true}));return()=>cancelAnimationFrame(frame);}},[focusRequest]);
  return <div className={["ui-ibf","ui-ibf__empty",className].filter(Boolean).join(" ")}><style href="ui-inbox-feedback" precedence="default">{css}</style><svg className="ui-ibf__empty-mark" viewBox="0 0 36 36" fill="none" aria-hidden="true"><circle cx="18" cy="18" r="16" stroke="currentColor" strokeWidth="1.4"/><path d="m10 18 5 5 11-11" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/></svg><h2 ref={heading} tabIndex={-1}>{title??(variant==="done"?"No answers yet":"You're all caught up")}</h2><p>{description??(variant==="done"?"Your answers will appear here.":`${Math.max(0,safeNumber(running,0))} ${running===1?"task is":"tasks are"} still running.`)}</p>{variant!=="done"&&onOpenTasks&&<button type="button" onClick={onOpenTasks}>{tasksLabel}<Icon name="arrow" size={13}/></button>}</div>;
}

/* ---------- Styles ---------- */
.ui-ibf{--ui-ibf-card:#fff;--ui-ibf-ink:rgba(0,0,0,.88);--ui-ibf-muted:rgba(0,0,0,.45);--ui-ibf-fill:rgba(0,0,0,.04);--ui-ibf-line:rgba(0,0,0,.06);--ui-ibf-focus:rgba(0,96,226,.7);--ui-ibf-ease:cubic-bezier(.22,1,.36,1);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-ibf-ink);container-type:inline-size;-webkit-font-smoothing:antialiased}.ui-ibf,.ui-ibf *,.ui-ibf *::before,.ui-ibf *::after{box-sizing:border-box}.ui-ibf__sent{display:flex;align-items:flex-start;gap:12px;animation:ui-ibf-fade 240ms both}.ui-ibf__mark{width:24px;height:24px;flex:none;overflow:visible}.ui-ibf__ring{fill:var(--ui-ibf-fill);stroke:none;transform-origin:center;animation:ui-ibf-pop 420ms var(--ui-ibf-ease) both}.ui-ibf__tick{fill:none;stroke:var(--ui-ibf-ink);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;animation:ui-ibf-draw 420ms var(--ui-ibf-ease) 160ms forwards}.ui-ibf__text{display:flex;flex-direction:column;min-width:0;padding-top:2px}.ui-ibf__text strong{font-size:13px;line-height:20px;font-weight:500;animation:ui-ibf-rise 360ms var(--ui-ibf-ease) 120ms both}.ui-ibf__text>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ui-ibf-muted);animation:ui-ibf-rise 360ms var(--ui-ibf-ease) 200ms both}.ui-ibf__empty{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;text-align:center;padding:40px 24px 80px;animation:ui-ibf-rise 480ms var(--ui-ibf-ease) both}.ui-ibf__empty-mark{width:36px;height:36px;color:var(--ui-ibf-muted)}.ui-ibf__empty h2{margin:16px 0 0;font-size:15px;line-height:24px;font-weight:500;outline:none}.ui-ibf__empty p{margin:2px 0 20px;color:var(--ui-ibf-muted);font-size:13px;line-height:20px;font-variant-numeric:tabular-nums}.ui-ibf__empty button{display:flex;align-items:center;justify-content:center;gap:6px;height:28px;padding:0 10px;border:0;border-radius:6px;background:var(--ui-ibf-card);box-shadow:0 0 0 .5px var(--ui-ibf-line);font:inherit;font-size:13px;line-height:20px;font-weight:500;color:var(--ui-ibf-ink);cursor:pointer}.ui-ibf__empty button:active{transform:scale(.97)}.ui-ibf__empty button:focus-visible{outline:2px solid var(--ui-ibf-focus);outline-offset:2px}
@keyframes ui-ibf-fade{from{opacity:0}}@keyframes ui-ibf-pop{from{transform:scale(.6);opacity:0}}@keyframes ui-ibf-draw{to{stroke-dashoffset:0}}@keyframes ui-ibf-rise{from{opacity:0;transform:translateY(3px)}}
@media(pointer:coarse){.ui-ibf__empty button{min-height:36px}}
@media(prefers-reduced-motion:reduce){.ui-ibf,.ui-ibf *{animation:none!important;transition:none!important}.ui-ibf__tick{stroke-dashoffset:0}}
:where(.dark,[data-theme="dark"]) .ui-ibf{--ui-ibf-card:#1c1c1e;--ui-ibf-ink:rgba(255,255,255,.9);--ui-ibf-muted:rgba(255,255,255,.46);--ui-ibf-fill:rgba(255,255,255,.06);--ui-ibf-line:rgba(255,255,255,.08);--ui-ibf-focus:rgba(77,141,255,.8)}
