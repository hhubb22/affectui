// These primitives are embedded into each distribution file; there are no runtime imports between components.
type IconName = "terminal" | "image" | "inbox" | "memory" | "video" | "chat" | "tasks" | "play" | "folder" | "folder-open" | "plug" | "bell" | "settings" | "search" | "compose" | "chevron" | "check" | "close" | "plus" | "more" | "pin" | "panel" | "mic" | "send" | "hand" | "globe" | "table" | "document" | "undo" | "redo" | "bold" | "italic" | "underline" | "link" | "sort" | "row" | "column" | "trash" | "copy" | "download" | "arrow" | "stop" | "warning" | "spark";

