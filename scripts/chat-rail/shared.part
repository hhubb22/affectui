function Icon({ name, size = 16 }: { name: IconName; size?: number }) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" style={{ flexShrink: 0 }}>{iconPaths[name] ?? iconPaths.document}</svg>;
}

function useControllable<T>(value: T | undefined, initial: T, onChange?: (value: T) => void) {
  const [state, setState] = useState(initial);
  const current = value === undefined ? state : value;
  const set = (next: T) => { if (value === undefined) setState(next); onChange?.(next); };
  return [current, set] as const;
}

function useReducedMotion() {
  const [reduced, setReduced] = useState(false);
  useEffect(() => {
    const query = window.matchMedia("(prefers-reduced-motion: reduce)");
    const update = () => setReduced(query.matches);
    update(); query.addEventListener("change", update);
    return () => query.removeEventListener("change", update);
  }, []);
  return reduced;
}

function useMorph(value: string) {
  const ref = useRef<HTMLButtonElement>(null);
  const previous = useRef<number | null>(null);
  const animation = useRef<Animation | null>(null);
  useLayoutEffect(() => {
    const el = ref.current;
    if (!el) return;
    animation.current?.cancel();
    const width = el.getBoundingClientRect().width;
    if (previous.current !== null && Math.abs(previous.current - width) > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      animation.current = el.animate([{ width: `${previous.current}px` }, { width: `${width}px` }], { duration: 480, easing: "cubic-bezier(0.25, 1, 0.5, 1)" });
    }
    previous.current = width;
    return () => animation.current?.cancel();
  }, [value]);
  return ref;
}

function moveMenuFocus(event: KeyboardEvent<HTMLElement>) {
  if ((event.target as HTMLElement).matches("input,textarea")) return;
  const items = [...event.currentTarget.querySelectorAll<HTMLElement>('button:not(:disabled),[role="option"][tabindex]')].filter(el => !el.closest("[inert],[hidden]") && el.getClientRects().length > 0);
  const index = items.indexOf(document.activeElement as HTMLElement);
  const next = event.key === "ArrowDown" ? (index + 1) % items.length : event.key === "ArrowUp" ? (index - 1 + items.length) % items.length : event.key === "Home" ? 0 : event.key === "End" ? items.length - 1 : null;
  if (next === null || !items.length) return;
  event.preventDefault(); items[next]?.focus();
}

function FloatingMenu({ anchor, root, children, onClose, className, id, label, side = "bottom", align = "start" }: {
  anchor: RefObject<HTMLElement | null>; root: RefObject<HTMLElement | null>; children: ReactNode;
  onClose: () => void; className: string; id: string; label: string; side?: "top" | "bottom" | "right"; align?: "start" | "end";
}) {
  const ref = useRef<HTMLDivElement>(null);
  const closeRef = useRef(onClose); closeRef.current = onClose;
  const [position, setPosition] = useState({ left: 0, top: 0, maxHeight: 400 });
  useLayoutEffect(() => {
    const update = () => {
      const origin = root.current, target = anchor.current, menu = ref.current;
      if (!origin || !target || !menu) return;
      const a = target.getBoundingClientRect(), r = origin.getBoundingClientRect();
      const boundary = origin.closest<HTMLElement>("[data-overlay-boundary]")?.getBoundingClientRect();
      const leftEdge = Math.max(8, (boundary?.left ?? 0) + 8), rightEdge = Math.min(window.innerWidth - 8, (boundary?.right ?? window.innerWidth) - 8);
      const topEdge = Math.max(8, (boundary?.top ?? 0) + 8), bottomEdge = Math.min(window.innerHeight - 8, (boundary?.bottom ?? window.innerHeight) - 8);
      const maxHeight = Math.max(80, bottomEdge - topEdge);
      const width = menu.offsetWidth, height = Math.min(menu.scrollHeight, maxHeight);
      let x = side === "right" ? a.right + 10 : align === "end" ? a.right - width : a.left;
      let y = side === "top" ? a.top - height - 8 : side === "right" ? a.top : a.bottom + 8;
      if (side === "bottom" && y + height > bottomEdge && a.top - height - 8 >= topEdge) y = a.top - height - 8;
      x = Math.max(leftEdge, Math.min(x, rightEdge - width)); y = Math.max(topEdge, Math.min(y, bottomEdge - height));
      setPosition({ left: x - r.left + origin.scrollLeft, top: y - r.top + origin.scrollTop, maxHeight });
    };
    update();
    const observer = new ResizeObserver(update); if (ref.current) observer.observe(ref.current);
    window.addEventListener("resize", update); window.addEventListener("scroll", update, true);
    return () => { observer.disconnect(); window.removeEventListener("resize", update); window.removeEventListener("scroll", update, true); };
  }, [anchor, root, side, align]);
  useEffect(() => {
    const target = anchor.current;
    ref.current?.querySelector<HTMLElement>('[aria-checked="true"],input,button:not(:disabled)')?.focus({ preventScroll: true });
    const dismiss = (event: PointerEvent) => { if (!ref.current?.contains(event.target as Node) && !anchor.current?.contains(event.target as Node)) closeRef.current(); };
    const key = (event: globalThis.KeyboardEvent) => {
      if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); closeRef.current(); target?.focus({ preventScroll: true }); }
      if (event.key === "Tab") { closeRef.current(); target?.focus({ preventScroll: true }); }
    };
    document.addEventListener("pointerdown", dismiss, true); document.addEventListener("keydown", key, true);
    return () => { document.removeEventListener("pointerdown", dismiss, true); document.removeEventListener("keydown", key, true); };
  }, [anchor]);
  return <div ref={ref} id={id} className={className} role="menu" aria-label={label} style={{ position: "absolute", ...position, zIndex: 50 }} onKeyDown={moveMenuFocus}>{children}</div>;
}

function initials(name: string) { return String(name || "User").trim().split(/\s+/).slice(0, 2).map(part => part[0]).join("").toUpperCase(); }
function durationLabel(ms: number) { return `${(Math.max(0, Number.isFinite(ms) ? ms : 0) / 1000).toFixed(1)}s`; }
function safeNumber(value: unknown, fallback: number) { return typeof value === "number" && Number.isFinite(value) ? value : fallback; }
function clamp(value: number, min: number, max: number) { return Math.max(min, Math.min(value, max)); }
function isEditing(target: EventTarget | null) { return target instanceof HTMLElement && !!target.closest('input,textarea,select,[contenteditable="true"]'); }

function agentTaskNeeds(task: AgentTask) { return task.done ? 0 : task.asks?.length ? task.asks.length : Math.max(0,Math.floor(safeNumber(task.needs,0))); }
function agentTaskAge(at: number, now: number) {
  const minutes=Math.max(0,Math.floor((now-safeNumber(at,now))/60000));
  if(minutes<1)return {short:"now",long:"just now"};
  const value=minutes<60?minutes:minutes<1440?Math.floor(minutes/60):Math.floor(minutes/1440);
  const unit=minutes<60?"minute":minutes<1440?"hour":"day";
  return {short:`${value}${minutes<60?"m":minutes<1440?"h":"d"}`,long:`${value} ${unit}${value===1?"":"s"} ago`};
}
function agentTaskStatus(task: AgentTask, now: number) {
  if(task.statusText?.trim())return task.statusText;
  if(task.done){const days=Math.floor((now-safeNumber(task.updatedAt,now))/86400000);return `Done · ${days<1?"Today":days<2?"Yesterday":new Intl.DateTimeFormat("en",{weekday:"short",timeZone:"UTC"}).format(task.updatedAt)}`;}
  return agentTaskNeeds(task)?"Waiting on you":task.status==="planning"?"Planning":task.status==="paused"?"Paused":"Working";
}

export type InboxAnswer = { option?: string; text?: string } | "approve" | "decline";
export type InboxDraft = { option?: string; text?: string };
export type InboxOption = { id: string; title: string; summary?: string; recommended?: boolean; pros?: string[]; cons?: string[]; wireframe?: "illustration" | "checklist" | "data" | "bars" | "line" | ReactNode; preview?: ReactNode };
export type InboxItem = { id: string; kind: "decision" | "pick" | "approval" | "question"; question: string; context?: string; task: string; at: number; unread?: boolean; options?: InboxOption[]; facts?: { label: string; value: string }[]; suggestions?: string[]; done?: { answer: InboxAnswer; at: number; label?: string; history?: string[]; artifacts?: string[] } };
export type InboxTask = { goal?: string; project?: string; status?: string; started?: string; steps?: { label: string; done?: boolean }[]; artifacts?: string[] };

function InboxGlyph({kind,size=14}:{kind:InboxItem["kind"]|"done";size?:number}) {
  return <svg width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{kind==="done"?<path d="m3 8 3 3 7-7"/>:kind==="decision"?<path d="M8 14V9L3 4m0 0h4M3 4v4M8 9l5-5m0 0H9m4 0v4"/>:kind==="pick"?<><rect x="1.5" y="1.5" width="13" height="13" rx="3"/><path d="M1.5 7h13M7 1.5v13"/></>:kind==="approval"?<><circle cx="8" cy="8" r="6.5"/><path d="m4.5 8 2.3 2.3 4.7-4.7"/></>:<><circle cx="8" cy="8" r="6.5"/><path d="M6 5.5a2 2 0 0 1 4 .5c0 1.5-2 1.5-2 3M8 11.5h.01"/></>}</svg>;
}
function inboxKind(kind: unknown): InboxItem["kind"] { return kind==="decision"||kind==="pick"||kind==="approval"?kind:"question"; }
function inboxAge(at: number, now: number) { const minutes=Math.max(0,Math.floor((now-safeNumber(at,now))/60000));if(minutes<1)return {short:"now",long:"just now"};if(minutes<60)return{short:`${minutes}m`,long:`${minutes} ${minutes===1?"minute":"minutes"} ago`};const hours=Math.floor(minutes/60);if(hours<24)return{short:`${hours}h`,long:`${hours} ${hours===1?"hour":"hours"} ago`};const days=Math.floor(hours/24);return{short:days===1?"Yesterday":`${days}d`,long:days===1?"yesterday":`${days} days ago`}; }
function inboxAnswerLabel(item: InboxItem, answer: InboxAnswer) { if(answer==="approve")return "Approved";if(answer==="decline")return "Declined";const option=item.options?.find(option=>option.id===answer.option);return option?`${option.title}${answer.text?.trim()?` – “${answer.text.trim()}”`:""}`:answer.text?.trim()??"Answered"; }
