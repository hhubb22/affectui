export type ThreadTaskDetail = { goal?: string; project?: string; started?: string; steps?: { label: string; done?: boolean }[]; history?: string[]; artifacts?: string[]; decided?: { question: string; answer: string; at?: number }[] };
export type TaskDetailsProps = { task: ThreadTask; detail?: ThreadTaskDetail; decision?: { id: string; question: string }; onDecide?: (id: string) => void; onOpenFile?: (name: string) => void; onShow?: (id: string) => void; className?: string };

/** The task tab in the work area: status, steps, history, artifacts and earlier decisions. */
export function TaskDetails({ task, detail = {}, decision, onDecide, onOpenFile, onShow, className }: TaskDetailsProps) {
  return <section className={["ui-td", className].filter(Boolean).join(" ")} aria-label={task.title}>
    <style href="ui-task-details" precedence="default">{css}</style>
    <h2 className="ui-td__sr">{task.title}</h2>{detail.goal && <p className="ui-td__goal" dir="auto">{detail.goal}</p>}
    <dl className="ui-td__meta"><div><dt>Status</dt><dd><span data-done={task.done || undefined}><Icon name={task.done ? "check" : "play"} size={14}/></span>{task.status}{task.steps && <small>{task.steps.done}/{task.steps.total}</small>}</dd></div>{detail.project && <div><dt>Project</dt><dd>{detail.project}</dd></div>}{detail.started && <div><dt>Started</dt><dd>{detail.started}</dd></div>}</dl>
    {decision && <button type="button" className="ui-td__waiting" onClick={() => onDecide?.(decision.id)}><span>Needs you</span>{decision.question}<Icon name="arrow" size={13}/></button>}
    {detail.steps && detail.steps.length > 0 && <section className="ui-td__section"><h3>Steps</h3><ol className="ui-td__steps">{detail.steps.map((step, index) => <li key={`${step.label}-${index}`} data-done={step.done || undefined} data-active={!step.done && detail.steps?.findIndex(item => !item.done) === index || undefined}><span aria-hidden="true">{step.done && <Icon name="check" size={10}/>}</span><span dir="auto">{step.label}</span><span className="ui-td__sr">{step.done ? ", done" : detail.steps?.findIndex(item => !item.done) === index ? ", in progress" : ""}</span></li>)}</ol></section>}
    {detail.history && detail.history.length > 0 && <section className="ui-td__section"><h3>What happened so far</h3><ul className="ui-td__history">{detail.history.map((line, index) => <li key={index} dir="auto">{line}</li>)}</ul></section>}
    {detail.artifacts && detail.artifacts.length > 0 && <section className="ui-td__section"><h3>Artifacts</h3><div className="ui-td__files">{detail.artifacts.map(name => <button type="button" key={name} onClick={() => onOpenFile?.(name)}><Icon name="document" size={13}/>{name}</button>)}</div></section>}
    {detail.decided && detail.decided.length > 0 && <section className="ui-td__section"><h3>Decided</h3>{detail.decided.map((item, index) => <div className="ui-td__answer" key={index}><Icon name="check" size={13}/><span><strong dir="auto">{item.question}</strong><small dir="auto">{item.answer}</small></span></div>)}</section>}
    <footer><button type="button" disabled={!onShow} onClick={() => onShow?.(task.id)}>Show in Tasks<Icon name="chevron" size={12}/></button></footer>
  </section>;
}

/* ---------- Styles ---------- */
.ui-td{--ui-td-card:#fff;--ui-td-ink:rgba(0,0,0,.88);--ui-td-text:rgba(0,0,0,.61);--ui-td-muted:rgba(0,0,0,.45);--ui-td-faint:rgba(0,0,0,.27);--ui-td-line:rgba(0,0,0,.06);--ui-td-fill:rgba(0,0,0,.025);--ui-td-focus:rgba(0,96,226,.35);height:100%;overflow:auto;padding:18px;color:var(--ui-td-ink);font:13px/1.5 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-td / inline-size;-webkit-font-smoothing:antialiased}
.ui-td,.ui-td *,.ui-td *::before,.ui-td *::after{box-sizing:border-box}.ui-td button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-td button:disabled{opacity:.4;cursor:default}.ui-td button:active:not(:disabled){transform:scale(.97)}.ui-td button:focus-visible{outline:2px solid var(--ui-td-focus);outline-offset:2px}.ui-td__goal{color:var(--ui-td-text);font-size:13px;line-height:1.6;margin:0 0 22px;overflow-wrap:anywhere}.ui-td__meta{display:flex;flex-direction:column;gap:10px;margin:0 0 22px;font-size:12px}.ui-td__meta>div{display:flex;gap:16px}.ui-td__meta dt{width:60px;flex:none;color:var(--ui-td-muted)}.ui-td__meta dd{display:flex;align-items:center;gap:6px;margin:0;min-width:0}.ui-td__meta dd>span{display:flex;color:#e8a20c}.ui-td__meta dd>span[data-done]{color:#1a9a52}.ui-td__meta small{font-size:12px;color:var(--ui-td-faint);font-variant-numeric:tabular-nums}.ui-td__section{margin:0 0 22px}.ui-td__section h3{font-size:12px;font-weight:400;color:var(--ui-td-muted);margin:0 0 8px}.ui-td__steps{padding:10px 0;margin:0;list-style:none;background:var(--ui-td-fill);border-radius:10px}.ui-td__steps li{display:flex;align-items:center;gap:10px;position:relative;padding:5px 0;color:var(--ui-td-muted);font-size:12px;min-height:28px}.ui-td__steps li>span:first-child{display:grid;place-items:center;width:14px;height:14px;border-radius:50%;border:1px solid var(--ui-td-line);color:#fff;flex:none}.ui-td__steps li[data-done]>span:first-child{background:#0095ff;border-color:#0095ff}.ui-td__steps li[data-active]{color:var(--ui-td-ink)}.ui-td__steps li[data-active]>span:first-child{border-color:#0095ff;background:rgba(0,149,255,.13)}.ui-td__history{margin:0;padding-left:15px;font-size:12px;line-height:1.8;color:var(--ui-td-text)}.ui-td__history li::marker{color:var(--ui-td-faint)}.ui-td__history li:first-child{color:var(--ui-td-ink)}.ui-td__answer{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:11px;box-shadow:0 0 0 .5px var(--ui-td-line);margin-bottom:6px}.ui-td__answer>svg{color:#1a9a52}.ui-td__answer>span{display:flex;min-width:0;flex-direction:column}.ui-td__answer strong{font-size:12px;font-weight:400;overflow-wrap:anywhere}.ui-td__answer small{font-size:11px;color:var(--ui-td-muted)}.ui-td__files{display:flex;flex-wrap:wrap;gap:5px}.ui-td__files button{display:flex;align-items:center;gap:5px;font-size:11px;padding:5px 7px;background:var(--ui-td-fill);border-radius:5px}.ui-td>footer{display:flex;justify-content:flex-end;padding-top:0}.ui-td>footer button{display:flex;align-items:center;gap:5px;min-height:28px;font-size:12px;color:var(--ui-td-muted)}.ui-td>footer button svg{rotate:-90deg}.ui-td__waiting{display:flex;align-items:center;gap:8px;width:100%;padding:10px;text-align:left;background:var(--ui-td-fill)!important;border-radius:9px;margin-bottom:18px;font-size:12px!important}.ui-td__waiting>span{font-size:10px;color:#b47a06;white-space:nowrap}.ui-td__waiting>svg{margin-left:auto}.ui-td__sr{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}
@container ui-td (max-width:320px){.ui-td__meta>div{gap:8px}.ui-td__meta dt{width:52px}}
@media(pointer:coarse){.ui-td button{min-height:36px}.ui-td__steps li{min-height:34px}}
@media(prefers-reduced-motion:reduce){.ui-td,.ui-td *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-td{--ui-td-card:#1c1c1e;--ui-td-ink:rgba(255,255,255,.9);--ui-td-text:rgba(255,255,255,.62);--ui-td-muted:rgba(255,255,255,.46);--ui-td-faint:rgba(255,255,255,.3);--ui-td-line:rgba(255,255,255,.08);--ui-td-fill:rgba(255,255,255,.04);--ui-td-focus:rgba(77,141,255,.5)}
