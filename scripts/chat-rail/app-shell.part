      <button ref={sideOpenRef} type="button" className="ui-as__drawer-trigger ui-as__open-side" aria-label={labels.openSidebar} aria-expanded={sidebarOpen} aria-controls={`${id}-sidebar`} onClick={() => { if (narrow) { setSidebarOpen(true); setPanelOpen(false); } else setCollapsed(false); }}><Icon name="panel"/></button>
      {hasPanel && <button ref={panelOpenRef} type="button" className="ui-as__drawer-trigger ui-as__open-panel" aria-label={labels.openPanel(panelTitle)} aria-expanded={visiblePanel} aria-controls={`${id}-panel`} onClick={() => { setPanelOpen(!panelOpen); setSidebarOpen(false); }}><Icon name="panel"/></button>}
      {drawer && <button type="button" className="ui-as__scrim" aria-label={sidebarOpen ? labels.closeSidebar : labels.closePanel(panelTitle)} tabIndex={-1} onClick={closeDrawer}/>}
      <aside ref={sidebar} className="ui-as__side" id={`${id}-sidebar`} aria-label={labels.sidebar} inert={narrow ? !sidebarOpen : collapsed && !iconSidebar}>
        {rail && <nav className="ui-as__rail" aria-label={labels.apps}><button type="button" className="ui-as__logo" aria-label={workspace} title={workspace} aria-haspopup="menu" aria-expanded={menu === "workspace"} aria-controls={menu === "workspace" ? `${id}-menu` : undefined} {...trigger("workspace")}>{initials(workspace).slice(0, 1)}</button><span className="ui-as__rail-line"/>{rail.items.filter(Boolean).map(item => <button type="button" className="ui-as__rail-item" key={item.label} aria-label={item.label} title={item.label} aria-current={(activeProp ?? rail.active ?? active) === item.label ? "page" : undefined} disabled={item.disabled} onClick={() => navigate(item.label)} onErrorCapture={event => { if (event.target instanceof HTMLImageElement) event.target.style.visibility = "hidden"; }}>{item.icon ?? <Icon name="chat" size={19}/>}</button>)}<span className="ui-as__rail-space"/>{rail.bottom?.filter(Boolean).map(item => <button type="button" className="ui-as__rail-item" key={item.label} aria-label={item.count ? labels.unreadCount(item.label, item.count) : item.label} title={item.label} disabled={item.disabled} onClick={() => navigate(item.label)}>{item.icon ?? <Icon name="settings" size={19}/>} {!!item.count && <i className="ui-as__notification-dot"/>}</button>)}<button type="button" className="ui-as__user" aria-label={user.name} title={user.name} aria-haspopup="menu" aria-expanded={menu === "account"} aria-controls={menu === "account" ? `${id}-menu` : undefined} {...trigger("account")}>{user.avatar && !brokenAvatar ? <img src={user.avatar} alt="" onError={() => setBrokenAvatar(true)}/> : initials(user.name)}</button></nav>}
        <div className="ui-as__side-col" data-navigation={!!navigation || undefined}>{sidebarContent !== undefined ? sidebarContent : <>{navigation ? <div className="ui-as__navigation"><header className="ui-as__nav-head"><button type="button" className="ui-as__nav-workspace" aria-label={workspace} aria-haspopup="menu" aria-expanded={menu === "workspace"} {...trigger("workspace")}><span>{initials(workspace).slice(0,1)}</span><strong>{workspace}</strong><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" aria-hidden="true"><path d="M18 9s-4.42 6-6 6-6-6-6-6"/></svg></button><button type="button" className="ui-as__icon-btn" aria-label={collapsed && !narrow ? labels.expandSidebar : labels.collapseSidebar} onClick={() => narrow ? setSidebarOpen(false) : setCollapsed(!collapsed)}><Icon name="panel"/></button></header><button type="button" className="ui-as__nav-search" aria-label={labels.search} aria-haspopup="dialog" aria-expanded={searchOpen} onClick={() => setSearchOpen(true)}><Icon name="search" size={14}/><span>{labels.searchPlaceholder}</span><kbd>⌘K</kbd></button><nav className="ui-as__nav-items" aria-label={labels.workspace}>{navigation.map((item,index) => <div key={item.label}>{item.section && navigation[index-1]?.section !== item.section && <div className="ui-as__nav-section">{item.section}</div>}<button type="button" className="ui-as__nav-item" aria-label={item.label} aria-current={active === item.label ? "page" : undefined} disabled={item.disabled} onClick={() => navigate(item.label)}><span className="ui-as__nav-icon" aria-hidden="true" onErrorCapture={event => { if(event.target instanceof HTMLImageElement) event.target.style.visibility="hidden"; }}>{item.icon ?? <Icon name="document" size={16}/>}</span><span>{item.label}</span>{item.count != null && item.count > 0 && <small>{item.count}</small>}</button></div>)}</nav></div> : <><header className="ui-as__side-head"><button type="button" className="ui-as__project" aria-haspopup="menu" aria-expanded={menu === "projects"} aria-controls={menu === "projects" ? `${id}-menu` : undefined} {...trigger("projects")}><span title={project || labels.allProjects}>{project || labels.allProjects}</span><Icon name="chevron" size={12}/></button><button type="button" className="ui-as__icon-btn" aria-label={labels.search} title={labels.searchHint} onClick={() => setSearchOpen(true)}><Icon name="search"/></button><button type="button" className="ui-as__mobile-close ui-as__icon-btn" aria-label={labels.closeSidebar} onClick={() => setSidebarOpen(false)}><Icon name="panel"/></button></header>
          <nav className="ui-as__chat-nav" aria-label={labels.conversations}><button type="button" className="ui-as__new-chat" onClick={() => { onNewChat?.(); if (narrow) setSidebarOpen(false); }}><Icon name="compose" size={16}/>{labels.newChat}</button>
            {shown.some(chat => chat.pinned) && <div className="ui-as__group"><h2>{labels.pinned}</h2>{shown.filter(chat => chat.pinned).map(chat => row(chat))}</div>}
            <div className="ui-as__group"><h2>{labels.projects}</h2>{projectList.filter(name => !project || name === project).map(name => <div key={name}><button type="button" className="ui-as__folder" aria-expanded={folders.includes(name)} aria-controls={`${id}-folder-${encodeURIComponent(name)}`} onClick={() => setFolders(folders.includes(name) ? folders.filter(item => item !== name) : [...folders, name])}><Icon name={folders.includes(name) ? "folder-open" : "folder"} size={16}/><span title={name}>{name}</span><span className="ui-as__folder-chevron"><Icon name="chevron" size={12}/></span></button><div className="ui-as__folder-wrap" data-open={folders.includes(name)} id={`${id}-folder-${encodeURIComponent(name)}`} inert={!folders.includes(name)}><div>{shown.filter(chat => chat.project === name && !chat.pinned).map(chat => row(chat, true))}</div></div></div>)}</div>
            {shown.some(chat => !chat.project && !chat.pinned) && <div className="ui-as__group"><h2>{labels.chats}</h2>{shown.filter(chat => !chat.project && !chat.pinned).map(chat => row(chat))}</div>}
            {!shown.length && <p className="ui-as__empty">{labels.empty}</p>}
          </nav>
          </>}{!rail && <button type="button" className="ui-as__account-row" aria-label={user.name} aria-haspopup="menu" aria-expanded={menu === "account"} {...trigger("account")}><span className="ui-as__user-initials">{userAvatar}</span><span>{user.name}</span><Icon name="chevron" size={12}/></button>}</>}
        </div>
      </aside>
      <div className="ui-as__resizer" role="separator" aria-label={labels.resizeSidebar} aria-orientation="vertical" aria-valuemin={sidebarBounds.min} aria-valuemax={sidebarBounds.max} aria-valuenow={Math.round(sidebarWidth)} aria-controls={`${id}-sidebar`} tabIndex={narrow || collapsed ? -1 : 0} onPointerDown={event => resize("sidebar", event)} onKeyDown={event => resizeKey("sidebar", event)}/>
      {header != null && <div className="ui-as__header" inert={!!drawer}>{header}</div>}
      <main className="ui-as__main" inert={!!drawer}>{children}</main>
      {hasPanel && <><div className="ui-as__resizer ui-as__panel-resizer" role="separator" aria-label={labels.resizePanel(panelTitle)} aria-orientation="vertical" aria-valuemin={panelBounds.min} aria-valuemax={panelBounds.max} aria-valuenow={Math.round(panelWidth)} aria-controls={`${id}-panel`} tabIndex={visiblePanel && !narrow ? 0 : -1} onPointerDown={event => resize("panel", event)} onKeyDown={event => resizeKey("panel", event)}/><aside ref={panelRef} className="ui-as__panel" id={`${id}-panel`} aria-label={panelTitle} inert={!visiblePanel || narrow && sidebarOpen}>{panel}</aside></>}
    </div>
    {menu && <FloatingMenu key={menu} anchor={anchor} root={root} className={menu === "workspace" || menu === "account" ? `ui-as__menu ui-as__ws-menu${menu === "account" ? " ui-as__account-menu" : ""}` : "ui-as__menu"} id={`${id}-menu`} label={menu === "chat" ? labels.options(currentMenuChat?.title ?? "") : menu === "projects" ? labels.projects : menu === "workspace" ? workspace : labels.account} side={menu === "account" ? rail ? "right" : "top" : menu === "workspace" && !navigation ? "right" : "bottom"} align={menu === "account" && rail ? "end" : "start"} gap={menu === "account" && rail ? 12 : menu === "account" || menu === "workspace" && !!navigation ? 6 : undefined} onClose={() => setMenu(null)}>
      {menu === "workspace" && <>
        {wsItem("Invite people", "invite")}<span className="ui-as__wsm-sep" role="separator"/>
        {wsItem("Workspace settings", "settings")}{wsItem("Analytics", "analytics")}{wsItem("Billing", "billing")}{wsItem("Usage & limits", "usage")}{wsItem("Members", "members")}<span className="ui-as__wsm-sep" role="separator"/>
        {wsSub("Learn more", "info", <>{wsItem("Documentation", "docs")}{wsItem("Changelog", "changelog")}{wsItem("Help & feedback", "help")}</>)}<span className="ui-as__wsm-sep" role="separator"/>
        {wsSub("Switch workspace", "switch", <>{[[workspace, "Pro · 8 members"], ["Personal", "Free"]].filter((entry, index, all) => all.findIndex(other => other[0] === entry[0]) === index).map(([name, plan]) => <button type="button" role="menuitemradio" aria-checked={name === workspace} className="ui-as__wsm-item" data-rich="" key={name} onClick={() => menuAction(`Switch workspace: ${name}`)}><span className="ui-as__wsm-label" title={name}><span>{name}</span><small>{plan}</small></span>{name === workspace && <WsGlyph name="check" size={14}/>}</button>)}<span className="ui-as__wsm-sep" role="separator"/>{wsItem("Create workspace", "plus")}</>)}
      </>}
      {menu === "projects" && <><div className="ui-as__menu-label">{labels.projects}</div>{["", ...projectList].map(name => <button type="button" role="menuitemradio" aria-checked={project === name} key={name} onClick={() => { selectProject(name); setMenu(null); anchor.current?.focus(); }}>{name || labels.allProjects}{project === name && <Icon name="check" size={13}/>}</button>)}{addingProject ? <form className="ui-as__project-form" onSubmit={event => { event.preventDefault(); const name = newProject.trim(); if (!name) return; if (!projectList.includes(name)) setProjects([...projectList, name]); setProject(name); setFolders([name]); setMenu(null); setAddingProject(false); setNewProject(""); }}><input autoFocus aria-label={labels.projectName} placeholder={labels.projectName} value={newProject} onChange={event => setNewProject(event.target.value)}/><button type="submit" aria-label={labels.createProject}><Icon name="check" size={14}/></button></form> : <button type="button" role="menuitem" data-divider="" onClick={() => setAddingProject(true)}><Icon name="plus" size={14}/>{labels.newProject}</button>}</>}
      {menu === "account" && <>
        <div className="ui-as__menu-user"><span className="ui-as__user-initials">{userAvatar}</span><span><strong>{user.name}</strong>{user.email && <small>{user.email}</small>}</span></div>
        {wsSub(labels.language, "language", <>{([
          ["English", <><rect width="20" height="14" fill="#012169"/><path d="M0 0 20 14M20 0 0 14" stroke="#fff" strokeWidth="2.8"/><path d="M0 0 20 14M20 0 0 14" stroke="#c8102e"/><path d="M10 0v14M0 7h20" stroke="#fff" strokeWidth="4.2"/><path d="M10 0v14M0 7h20" stroke="#c8102e" strokeWidth="2.4"/></>],
          ["Deutsch", <><rect width="20" height="4.67" fill="#1f1f1f"/><rect y="4.67" width="20" height="4.67" fill="#dd0000"/><rect y="9.33" width="20" height="4.67" fill="#ffce00"/></>],
          ["Français", <><rect width="6.67" height="14" fill="#002395"/><rect x="6.67" width="6.67" height="14" fill="#fff"/><rect x="13.33" width="6.67" height="14" fill="#ed2939"/></>],
          ["Español", <><rect width="20" height="14" fill="#aa151b"/><rect y="3.5" width="20" height="7" fill="#f1bf00"/></>],
        ] as const).map(([label, flag]) => <button type="button" role="menuitemradio" aria-checked={language === label} className="ui-as__wsm-item" key={label} onClick={() => { setLanguage(label); menuAction(`Language: ${label}`); }}><svg className="ui-as__wsm-flag" viewBox="0 0 20 14" aria-hidden="true">{flag}</svg><span className="ui-as__wsm-label">{label}</span>{language === label && <WsGlyph name="check" size={14}/>}</button>)}</>)}
        {wsSub(labels.appearance, "appearance", <>{(["system", "light", "dark"] as const).map(value => <button type="button" role="menuitemradio" aria-checked={theme === value} className="ui-as__wsm-item" key={value} onClick={() => { setTheme(value); setMenu(null); anchor.current?.focus(); }}><WsGlyph name={value}/><span className="ui-as__wsm-label">{labels.theme(value)}</span>{theme === value && <WsGlyph name="check" size={14}/>}</button>)}</>)}
        {wsItem("Integrations", "integrations")}{wsItem("Settings", "settings")}<span className="ui-as__wsm-sep" role="separator"/>
        {wsItem("Download apps", "download")}<span className="ui-as__wsm-sep" role="separator"/>
        {wsItem("Changelog", "changelog")}{wsSub("Learn more", "info", <>{wsItem("Documentation", "docs")}{wsItem("Help & feedback", "help")}</>)}<span className="ui-as__wsm-sep" role="separator"/>
        {wsItem("Log out", "logout")}
      </>}
      {menu === "chat" && currentMenuChat && ([['rename', 'Rename', '⌥⌘R'], ['pin', currentMenuChat.pinned ? 'Unpin' : 'Pin', '⌥⌘P'], ['unread', 'Mark as unread', '⇧⌘U'], ['project', 'Project', '›'], ['share', 'Share', ''], ['copy', 'Copy', ''], ['window', 'Open in new window', ''], ['archive', 'Archive', '⇧⌘A']] as const).map(([action, label, shortcut], index) => <button type="button" role="menuitem" key={action} data-divider={index === 4 || index === 6 || index === 7 || undefined} onClick={() => chatAction(action)}>{labels.action(label)}<kbd>{shortcut}</kbd></button>)}
      {menu === "chat-project" && currentMenuChat && <><div className="ui-as__menu-label">{labels.moveToProject}</div>{["", ...projectList].map(name => <button type="button" role="menuitemradio" aria-checked={(currentMenuChat.project ?? "") === name} key={name} onClick={() => { changeChat(currentMenuChat.id, { project: name || undefined }); setMenu(null); onChatAction?.("project", currentMenuChat.id); }}>{name || labels.noProject}{(currentMenuChat.project ?? "") === name && <Icon name="check" size={13}/>}</button>)}</>}
    </FloatingMenu>}
    {searchOpen && <ShellSearch groups={commandGroups} placeholder="Type a command or search…" onAsk={onAsk} onClose={() => setSearchOpen(false)} onRun={command => { setSearchOpen(false); if (command.onSelect) command.onSelect(); else if (command.id !== "new-chat") onNavigate?.(command.id); }}/>}
    <span className="ui-as__sr" role="status" aria-live="polite">{notice}</span>
  </div>;
}

/* ---------- Styles ---------- */
.ui-as__app[data-header]{grid-template-rows:auto minmax(0,1fr)}.ui-as__header{grid-column:3/-1;grid-row:1;min-width:0}.ui-as__app[data-header]>.ui-as__side,.ui-as__app[data-header]>.ui-as__side+.ui-as__resizer{grid-row:1/-1}.ui-as__app[data-header]>.ui-as__main,.ui-as__app[data-header]>.ui-as__panel,.ui-as__app[data-header]>.ui-as__panel-resizer{grid-row:2}
@container ui-as (max-width:899.99px){.ui-as__header{grid-column:1/-1}}
.ui-as:has(.ui-as__side-col[data-navigation]) .ui-as__main{border-radius:12px;border-left:.5px solid var(--ui-as-line)}
.ui-as__side-col[data-navigation]{background:transparent;box-shadow:none;border-radius:0;margin:0;padding:10px 8px 8px 10px;line-height:1.4286;overflow:hidden}
.ui-as__navigation{display:flex;flex:1;min-height:0;flex-direction:column}.ui-as__nav-head{position:relative;display:flex;align-items:center;justify-content:space-between;gap:4px;height:28px;min-height:28px;margin-bottom:12px}
.ui-as__nav-workspace{display:flex;align-items:center;gap:6px;min-width:0;max-width:100%;height:30px;padding:0 6px;border-radius:8px;text-align:left}.ui-as__nav-workspace:hover,.ui-as__account-row:hover{background:rgba(0,0,0,.03)}
.ui-as__nav-workspace>span{display:grid;place-items:center;flex:none;width:18px;height:18px;margin-right:1px;background:var(--ui-as-card);border-radius:5px;box-shadow:0 0 0 .5px rgba(0,0,0,.08),0 1px 1px rgba(0,0,0,.12);font-size:10.5px;font-weight:500;transition:opacity 140ms ease}.ui-as__nav-workspace>strong{font-size:14px;font-weight:500;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ui-as__nav-workspace>svg{color:var(--ui-as-muted)}
.ui-as__nav-search{display:flex;align-items:center;flex:none;gap:8px;width:100%;height:30px;border-radius:8px!important;padding:0 6px 0 8px!important;background:var(--ui-as-card)!important;box-shadow:0 0 0 .5px var(--ui-as-line);color:var(--ui-as-muted)!important;margin-bottom:12px;text-align:left;font-size:13px!important}.ui-as__nav-search>span{flex:1}.ui-as__nav-search kbd{font:10px/1.4 inherit;font-family:inherit;border:.5px solid var(--ui-as-line);padding:1px 3px;border-radius:3px;color:var(--ui-as-faint)}
.ui-as__nav-items{overflow:auto;min-height:0}.ui-as__nav-item{display:flex;align-items:center;gap:8px;width:100%;height:30px;border-radius:7px;text-align:left;padding:0 8px!important;color:var(--ui-as-text)!important}.ui-as__nav-item:hover,.ui-as__nav-item[aria-current="page"]{background:var(--ui-as-fill)!important;color:var(--ui-as-ink)!important}.ui-as__nav-icon{display:flex;color:var(--ui-as-muted)}.ui-as__nav-item>small{font-size:11px;color:var(--ui-as-faint);font-variant-numeric:tabular-nums;margin-left:auto}.ui-as__nav-section{font-size:12px;color:var(--ui-as-faint);padding:18px 8px 4px}
.ui-as__side-col[data-navigation] .ui-as__account-row{flex:none;height:34px;min-height:34px;padding:0 6px;gap:7px;border-radius:8px;font-size:13px!important;font-weight:500;margin-top:auto}.ui-as__side-col[data-navigation] .ui-as__user-initials{width:21px;height:21px;font-size:9px;color:var(--ui-as-accent);background:rgba(0,96,226,.08)}.ui-as__side-col[data-navigation] .ui-as__account-row>svg{color:var(--ui-as-faint)}
.ui-as .ui-as__nav-workspace:active:not(:disabled),.ui-as .ui-as__account-row:active:not(:disabled),.ui-as .ui-as__wsm-item:active:not(:disabled){transform:none}
.ui-as[data-sidebar-collapsed] .ui-as__app{grid-template-columns:0 0 minmax(0,1fr) 0 0;padding-left:8px}.ui-as[data-sidebar-collapsed][data-panel-open] .ui-as__app{grid-template-columns:0 0 minmax(0,1fr) 4px var(--ui-as-panel-width)}.ui-as[data-sidebar-collapsed] .ui-as__side{visibility:hidden;pointer-events:none}.ui-as[data-sidebar-collapsed] .ui-as__main{border-radius:12px}.ui-as[data-sidebar-collapsed] .ui-as__open-side{display:grid}.ui-as[data-sidebar-collapsed] .ui-as__side+.ui-as__resizer{visibility:hidden}
@container ui-as (min-width:900px){
  .ui-as[data-navigation] .ui-as__app{transition-duration:420ms}.ui-as[data-navigation] .ui-as__side{overflow:hidden}.ui-as[data-navigation] .ui-as__side-col{flex:none;width:var(--ui-as-sidebar-width)}
  .ui-as[data-navigation][data-sidebar-collapsed] .ui-as__app{grid-template-columns:48px 0 minmax(0,1fr) 0 0;padding-left:0}.ui-as[data-navigation][data-sidebar-collapsed][data-panel-open] .ui-as__app{grid-template-columns:48px 0 minmax(0,1fr) 4px var(--ui-as-panel-width)}
  .ui-as[data-navigation][data-sidebar-collapsed] .ui-as__side{visibility:visible;pointer-events:auto}.ui-as[data-navigation][data-sidebar-collapsed] .ui-as__open-side{display:none}
  .ui-as[data-navigation][data-sidebar-collapsed] :is(.ui-as__nav-workspace>strong,.ui-as__nav-workspace>svg,.ui-as__nav-search>span,.ui-as__nav-search>kbd,.ui-as__nav-item>span:not(.ui-as__nav-icon),.ui-as__nav-item>small,.ui-as__account-row>span:nth-child(2),.ui-as__account-row>svg){display:none}
  .ui-as[data-navigation][data-sidebar-collapsed] :is(.ui-as__nav-workspace,.ui-as__nav-search,.ui-as__nav-item,.ui-as__account-row){width:fit-content}
  .ui-as[data-navigation][data-sidebar-collapsed] .ui-as__nav-search{padding-right:8px!important}
  .ui-as[data-navigation][data-sidebar-collapsed] .ui-as__nav-section{color:transparent;white-space:nowrap;overflow:hidden;background:linear-gradient(var(--ui-as-line),var(--ui-as-line)) 0 50% / 28px .5px no-repeat}
  .ui-as[data-navigation][data-sidebar-collapsed] .ui-as__nav-head>.ui-as__icon-btn{position:absolute;top:0;left:0;width:30px;opacity:0;transition:opacity 140ms ease}
  .ui-as[data-navigation][data-sidebar-collapsed]:has(.ui-as__side:hover,.ui-as__nav-head :focus-visible) .ui-as__nav-head>.ui-as__icon-btn{opacity:1}
  .ui-as[data-navigation][data-sidebar-collapsed]:has(.ui-as__side:hover,.ui-as__nav-head :focus-visible) .ui-as__nav-workspace>span{opacity:0}
}
@container ui-as (max-width:899.99px){.ui-as[data-sidebar-collapsed] .ui-as__app,.ui-as[data-sidebar-collapsed][data-panel-open] .ui-as__app{grid-template-columns:minmax(0,1fr)}.ui-as[data-sidebar-open] .ui-as__side{visibility:visible;pointer-events:auto}.ui-as .ui-as__side-col[data-navigation]{padding:8px}}
@media(pointer:coarse){.ui-as__nav-item,.ui-as__nav-search{min-height:36px}}
.ui-as{--ui-as-page:#f8f8f8;--ui-as-card:#fff;--ui-as-side:#fcfcfc;--ui-as-ink:rgba(0,0,0,.88);--ui-as-text:rgba(0,0,0,.61);--ui-as-muted:rgba(0,0,0,.45);--ui-as-faint:rgba(0,0,0,.27);--ui-as-line:rgba(0,0,0,.06);--ui-as-fill:rgba(0,0,0,.04);--ui-as-accent:#0060e2;--ui-as-focus:rgba(0,96,226,.35);--ui-as-ease:cubic-bezier(.22,1,.36,1);--ui-as-shadow:0 0 0 .5px rgba(0,0,0,.08),0 12px 28px -10px rgba(0,0,0,.16),0 1px 2px rgba(0,0,0,.05);width:100%;height:100%;min-height:400px;position:relative;container:ui-as / inline-size;overflow:hidden;background:var(--ui-as-page);color:var(--ui-as-ink);font:13px/1.5 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
.ui-as,.ui-as *,.ui-as *::before,.ui-as *::after{box-sizing:border-box}.ui-as button,.ui-as input{font:inherit;color:inherit}.ui-as button{cursor:pointer;border:0;background:none}.ui-as button:disabled{opacity:.4;cursor:default}.ui-as button:active:not(:disabled){transform:scale(.97)}.ui-as button:focus-visible,.ui-as input:focus-visible,.ui-as [role="separator"]:focus-visible{outline:2px solid var(--ui-as-focus);outline-offset:-2px}.ui-as__app{display:grid;grid-template-columns:calc(var(--ui-as-sidebar-width) + var(--ui-as-rail-width)) 0 minmax(0,1fr) 0 0;height:100%;padding:8px 8px 8px 0;transition:grid-template-columns 400ms var(--ui-as-ease)}.ui-as[data-panel-open] .ui-as__app{grid-template-columns:calc(var(--ui-as-sidebar-width) + var(--ui-as-rail-width)) 0 minmax(0,1fr) 4px var(--ui-as-panel-width)}.ui-as[data-dragging] .ui-as__app{transition:none}.ui-as__side{display:flex;min-width:0;min-height:0;margin-block:-8px;position:relative}.ui-as__rail{display:flex;flex-direction:column;align-items:center;gap:2px;width:52px;flex:none;padding:12px 0 16px}.ui-as__logo{display:grid;place-items:center;width:30px;height:30px;margin-bottom:10px;background:var(--ui-as-card)!important;border-radius:10px;box-shadow:0 0 0 .5px var(--ui-as-line),0 1px 2px rgba(0,0,0,.03);font-size:12px!important;font-weight:500!important}.ui-as__rail-line{height:.5px;width:20px;background:var(--ui-as-line);margin:0 0 6px}.ui-as__rail-item{display:grid;place-items:center;position:relative;flex:none;width:34px;height:34px;margin-bottom:0;border-radius:10px;color:var(--ui-as-muted)!important}.ui-as__rail-item:hover,.ui-as__rail-item[aria-current="page"]{background:var(--ui-as-fill);color:var(--ui-as-ink)!important}.ui-as__rail-space{flex:1}.ui-as__notification-dot{position:absolute;right:6px;top:7px;width:5px;height:5px;border-radius:50%;background:var(--ui-as-accent);box-shadow:0 0 0 2px var(--ui-as-page)}.ui-as__user{display:grid;place-items:center;width:24px;height:24px;margin-top:6px;border-radius:50%;font-size:9px!important;font-weight:500!important;color:var(--ui-as-accent)!important;background:rgba(0,96,226,.08)!important;overflow:hidden}.ui-as__user img{width:100%;height:100%;object-fit:cover}.ui-as__side-col{display:flex;flex-direction:column;flex:1;min-width:0;margin-block:8px;border-radius:12px 0 0 12px;box-shadow:0 0 0 .5px var(--ui-as-line);background:var(--ui-as-side);padding:8px 10px;overflow:hidden}.ui-as__side-head{display:flex;align-items:center;min-height:32px;gap:4px;padding-left:6px}.ui-as__project{display:flex;align-items:center;gap:5px;min-width:0;flex:1;height:30px;text-align:left;font-weight:500!important;padding:0}.ui-as__project>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-as__project>svg{color:var(--ui-as-muted)}.ui-as__icon-btn{display:grid;place-items:center;width:28px;height:28px;flex:none;color:var(--ui-as-muted)!important;border-radius:6px}.ui-as__icon-btn:hover{background:var(--ui-as-fill)}.ui-as__chat-nav{overflow:auto;min-height:0;flex:1;margin-inline:-1px;padding-top:12px;scrollbar-width:thin;scrollbar-color:var(--ui-as-line) transparent}.ui-as__new-chat{display:flex;align-items:center;gap:8px;width:100%;height:30px;padding:0 7px;text-align:left;color:var(--ui-as-text)!important;border-radius:7px}.ui-as__new-chat:hover{background:var(--ui-as-fill)}.ui-as__new-chat svg{color:var(--ui-as-muted)}.ui-as__group{margin-top:12px}.ui-as__group h2{font-size:12px;font-weight:400;color:var(--ui-as-faint);padding:0 7px;margin:0 0 4px;line-height:20px}.ui-as__chat-row{position:relative;display:flex;align-items:center;min-height:30px;border-radius:7px;color:var(--ui-as-text)}.ui-as__chat-row[data-active],.ui-as__chat-row:hover{background:var(--ui-as-fill)}.ui-as__chat-row[data-active]{color:var(--ui-as-ink)}.ui-as__chat-link{display:flex;align-items:center;gap:6px;min-width:0;width:100%;height:30px;padding:0 7px;text-align:left}.ui-as__chat-link>span{min-width:0;white-space:nowrap;overflow:hidden;text-