  const wsItem = (label: string, icon: keyof typeof wsGlyphs) => <button type="button" role="menuitem" className="ui-as__wsm-item" key={label} onClick={() => menuAction(label)}><WsGlyph name={icon}/><span className="ui-as__wsm-label" title={label}>{labels.action(label)}</span></button>;
  const wsSub = (label: string, icon: keyof typeof wsGlyphs, items: ReactNode) => <span className="ui-as__wsm-sub" data-open={wsOpen === label || undefined}><button type="button" role="menuitem" aria-haspopup="menu" aria-expanded={wsOpen === label} className="ui-as__wsm-item" onClick={() => setWsOpen(wsOpen === label ? null : label)} onKeyDown={event => { if (event.key === "ArrowRight") { event.preventDefault(); const panel = event.currentTarget.nextElementSibling; setWsOpen(label); requestAnimationFrame(() => panel?.querySelector<HTMLElement>("button")?.focus()); } }}><WsGlyph name={icon}/><span className="ui-as__wsm-label" title={label}>{labels.action(label)}</span><WsGlyph name="next" size={14}/></button><span className="ui-as__wsm-panel" role="menu" aria-label={label} onKeyDown={event => { event.stopPropagation(); if (event.key === "ArrowLeft") { event.preventDefault(); setWsOpen(null); (event.currentTarget.previousElementSibling as HTMLElement | null)?.focus(); } else moveMenuFocus(event); }}>{items}</span></span>;
  const commandGroups: CommandMenuGroup[] = commandGroupsProp ?? (navigation ? [{ id: "workspace", label: labels.workspace, commands: navigation.map(item => ({ id: `navigate:${item.label}`, label: item.label, icon: item.icon, disabled: item.disabled, onSelect: () => navigate(item.label) })) }] : [...defaultCommands, { id: "go-to", label: labels.goTo, commands: [{ id: "new-chat", label: labels.newChat, onSelect: onNewChat }, ...projectList.map(name => ({ id: `project:${name}`, label: name, onSelect: () => { setProject(name); setFolders([name]); } })), ...list.map(chat => ({ id: `chat:${chat.id}`, label: chat.title, onSelect: () => openChat(chat) }))] }]);
  return <div {...rest} ref={root} className={["ui-as", className].filter(Boolean).join(" ")} data-overlay-boundary="" data-theme={theme === "system" ? systemDark ? "dark" : undefined : theme} data-layout={layout === "flat" ? "flat" : "inset"} data-rail={!!rail || undefined} data-navigation={iconSidebar || undefined} data-sidebar-open={sidebarOpen || undefined} data-sidebar-collapsed={collapsed || undefined} data-panel-open={visiblePanel || undefined} data-dragging={dragging || undefined} style={{ "--ui-as-sidebar-width": `${clamp(safeNumber(sidebarWidth, 272), sidebarBounds.min, sidebarBounds.max)}px`, "--ui-as-panel-width": `${clamp(safeNumber(panelWidth, 455), panelBounds.min, panelBounds.max)}px`, "--ui-as-rail-width": `${railWidth}px`, ...style } as CSSProperties} onKeyDown={onKeyDown}>
    <style href="ui-app-shell" precedence="default">{css}</style>
