function WsGlyph({ name, size = 15 }: { name: keyof typeof wsGlyphs; size?: number }) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{wsGlyphs[name]}</svg>;
}
const assistantSpark = <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="ui-as-spark" x1="0" y1="0" x2="1" y2="1"><stop stopColor="#7C5CFF"/><stop offset="1" stopColor="#2F9BFF"/></linearGradient></defs><path fill="url(#ui-as-spark)" d="M12 2.5c.6 3.9 2.1 6.4 4.4 7.6 1.1.6 2.4.9 4.1 1.1v1.6c-4.6.6-7.3 3-8.5 8.7h-1.6c-.6-3.9-2.1-6.4-4.4-7.6-1.1-.6-2.4-.9-4.1-1.1v-1.6c4.6-.6 7.3-3 8.5-8.7z"/></svg>;
const foldText = (text: string) => text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
function SearchMatch({ text, query }: { text: string; query: string }) {
  const folded = foldText(text), needle = foldText(query), at = needle && folded.length === text.length ? folded.indexOf(needle) : -1;
  return at < 0 ? <>{text}</> : <>{text.slice(0, at)}<mark>{text.slice(at, at + needle.length)}</mark>{text.slice(at + needle.length)}</>;
}

/** The shell's ⌘K search: grouped commands with a sliding highlight, Tab between groups and an optional “Ask assistant” row. The first five visible “suggestions” run with Mod+1–5. */
function ShellSearch({ groups, placeholder, onRun, onAsk, onClose }: { groups: CommandMenuGroup[]; placeholder: string; onRun: (command: CommandMenuItem) => void; onAsk?: (query: string) => void; onClose: () => void }) {
  const [query, setQuery] = useState(""), [selectedKey, setSelectedKey] = useState<string | null>(null), [lit, setLit] = useState(true);
  const [pill, setPill] = useState<{ y: number; h: number } | null>(null), [height, setHeight] = useState(0);
  const input = useRef<HTMLInputElement>(null), list = useRef<HTMLDivElement>(null), inner = useRef<HTMLDivElement>(null), reveal = useRef(false), id = useId();
  const mod = typeof navigator !== "undefined" && /Mac|iPhone|iPad/.test(navigator.platform) ? "⌘" : "Ctrl";
  const q = query.trim(), needle = foldText(q);
  const shown: { id: string; label: string; commands: (CommandMenuItem & { key: string })[] }[] = (Array.isArray(groups) ? groups : []).filter(Boolean).map(group => ({ ...group, commands: (Array.isArray(group.commands) ? group.commands : []).filter(command => command && (!needle || foldText(`${command.label} ${command.description ?? ""} ${command.keywords ?? ""}`).includes(needle))).map((command, index) => ({ ...command, key: `${group.id}:${command.id}`, shortcut: group.id === "suggestions" && index < 5 ? `⌘ ${index + 1}` : command.shortcut })) })).filter(group => group.commands.length);
  if (q && onAsk) shown.unshift({ id: "ask", label: "Assistant", commands: [{ id: "ask", key: "ask", label: `Ask assistant about “${q}”`, logo: assistantSpark, onSelect: () => onAsk(q) }] });
  const flat = shown.flatMap(group => group.commands).filter(command => !command.disabled);
  const selected = flat.find(command => command.key === selectedKey) ?? flat[0];
  useEffect(() => {
    const previous = document.activeElement as HTMLElement | null;
    input.current?.focus({ preventScroll: true });
    return () => { if (previous?.isConnected) previous.focus({ preventScroll: true }); };
  }, []);
  useLayoutEffect(() => {
    const box = list.current, row = box?.querySelector<HTMLElement>(`[data-key="${CSS.escape(selected?.key ?? "")}"]`);
    if (!box || !row) { setPill(null); return; }
    setPill({ y: row.offsetTop, h: row.offsetHeight });
    if (!reveal.current) return; reveal.current = false;
    const label = row.previousElementSibling?.classList.contains("ui-as__cmd-label") ? (row.previousElementSibling as HTMLElement).offsetHeight : 0;
    const top = row.offsetTop - 8 - label, bottom = row.offsetTop + row.offsetHeight + 8;
    if (top < box.scrollTop) box.scrollTop = top; else if (bottom > box.scrollTop + box.clientHeight) box.scrollTop = bottom - box.clientHeight;
  }, [selected?.key, flat.length]);
  useLayoutEffect(() => {
    const box = list.current, content = inner.current; if (!box || !content) return;
    const measure = () => { const style = getComputedStyle(box); setHeight(Math.min(content.offsetHeight + parseFloat(style.paddingTop) + parseFloat(style.paddingBottom), parseFloat(style.maxHeight) || Infinity)); };
    measure(); const observer = new ResizeObserver(measure); observer.observe(content); return () => observer.disconnect();
  }, []);
  const move = (step: number) => { if (!flat.length || !selected) return; reveal.current = true; setLit(true); const target = flat[(flat.indexOf(selected) + step + flat.length) % flat.length]; if (target) setSelectedKey(target.key); };
  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") { event.preventDefault(); move(event.key === "ArrowDown" ? 1 : -1); }
    else if (event.key === "Enter" && selected) { event.preventDefault(); onRun(selected); }
    else if (event.key === "Tab") {
      event.preventDefault(); if (shown.length < 2) return;
      const current = shown.findIndex(group => group.commands.some(command => command.key === selected?.key));
      const next = event.shiftKey ? current <= 0 ? shown.length - 1 : current - 1 : (current + 1) % shown.length;
      const target = shown[next]?.commands.find(command => !command.disabled); if (target) { reveal.current = true; setLit(true); setSelectedKey(target.key); }
    } else if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); if (query) { setQuery(""); setSelectedKey(null); } else onClose(); }
    else if ((event.metaKey || event.ctrlKey) && /^[1-9]$/.test(event.key)) { const command = flat.find(item => item.shortcut?.split(" ").at(-1) === event.key); if (command) { event.preventDefault(); onRun(command); } }
  };
  return <div className="ui-as__cmd" role="dialog" aria-modal="true" aria-label="Search" onPointerDown={event => { if (event.target === event.currentTarget) onClose(); }}>
    <div className="ui-as__cmd-card">
      <label className="ui-as__cmd-search"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7.25" cy="7.25" r="4.75"/><path d="m13.5 13.5-2.9-2.9"/></svg>
        <input ref={input} value={query} dir="auto" placeholder={placeholder} aria-label="Search commands" role="combobox" aria-expanded="true" aria-controls={`${id}-list`} aria-activedescendant={selected ? `${id}-${selected.key}` : undefined} onChange={event => { setQuery(event.target.value); setSelectedKey(null); }} onKeyDown={onKeyDown}/>
        <kbd className="ui-as__cmd-enter" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M12.5 4v3a2 2 0 0 1-2 2h-7M6 6.5 3.5 9 6 11.5"/></svg></kbd>
      </label>
      <div ref={list} id={`${id}-list`} className="ui-as__cmd-list" role="listbox" aria-label="Commands" style={height ? { height } : undefined} onMouseLeave={() => setLit(false)}>
        {pill && <span className="ui-as__cmd-pill" data-lit={lit || undefined} style={{ transform: `translateY(${pill.y}px)`, height: pill.h }} aria-hidden="true"/>}
        <div ref={inner}>
          {shown.map(group => <div role="group" aria-label={group.label} className="ui-as__cmd-group" key={group.id}>
            {group.id !== "ask" && group.label && <span className="ui-as__cmd-label" dir="auto">{group.label}</span>}
            {group.commands.map(command => { const keys = command.shortcut?.split(" ").filter(Boolean).map(key => key === "⌘" ? mod : key); return <button type="button" role="option" tabIndex={-1} id={`${id}-${command.key}`} data-key={command.key} aria-selected={command.key === selected?.key} disabled={command.disabled} className="ui-as__cmd-item" key={command.key} onMouseMove={() => { setLit(true); if (command.key !== selected?.key && !command.disabled) setSelectedKey(command.key); }} onClick={() => onRun(command)}>
              <span className={command.logo ? "ui-as__cmd-logo" : "ui-as__cmd-icon"}>{command.logo ?? command.icon ?? <Icon name={command.id.startsWith("chat:") ? "chat" : command.id.startsWith("project:") ? "folder" : command.id === "new-chat" ? "compose" : "document"}/>}</span>
              <span className="ui-as__cmd-text"><span className="ui-as__cmd-name" dir="auto" title={command.label}><SearchMatch text={command.label} query={q}/></span>{command.description && <span className="ui-as__cmd-hint" dir="auto" title={command.description}><SearchMatch text={command.description} query={q}/></span>}</span>
              {keys?.length ? <span className="ui-as__cmd-keys" aria-hidden="true">{keys.map((key, index) => <kbd key={index}>{key}</kbd>)}</span> : null}
            </button>; })}
          </div>)}
          {!flat.length && <p className="ui-as__cmd-empty" role="status">No results for “{q}”</p>}
        </div>
      </div>
      <footer className="ui-as__cmd-foot"><span><kbd>Tab</kbd> to jump between sections</span><span><span className="ui-as__cmd-keys"><kbd>{mod}</kbd><kbd>K</kbd></span>to open</span></footer>
    </div>
  </div>;
}

/** A resizable application shell with optional icon rail, project/chat navigation and an artifact panel. */
export function AppShell({ sidebar: sidebarContent, header, labels: labelsProp, workspace = "Fieldwork", user = { name: "Alex Morgan", email: "alex@fieldwork.com" }, rail = false, active: activeProp, defaultActive = "Chats", onActiveChange, onNavigate, navigation, commands: commandGroupsProp, onAsk, globalShortcut = true, sidebarCollapsed: collapsedProp, defaultSidebarCollapsed = false, onSidebarCollapsedChange, chats: chatsProp, defaultChats: initialChats = defaultChats, onChatsChange, activeChat: activeChatProp, defaultActiveChat = "fabric", onOpenChat, onNewChat, onChatAction, projects: projectsProp, defaultProjects = defaultChatProjects, onProjectsChange, project: projectProp, defaultProject = "", onProjectChange, sidebarWidth: sidebarWidthProp, defaultSidebarWidth = 272, onSidebarWidthChange, sidebarBounds = { min: 200, max: 420 }, sidebarOpen: sidebarOpenProp, defaultSidebarOpen = false, onSidebarOpenChange, panel, panelTitle: panelTitleProp, panelOpen: panelOpenProp, defaultPanelOpen = true, onPanelOpenChange, panelWidth: panelWidthProp, defaultPanelWidth = 455, onPanelWidthChange, panelBounds = { min: 300, max: 640 }, theme: themeProp, defaultTheme = "system", onThemeChange, layout = "inset", children, className, onKeyDown, style, ...rest }: AppShellProps) {
  const labels = { ...defaultAppShellLabels, ...labelsProp };
  const panelTitle = panelTitleProp ?? labels.panelTitle;
  const [collapsed, setCollapsed] = useControllable(collapsedProp, defaultSidebarCollapsed, onSidebarCollapsedChange);
  const [chats, setChats] = useControllable(chatsProp, initialChats, onChatsChange);
  const [projects, setProjects] = useControllable(projectsProp, defaultProjects, onProjectsChange);
  const [project, setProject] = useControllable(projectProp, defaultProject, onProjectChange);
  const [activeChat, setActiveChat] = useControllable(activeChatProp, defaultActiveChat, onOpenChat);
  const [active, setActive] = useControllable(activeProp, defaultActive, onActiveChange);
  const [sidebarWidthValue, setSidebarWidth] = useControllable(sidebarWidthProp, defaultSidebarWidth, onSidebarWidthChange);
  const [panelWidthValue, setPanelWidth] = useControllable(panelWidthProp, defaultPanelWidth, onPanelWidthChange);
  const sidebarWidth = clamp(safeNumber(sidebarWidthValue, 272), sidebarBounds.min, sidebarBounds.max);
  const panelWidth = clamp(safeNumber(panelWidthValue, 455), panelBounds.min, panelBounds.max);
  const [sidebarOpen, setSidebarOpen] = useControllable(sidebarOpenProp, defaultSidebarOpen, onSidebarOpenChange);
  const [panelOpen, setPanelOpen] = useControllable(panelOpenProp, defaultPanelOpen, onPanelOpenChange);
  const [theme, setTheme] = useControllable(themeProp, defaultTheme, onThemeChange);
  const [systemDark, setSystemDark] = useState(false), [narrow, setNarrow] = useState(false), [searchOpen, setSearchOpen] = useState(false);
  const [folders, setFolders] = useState<string[]>(["Summer collection"]);
  const [menu, setMenu] = useState<"workspace" | "account" | "projects" | "chat" | "chat-project" | null>(null);
  const [wsOpen, setWsOpen] = useState<string | null>(null);
  useEffect(() => setWsOpen(null), [menu]);
  const [menuChat, setMenuChat] = useState<string | null>(null), [renaming, setRenaming] = useState<string | null>(null), [renameValue, setRenameValue] = useState("");
  const [addingProject, setAddingProject] = useState(false), [newProject, setNewProject] = useState("");
  const [language, setLanguage] = useState("English"), [notice, setNotice] = useState(""), [brokenAvatar, setBrokenAvatar] = useState(false), [dragging, setDragging] = useState(false);
  const root = useRef<HTMLDivElement>(null), sidebar = useRef<HTMLElement>(null), panelRef = useRef<HTMLElement>(null), anchor = useRef<HTMLElement>(null), renameRef = useRef<HTMLInputElement>(null), sideOpenRef = useRef<HTMLButtonElement>(null), panelOpenRef = useRef<HTMLButtonElement>(null);
  const cleanupDrag = useRef<(() => void) | null>(null), narrowRef = useRef<boolean | null>(null);
  const id = useId();
  const list = (Array.isArray(chats) ? chats : []).filter(Boolean), projectList = (Array.isArray(projects) ? projects : []).filter(Boolean);
  const shown = project ? list.filter(chat => chat.project === project) : list;
  const currentMenuChat = list.find(chat => chat.id === menuChat);
  const hasPanel = panel != null, railWidth = rail ? 52 : 0;
  const iconSidebar = !!navigation && !rail && sidebarContent === undefined;
  const userAvatar = user.avatar && !brokenAvatar ? <img src={user.avatar} alt="" onError={() => setBrokenAvatar(true)}/> : initials(user.name);
  const visiblePanel = hasPanel && panelOpen;
  const drawer = narrow && (sidebarOpen || visiblePanel);
  useEffect(() => { const query = window.matchMedia("(prefers-color-scheme: dark)"); const update = () => setSystemDark(query.matches); update(); query.addEventListener("change", update); return () => query.removeEventListener("change", update); }, []);
  useEffect(() => setBrokenAvatar(false), [user.avatar]);
  useLayoutEffect(() => {
    const el = root.current; if (!el) return;
    const observer = new ResizeObserver(([entry]) => {
      if (!entry) return;
      const next = entry.contentRect.width < 900;
      if (next !== narrowRef.current) { narrowRef.current = next; setNarrow(next); if (next) { setPanelOpen(false); setSidebarOpen(false); } }
    }); observer.observe(el); return () => observer.disconnect();
  }, []);
  useEffect(() => { if (renaming) { renameRef.current?.focus(); renameRef.current?.select(); } }, [renaming]);
  useEffect(() => { if (!notice) return; const timer = window.setTimeout(() => setNotice(""), 2500); return () => window.clearTimeout(timer); }, [notice]);
  useEffect(() => () => cleanupDrag.current?.(), []);
  const live = useRef({ narrow, sidebarOpen, panelOpen, root: root.current }); live.current = { narrow, sidebarOpen, panelOpen, root: root.current };
  const closeDrawer = () => { if (sidebarOpen) { setSidebarOpen(false); sideOpenRef.current?.focus(); } else { setPanelOpen(false); panelOpenRef.current?.focus(); } };
  const closeDrawerRef = useRef(closeDrawer); closeDrawerRef.current = closeDrawer;
  useEffect(() => {
    const key = (event: globalThis.KeyboardEvent) => {
      const state = live.current;
      const inside = state.root?.contains(document.activeElement) || document.activeElement === document.body;
      if (!inside || event.defaultPrevented) return;
      if (globalShortcut && (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") { event.preventDefault(); setSearchOpen(open => !open); }
      if (event.key === "Escape" && state.narrow && (state.sidebarOpen || state.panelOpen)) { event.preventDefault(); closeDrawerRef.current(); }
    }; document.addEventListener("keydown", key); return () => document.removeEventListener("keydown", key);
  }, [globalShortcut]);
  useEffect(() => {
    if (!drawer) return;
    const area = sidebarOpen ? sidebar.current : panelRef.current;
    const previous = document.activeElement as HTMLElement | null;
    const focusable = 'a[href],button:not(:disabled),input:not(:disabled),textarea:not(:disabled),select:not(:disabled),[tabindex="0"]';
    area?.querySelector<HTMLElement>(focusable)?.focus({ preventScroll: true });
    const trap = (event: globalThis.KeyboardEvent) => {
      if (event.key !== "Tab" || menu || searchOpen) return;
      const items = [...(area?.querySelectorAll<HTMLElement>(focusable) ?? [])].filter(item => item.tabIndex >= 0 && !item.closest("[inert],[hidden]") && item.getClientRects().length && getComputedStyle(item).visibility !== "hidden");
      const first = items[0], last = items.at(-1); if (!first) return;
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }; document.addEventListener("keydown", trap);
    return () => { document.removeEventListener("keydown", trap); if (previous?.isConnected) previous.focus({ preventScroll: true }); };
  }, [drawer, sidebarOpen]);
  const navigate = (label: string) => { setActive(label); onNavigate?.(label); if (narrow) setSidebarOpen(false); };
  const openChat = (chat: AppChat) => { setActiveChat(chat.id); if (chat.project && !folders.includes(chat.project)) setFolders([...folders, chat.project]); if (project && chat.project !== project) setProject(chat.project ?? ""); if (chat.unread) setChats(list.map(item => item.id === chat.id ? { ...item, unread: false } : item)); if (narrow) setSidebarOpen(false); };
  const selectProject = (name: string) => { setProject(name); if (name) setFolders([name]); else { const activeProject = list.find(chat => chat.id === activeChat)?.project; if (activeProject && !folders.includes(activeProject)) setFolders([...folders, activeProject]); } };
  const trigger = (kind: NonNullable<typeof menu>, chatId?: string) => ({
    onClick: (event: ReactMouseEvent<HTMLButtonElement>) => { anchor.current = event.currentTarget; setMenuChat(chatId ?? null); setMenu(menu === kind && menuChat === (chatId ?? null) ? null : kind); setAddingProject(false); },
    onKeyDown: (event: KeyboardEvent<HTMLButtonElement>) => { if (event.key === "ArrowDown" || event.key === "ArrowUp") { event.preventDefault(); anchor.current = event.currentTarget; setMenuChat(chatId ?? null); setMenu(kind); } },
  });
  const changeChat = (id: string, patch: Partial<AppChat>) => setChats(list.map(chat => chat.id === id ? { ...chat, ...patch } : chat));
  const pinChat = (chat: AppChat) => { changeChat(chat.id, { pinned: !chat.pinned }); onChatAction?.(chat.pinned ? "unpin" : "pin", chat.id); };
  const rename = () => { if (renaming && renameValue.trim()) { changeChat(renaming, { title: renameValue.trim() }); onChatAction?.("rename", renaming); } setRenaming(null); };
  const chatAction = (action: string) => {
    const chat = currentMenuChat; if (!chat) return;
    if (action === "rename") { setRenaming(chat.id); setRenameValue(chat.title); }
    else if (action === "pin") pinChat(chat);
    else if (action === "unread") changeChat(chat.id, { unread: true });
    else if (action === "project") { setMenu("chat-project"); return; }
    else if (action === "archive") { const remaining = list.filter(item => item.id !== chat.id); setChats(remaining); if (activeChat === chat.id) setActiveChat(remaining[0]?.id ?? ""); }
    else if (action === "copy") { navigator.clipboard?.writeText(chat.title).then(() => setNotice(labels.copied)).catch(() => setNotice(labels.copyFailed)); }
    if (action !== "rename" && action !== "pin") onChatAction?.(action, chat.id); setMenu(null); anchor.current?.focus({ preventScroll: true });
  };
  const resize = (edge: "sidebar" | "panel", event: ReactPointerEvent<HTMLDivElement>) => {
    event.preventDefault(); const target = event.currentTarget, start = event.clientX;
    const initial = edge === "sidebar" ? safeNumber(sidebarWidth, 272) : safeNumber(panelWidth, 455);
    const previousCursor = document.body.style.cursor, previousSelect = document.body.style.userSelect;
    target.setPointerCapture(event.pointerId); document.body.style.cursor = "col-resize"; document.body.style.userSelect = "none"; setDragging(true);
    const move = (event: PointerEvent) => { const width = root.current?.clientWidth ?? 1600; const value = initial + (event.clientX - start) * (edge === "sidebar" ? 1 : -1); if (edge === "sidebar") setSidebarWidth(clamp(value, sidebarBounds.min, Math.max(sidebarBounds.min, Math.min(sidebarBounds.max, width - railWidth - (visiblePanel ? panelWidth : 0) - 280)))); else setPanelWidth(clamp(value, panelBounds.min, Math.max(panelBounds.min, Math.min(panelBounds.max, width - sidebarWidth - railWidth - 280)))); };
    const stop = () => { target.removeEventListener("pointermove", move); target.removeEventListener("pointerup", stop); target.removeEventListener("pointercancel", stop); document.body.style.cursor = previousCursor; document.body.style.userSelect = previousSelect; setDragging(false); cleanupDrag.current = null; };
    cleanupDrag.current?.(); cleanupDrag.current = stop; target.addEventListener("pointermove", move); target.addEventListener("pointerup", stop); target.addEventListener("pointercancel", stop);
  };
  const resizeKey = (edge: "sidebar" | "panel", event: KeyboardEvent<HTMLDivElement>) => {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
    event.preventDefault(); const value = edge === "sidebar" ? sidebarWidth : panelWidth;
    const bounds = edge === "sidebar" ? sidebarBounds : panelBounds;
    const next = event.key === "Home" ? bounds.min : event.key === "End" ? bounds.max : value + (event.key === "ArrowRight" ? 10 : -10) * (edge === "panel" ? -1 : 1);
    if (edge === "sidebar") setSidebarWidth(clamp(next, bounds.min, bounds.max)); else setPanelWidth(clamp(next, bounds.min, bounds.max));
  };
  const row = (chat: AppChat, nested = false) => <div className="ui-as__chat-row" key={chat.id} data-active={chat.id === activeChat || undefined} data-nested={nested || undefined}>
    {renaming === chat.id ? <input ref={renameRef} className="ui-as__rename" aria-label={labels.chatName} value={renameValue} onChange={event => setRenameValue(event.target.value)} onBlur={rename} onKeyDown={event => { if (event.key === "Enter") rename(); if (event.key === "Escape") { event.stopPropagation(); setRenaming(null); } }}/> : <button type="button" className="ui-as__chat-link" aria-current={chat.id === activeChat ? "page" : undefined} title={chat.title} onClick={() => openChat(chat)}><span dir="auto">{chat.title}</span>{chat.unread && <i className="ui-as__unread" aria-label={labels.unread}/>}</button>}
    <span className="ui-as__chat-tools"><button type="button" aria-label={labels.options(chat.title)} aria-haspopup="menu" aria-expanded={menu === "chat" && menuChat === chat.id} aria-controls={menu === "chat" && menuChat === chat.id ? `${id}-menu` : undefined} {...trigger("chat", chat.id)}><Icon name="more" size={14}/></button><button type="button" aria-label={labels.pin(chat.title, !!chat.pinned)} onClick={() => pinChat(chat)}><Icon name="pin" size={12}/></button></span>
  </div>;
