export const defaultInboxSources:WorkspaceSource[] = [{name:"staging",description:"Ingest pipeline",artifact:"staging",kind:"folder"},{name:"triage-eval.csv",description:"Support triage",artifact:"triage-eval.csv",kind:"table"},{name:"dashboard-spec.md",description:"Client dashboard",artifact:"dashboard-spec.md",kind:"document"}];

export type InboxLabels = InboxListLabels & InboxItemLabels & InboxTaskContextLabels & { caughtUp?: string; tasks?: string; running?: (count:number)=>string; noAnswers?: string; noAnswersDescription?: string; back?: string; deferred?: string; reopened?: (count:number)=>string };
export type InboxScreenProps = Omit<AppShellProps,"children"|"panel"|"panelTitle"|"navigation"|"onSelect"> & {
  items?: InboxItem[]; defaultItems?: InboxItem[]; onItemsChange?: (items:InboxItem[])=>void;
  tab?: InboxTab; defaultTab?: InboxTab; onTabChange?: (tab:InboxTab)=>void;
  selected?: string|null; defaultSelected?: string|null; onSelectedChange?: (id:string|null)=>void; onSelect?: (id:string|null)=>void;
  drafts?: Record<string,InboxDraft>; defaultDrafts?: Record<string,InboxDraft>; onDraftsChange?: (drafts:Record<string,InboxDraft>)=>void;
  onDecide?: (id:string,answer:InboxAnswer)=>void; onLater?: (id:string)=>void; onReopen?: (id:string)=>void;
  managed?: boolean; submittingId?: string; confirmedId?: string; confirmedAnswer?: InboxAnswer; collapsingId?: string; allowFreeText?: boolean; showTabs?: boolean; error?: ReactNode;
  tasks?: Record<string,InboxTask>; running?: number;
  files?: ArtifactFile[]; defaultFiles?: ArtifactFile[]; onFilesChange?: (files:ArtifactFile[])=>void; onArtifactChange?: (name:string,file:ArtifactFile)=>void;
  openFiles?: string[]; defaultOpenFiles?: string[]; defaultOpenArtifacts?: {task:string;name:string}[]; onOpenFilesChange?: (names:string[])=>void;
  activeFile?: string; defaultActiveFile?: string; onActiveFileChange?: (name:string)=>void;
  onOpenArtifact?: (task:string,name:string)=>void; suggested?: WorkspaceSource[]; labels?: InboxLabels;
  onOpenTool?: (tool:WorkspaceToolKind)=>void; renderTool?: (tool:WorkspaceToolKind)=>ReactNode; onOpenUrl?: (url:string)=>void;
};

/** One question at a time, with a persistent editable work area and the task behind every answer. */
export function InboxScreen({items:itemsProp,defaultItems,onItemsChange,tab:tabProp,defaultTab="open",onTabChange,selected:selectedProp,defaultSelected,onSelectedChange,onSelect,drafts:draftsProp,defaultDrafts={},onDraftsChange,onDecide,onLater,onReopen,managed=false,submittingId,confirmedId,confirmedAnswer,collapsingId:collapsingProp,allowFreeText,showTabs=true,error,tasks=defaultInboxTasks,running=3,files:filesProp,defaultFiles=defaultInboxFiles,onFilesChange,onArtifactChange,openFiles:openedProp,defaultOpenFiles,defaultOpenArtifacts=defaultInboxOpenArtifacts,onOpenFilesChange,activeFile:activeProp,defaultActiveFile="task",onActiveFileChange,panelOpen:panelProp,defaultPanelOpen=true,onPanelOpenChange,onOpenArtifact,suggested=defaultInboxSources,labels={},onOpenTool,renderTool,onOpenUrl,onNavigate,className,style,...shellProps}:InboxScreenProps) {
  const [initial]=useState(()=>{const items=defaultItems??itemsProp??createDefaultInboxItems(),deep=items.find(item=>item.id===(selectedProp??defaultSelected)),tab=deep?(deep.done?"done":"open"):defaultTab;return {items,tab,selected:defaultSelected===null?null:deep?.id??items.find(item=>!!item.done===(tab==="done"))?.id??null};});
  const [items,setItems]=useControllable(itemsProp,initial.items,onItemsChange),[tabValue,setTab]=useControllable<InboxTab>(tabProp,initial.tab,onTabChange),[selected,setSelected]=useControllable<string|null>(selectedProp,initial.selected,onSelectedChange),[drafts,setDrafts]=useControllable(draftsProp,defaultDrafts,onDraftsChange);
  const [files,setFiles]=useControllable(filesProp,defaultFiles,onFilesChange),[opened,setOpened]=useControllable(openedProp,defaultOpenFiles??["task",...defaultOpenArtifacts.map(file=>file.name)],onOpenFilesChange),[active,setActive]=useControllable(activeProp,defaultActiveFile,onActiveFileChange),[panelOpen,setPanelOpen]=useControllable(panelProp,false,onPanelOpenChange);
  const [pending,setPending]=useState<{item:InboxItem;answer:InboxAnswer;collapsing:boolean}|null>(null),[detail,setDetail]=useState(!!defaultSelected||!!selectedProp),[focusRequest,setFocusRequest]=useState(0),[notice,setNotice]=useState(""),[clock,setClock]=useState(()=>Date.now()),[toast,setToast]=useState<{id:number;text:string}|null>(null);
  const [startTabs,setStartTabs]=useState<string[]>([]),[toolTabs,setToolTabs]=useState<{id:string;kind:WorkspaceToolKind}[]>([]),[toolValues,setToolValues]=useState<Record<string,string>>({}),[toolLines,setToolLines]=useState<Record<string,string[]>>({});
  const root=useRef<HTMLDivElement>(null),canvas=useRef<HTMLDivElement>(null),narrow=useRef(false),layout=useRef<boolean|undefined>(undefined),sequence=useRef(0),timers=useRef<ReturnType<typeof setTimeout>[]>([]),sending=useRef(false),fileRef=useRef(files),itemsRef=useRef(items),selectedRef=useRef(selected),draftsRef=useRef(drafts),owners=useRef<Record<string,string>>(Object.fromEntries(defaultOpenArtifacts.map(file=>[file.name,file.task])));
  fileRef.current=files;itemsRef.current=items;selectedRef.current=selected;draftsRef.current=drafts;
  const tab=tabValue==="done"?"done":"open",list=items.filter(item=>!!item.done===(tab==="done")),current=items.find(item=>item.id===selected&&!!item.done===(tab==="done"))??null,shown=pending?.item??current;
  const taskName=shown?.task,contextTask=taskName?tasks[taskName]:undefined;
  const showToast=(text:string)=>{const id=++sequence.current;setToast({id,text});timers.current.push(setTimeout(()=>setToast(value=>value?.id===id?null:value),2200));};
  const select=(id:string|null,focus=false)=>{if(selectedRef.current!==id){selectedRef.current=id;setSelected(id);onSelect?.(id);}if(id)setDetail(true);setFocusRequest(value=>focus?value+1:0);};
  const choose=(id:string,focus=false)=>{if(sending.current)return;const item=itemsRef.current.find(item=>item.id===id);if(!item)return;const nextTab=item.done?"done":"open";if(nextTab!==tab)setTab(nextTab);select(id,focus);};
  const changeTab=(next:InboxTab)=>{if(sending.current)return;setTab(next);select(itemsRef.current.find(item=>!!item.done===(next==="done"))?.id??null);setDetail(false);};
  useEffect(()=>{const timer=setInterval(()=>setClock(Date.now()),60000);return()=>clearInterval(timer);},[]);
  useEffect(()=>()=>timers.current.forEach(clearTimeout),[]);
  useEffect(()=>{if(sending.current)return;if((selected!==null&&!list.some(item=>item.id===selected))||(selected===null&&selectedProp!==null&&list.length>0))select(list[0]?.id??null);},[items,tab,selected]);
  useEffect(()=>{if(!current?.unread||current.done||pending)return;const id=current.id,timer=setTimeout(()=>{const latest=itemsRef.current;if(latest.some(item=>item.id===id&&item.unread))setItems(latest.map(item=>item.id===id?{...item,unread:false}:item));},600);return()=>clearTimeout(timer);},[current?.id,current?.unread,pending]);
  useLayoutEffect(()=>{const frame=root.current,body=canvas.current;if(!frame||!body)return;const measure=()=>{narrow.current=body.getBoundingClientRect().width<640;const small=frame.getBoundingClientRect().width<900;if(panelProp===undefined){if(layout.current===undefined)setPanelOpen(defaultPanelOpen&&opened.length>0&&!small);else if(small&&!layout.current)setPanelOpen(false);}layout.current=small;};measure();const observer=new ResizeObserver(measure);observer.observe(frame);observer.observe(body);return()=>observer.disconnect();},[panelProp]);
  const back=()=>{setDetail(false);requestAnimationFrame(()=>[...(canvas.current?.querySelectorAll<HTMLButtonElement>("[data-inbox-row]")??[])].find(row=>row.dataset.inboxRow===selectedRef.current)?.focus({preventScroll:true}));};
  const keyboard=useRef(back);keyboard.current=back;
  useEffect(()=>{const key=(event:globalThis.KeyboardEvent)=>{if(event.defaultPrevented||event.key!=="Escape"||!narrow.current||isEditing(event.target)||(event.target as HTMLElement)?.closest('[role="menu"],[role="dialog"]')||(document.activeElement===document.body?document.querySelector("[data-inbox-scope]")!==canvas.current:!root.current?.contains(event.target as Node))||canvas.current?.closest("[inert]"))return;event.preventDefault();keyboard.current();};document.addEventListener("keydown",key);return()=>document.removeEventListener("keydown",key);},[]);
  const changeDraft=(value:InboxDraft)=>{if(!shown)return;const next={...draftsRef.current,[shown.id]:value};draftsRef.current=next;setDrafts(next);};
  const decide=(answer:InboxAnswer)=>{const item=current;if(!item||item.done||sending.current||submittingId||confirmedId)return;if(managed){onDecide?.(item.id,answer);return;}sending.current=true;const position=itemsRef.current.filter(entry=>!entry.done).findIndex(entry=>entry.id===item.id),snapshot={...item,done:undefined};setPending({item:snapshot,answer,collapsing:false});setFocusRequest(value=>value+1);const left=itemsRef.current.filter(entry=>!entry.done&&entry.id!==item.id).length;setNotice(left?`Sent. ${left} left.`:"Sent. You're all caught up.");onDecide?.(item.id,answer);
    timers.current.push(setTimeout(()=>setPending(value=>value?{...value,collapsing:true}:null),900));
    timers.current.push(setTimeout(()=>{const latest=itemsRef.current,oldIndex=position,remaining=latest.filter(entry=>entry.id!==item.id),found=latest.find(entry=>entry.id===item.id);if(found){const done={...found,unread:false,done:found.done??{answer,at:Date.now()}};const firstDone=remaining.findIndex(entry=>entry.done);setItems(firstDone<0?[...remaining,done]:[...remaining.slice(0,firstDone),done,...remaining.slice(firstDone)]);}sending.current=false;setPending(null);if(selectedRef.current===item.id){const open=remaining.filter(entry=>!entry.done);select(open[Math.max(0,Math.min(oldIndex,open.length-1))]?.id??null,true);}},1180));
  };
  const later=()=>{if(!current||current.done||sending.current||submittingId||confirmedId)return;if(managed){onLater?.(current.id);return;}const open=items.filter(item=>!item.done),index=open.findIndex(item=>item.id===current.id),remaining=open.filter(item=>item.id!==current.id);setItems([...remaining,current,...items.filter(item=>item.done)]);select(remaining[index]?.id??remaining[0]?.id??current.id,true);onLater?.(current.id);const message=labels.deferred??"Moved to the end of the list";setNotice(message);showToast(message);};
  const reopen=()=>{if(!current?.done||sending.current||submittingId||confirmedId)return;if(managed){onReopen?.(current.id);return;}const item={...current,done:undefined,unread:false},nextDrafts={...draftsRef.current};delete nextDrafts[item.id];draftsRef.current=nextDrafts;setDrafts(nextDrafts);setItems([item,...items.filter(entry=>entry.id!==item.id)]);setTab("open");select(item.id,true);onReopen?.(item.id);const count=items.filter(entry=>!entry.done).length+1;setNotice(labels.reopened?.(count)??`Reopened. ${count} open.`);};
  const updateFiles=(next:ArtifactFile[])=>{const previous=fileRef.current;fileRef.current=next;setFiles(next);next.forEach(file=>{if(JSON.stringify(previous.find(item=>item.name===file.name))!==JSON.stringify(file))onArtifactChange?.(file.name,file);});};
  const changePanel=(open:boolean)=>{if(open&&!opened.length){setOpened(["task"]);setActive("task");}setPanelOpen(open);};
  const closePanel=()=>{setPanelOpen(false);setFocusRequest(value=>value+1);};
  const changeOpened=(next:string[])=>{setOpened(next);setStartTabs(tabs=>tabs.filter(id=>next.includes(id)));setToolTabs(tabs=>tabs.filter(tab=>next.includes(tab.id)));if(!next.length)closePanel();};
  const openArtifact=(name:string,replace?:string,owner=taskName??"")=>{if(!fileRef.current.some(file=>file.name===name))updateFiles([...fileRef.current,{kind:"document",name,content:`# ${name}\n\n`,updated:"Just now"}]);owners.current[name]=owner;setOpened([...new Set(replace?opened.map(id=>id===replace?name:id):[...opened,name])]);if(replace)setStartTabs(tabs=>tabs.filter(id=>id!==replace));setActive(name);setPanelOpen(true);onOpenArtifact?.(owner,name);};
  const openedFile=(name:string)=>{const owner=owners.current[active]??taskName??"";owners.current[name]=owner;onOpenArtifact?.(owner,name);};
  const newTab=()=>{const id=`new-${++sequence.current}`;setStartTabs(tabs=>[...tabs,id]);setOpened([...opened,id]);setActive(id);setPanelOpen(true);};
  const openTool=(kind:WorkspaceToolKind,replace?:string)=>{const id=replace??`tool-${++sequence.current}`;if(replace)setStartTabs(tabs=>tabs.filter(tab=>tab!==replace));else setOpened([...opened,id]);setToolTabs(tabs=>[...tabs.filter(tab=>tab.id!==id),{id,kind}]);setActive(id);setPanelOpen(true);onOpenTool?.(kind);};
  const openUrl=(value:string)=>{try{const url=new URL(/^[a-z][a-z\d+.-]*:/i.test(value)?value:`https://${value}`);if(!["http:","https:"].includes(url.protocol))throw new Error("Invalid address");if(onOpenUrl)onOpenUrl(url.href);else window.open(url.href,"_blank","noopener,noreferrer");}catch{setNotice("Enter a valid web address");}};
  const extraTabs:ArtifactWorkspaceTab[]=[{id:"task",label:taskName??"Task",icon:<Icon name="tasks" size={14}/>,content:<InboxTaskContext name={taskName} task={contextTask} items={items} activeId={shown?.id} onOpenItem={id=>choose(id,true)} onOpenArtifact={name=>openArtifact(name)} labels={labels} now={clock}/>} ,...startTabs.map(id=>({id,label:"New tab",icon:<Icon name="globe" size={14}/>,content:<WorkspaceStart suggested={suggested} onOpenSource={source=>openArtifact(source.artifact??source.name,id)} onOpenTool={kind=>openTool(kind,id)} onOpenUrl={value=>{openTool("browser",id);setToolValues(values=>({...values,[id]:value}));openUrl(value);}}/>})),...toolTabs.map(({id,kind})=>({id,label:kind==="terminal"?"Terminal":kind==="browser"?"Browser":"Notes",icon:<Icon name={kind==="terminal"?"terminal":kind==="browser"?"globe":"compose"} size={14}/>,content:renderTool?.(kind)??<WorkspaceTool kind={kind} value={toolValues[id]??""} onValueChange={value=>setToolValues(values=>({...values,[id]:value}))} lines={toolLines[id]} onLinesChange={lines=>setToolLines(values=>({...values,[id]:lines}))} onOpenUrl={openUrl}/>}))];
  const navigation:AppRailItem[]=[{label:"Thread",icon:<Icon name="chat"/>},{label:"Inbox",icon:<Icon name="inbox"/>,count:items.filter(item=>!item.done).length},{label:"Tasks",icon:<Icon name="tasks"/>},{label:"Memory",icon:<Icon name="memory"/>},{label:"Settings",icon:<Icon name="settings"/>,section:"Workspace"}];
  const commands:CommandMenuGroup[]=[{id:"inbox",label:labels.inbox??"Inbox",commands:items.map(item=>({id:item.id,label:item.question,description:item.task,icon:<InboxGlyph kind={item.done?"done":item.kind}/>,onSelect:()=>choose(item.id,true)}))},{id:"workspace",label:"Workspace",commands:navigation.map(item=>({id:`navigate:${item.label}`,label:item.label,icon:item.icon,onSelect:()=>onNavigate?.(item.label)}))}];
  const busy=!!pending||!!submittingId||!!confirmedId,activeSending=pending?.item.id??submittingId??confirmedId,activeCollapsing=pending?.collapsing?pending.item.id:collapsingProp,itemPhase=pending||(shown&&confirmedId===shown.id)?"sent":shown&&submittingId===shown.id?"submitting":"answer";
  return <div ref={root} className={["ui-ibs__frame",className].filter(Boolean).join(" ")} style={style}><style href="ui-inbox" precedence="default">{css}</style><AppShell {...shellProps} className="ui-ibs__shell" defaultChats={shellProps.defaultChats??[]} defaultActive={shellProps.defaultActive??"Inbox"} navigation={navigation} commands={shellProps.commands??commands} onNavigate={onNavigate} panelOpen={panelOpen} onPanelOpenChange={changePanel} defaultPanelWidth={shellProps.defaultPanelWidth??410} panelTitle="Task" panel={<ArtifactWorkspace files={files} onFilesChange={updateFiles} openFiles={opened} onOpenFilesChange={changeOpened} activeFile={active} onActiveFileChange={setActive} tabs={extraTabs} onNewTab={newTab} onOpenFile={openedFile} onClose={closePanel} closeLabel="Close task"/>}>
    <div ref={canvas} className="ui-ibs" data-inbox-scope="" data-detail={detail||undefined} aria-busy={busy}><div className="ui-ibs__list"><InboxList items={items} tab={tab} onTabChange={changeTab} selected={selected} onSelect={id=>choose(id)} sendingId={activeSending} collapsingId={activeCollapsing} showTabs={showTabs} disabled={busy} labels={labels} now={clock}/></div><div className="ui-ibs__reading"><header className="ui-ibs__mobile-head"><button type="button" onClick={back}><Icon name="chevron" size={14}/>{labels.back??labels.inbox??"Inbox"}</button></header><div className="ui-ibs__scroll">{shown?<InboxItemView key={`${shown.id}:${shown.done?"done":"open"}`} item={shown} draft={drafts[shown.id]??{option:shown.options?.find(option=>option.recommended)?.id,text:""}} onDraftChange={changeDraft} onSubmit={decide} onLater={!managed||onLater?later:undefined} onReopen={reopen} onOpenArtifact={name=>openArtifact(name)} phase={itemPhase} sentAnswer={pending?.answer??confirmedAnswer} managed={managed} allowFreeText={allowFreeText} error={error} focusRequest={focusRequest} labels={labels} now={clock}/>:<div className="ui-ibs__empty"><InboxEmptyState variant={tab} running={running} title={tab==="open"?labels.caughtUp:labels.noAnswers} description={tab==="open"?(labels.running?.(running)??`${running} ${running===1?"task keeps":"tasks keep"} running in the background`):labels.noAnswersDescription} tasksLabel={labels.tasks} onOpenTasks={()=>onNavigate?.("Tasks")} focusRequest={focusRequest}/></div>}</div></div></div>
    {toast&&<div className="ui-ibs__toast" key={toast.id} aria-hidden="true"><Icon name="check" size={14}/><span>{toast.text}</span></div>}
    <span className="ui-ibs__sr" role="status" aria-live="polite">{notice}</span>
  </AppShell></div>;
}

/* ---------- Styles ---------- */
.ui-ibs__frame{width:100%;height:100%;min-height:0;container:ui-ibs-frame / inline-size;font-family:"Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}.ui-ibs__frame,.ui-ibs__frame *,.ui-ibs__frame *::before,.ui-ibs__frame *::after{box-sizing:border-box}.ui-ibs__shell{height:100%}.ui-ibs{--ui-ibs-ink:rgba(0,0,0,.88);--ui-ibs-muted:rgba(0,0,0,.45);--ui-ibs-line:rgba(0,0,0,.06);--ui-ibs-focus:rgba(0,96,226,.7);height:100%;min-height:0;width:100%;container:ui-ibs / inline-size;display:flex;color:var(--ui-ibs-ink)}.ui-ibs__list{flex:none;width:320px;min-height:0}.ui-ibs__reading{display:flex;flex-direction:column;flex:1;min-width:0;min-height:0}.ui-ibs__scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--ui-ibs-line) transparent}.ui-ibs__mobile-head{display:none;height:48px;flex:none;align-items:center;padding:0 48px}.ui-ibs__mobile-head button{display:flex;align-items:center;gap:8px;height:32px;padding:0 4px;border:0;background:none;color:var(--ui-ibs-muted);font:500 13px/20px "Inter",ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ui-ibs__mobile-head button>svg{transform:rotate(180deg)}.ui-ibs__mobile-head button:active{transform:scale(.97)}.ui-ibs__mobile-head button:focus-visible{outline:2px solid var(--ui-ibs-focus);outline-offset:2px}.ui-ibs__empty{display:grid;place-items:center;min-height:100%;padding-bottom:48px}.ui-ibs__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.ui-ibs__frame .ui-aw__tabs{flex:1}.ui-ibs__frame .ui-aw__tab-wrap{flex:1 1 0;max-width:166px}.ui-ibs__frame .ui-aw__tab{width:100%;font-size:13px!important;padding-right:24px}.ui-ibs__frame .ui-aw__tab>span:first-child{flex:none}.ui-ibs__frame .ui-aw__tab-wrap:not([data-active]) .ui-aw__tab-close{opacity:0}.ui-ibs__frame .ui-aw__tab-wrap:hover .ui-aw__tab-close,.ui-ibs__frame .ui-aw__tab-wrap:focus-within .ui-aw__tab-close{opacity:1}
@container ui-ibs (max-width:639.99px){.ui-ibs__list{width:100%}.ui-ibs__reading{display:none}.ui-ibs[data-detail] .ui-ibs__list{display:none}.ui-ibs[data-detail] .ui-ibs__reading{display:flex}.ui-ibs__mobile-head{display:flex}.ui-ibs__empty{padding-bottom:0}}
.ui-ibs__toast{position:absolute;z-index:40;left:50%;bottom:20px;translate:-50% 0;display:flex;align-items:center;gap:8px;max-width:calc(100% - 32px);height:36px;padding:0 14px 0 12px;border-radius:999px;background:var(--ui-as-ink,#171717);color:var(--ui-as-card,#fff);font-size:13px;line-height:20px;box-shadow:0 10px 24px -8px rgba(0,0,0,.35);animation:ui-ibs-toast 2200ms cubic-bezier(.22,1,.36,1) both}.ui-ibs__toast>svg{flex:none}.ui-ibs__toast>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@keyframes ui-ibs-toast{0%{opacity:0;transform:translateY(12px) scale(.96)}12%,85%{opacity:1;transform:none}100%{opacity:0;transform:translateY(6px)}}
@media(pointer:coarse){.ui-ibs__mobile-head button{min-height:36px}}
@media(prefers-reduced-motion:reduce){.ui-ibs__frame,.ui-ibs__frame *{scroll-behavior:auto!important}.ui-ibs__toast{animation:none!important}}
:where(.dark,[data-theme="dark"]) .ui-ibs{--ui-ibs-ink:rgba(255,255,255,.9);--ui-ibs-muted:rgba(255,255,255,.46);--ui-ibs-line:rgba(255,255,255,.08);--ui-ibs-focus:rgba(77,141,255,.8)}
