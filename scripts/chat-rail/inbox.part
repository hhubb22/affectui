export function createDefaultInboxItems(now=Date.now()):InboxItem[] {
  return [
    {id:"queue",kind:"decision",task:"Ingest pipeline",at:now-4*60000,question:"Which queue should the ingest service use?",context:"Events arrive in bursts of up to 20k a minute. The service needs retries, and a way to replay a day of events after a bad deploy.",options:[
      {id:"kafka",title:"Kafka",summary:"A durable log – replay is built in",recommended:true,pros:["Replays any day after a bad deploy","Takes the bursts with room to spare"],cons:["One more cluster to run","Overkill below a thousand events a minute"]},
      {id:"sqs",title:"SQS",summary:"Managed, nothing to operate",pros:["No servers, pay per message","Retries and dead letters built in"],cons:["No replay – a message is gone once read","Ordering only in FIFO queues"]},
      {id:"pg",title:"Postgres queue",summary:"Use the database you already have",pros:["Nothing new to deploy","Jobs and data in one transaction"],cons:["Won't keep up with the bursts","Replay means writing it yourself"]}]},
    {id:"empty-state",kind:"pick",task:"Client dashboard",at:now-18*60000,unread:true,question:"Which empty state for the dashboard?",context:"New accounts land on an empty dashboard until their first sync finishes, about ten minutes.",options:[{id:"illustration",title:"Illustration",wireframe:"illustration"},{id:"checklist",title:"Setup checklist",wireframe:"checklist"},{id:"sample",title:"Sample data",wireframe:"data"}]},
    {id:"weekly",kind:"approval",task:"Weekly update",at:now-42*60000,unread:true,question:"Send the weekly update to Northwind?",context:"Drafted from this week's merged work and the two open questions. It goes out from your address.",facts:[{label:"To",value:"Dana Reyes, Northwind"},{label:"Subject",value:"Week 45: ingest is live, dashboard in review"},{label:"Body",value:"Ingest runs on staging and took Tuesday's spike without losing an event…"}]},
    {id:"tone",kind:"question",task:"Launch post",at:now-3600000,question:"What tone should the launch post have?",context:"The post announces the client portal on Thursday. The draft is ready apart from its voice.",suggestions:["Calm and factual","Warm, a little playful","Short, for developers"]},
    {id:"api",kind:"decision",task:"API migration",at:now-3*3600000,question:"Keep the old API until March or drop it now?",context:"Two clients still call v1, about 4% of traffic. Keeping it means every fix lands twice.",options:[{id:"keep",title:"Keep it until March",summary:"Clients move at their own pace",pros:["No rushed migrations for the two clients","Time to ship a migration guide"],cons:["Every fix lands in two versions","Three more months of v1 tests"]},{id:"drop",title:"Drop it now",summary:"One codebase from next week",pros:["Half the surface to maintain","The new auth applies everywhere"],cons:["Two clients have to move this week"]}]},
    {id:"model",kind:"decision",task:"Support triage",at:now-86400000,question:"Which model should summarise support tickets?",options:[{id:"small",title:"The small model",summary:"With a weekly eval",pros:["A tenth of the cost per ticket","Fast enough to run on every ticket"]},{id:"large",title:"The large model",summary:"Better on long threads"}],done:{answer:{option:"small"},at:now-86400000,history:["Runs on 2 of 5 support queues","First weekly eval: 94% match a human summary"],artifacts:["triage-eval.csv"]}},
    {id:"auth",kind:"approval",task:"Auth refactor",at:now-86400000,question:"Merge the auth refactor before the demo?",facts:[{label:"Branch",value:"auth-refactor → main"},{label:"Change",value:"41 files, all checks green"}],done:{answer:"approve",at:now-86400000,history:["Merged into main","Deployed to staging before the demo"],artifacts:["auth-refactor.md"]}},
    {id:"chart",kind:"pick",task:"Client dashboard",at:now-2*86400000,question:"Which chart for the usage page?",options:[{id:"bars",title:"Bars",summary:"One bar per day, easy to compare",wireframe:"bars"},{id:"line",title:"Line",wireframe:"line"}],done:{answer:{option:"bars"},at:now-2*86400000,history:["Usage page shipped with daily bars","Northwind's team opened it 31 times this week"],artifacts:["usage-page.png","screens"]}}
  ];
}

