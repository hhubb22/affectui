export type InboxItemLabels = { send?: string; later?: string; approve?: string; decline?: string; reopen?: string; recommended?: string; reply?: string; answer?: string; sent?: string; submitting?: string; approval?: string; done?: string; since?: string };
export type InboxItemViewProps = { item: InboxItem; draft?: InboxDraft; defaultDraft?: InboxDraft; onDraftChange?: (draft: InboxDraft) => void; onSubmit?: (answer: InboxAnswer) => void; onLater?: () => void; onReopen?: () => void; onOpenArtifact?: (name: string) => void; phase?: "answer" | "submitting" | "sent"; sentAnswer?: InboxAnswer; managed?: boolean; allowFreeText?: boolean; error?: ReactNode; extraActions?: ReactNode; focusRequest?: number; shortcuts?: boolean; labels?: InboxItemLabels; now?: number; className?: string };

/** One question, including its decision, visual pick, approval or answer and its resolved history. */
export function InboxItemView({item,draft:draftProp,defaultDraft,onDraftChange,onSubmit,onLater,onReopen,onOpenArtifact,phase="answer",sentAnswer,managed=false,allowFreeText,error,extraActions,focusRequest,shortcuts=true,labels={},now=Date.now(),className}:InboxItemViewProps) {
  const options=(Array.isArray(item.options)?item.options:[]).filter(Boolean),kind=inboxKind(item.kind),freeText=allowFreeText??(!managed||kind==="question"),showLater=!managed||!!onLater;
  const [draft,setDraft]=useControllable<InboxDraft>(draftProp,defaultDraft??{option:options.find(option=>option.recommended)?.id,text:""},onDraftChange);
  const root=useRef<HTMLElement>(null),heading=useRef<HTMLHeadingElement>(null),field=useRef<HTMLInputElement|HTMLTextAreaElement>(null),previous=useRef(item.id),draftRef=useRef(draft);draftRef.current=draft;
  const choice=options.some(option=>option.id===draft.option)?draft.option:undefined,text=draft.text??"",sent=phase==="sent",submitting=phase==="submitting",busy=sent||submitting;
  useEffect(()=>{if(previous.current===item.id)return;previous.current=item.id;if(draftProp===undefined)setDraft({option:options.find(option=>option.recommended)?.id,text:""});},[item.id]);
  useLayoutEffect(()=>{if(focusRequest)heading.current?.focus({preventScroll:true});},[focusRequest]);
  const change=(next:InboxDraft)=>{draftRef.current=next;setDraft(next);};
  const submit=(optionId?:string)=>{if(busy||item.done)return;const draft=draftRef.current,words=freeText?(draft.text?.trim()??""):"",option=optionId??(options.some(option=>option.id===draft.option)?draft.option:undefined);if(kind!=="approval"&&!words&&!option)return;const answer:InboxAnswer=kind==="approval"&&!words?"approve":option?words?{option,text:words}:{option}:{text:words};onSubmit?.(answer);};
  const blurField=()=>{field.current?.blur();heading.current?.focus({preventScroll:true});};
  const keyboard=useRef({item,kind,options,busy,showLater,freeText,submit,onLater,change,blurField});keyboard.current={item,kind,options,busy,showLater,freeText,submit,onLater,change,blurField};
  useEffect(()=>{if(!shortcuts)return;const key=(event:globalThis.KeyboardEvent)=>{const state=keyboard.current;if(state.item.done||state.busy||event.defaultPrevented||event.metaKey||event.ctrlKey||event.altKey||isEditing(event.target)||(event.target as HTMLElement)?.closest('[role="menu"],[role="dialog"]'))return;const area=root.current?.closest("[data-inbox-scope]")??root.current;if(document.activeElement===document.body){if(document.querySelector("[data-inbox-view]")!==root.current)return;}else if(!area?.contains(document.activeElement))return;if(root.current?.closest("[inert]"))return;const value=event.key.toLowerCase();if(/^[1-9]$/.test(value)&&(state.kind==="decision"||state.kind==="pick")){const option=state.options[Number(value)-1];if(option){event.preventDefault();state.change({...draftRef.current,option:option.id});const target=[...(root.current?.querySelectorAll<HTMLButtonElement>("[data-inbox-option]")??[])].find(el=>el.dataset.inboxOption===option.id);target?.focus({preventScroll:true});}}else if(value==="l"&&state.showLater){event.preventDefault();state.onLater?.();}else if((value==="r"||value==="/")&&state.freeText){event.preventDefault();field.current?.focus();}else if(event.key==="Enter"&&(!(event.target as HTMLElement).closest("button,a")||(event.target as HTMLElement).closest("[data-inbox-row]"))){event.preventDefault();state.submit();}};document.addEventListener("keydown",key);return()=>document.removeEventListener("keydown",key);},[shortcuts]);
  const fieldKey=(event:KeyboardEvent<HTMLInputElement|HTMLTextAreaElement>)=>{if(event.key==="Escape"){event.preventDefault();event.stopPropagation();blurField();}else if(event.key==="Enter"&&!event.shiftKey&&!event.nativeEvent.isComposing){event.preventDefault();event.stopPropagation();submit();}};
  const answer=item.done?.answer,savedOption=typeof answer==="object"?options.find(option=>option.id===answer.option):undefined;
  const canSubmit=!submitting&&(kind==="approval"||!!choice||(freeText&&!!text.trim()));
  return <section ref={root} data-inbox-view="" className={["ui-ibv",className].filter(Boolean).join(" ")} data-phase={sent?"sent":submitting?"submitting":item.done?"done":"answer"} aria-busy={submitting||undefined}>
    <style href="ui-inbox-item-view" precedence="default">{css}</style>
    <p className="ui-ibv__meta"><span data-kind={item.done?"done":kind}><InboxGlyph kind={item.done?"done":kind}/></span>{kind==="approval"&&!item.done&&<span className="ui-ibv__badge">{labels.approval??"Approval"}</span>}<span title={item.task} dir="auto">{item.task}</span><i>·</i><span>{item.done?labels.done??"Done":inboxAge(item.at,now).long}</span></p>
    <h2 ref={heading} className="ui-ibv__question" tabIndex={-1} dir="auto">{item.question}</h2>
    {!sent&&item.context&&<p className="ui-ibv__context" dir="auto">{item.context}</p>}
    {sent?<div className="ui-ibv__answer"><InboxConfirmation answer={inboxAnswerLabel(item,sentAnswer??(kind==="approval"?"approve":{}))} message={labels.sent}/></div>:item.done?<div className="ui-ibv__done">
      <div className="ui-ibv__chosen"><div className="ui-ibv__chosen-row"><Icon name={answer==="decline"?"close":"check"} size={14}/><strong dir="auto" title={item.done.label??inboxAnswerLabel(item,item.done.answer)}>{item.done.label??inboxAnswerLabel(item,item.done.answer)}</strong><span>{inboxAge(item.done.at,now).long}</span></div>
        {(savedOption||typeof answer==="object"&&answer.text||kind==="approval"&&item.facts?.length)&&<div className="ui-ibv__chosen-body">{savedOption&&kind==="pick"&&<span className="ui-ibv__chosen-thumb" onErrorCapture={event=>{if(event.target instanceof HTMLImageElement)event.target.style.visibility="hidden";}}>{savedOption.preview??(typeof savedOption.wireframe==="object"?savedOption.wireframe:<InboxWireframe kind={typeof savedOption.wireframe==="string"?savedOption.wireframe:savedOption.id}/>)}</span>}<div className="ui-ibv__chosen-lines">{savedOption?.summary&&<span className="ui-ibv__chosen-summary">{savedOption.summary}</span>}{savedOption?.pros?.map((line,index)=><span className="ui-ibv__pro" key={index}><b>+</b><span dir="auto">{line}</span></span>)}{kind==="approval"&&item.facts?.map(fact=><span className="ui-ibv__chosen-fact" key={fact.label}><span>{fact.label}</span><span dir="auto" title={fact.value}>{fact.value}</span></span>)}{typeof answer==="object"&&answer.text&&<span className="ui-ibv__words" dir="auto">“{answer.text}”</span>}</div></div>}
      </div>
      {!!item.done.history?.length&&<section className="ui-ibv__since"><h3>{labels.since??"Since then"}</h3><ul>{item.done.history.map((line,index)=><li key={index} dir="auto">{line}</li>)}</ul></section>}
      {!!item.done.artifacts?.length&&<div className="ui-ibv__files">{item.done.artifacts.map(name=><button type="button" key={name} onClick={()=>onOpenArtifact?.(name)}><Icon name={name.endsWith(".csv")?"table":/\.(png|jpg|webp|svg)$/i.test(name)?"image":name.includes(".")?"document":"folder"} size={12}/>{name}</button>)}</div>}
      <div className="ui-ibv__done-actions">{onReopen&&<button type="button" className="ui-ibv__button" onClick={onReopen}><Icon name="undo" size={13}/>{labels.reopen??"Reopen"}</button>}</div>
    </div>:<>
      <div className="ui-ibv__answer">{kind==="decision"||kind==="pick"?<InboxOptions options={options} variant={kind==="pick"?"variants":"options"} value={choice??""} onValueChange={option=>change({...draftRef.current,option})} onConfirm={submit} label={item.question} recommendedLabel={labels.recommended} disabled={submitting}/>:kind==="approval"?item.facts?.length?<dl className="ui-ibv__facts">{item.facts.map(fact=><div key={fact.label}><dt>{fact.label}</dt><dd dir="auto" title={fact.value}>{fact.value}</dd></div>)}</dl>:null:<div className="ui-ibv__free"><textarea ref={field as RefObject<HTMLTextAreaElement|null>} className="ui-ibv__reply ui-ibv__area" aria-label="Your answer" placeholder={labels.answer??"Write your answer…"} value={text} disabled={submitting} onChange={event=>change({...draftRef.current,text:event.target.value})} onKeyDown={fieldKey}/>{!!item.suggestions?.length&&<div className="ui-ibv__chips">{item.suggestions.map(suggestion=><button type="button" aria-pressed={text===suggestion} disabled={submitting} key={suggestion} title={suggestion} onClick={()=>{change({...draftRef.current,text:suggestion});field.current?.focus();}}>{suggestion}</button>)}</div>}</div>}</div>
      {error!=null&&<div className="ui-ibv__error" role="alert">{error}</div>}
      <div className="ui-ibv__footer">{kind!=="question"&&freeText&&<input ref={field as RefObject<HTMLInputElement|null>} className="ui-ibv__reply" aria-label="Tell it something else" placeholder={labels.reply??"Or tell it something else…"} value={text} disabled={submitting} onChange={event=>change({...draftRef.current,text:event.target.value})} onKeyDown={fieldKey}/>}<div className="ui-ibv__actions">{extraActions}{showLater&&<button type="button" className="ui-ibv__button ui-ibv__later" disabled={submitting} aria-keyshortcuts="L" onClick={onLater}>{labels.later??"Later"}<kbd aria-hidden={managed||undefined}>L</kbd></button>}{kind==="approval"&&<button type="button" className="ui-ibv__button" disabled={submitting} onClick={()=>onSubmit?.("decline")}>{labels.decline??"Decline"}</button>}<button type="button" className="ui-ibv__button ui-ibv__send" disabled={!canSubmit} aria-keyshortcuts="Enter" onClick={()=>submit()}>{submitting&&labels.submitting?labels.submitting:kind==="approval"&&(!freeText||!text.trim())?labels.approve??"Approve":labels.send??"Send"}<kbd aria-hidden={managed||undefined}>↵</kbd></button></div></div>
    </>}
  </section>;
}

/* ---------- Styles ---------- */
.ui-ibv{--ui-ibv-card:#fff;--ui-ibv-ink:rgba(0,0,0,.88);--ui-ibv-text:rgba(0,0,0,.61);--ui-ibv-muted:rgba(0,0,0,.45);--ui-ibv-faint:rgba(0,0,0,.27);--ui-ibv-line:rgba(0,0,0,.06);--ui-ibv-fill:rgba(0,0,0,.04);--ui-ibv-focus:rgba(0,96,226,.7);--ui-ibv-shadow:0 0 0 .5px var(--ui-ibv-line),0 1px 2px rgba(0,0,0,.025);box-sizing:border-box;width:100%;max-width:640px;margin:0 auto;padding:clamp(40px,11vh,104px) 40px 64px;color:var(--ui-ibv-ink);font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container:ui-ibv / inline-size;-webkit-font-smoothing:antialiased;animation:ui-ibv-in 420ms cubic-bezier(.22,1,.36,1) both}
.ui-ibv,.ui-ibv *,.ui-ibv *::before,.ui-ibv *::after{box-sizing:border-box}.ui-ibv :where(button){font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-ibv :where(button,a.ui-ibv__button):focus-visible{outline:2px solid var(--ui-ibv-focus);outline-offset:-2px}.ui-ibv :where(button,a.ui-ibv__button):active:not(:disabled){transform:scale(.97)}.ui-ibv a.ui-ibv__button{color:inherit;text-decoration:none}.ui-ibv__meta{display:flex;align-items:center;gap:6px;min-width:0;margin:0;font-size:12px;line-height:16px;color:var(--ui-ibv-muted)}.ui-ibv__meta>span:first-child{display:flex;flex:none;margin-right:2px}.ui-ibv__meta>span[data-kind="decision"]{color:#a651f0}.ui-ibv__meta>span[data-kind="pick"]{color:#0190fe}.ui-ibv__meta>span:is([data-kind="approval"],[data-kind="done"]){color:#5fc88a}.ui-ibv__meta>span[data-kind="question"]{color:#f28a2e}.ui-ibv__meta>span[dir]{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-ibv__meta>span:last-child{flex:none;font-variant-numeric:tabular-nums}.ui-ibv__meta i{font-style:normal;color:var(--ui-ibv-faint)}.ui-ibv__badge{flex:none;padding:0 6px;border-radius:4px;font-size:11px;font-weight:500;line-height:18px;background:rgba(255,156,0,.16);color:#cc4e00}.ui-ibv__question{margin:10px 0 0;font-size:24px;line-height:32px;font-weight:500;letter-spacing:-.24px;text-wrap:balance;overflow-wrap:anywhere;outline:none!important}.ui-ibv__context{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin:12px 0 0;font-size:14px;line-height:22px;color:var(--ui-ibv-text);text-wrap:pretty}.ui-ibv__answer{margin-top:32px}.ui-ibv__facts{margin:0;padding:4px 16px;border-radius:10px;background:var(--ui-ibv-card);box-shadow:var(--ui-ibv-shadow)}.ui-ibv__facts>div{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:12px;align-items:center;min-height:40px}.ui-ibv__facts>div+div{box-shadow:inset 0 .5px var(--ui-ibv-line)}.ui-ibv__facts dt{font-size:13px;line-height:20px;color:var(--ui-ibv-muted)}.ui-ibv__facts dd{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin:0;padding:10px 0;overflow:hidden;font-size:13px;line-height:20px;overflow-wrap:anywhere}.ui-ibv__free{display:flex;flex-direction:column;gap:12px}.ui-ibv__reply{box-sizing:border-box;flex:1;min-width:0;height:32px;padding:0 12px;border:0;border-radius:8px;background:var(--ui-ibv-card);box-shadow:var(--ui-ibv-shadow);font:inherit;font-size:13px;line-height:20px;color:var(--ui-ibv-ink);outline:none;transition:box-shadow 140ms}.ui-ibv__reply::placeholder{color:var(--ui-ibv-faint)}.ui-ibv__reply:focus{outline:none;box-shadow:0 0 0 .5px rgba(0,0,0,.16),0 1px 2px rgba(0,0,0,.04)}.ui-ibv__area{flex:none;height:88px;width:100%;padding:10px 12px;resize:none}.ui-ibv__chips{display:flex;flex-wrap:wrap;gap:6px}.ui-ibv__chips button{height:28px;max-width:100%;padding:0 10px;border-radius:6px;background:var(--ui-ibv-fill);font-size:13px;color:var(--ui-ibv-text);white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.ui-ibv__chips button[aria-pressed="true"]{color:var(--ui-ibv-ink);box-shadow:inset 0 0 0 .5px var(--ui-ibv-line)}.ui-ibv__error{margin-top:14px;font-size:13px;line-height:20px;color:var(--aui-danger,#c4320a)}.ui-ibv__footer{display:flex;align-items:center;gap:8px;margin-top:16px}.ui-ibv__actions{display:flex;align-items:center;gap:8px;flex:none;margin-left:auto}.ui-ibv__button{display:inline-flex;align-items:center;justify-content:center;gap:6px;flex:none;height:28px;padding:0 10px;border-radius:6px;background:var(--ui-ibv-card)!important;box-shadow:var(--ui-ibv-shadow);font-size:13px!important;font-weight:500!important;white-space:nowrap}.ui-ibv__button:disabled{opacity:.4;cursor:default}.ui-ibv__later{box-shadow:none;background:none!important;color:var(--ui-ibv-text)!important}.ui-ibv__later:hover{background:var(--ui-ibv-fill)!important}.ui-ibv__send{background:var(--ui-ibv-ink)!important;color:var(--ui-ibv-card)!important;box-shadow:none}.ui-ibv kbd{font:inherit;font-size:12px;line-height:1;font-weight:400;opacity:.5;margin-right:-2px}.ui-ibv__done{display:flex;flex-direction:column;gap:16px;margin-top:28px}.ui-ibv[data-phase="done"] .ui-ibv__context+.ui-ibv__done{margin-top:16px}.ui-ibv__chosen{border-radius:10px;background:var(--ui-ibv-card);box-shadow:var(--ui-ibv-shadow);font-size:13px;line-height:20px}.ui-ibv__chosen-row{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 16px 0 14px}.ui-ibv__chosen-row>svg{flex:none;color:#5fc88a}.ui-ibv__chosen-row>strong{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:500}.ui-ibv__chosen-row>span{flex:none;color:var(--ui-ibv-muted);font-size:12px;font-variant-numeric:tabular-nums}.ui-ibv__chosen-body{display:flex;align-items:flex-start;gap:14px;padding:0 16px 14px 40px;margin-top:-6px}.ui-ibv__chosen-thumb{flex:none;width:96px;overflow:hidden;border-radius:6px;box-shadow:var(--ui-ibv-shadow)}.ui-ibv__chosen-lines{display:flex;flex-direction:column;gap:2px;min-width:0}.ui-ibv__chosen-summary,.ui-ibv__words{font-size:13px;line-height:20px;color:var(--ui-ibv-text);overflow-wrap:anywhere}.ui-ibv__pro{display:flex;gap:8px;font-size:12px;line-height:18px;color:var(--ui-ibv-muted)}.ui-ibv__pro>b{font-weight:500;color:var(--ui-ibv-faint)}.ui-ibv__chosen-summary+.ui-ibv__pro{margin-top:4px}.ui-ibv__chosen-fact{display:grid;grid-template-columns:64px minmax(0,1fr);gap:12px;font-size:12px;line-height:20px}.ui-ibv__chosen-fact>span:first-child{color:var(--ui-ibv-muted)}.ui-ibv__chosen-fact>span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-ibv__since{display:flex;flex-direction:column;gap:8px}.ui-ibv__since h3{margin:0;font-size:12px;font-weight:500;color:var(--ui-ibv-muted)}.ui-ibv__since ul{display:grid;gap:4px;margin:0;padding:0;list-style:none;color:var(--ui-ibv-text)}.ui-ibv__since li{position:relative;padding-left:16px;overflow-wrap:anywhere}.ui-ibv__since li:before{content:"";position:absolute;top:9px;left:4px;width:4px;height:4px;border-radius:50%;background:var(--ui-ibv-faint)}.ui-ibv__files{display:flex;flex-wrap:wrap;gap:6px}.ui-ibv__files>button{display:flex;align-items:center;gap:6px;max-width:100%;padding:3px 8px;border-radius:6px;background:var(--ui-ibv-fill);font-size:12px}.ui-ibv__done-actions{display:flex}
@keyframes ui-ibv-in{from{opacity:0;transform:translateY(8px)}}
@container ui-ibs (max-width:639.99px){.ui-ibv{padding:12px 20px 40px}.ui-ibv__question{font-size:20px;line-height:28px;letter-spacing:-.2px}.ui-ibv__answer{margin-top:24px}.ui-ibv__footer{flex-wrap:wrap}.ui-ibv__footer>.ui-ibv__reply{flex-basis:100%}.ui-ibv kbd{display:none}.ui-ibv__facts>div{grid-template-columns:60px minmax(0,1fr)}}
@media(pointer:coarse){.ui-ibv__button,.ui-ibv__chips button{min-height:36px}.ui-ibv__reply:not(.ui-ibv__area){height:40px}.ui-ibv kbd{display:none}}
@media(prefers-reduced-motion:reduce){.ui-ibv,.ui-ibv *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
:where(.dark,[data-theme="dark"]) .ui-ibv{--ui-ibv-card:#1c1c1e;--ui-ibv-ink:rgba(255,255,255,.9);--ui-ibv-text:rgba(255,255,255,.62);--ui-ibv-muted:rgba(255,255,255,.46);--ui-ibv-faint:rgba(255,255,255,.3);--ui-ibv-line:rgba(255,255,255,.08);--ui-ibv-fill:rgba(255,255,255,.06);--ui-ibv-focus:rgba(77,141,255,.8)}
:where(.dark,[data-theme="dark"]) .ui-ibv__badge{background:rgba(251,106,0,.15);color:#ffa057}
:where(.dark,[data-theme="dark"]) .ui-ibv__error{color:var(--aui-danger,#ff8a7a)}
