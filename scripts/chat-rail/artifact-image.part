export type ArtifactImageViewerProps = { src: string; name?: string; alt?: string; zoom?: number; defaultZoom?: number; onZoomChange?: (zoom: number) => void; className?: string };

/** A contained image preview with zoom, fit and download controls and a readable error fallback. */
export function ArtifactImageViewer({src,name="Image",alt=name,zoom:zoomProp,defaultZoom=1,onZoomChange,className}:ArtifactImageViewerProps) {
  const [zoom,setZoom]=useControllable(zoomProp,defaultZoom,onZoomChange),[failed,setFailed]=useState(false);
  useEffect(()=>setFailed(false),[src]);
  const scale=clamp(safeNumber(zoom,1),.25,4);
  return <div className={["ui-aiv",className].filter(Boolean).join(" ")}><style href="ui-artifact-image" precedence="default">{css}</style><div className="ui-aiv__toolbar"><button type="button" aria-label="Zoom out" disabled={scale<=.25} onClick={()=>setZoom(Math.max(.25,scale-.25))}>−</button><button type="button" aria-label="Fit image" onClick={()=>setZoom(1)}>{Math.round(scale*100)}%</button><button type="button" aria-label="Zoom in" disabled={scale>=4} onClick={()=>setZoom(Math.min(4,scale+.25))}>+</button><a href={src} download={name} aria-label={`Download ${name}`}><Icon name="download" size={14}/></a></div><div className="ui-aiv__canvas">{failed?<p role="status">The image could not be loaded.</p>:<img src={src} alt={alt} onError={()=>setFailed(true)} style={{width:`${scale*100}%`,maxWidth:scale<=1?"100%":"none"}}/>}</div></div>;
}

/* ---------- Styles ---------- */
.ui-aiv{--ui-aiv-card:#fff;--ui-aiv-ink:rgba(0,0,0,.88);--ui-aiv-muted:rgba(0,0,0,.45);--ui-aiv-line:rgba(0,0,0,.06);--ui-aiv-fill:rgba(0,0,0,.025);--ui-aiv-focus:#0060e2;display:flex;flex-direction:column;flex:1;min-height:0;width:100%;color:var(--ui-aiv-ink);font:12px/1.5 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;container-type:inline-size;-webkit-font-smoothing:antialiased}.ui-aiv,.ui-aiv *{box-sizing:border-box}.ui-aiv__toolbar{display:flex;align-items:center;gap:4px;padding:4px 12px;border-bottom:.5px solid var(--ui-aiv-line);flex:none}.ui-aiv button,.ui-aiv a{display:grid;place-items:center;min-width:28px;height:28px;border:0;border-radius:5px;color:var(--ui-aiv-muted);background:none;font:inherit;cursor:pointer;text-decoration:none}.ui-aiv a{margin-left:auto}.ui-aiv button:hover,.ui-aiv a:hover{background:var(--ui-aiv-fill)}.ui-aiv button:disabled{opacity:.4;cursor:default}.ui-aiv :is(button,a):focus-visible{outline:2px solid var(--ui-aiv-focus);outline-offset:-2px}.ui-aiv :is(button,a):active{transform:scale(.97)}.ui-aiv__canvas{flex:1;min-height:0;overflow:auto;padding:16px;display:flex;align-items:flex-start;justify-content:center;background:var(--ui-aiv-fill)}.ui-aiv img{display:block;height:auto;flex:none;border-radius:6px;box-shadow:0 0 0 .5px var(--ui-aiv-line)}.ui-aiv__canvas p{color:var(--ui-aiv-muted)}
@media(pointer:coarse){.ui-aiv button,.ui-aiv a{min-width:36px;height:36px}}
@media(prefers-reduced-motion:reduce){.ui-aiv,.ui-aiv *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-aiv{--ui-aiv-card:#1c1c1e;--ui-aiv-ink:rgba(255,255,255,.9);--ui-aiv-muted:rgba(255,255,255,.46);--ui-aiv-line:rgba(255,255,255,.08);--ui-aiv-fill:rgba(255,255,255,.025);--ui-aiv-focus:#4d8dff}
