  const [lastSeen, setLastSeen] = useControllable<number | undefined>(lastSeenProp, managed ? undefined : defaultLastSeen, onLastSeenChange);
  const [readReceipt, setReadReceipt] = useState<number | undefined>();
  const [localRunning, setLocalRunning] = useState(false), [away, setAway] = useState(false), [newCount, setNewCount] = useState(0), [announcement, setAnnouncement] = useState("");
  const [localAnswers, setAnswers] = useState<Record<string, string>>({}), [activeDecision, setActiveDecision] = useState(""), [focusRequest, setFocusRequest] = useState(0);
  const answers: Record<string, string> = managed ? Object.fromEntries([...decisions.filter(decision => decision.status === "answered").map(decision => [decision.id, decision.answer === undefined ? decisionLabels.answered : threadDecisionAnswerLabel(decision, decision.answer, decisionLabels)]), ...messages.filter(message => message.answer).map(message => [message.answer!.id, message.text ?? decisionLabels.answered])]) : localAnswers;
  const [voicePreview, setVoicePreview] = useState(simulate === "dictating"), [voiceSeconds, setVoiceSeconds] = useState(0);
  const root = useRef<HTMLElement>(null), scroll = useRef<HTMLDivElement>(null), column = useRef<HTMLDivElement>(null), unreadBoundary = useRef<HTMLDivElement>(null), follow = useRef(simulate !== "scrolled");
  const messageRef = useRef(messages), decisionsRef = useRef(decisions), uploadsRef = useRef(uploads), draftRef = useRef(draft);
  messageRef.current = messages; decisionsRef.current = decisions; uploadsRef.current = uploads; draftRef.current = draft;
  const managedRef = useRef(managed); managedRef.current = managed;
  const timers = useRef<Set<ReturnType<typeof setTimeout>>>(new Set()), generation = useRef(0), sequence = useRef(0), mounted = useRef(true);
  const deliveryTimers = useRef<Set<ReturnType<typeof setTimeout>>>(new Set());
  const controllers = useRef<Map<string, AbortController>>(new Map()), transcribing = useRef<Set<string>>(new Set()), delivered = useRef<Set<string>>(new Set());
