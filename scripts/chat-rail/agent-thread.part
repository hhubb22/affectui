  const reduced = useReducedMotion();
  const list = (Array.isArray(messages) ? messages : []).filter(Boolean);
  const streaming = !managed && localRunning || list.some(message => message.streaming || message.tools?.some(tool => tool.status === "running") || message.parts?.some(part => part.kind === "tools" && part.tools.some(tool => tool.status === "running")));
  const update = (fn: (messages: AgentMessage[]) => AgentMessage[]) => { if (managedRef.current) return; const next = fn(messageRef.current); messageRef.current = next; setMessages(next); };
  const updateUploads = (fn: (uploads: ThreadUpload[]) => ThreadUpload[]) => { if (managedRef.current) return; const next = fn(uploadsRef.current); uploadsRef.current = next; setUploads(next); };
  const updateDecisions = (next: ThreadDecision[]) => { if (managedRef.current) return; decisionsRef.current = next; setDecisions(next); };
  const schedule = (callback: () => void, ms: number) => { const timer = setTimeout(() => { timers.current.delete(timer); if (mounted.current && !managedRef.current) callback(); }, ms); timers.current.add(timer); return timer; };
  const clearTimers = () => { timers.current.forEach(timer => clearTimeout(timer)); timers.current.clear(); };
  const pause = (ms: number, token: number) => new Promise<boolean>(resolve => {
    let remaining = ms;
