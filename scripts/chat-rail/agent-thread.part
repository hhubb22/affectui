  });
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; generation.current++; clearTimers(); deliveryTimers.current.forEach(timer => clearTimeout(timer)); controllers.current.forEach(controller => controller.abort()); }; }, []);
  useEffect(() => { if (!managed) return; generation.current++; clearTimers(); controllers.current.forEach(controller => controller.abort()); controllers.current.clear(); setVoicePreview(false); }, [managed]);
