    const online = connectionRef.current === "online";
    update(messages => [...messages, { id, role: "user", text, at: Date.now(), status: online ? "sent" : "queued", attachments: options.attachments.map(file => ({ name: file.name, size: file.size })) }]);
    updateUploads(uploads => uploads.filter(file => file.kind === "voice" && file.state !== "done")); latest();
    if (!online) { pending.current.set(id, options); setAnnouncement(labels.queuedAnnouncement); return; }
