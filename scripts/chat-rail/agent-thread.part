  };
  const later = (id: string) => { onLater?.(id); setAnnouncement(labels.laterAnnouncement); requestAnimationFrame(() => root.current?.querySelector<HTMLTextAreaElement>("textarea")?.focus({ preventScroll: true })); };
  const read = () => { if (managed) { onMarkRead?.(); return; } setReadReceipt(lastSeen); setLastSeen(undefined); onMarkRead?.(); setAnnouncement(labels.markedRead); };
  const boundaryIndex = lastSeen != null && lastSeen !== readReceipt ? list.findIndex(message => (message.at ?? 0) > lastSeen) : -1;
  const after = boundaryIndex >= 0 ? list.slice(boundaryIndex) : [];
  const completedTasks = new Map<string, ThreadTask>();
  after.forEach(message => message.parts?.forEach(part => { if (part.kind === "task" && part.task.done) completedTasks.set(part.task.id, part.task); }));
  const awayDecisions = after.flatMap(message => message.parts?.filter((part): part is Extract<AgentMessagePart, { kind: "decision" }> => part.kind === "decision").map(part => part.ask) ?? []).filter((decision, index, all) => !answers[decision.id] && all.findIndex(item => item.id === decision.id) === index);
  useLayoutEffect(() => {
    if (boundaryIndex < 0) return;
    let disposed = false;
    const position = () => { if (disposed || !unreadBoundary.current || !scroll.current) return; follow.current = false; const viewport = scroll.current; const top = unreadBoundary.current.getBoundingClientRect().top - viewport.getBoundingClientRect().top + viewport.scrollTop; viewport.scrollTop = Math.max(0, top - 20); setAway(true); };
    position(); void document.fonts?.ready.then(position);
    return () => { disposed = true; };
  }, [lastSeen, builtInTimeline]);
  useEffect(() => { if (managed) return; let hiddenAt = 0; const visibility = () => { if (document.hidden) hiddenAt = Date.now(); else if (hiddenAt && Date.now() - hiddenAt >= Math.max(0, awayAfter) * 60000) setLastSeen(hiddenAt); }; document.addEventListener("visibilitychange", visibility); return () => document.removeEventListener("visibilitychange", visibility); }, [managed, awayAfter]);
  const shortcutActions = useRef({ latest, streaming, stop, voicePreview, builtInTimeline }); shortcutActions.current = { latest, streaming, stop, voicePreview, builtInTimeline };
  useEffect(() => { const key = (event: globalThis.KeyboardEvent) => { if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || isEditing(event.target)) return; if (document.activeElement !== document.body && !root.current?.contains(document.activeElement)) return; if (event.key === "End" && shortcutActions.current.builtInTimeline) { event.preventDefault(); shortcutActions.current.latest(); } if (event.key === "/") { event.preventDefault(); root.current?.querySelector<HTMLTextAreaElement>("textarea")?.focus(); } }; document.addEventListener("keydown", key); return () => document.removeEventListener("keydown", key); }, []);
  const liveStory = async () => {
    const token = generation.current, id = "ingest-story"; setLocalRunning(true);
    if (!await pause(900, token)) return;
    update(messages => [...messages, { id: "staging-question", role: "user", at: Date.now(), text: "Good. Get ingest onto staging today – and tell me what you need from me." }]);
    if (!await pause(450, token)) return;
    const toolLabels = ["Read ingest-design.md", "Checked the staging cluster", "Compared Kafka, SQS and a Postgres queue"];
    update(messages => [...messages, { id, role: "agent", at: Date.now(), streaming: true, parts: [{ kind: "tools", id: "stage-tools", tools: toolLabels.map((label, index) => ({ id: `stage-${index}`, label, status: "running", startedAt: Date.now() })) }] }]);
    for (const [index, wait, duration] of [[0,1200,1200],[1,1400,2600],[2,1600,4200]]) {
      if (!await pause(wait, token)) return;
      update(messages => messages.map(message => message.id === id ? { ...message, parts: message.parts?.map(part => part.kind === "tools" ? { ...part, tools: part.tools.map((tool, position) => position === index ? { ...tool, status: "done", duration } : tool) } : part) } : message));
    }
    if (!await pause(700, token)) return;
    if (!await streamText(id, "Staging is ready and the load test holds. One thing I can't decide for you: which queue the service runs on. Kafka keeps a day of events to replay after a bad deploy; SQS is less to run but can't replay. I'd pick Kafka.", token)) return;
    update(messages => messages.map(message => message.id === id ? { ...message, streaming: false, parts: [...message.parts ?? [], { kind: "task", task: { id: "ingest", title: "Ingest pipeline", status: "Picking a queue", steps: { done: 2, total: 4 } } }, { kind: "decision", ask: { id: "queue", question: defaultThreadDecisions[0].question, task: "Ingest pipeline" } }, { kind: "text", text: "Once you've picked, I'll deploy to staging and run the smoke test. The deploy plan is ready:" }, { kind: "artifacts", names: ["deploy.yaml", "ingest-design.md"] }] } : message));
    if (!decisionsRef.current.some(decision => decision.id === "queue")) updateDecisions([...decisionsRef.current, defaultThreadDecisions[0]]);
    setFolded(false); setLocalRunning(false);
  };
  useEffect(() => {
    if (simulate === "live") void liveStory();
    if (simulate === "scrolled") { follow.current = false; const frame = requestAnimationFrame(() => { if (scroll.current) scroll.current.scrollTop = Math.max(0, scroll.current.scrollHeight - scroll.current.clientHeight - 280); setAway(true); setNewCount(12); }); return () => cancelAnimationFrame(frame); }
  }, []);
  const retry = (id: string) => {
    onRetry?.(id); if (managed || !simulate) return;
    const failed = messageRef.current.find(message => message.id === id); if (!failed) return;
    if (failed.role === "user") { const options = defaults(); update(messages => messages.map(message => message.id === id ? { ...message, status: connectionRef.current === "online" ? "sent" : "queued" } : message)); if (connectionRef.current === "online") { onSend?.(failed.text ?? "", options); void reply(failed.text ?? ""); } return; }
    update(messages => messages.map(message => message.id === id ? { ...message, streaming: true, parts: message.parts?.filter(part => part.kind !== "error").map(part => part.kind === "tools" ? { ...part, tools: part.tools.map(tool => tool.status === "failed" ? { ...tool, status: "running", startedAt: Date.now() } : tool) } : part) } : message));
    const token = generation.current;
    void (async () => { if (!await pause(1600, token)) return; update(messages => messages.map(message => message.id === id ? { ...message, streaming: false, parts: [...(message.parts?.map(part => part.kind === "tools" ? { ...part, tools: part.tools.map(tool => tool.status === "running" ? { ...tool, status: "done" as const, duration: 1600 } : tool) } : part) ?? []), { kind: "text", text: "The staging cluster answers again – the check passed, so we're good to deploy once you've picked a queue." }] } : message)); })();
  };
  const needsBaseline = useRef({ needs: running?.needs, answered: 0 });
  if (needsBaseline.current.needs !== running?.needs) needsBaseline.current = { needs: running?.needs, answered: Object.keys(answers).length };
  const needs = Math.max(0, safeNumber(running?.needs, decisions.filter(decision => !decision.status || decision.status === "awaiting" || decision.status === "submitting").length) - (managed ? 0 : Object.keys(answers).length - needsBaseline.current.answered));
  const fileChips = (names: string[]) => <div className="ui-th__files" aria-label={labels.createdFiles}>{names.map(name => <button type="button" key={name} className="ui-th__file" title={name} onClick={() => onOpenFile?.(name)}><span data-kind={name.endsWith(".csv") ? "table" : /\.(ya?ml|json|tsx?|js)$/.test(name) ? "code" : "document"}><Icon name={name.endsWith(".csv") ? "table" : "document"} size={12}/></span><span>{name}</span></button>)}</div>;
  const textPart = (text: string, caret: boolean) => <div className="ui-th__text" dir="auto">{text.split(/\n{2,}/).map((paragraph, index, paragraphs) => <p key={index}>{paragraph}{caret && index === paragraphs.length - 1 && <span className="ui-th__caret" aria-hidden="true"/>}</p>)}</div>;
  const completedUploads = uploads.filter(file => file.state === "done" && file.kind !== "voice");
  const blockedUpload = !managed && uploads.some(file => file.kind !== "voice" && file.state !== "done");
  const content = (message: AgentMessage, defaultContent: ReactNode) => renderMessageContent ? renderMessageContent(message, defaultContent) : defaultContent;
  return <section ref={root} data-thread-shortcuts="" className={["ui-th", className].filter(Boolean).join(" ")} data-orchestrator={mode === "orchestrator" || undefined} aria-label={title} onKeyDown={event => { if (event.defaultPrevented || event.repeat || event.nativeEvent.isComposing) return; if (event.key === "Escape" && voicePreview) { event.preventDefault(); setVoicePreview(false); } else if (event.key === "Escape" && streaming) { event.preventDefault(); stop(); } }}>
    <style href="ui-agent-thread" precedence="default">{css}</style>
    <header className="ui-th__head"><h1 className="ui-th__sr">{title}</h1>{running && <div className="ui-th__summary"><button type="button" aria-label={labels.runningTasks(running.running)} onClick={() => onNavigate?.("Tasks")}><i className="ui-th__running-dot"/>{Math.max(0, safeNumber(running.running, 0))}<span>{labels.running}</span></button>{needs > 0 && <><span className="ui-th__summary-separator">·</span><button type="button" aria-label={labels.waitingQuestions(needs, decisions.length > 0)} onClick={() => showDecision()}><i className="ui-th__needs-dot"/>{needs}<span>{labels.needsYou(needs)}</span></button></>}</div>}</header>
    <ConnectionBanner managed labels={labels.connection} connection={connectionState.status} retryIn={managed ? undefined : connectionState.retryIn} backOnline={!managed && connectionState.backOnline} onReconnect={connectionState.reconnect}/>
    <div className="ui-th__body">{!builtInTimeline ? timeline : <><div ref={scroll} className="ui-th__scroll" onScroll={() => { const el = scroll.current; if (!el) return; const pinned = el.scrollHeight - el.clientHeight - el.scrollTop < 40; follow.current = pinned; setAway(!pinned); if (pinned) setNewCount(0); }}><div ref={column} className="ui-th__column" role="log" aria-label={labels.conversation} aria-live="polite" aria-relevant="additions" aria-busy={streaming}>
      {!list.length && <div className="ui-th__empty"><span className="ui-th__empty-icon"><Icon name="spark" size={26}/></span><h2>{labels.emptyTitle}</h2><p>{labels.emptyDescription}</p></div>}
      {list.map((message, messageIndex) => <div className="ui-th__message" data-message-id={message.id} key={message.id}>
        {messageIndex === boundaryIndex && <div ref={unreadBoundary} className="ui-th__unread-boundary"><AwaySummary labels={labels.away} formatTime={formatTime} tasks={[...completedTasks.values()]} decisions={awayDecisions} since={lastSeen} onOpenTask={id => onOpenTask ? onOpenTask(id) : onNavigate?.("Tasks")} onOpenDecision={showDecision} onOpenTasks={() => onNavigate?.("Tasks")} onOpenInbox={() => openInbox()} onMarkRead={read}/></div>}
        {message.role === "user" ? <div className="ui-th__user" data-status={message.status ?? "sent"} data-answer={message.answer?.id}><span className="ui-th__sr">{message.answer ? labels.youAnswered : labels.youSaid}</span>{message.answer && <span className="ui-th__answer-context" title={message.answer.question}>{labels.answerContext(message.answer.question)}</span>}{content(message, <>{message.attachments && message.attachments.length > 0 && <div className="ui-th__attachments">{message.attachments.map((file, index) => <span key={`${file.name}-${index}`}><Icon name="document" size={14}/>{file.name}</span>)}</div>}{message.text && <p className="ui-th__bubble" dir="auto">{message.text}</p>}</>)}{message.status && message.status !== "sent" && <span className="ui-th__send-status">{message.status === "failed" ? <><Icon name="warning" size={12}/>{labels.sendFailed} · <button type="button" onClick={() => retry(message.id)}>{labels.retry}</button></> : message.status === "queued" ? labels.queued : labels.sending}</span>}</div> : <div className="ui-th__assistant" data-streaming={message.streaming || undefined}>
          {messageIndex === 0 || list[messageIndex - 1].role === "user" || messageIndex === boundaryIndex ? <div className="ui-th__who"><span className="ui-th__avatar" data-busy={message.streaming || undefined} aria-hidden="true">{[0, 2, 4, 6, 8].map((pixel, index) => <i key={pixel} style={{ gridArea: `${Math.floor(pixel / 3) + 1}/${pixel % 3 + 1}`, animationDelay: `${index * 130}ms` }}/>)}</span><span>{assistantName}</span>{message.at != null && Number.isFinite(message.at) && <time dateTime={new Date(message.at).toISOString()}>{formatTime(message.at)}</time>}</div> : <span className="ui-th__sr">{assistantName}:</span>}
          {content(message, <>
          {message.tools && message.tools.length > 0 && <ToolActivity labels={labels.tools} tools={message.tools} onRetry={mode === "chat" && onRetry ? () => retry(message.id) : undefined}/>}
          {message.parts?.slice(0, 1).map(part => part.kind === "tools" && <ToolActivity labels={labels.tools} key={part.id} tools={part.tools.map(tool => ({ ...tool, duration: tool.duration ?? tool.ms }))}/>)}
          {message.text && textPart(message.text, !!message.streaming)}
          {message.parts?.map((part, index) => index === 0 && part.kind === "tools" ? null : <div className="ui-th__part" key={`${part.kind}-${index}`}>{part.kind === "tools" ? <ToolActivity labels={labels.tools} tools={part.tools.map(tool => ({ ...tool, duration: tool.duration ?? tool.ms }))}/> : part.kind === "text" ? textPart(part.text, !!message.streaming && index === message.parts!.length - 1 && !message.text) : part.kind === "task" ? <ThreadTaskCard labels={labels.task} task={part.task} onOpen={id => onOpenTask ? onOpenTask(id) : onNavigate?.("Tasks")}/> : part.kind === "artifacts" ? fileChips(part.names) : part.kind === "decision" ? <button type="button" className="ui-th__asked" onClick={() => showDecision(part.ask.id)}><i data-answered={!!answers[part.ask.id] || undefined}/><span>{labels.asked(part.ask.question)}</span><small>· {answers[part.ask.id] ? labels.answeredBelow : decisions.some(decision => decision.id === part.ask.id) ? labels.waiting : labels.inInbox}</small></button> : <div className="ui-th__error" role="status"><Icon name="warning" size={14}/><span dir="auto">{part.text}</span>{part.retry && <button type="button" onClick={() => retry(message.id)}>{labels.retry}</button>}</div>}</div>)}
          {message.files && fileChips(message.files)}</>)}{message.stopped && <span className="ui-th__stopped"><Icon name="stop" size={11}/>{labels.stopped}</span>}
        </div>}
      </div>)}
    </div></div>{away && boundaryIndex < 0 && <button type="button" className="ui-th__jump" aria-label={labels.jumpToLatest(newCount, streaming)} aria-keyshortcuts="End" onClick={latest}><Icon name="arrow" size={14}/>{newCount ? labels.newLines(newCount) : labels.latest}{streaming && <span className="ui-th__jump-live"/>}</button>}</>}</div>
    <footer className="ui-th__foot"><div className="ui-th__foot-column"><div className="ui-th__dock-slot" data-visible={decisions.length > 0 || undefined}><DecisionDock managed={managed} labels={labels.decisions} decisions={decisions} onDecisionsChange={updateDecisions} activeId={activeDecision} onActiveIdChange={setActiveDecision} folded={folded} onFoldedChange={setFolded} onAnswer={answered} onLater={later} focusRequest={focusRequest}/></div>
      {(uploads.length > 0 || voicePreview || streaming) && <div className="ui-th__above">
        {uploads.length > 0 && <div className="ui-th__upload-slot"><ThreadUploads labels={labels.uploads} uploads={uploads} onRemove={managed ? undefined : removeUpload} onRetry={managed ? undefined : retryUpload}/></div>}
        {voicePreview && <div className="ui-th__upload-slot"><ThreadVoiceInput labels={labels.voice} seconds={voiceSeconds} onDiscard={() => setVoicePreview(false)} onDone={finishVoicePreview}/></div>}
        {streaming && !voicePreview && <button type="button" className="ui-th__stop" disabled={stopping} aria-busy={stopping} onClick={stop} aria-keyshortcuts={stopping ? undefined : "Escape"}><Icon name="stop" size={12}/>{stopping ? labels.stopping : labels.stop}</button>}
      </div>}
      {composer ?? <ChatComposer {...composerProps} managed={managed || composerProps?.managed} models={composerProps?.models ?? (mode === "orchestrator" ? [] : undefined)} value={draft} onValueChange={setDraft} attachments={!managed && mode === "orchestrator" ? completedUploads : composerProps?.attachments} onAttachmentsChange={!managed && mode === "orchestrator" ? attach : composerProps?.onAttachmentsChange} showAttachments={!managed && mode === "orchestrator" ? false : composerProps?.showAttachments} sendDisabled={blockedUpload || composerProps?.sendDisabled} transcribe={managed ? undefined : mode === "orchestrator" && (transcribe || simulate) ? voice : composerProps?.transcribe} onSend={send}/>}
    </div></footer><span role="status" aria-live="polite" className="ui-th__sr">{announcement}</span>
  </section>;
}

/* ---------- Styles ---------- */
.ui-th[data-orchestrator]{position:relative}.ui-th[data-orchestrator]>.ui-cn{position:absolute;inset:8px 0 auto;z-index:4;pointer-events:none}.ui-th[data-orchestrator] .ui-th__head{position:absolute;inset:0 0 auto;z-index:2;pointer-events:none;display:flex;align-items:center;gap:12px;height:48px;padding:0 58px 0 24px}.ui-th__title{font-size:13px;font-weight:500;margin:0}.ui-th__summary{pointer-events:auto;display:flex;align-items:center;gap:7px;margin-left:auto;font-size:11px;color:var(--ui-th-muted);font-variant-numeric:tabular-nums}.ui-th__summary button{display:flex;align-items:center;gap:5px;font-size:11px;min-height:28px;border-radius:5px;padding:3px}.ui-th__summary button:hover{background:var(--ui-th-fill)}.ui-th__summary-separator{color:var(--ui-th-faint)}.ui-th__running-dot{width:6px;height:6px;border-radius:50%;border:1px solid #13b8a6}.ui-th__needs-dot{width:5px;height:5px;border-radius:50%;background:#e8a20c}.ui-th[data-orchestrator] .ui-th__scroll{padding-top:56px;padding-bottom:8px;mask-image:linear-gradient(transparent,#000 20px)}.ui-th[data-orchestrator] .ui-th__bubble{max-width:80%}.ui-th__part{margin-top:12px}.ui-th__part:has(.ui-tk)+.ui-th__part:has(.ui-tk){margin-top:8px}.ui-th__part>.ui-th__files{margin-top:0}.ui-th__part>.ui-th__text{margin:0}.ui-th__asked{margin:-2px 0;display:flex;align-items:center;gap:8px;width:100%;padding:0!important;min-height:28px;border-radius:6px;text-align:left;font-size:13px!important;color:var(--ui-th-muted)!important}.ui-th__asked:hover{background:var(--ui-th-fill)}.ui-th__asked>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-th__asked>i{width:6px;height:6px;margin:0 4px;background:#e8a20c;border-radius:50%;flex:none}.ui-th__asked>i[data-answered]{background:#1a9a52}.ui-th__asked>small{font-size:11px;color:var(--ui-th-faint);flex:none}.ui-th__error{display:flex;align-items:center;gap:8px;color:#e5484d;font-size:12px;padding:7px 0}.ui-th__error>span{flex:1;overflow-wrap:anywhere}.ui-th__error button{font-size:12px;text-decoration:underline}.ui-th__answer-context{font-size:11px;color:var(--ui-th-muted);max-width:80%;margin-bottom:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-th__dock-slot[data-visible]{margin-bottom:16px}.ui-th__upload-slot{flex:1;min-width:0}.ui-th[data-orchestrator] .ui-th__above{align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px;padding:0 2px;margin-bottom:8px}.ui-th__jump-live{width:5px;height:5px;background:#13b8a6;border-radius:50%;animation:ui-th-caret 1.2s ease infinite}.ui-th__unread-boundary{position:relative;margin-bottom:18px}.ui-th[data-orchestrator] .ui-th__foot{padding-top:4px}.ui-th[data-orchestrator] .ui-th__foot-column>.ui-cc{margin-top:8px}.ui-th[data-orchestrator] .ui-th__foot-column:has(.ui-th__dock-slot[data-visible])>.ui-cc{margin-top:0}
@container ui-th (max-width:900px){.ui-th__summary{display:none}}
@container ui-th (max-width:560px){.ui-th[data-orchestrator] .ui-th__scroll{padding-inline:12px}.ui-th[data-orchestrator] .ui-th__foot{padding-inline:12px}.ui-th[data-orchestrator] .ui-th__bubble{max-width:88%}.ui-th__asked{flex-wrap:wrap}.ui-th__asked>span{white-space:normal;flex:1}.ui-th__asked>small{margin-left:12px}}

.ui-th{--ui-th-card:#fff;--ui-th-ink:rgba(0,0,0,.88);--ui-th-text:rgba(0,0,0,.61);--ui-th-muted:rgba(0,0,0,.45);--ui-th-faint:rgba(0,0,0,.27);--ui-th-fill:rgba(0,0,0,.04);--ui-th-line:rgba(0,0,0,.06);--ui-th-focus:rgba(0,96,226,.35);--ui-th-ease:cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column;height:100%;min-height:0;width:100%;position:relative;background:var(--ui-th-card);border-radius:inherit;container:ui-th / inline-size;font:14px/1.6 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-th-ink);-webkit-font-smoothing:antialiased}
.ui-th,.ui-th *,.ui-th *::before,.ui-th *::after{box-sizing:border-box}.ui-th :where(button){font:inherit;color:inherit;border:0;background:none;cursor:pointer}.ui-th button:active:not(:disabled){transform:scale(.97)}.ui-th button:focus-visible{outline:2px solid var(--ui-th-focus);outline-offset:2px}.ui-th__head{height:32px;flex:none}.ui-th__body{flex:1;min-height:0;position:relative}.ui-th__scroll{height:100%;overflow-y:auto;overscroll-behavior:contain;padding:24px 32px 12px;scrollbar-width:thin;scrollbar-color:var(--ui-th-line) transparent;overflow-anchor:none}.ui-th__column{max-width:680px;margin-inline:auto;min-width:0}.ui-th__user{display:flex;align-items:flex-end;flex-direction:column;margin:0 0 24px;animation:ui-th-in 420ms var(--ui-th-ease) both}.ui-th__bubble{max-width:94%;margin:0;padding:8px 14px;border-radius:18px;background:var(--ui-th-fill);line-height:22.4px;white-space:pre-wrap;overflow-wrap:anywhere}.ui-th__assistant{margin-bottom:24px;animation:ui-th-in 420ms var(--ui-th-ease) both}.ui-th__who{display:flex;align-items:center;gap:9px;min-height:22px;font-size:13px;line-height:20.8px;margin-bottom:12px}.ui-th__who time{font-size:11px;color:var(--ui-th-faint);font-variant-numeric:tabular-nums}.ui-th__avatar{display:grid;grid-template-columns:repeat(3,3px);grid-template-rows:repeat(3,3px);gap:2px;width:15px;height:15px;flex:none;align-content:center}.ui-th__avatar i{background:#a654ff;width:3px;height:3px}.ui-th__avatar[data-busy] i{animation:ui-th-pixel 1.25s ease-in-out infinite}.ui-th__assistant>.ui-ta{margin-bottom:12px}.ui-th__text p{margin:0 0 12px;overflow-wrap:anywhere;white-space:pre-wrap}.ui-th__text p:last-child{margin-bottom:0}.ui-th__files{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.ui-th__file{display:flex;align-items:center;gap:6px;max-width:240px;height:26px;padding:3px 8px!important;background:var(--ui-th-fill)!important;border-radius:6px;font-size:12px!important}.ui-th__file>span:first-child{display:flex;color:#2989df}.ui-th__file>span[data-kind="table"]{color:#1a9a52}.ui-th__file>span[data-kind="code"]{color:#eb9238}.ui-th__file>span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-th__file:hover{box-shadow:0 0 0 .5px var(--ui-th-line)}.ui-th__foot{padding:12px 32px 20px;position:relative;flex:none}.ui-th__foot-column{width:100%;max-width:680px;margin-inline:auto}.ui-th__above{display:flex;justify-content:center;padding-bottom:10px}.ui-th__stop{display:flex;align-items:center;gap:6px;min-height:28px;padding:3px 12px!important;border-radius:20px;font-size:12px!important;background:var(--ui-th-card)!important;box-shadow:0 0 0 .5px var(--ui-th-line),0 2px 6px rgba(0,0,0,.04);animation:ui-th-in 200ms both}.ui-th__stop:hover{background:var(--ui-th-fill)!important}.ui-th__caret{display:inline-block;width:2px;height:1em;margin-left:3px;background:var(--ui-th-ink);vertical-align:-2px;animation:ui-th-caret 1s steps(2) infinite}.ui-th__stopped,.ui-th__send-status{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--ui-th-muted);margin-top:8px}.ui-th__send-status button{font-size:inherit;text-decoration:underline}.ui-th__attachments{display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end;margin-bottom:7px}.ui-th__attachments>span{display:flex;align-items:center;gap:6px;background:var(--ui-th-fill);border-radius:7px;padding:5px 8px;font-size:12px}.ui-th__jump{display:flex;align-items:center;gap:6px;position:absolute;bottom:12px;left:50%;translate:-50% 0;min-height:30px;padding:4px 12px!important;border-radius:20px;background:var(--ui-th-card)!important;box-shadow:0 0 0 .5px var(--ui-th-line),0 3px 14px rgba(0,0,0,.06);font-size:12px!important;white-space:nowrap;z-index:2}.ui-th__jump svg{rotate:90deg}.ui-th__empty{min-height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:var(--ui-th-muted)}.ui-th__empty-icon{color:#a654ff;margin-bottom:12px}.ui-th__empty h2{font-size:24px;line-height:1.4;font-weight:500;color:var(--ui-th-ink);margin:0 0 8px}.ui-th__empty p{font-size:13px;margin:0}.ui-th__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@keyframes ui-th-in{from{opacity:0;transform:translateY(8px)}}@keyframes ui-th-pixel{50%{opacity:.2}}@keyframes ui-th-caret{50%{opacity:0}}
@container ui-th (max-width:600px){.ui-th__scroll{padding-inline:24px}.ui-th__foot{padding-inline:24px}.ui-th__bubble{max-width:96%}}
@container ui-th (max-width:400px){.ui-th__scroll{padding:20px 16px 12px}.ui-th__foot{padding:12px 12px 14px}.ui-th__bubble{padding:8px 12px}.ui-th__user{margin-bottom:20px}.ui-th__assistant{margin-bottom:26px}.ui-th__empty h2{font-size:21px}}
@media(pointer:coarse){.ui-th__file{height:32px}.ui-th__stop{min-height:36px}.ui-th__jump{min-height:36px}}
@media(prefers-reduced-motion:reduce){.ui-th,.ui-th *{animation:none!important;transition:none!important;scroll-behavior:auto!important}.ui-th__caret{opacity:.45}}
:where(.dark,[data-theme="dark"]) .ui-th{--ui-th-card:#1c1c1e;--ui-th-ink:rgba(255,255,255,.9);--ui-th-text:rgba(255,255,255,.62);--ui-th-muted:rgba(255,255,255,.46);--ui-th-faint:rgba(255,255,255,.3);--ui-th-fill:rgba(255,255,255,.06);--ui-th-line:rgba(255,255,255,.08);--ui-th-focus:rgba(77,141,255,.5)}

@container ui-th (max-width:560px){.ui-th:has(>.ui-cn) .ui-th__summary{visibility:hidden}}
