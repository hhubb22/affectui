  };
  const deliveryRef = useRef({ onSend, simulate }); deliveryRef.current = { onSend, simulate };
  useEffect(() => {
    if (managed || connectionState.status !== "online") return;
    const queued = messageRef.current.filter(message => message.role === "user" && message.status === "queued" && !delivered.current.has(message.id));
    queued.forEach(message => delivered.current.add(message.id));
    if (!queued.length) return;
    update(messages => messages.map(message => queued.some(item => item.id === message.id) ? { ...message, status: "sending" } : message));
    const deliveryTimer = setTimeout(() => { deliveryTimers.current.delete(deliveryTimer); if (!mounted.current) return; if (connectionRef.current !== "online") { queued.forEach(message => delivered.current.delete(message.id)); update(messages => messages.map(message => queued.some(item => item.id === message.id) ? { ...message, status: "queued" } : message)); return; } update(messages => messages.map(message => queued.some(item => item.id === message.id) ? { ...message, status: "sent" } : message)); queued.forEach(message => { const options = pending.current.get(message.id) ?? defaults(); pending.current.delete(message.id); if (!message.answer) deliveryRef.current.onSend?.(message.text ?? "", options); }); if (deliveryRef.current.simulate && queued.some(message => !message.answer)) { update(messages => messages.map(message => message.streaming ? { ...message, streaming: false } : message)); void reply(queued.at(-1)?.text ?? ""); } }, 600); deliveryTimers.current.add(deliveryTimer);
