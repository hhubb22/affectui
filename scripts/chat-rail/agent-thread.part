export type ThreadPreset = "live" | "decision" | "scrolled" | "offline" | "uploading" | "dictating" | "away" | "error";
export type AgentMessagePart =
  | { kind: "text"; text: string }
  | { kind: "tools"; id: string; tools: (ToolActivityItem & { ms?: number })[] }
  | { kind: "task"; task: ThreadTask }
  | { kind: "decision"; ask: { id: string; question: string; task?: string; kind?: string } }
  | { kind: "artifacts"; names: string[] }
  | { kind: "error"; text: string; retry?: boolean };
export type AgentMessage = {
  id: string;
  role: "user" | "assistant" | "agent";
  text?: string;
  at?: number;
  parts?: AgentMessagePart[];
  tools?: ToolActivityItem[];
  files?: string[];
  attachments?: { name: string; size?: number }[];
  streaming?: boolean;
  stopped?: boolean;
  status?: "sent" | "sending" | "queued" | "failed";
  answer?: { id: string; question: string };
};
const defaultAgentThreadLabels = {
  conversation: "Conversation", emptyTitle: "What can I help you with?", emptyDescription: "Ask a question, explore an idea, or bring a file.", createdFiles: "Created files", youSaid: "You said:", youAnswered: "You answered:", answerContext: (question: string) => `Answered: ${question}`, asked: (question: string) => `Asked: ${question}`, answeredBelow: "answered below", waiting: "waiting", inInbox: "in Inbox",
  retry: "Retry", sendFailed: "Couldn't send", queued: "Waiting to send", sending: "Sending…", stop: "Stop", stopping: "Stopping…", stopped: "Stopped", responseStopped: "Response stopped", responseComplete: "Response complete", queuedAnnouncement: "Waiting to send – it goes out when you're back online", uploadFailed: (name: string) => `Upload failed: ${name}`, voiceSaved: "Voice note saved – it will transcribe when you're back online", voiceNote: "Voice note", answeredAnnouncement: (answer: string) => `Answered: ${answer}`, laterAnnouncement: "Later – the decision waits above the composer", markedRead: "Marked as read",
  running: "running", runningTasks: (count: number) => `${count} tasks running – open Tasks`, needsYou: (count: number) => `need${count === 1 ? "s" : ""} you`, waitingQuestions: (count: number, dock: boolean) => `${count} questions waiting – ${dock ? "show the decision" : "open Inbox"}`,
  latest: "Back to latest", newLines: (count: number) => `${count} new lines`, jumpToLatest: (count: number, streaming: boolean) => `Jump to latest${count ? `, ${count} new lines` : ""}${streaming ? ", still writing" : ""}`,
};
export type AgentThreadLabels = typeof defaultAgentThreadLabels & { decisions?: Partial<DecisionDockLabels>; connection?: Partial<ConnectionBannerLabels>; uploads?: Partial<ThreadUploadsLabels>; voice?: Partial<ThreadVoiceInputLabels>; away?: Partial<AwaySummaryLabels>; tools?: Partial<ToolActivityLabels>; task?: Partial<ThreadTaskCardLabels> };
export type AgentThreadProps = {
  /** Caller owns all business state. default* fixtures and simulate are ignored. */
  managed?: boolean;
  /** A stop intent is pending; do not infer that tools have stopped. */
  stopping?: boolean;
  renderMessageContent?: (message: AgentMessage, defaultContent: ReactNode) => ReactNode;
  /** Replaces the message list and its scrolling/log semantics; undefined keeps the built-in timeline. */
  timeline?: ReactNode;
  labels?: Partial<AgentThreadLabels>;
  formatTime?: (timestamp: number) => string;
  messages?: AgentMessage[];
  defaultMessages?: AgentMessage[];
  onMessagesChange?: (messages: AgentMessage[]) => void;
  title?: string;
  assistantName?: string;
  mode?: "chat" | "orchestrator";
  onSend?: (message: string, options: ChatComposerSendOptions) => void;
  onStop?: () => void;
  onRetry?: (id: string) => void;
  onOpenFile?: (name: string) => void;
  onNavigate?: (label: string) => void;
  onOpenTask?: (id: string) => void;
  onOpenInbox?: (id?: string) => void;
  running?: { running: number; needs: number };
  decisions?: ThreadDecision[];
  defaultDecisions?: ThreadDecision[];
  onDecisionsChange?: (decisions: ThreadDecision[]) => void;
  onDecide?: (id: string, answer: ThreadDecisionAnswer) => void;
  onLater?: (id: string) => void;
  decisionRequest?: { id: string; sequence: number };
  folded?: boolean;
  defaultFolded?: boolean;
  onFoldedChange?: (folded: boolean) => void;
  connection?: ThreadConnection;
  defaultConnection?: ThreadConnection;
  onConnectionChange?: (connection: ThreadConnection) => void;
  onReconnect?: () => void | Promise<void>;
  lastSeen?: number;
  defaultLastSeen?: number;
  onLastSeenChange?: (at: number | undefined) => void;
  awayAfter?: number;
  onMarkRead?: () => void;
  uploads?: ThreadUpload[];
  defaultUploads?: ThreadUpload[];
  onUploadsChange?: (uploads: ThreadUpload[]) => void;
  upload?: (file: File, progress: (progress: number) => void, signal: AbortSignal) => Promise<void>;
  transcribe?: (clip: ThreadAttachment) => Promise<string>;
  composerProps?: Omit<ChatComposerProps, "onSend">;
  composer?: ReactNode;
  simulate?: boolean | ThreadPreset;
  className?: string;
};

export const defaultAgentMessages: AgentMessage[] = [
  { id: "fabric-question", role: "user", text: "What's the best fabric for a summer overshirt – linen, cotton or a blend?" },
  { id: "fabric-answer", role: "assistant", at: Date.UTC(2026, 10, 8, 10, 48), tools: [
    { id: "web", label: "Searched the web for “linen vs cotton breathability”", status: "done", duration: 1400 },
    { id: "read", label: "Read 6 pages", status: "done", duration: 3100 },
    { id: "compare", label: "Compared weights, creasing and price", status: "done", duration: 900 },
  ], text: "Linen breathes best – it pulls moisture off the skin and dries fast, which is why it feels cool on a hot day. The trade-off is creasing: a pure linen overshirt looks lived-in after an hour.\n\nFor an overshirt I'd take a linen-cotton blend around 55/45 at 160–180 gsm: it keeps most of the coolness, creases far less and is soft from the first wear. Pure linen if the relaxed look is the point; seersucker if it has to look sharp all day.", files: ["fabric-comparison.csv", "sources.md"] },
  { id: "weight-question", role: "user", text: "Which weight for a shirt you can wear open over a T-shirt?" },
  { id: "weight-answer", role: "assistant", at: Date.UTC(2026, 10, 8, 10, 52), tools: [{ id: "weight", label: "Searched the web for “overshirt fabric weight gsm”", status: "done", duration: 1200 }], text: "Go a little heavier than a shirt: 180–200 gsm. It hangs straight when it's open, doesn't cling to the T-shirt underneath and still breathes – under 160 gsm it starts to look like a shirt you forgot to button." },
];

/** A conversation that preserves decisions, uploads and queued messages across interrupted connections. */
export function AgentThread({ managed = false, stopping = false, renderMessageContent, timeline, labels: labelsProp, formatTime = defaultThreadFormatTime, messages: messagesProp, defaultMessages = defaultAgentMessages, onMessagesChange, title = "Best fabric for a summer overshirt", assistantName = "Assistant", mode = "chat", onSend, onStop, onRetry, onOpenFile, onNavigate, onOpenTask, onOpenInbox, running, decisions: decisionsProp, defaultDecisions = [], onDecisionsChange, onDecide, onLater, decisionRequest, folded: foldedProp, defaultFolded = false, onFoldedChange, connection, defaultConnection, onConnectionChange, onReconnect, lastSeen: lastSeenProp, defaultLastSeen, onLastSeenChange, awayAfter = 5, onMarkRead, uploads: uploadsProp, defaultUploads = [], onUploadsChange, upload, transcribe, composerProps, composer, simulate: simulateProp = messagesProp === undefined && onSend === undefined, className }: AgentThreadProps) {
  const simulate = !managed && simulateProp;
