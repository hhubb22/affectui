    if (!await pause(1300, token)) return;
    update(messages => messages.map(message => message.id === id ? { ...message, tools: message.tools?.map(tool => ({ ...tool, status: "done", duration: 1300 })) } : message));
    const response = mode === "orchestrator" ? "I've checked the project notes and the current tasks. I'll keep the work moving and bring the next decision back here when I need your input." : "Here's what I found: the sources agree on the main point, and the comparison sheet has the numbers side by side. Want me to turn it into a short brief for the supplier?";
    if (!await streamText(id, response, token)) return;
    update(messages => messages.map(message => message.id === id ? { ...message, streaming: false } : message)); setLocalRunning(false); setAnnouncement(labels.responseComplete);
  };
  const defaults = (): ChatComposerSendOptions => ({ model: composerProps?.model ?? "auto", approval: composerProps?.approval ?? "request", planMode: composerProps?.planMode ?? false, attachments: [] });
  const pending = useRef<Map<string, ChatComposerSendOptions>>(new Map());
  const send = (text: string, options: ChatComposerSendOptions) => {
    if (managed) { onSend?.(text, options); return; }
