export type TaskInspectorLabels = { needsYou?: string; decide?: string; decisionOne?: string; decisionMany?: string; happened?: string; showAgents?: string; status?: string; project?: string; started?: string; steps?: string; artifacts?: string; decided?: string; selectTask?: string };
export type TaskInspectorProps = { task?: AgentTask | null; onOpenInbox?: (taskId: string,itemId?: string) => void; onOpenArtifact?: (name: string) => void; onShowAgents?: (taskId: string) => void; labels?: TaskInspectorLabels; focusRequest?: number; now?: number; className?: string };

/** Task context and its outputs, with one direct route to what waits in the Inbox. */
export function TaskInspector({task, onOpenInbox, onOpenArtifact, onShowAgents, labels = {}, focusRequest, now = Date.now(), className}: TaskInspectorProps) {
  const root=useRef<HTMLElement>(null), id=useId();
  useEffect(()=>{if(!focusRequest)return;const frame=requestAnimationFrame(()=>{const target=root.current?.querySelector<HTMLButtonElement>("[data-task-decide]");if(target)target.focus({preventScroll:true});else root.current?.focus({preventScroll:true});});return()=>cancelAnimationFrame(frame);},[focusRequest,task?.id]);
  if(!task)return <section className={["ui-tin",className].filter(Boolean).join(" ")}><style href="ui-task-inspector" precedence="default">{css}</style><div className="ui-tin__empty"><Icon name="tasks" size={28}/><p>{labels.selectTask??"Select a task"}</p></div></section>;
  const steps=task.steps??[], done=steps.filter(step=>step.done).length, needs=agentTaskNeeds(task), first=steps.findIndex(step=>!step.done), status=agentTaskStatus(task,now), ask=task.asks?.[0];
  return <section ref={root} className={["ui-tin",className].filter(Boolean).join(" ")} aria-labelledby={`${id}-title`} tabIndex={-1}>
    <style href="ui-task-inspector" precedence="default">{css}</style>
    <h2 className="ui-tin__sr" id={`${id}-title`}>{task.title}</h2><div className="ui-tin__body">
      {task.goal&&<p className="ui-tin__goal" dir="auto">{task.goal}</p>}
      {needs>0&&<div className="ui-tin__needs"><div className="ui-tin__needs-text"><div><span className="ui-tin__badge">{labels.needsYou??"Needs you"}</span><span className="ui-tin__waiting">{needs===1?labels.decisionOne??"1 decision waiting":(labels.decisionMany??"{count} decisions waiting").replace("{count}",String(needs))}</span></div>{ask?.question&&<span className="ui-tin__question" dir="auto">{ask.question}</span>}</div><button type="button" data-task-decide="" className="ui-tin__decide" aria-label={`${labels.decide??"Decide"} in Inbox${ask?.question?`: ${ask.question}`:""}`} disabled={!onOpenInbox} onClick={()=>onOpenInbox?.(task.id,ask?.id)}>{labels.decide??"Decide"}</button></div>}
      <dl className="ui-tin__props"><div><dt>{labels.status??"Status"}</dt><dd><TaskProgressRing status={task.status} done={task.done} needs={!!needs} value={done} max={steps.length}/><span title={status} dir="auto">{status}</span>{steps.length>0&&<small>{done}/{steps.length}</small>}</dd></div><div><dt>{labels.project??"Project"}</dt><dd dir="auto">{task.project}</dd></div>{task.started&&<div><dt>{labels.started??"Started"}</dt><dd>{task.started}</dd></div>}</dl>
      {steps.length>0&&<section className="ui-tin__section"><h3>{labels.steps??"Steps"}</h3><ol className="ui-tin__steps">{steps.map((step,index)=>{const state=step.done?"done":index===first?needs?"you":"now":"later";return <li key={`${index}-${step.label}`} data-state={state}><span className="ui-tin__step-mark" aria-hidden="true">{step.done&&<Icon name="check" size={10}/>}</span><span className="ui-tin__step-label" title={step.label} dir="auto">{step.label}</span><span className="ui-tin__sr">{state==="done"?", done":state==="you"?", waiting on you":state==="now"?", in progress":""}</span>{state==="you"&&<button type="button" className="ui-tin__step-ask" aria-label={`Open decision${ask?.question?`: ${ask.question}`:""}`} onClick={()=>onOpenInbox?.(task.id,ask?.id)}><Icon name="warning" size={12}/></button>}</li>;})}</ol></section>}
      {!!task.history?.length&&<section className="ui-tin__section"><h3>{labels.happened??"What happened so far"}</h3><ul className="ui-tin__history">{task.history.map((line,index)=><li key={index} dir="auto">{line}</li>)}</ul></section>}
      {!!task.artifacts?.length&&<section className="ui-tin__section"><h3>{labels.artifacts??"Artifacts"}<span>{task.artifacts.length}</span></h3><div className="ui-tin__files">{task.artifacts.map(name=><button type="button" key={name} title={name} onClick={()=>onOpenArtifact?.(name)}><span data-kind={name.includes(".")?name.endsWith(".csv")?"table":/\.(json|ya?ml)$/.test(name)?"code":"document":"folder"}><Icon name={name.includes(".")?name.endsWith(".csv")?"table":"document":"folder"} size={12}/></span><span dir="auto">{name}</span></button>)}</div></section>}
      {!!task.decided?.length&&<section className="ui-tin__section"><h3>{labels.decided??"Decided"}</h3><ul className="ui-tin__decided">{task.decided.map((item,index)=><li key={index}><Icon name="check" size={13}/><span><strong title={item.question} dir="auto">{item.question}</strong><small title={item.answer} dir="auto">{item.answer}{item.at!=null&&` · ${now-item.at>=86400000&&now-item.at<172800000?"yesterday":agentTaskAge(item.at,now).long}`}</small></span></li>)}</ul></section>}
      <footer><button type="button" disabled={!onShowAgents} onClick={()=>onShowAgents?.(task.id)}>{labels.showAgents??"Show agents"}<Icon name="chevron" size={12}/></button></footer>
    </div>
  </section>;
}

/* ---------- Styles ---------- */
.ui-tin{--ui-tin-card:#fff;--ui-tin-ink:rgba(0,0,0,.88);--ui-tin-text:rgba(0,0,0,.61);--ui-tin-muted:rgba(0,0,0,.45);--ui-tin-faint:rgba(0,0,0,.27);--ui-tin-line:rgba(0,0,0,.06);--ui-tin-fill:rgba(0,0,0,.02);--ui-tin-focus:#0060e2;--ui-tin-blue:#0190fe;--ui-tin-orange:#f28a2e;--ui-tin-shadow:0 0 0 .5px var(--ui-tin-line),0 1px 2px rgba(0,0,0,.025);height:100%;width:100%;min-height:0;overflow:auto;overscroll-behavior:contain;padding:18px 18px 16px;font:13px/20px "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-tin-ink);container:ui-tin / inline-size;-webkit-font-smoothing:antialiased;outline:none}
.ui-tin,.ui-tin *,.ui-tin *::before,.ui-tin *::after{box-sizing:border-box}.ui-tin button{font:inherit;border:0;background:none;color:inherit;cursor:pointer}.ui-tin button:disabled{opacity:.4;cursor:default}.ui-tin button:active:not(:disabled){transform:scale(.97)}.ui-tin button:focus-visible{outline:2px solid var(--ui-tin-focus);outline-offset:-2px}.ui-tin__body{display:flex;flex-direction:column;gap:20px;min-width:0}.ui-tin__goal{margin:0;white-space:pre-line;overflow-wrap:anywhere;color:var(--ui-tin-text)}.ui-tin__needs{display:flex;align-items:center;gap:12px;min-height:56px;margin:0 -10px;padding:8px 8px 8px 10px;border-radius:10px;background:var(--ui-tin-card);box-shadow:var(--ui-tin-shadow)}.ui-tin__needs-text{display:flex;flex:1;min-width:0;flex-direction:column;gap:2px}.ui-tin__needs-text>div{display:flex;align-items:center;gap:8px}.ui-tin__badge{font-size:11px;line-height:18px;font-weight:500;padding:0 6px;border-radius:4px;white-space:nowrap;background:rgba(255,156,0,.16);color:#cc4e00}.ui-tin__waiting{font-size:12px;line-height:16px;color:var(--ui-tin-muted);font-variant-numeric:tabular-nums}.ui-tin__question{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere;line-height:20px}.ui-tin__decide{height:28px;padding:0 10px;border-radius:6px;background:var(--ui-tin-ink)!important;color:var(--ui-tin-card)!important;font-weight:500!important;flex:none}.ui-tin__props{display:grid;gap:2px;margin:0}.ui-tin__props>div{display:grid;grid-template-columns:76px minmax(0,1fr);align-items:center;min-height:28px}.ui-tin__props dt{font-size:12px;color:var(--ui-tin-muted)}.ui-tin__props dd{display:flex;align-items:center;gap:6px;min-width:0;margin:0}.ui-tin__props dd>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tin__props small{font-size:12px;color:var(--ui-tin-faint);font-variant-numeric:tabular-nums}.ui-tin__section{display:flex;flex-direction:column;gap:8px}.ui-tin__section h3{display:flex;gap:6px;margin:0;font-size:12px;line-height:16px;font-weight:500;color:var(--ui-tin-muted)}.ui-tin__section h3>span{font-weight:400;color:var(--ui-tin-faint);font-variant-numeric:tabular-nums}.ui-tin__steps{display:grid;margin:0 -10px;padding:6px 10px;list-style:none;border-radius:10px;background:var(--ui-tin-fill)}.ui-tin__steps li{position:relative;display:flex;align-items:center;gap:10px;min-height:28px}.ui-tin__steps li:not(:last-child):after{content:"";position:absolute;top:20px;bottom:-6px;left:7px;width:1px;background:var(--ui-tin-line)}.ui-tin__step-mark{position:relative;z-index:1;display:grid;place-items:center;flex:none;width:15px;height:15px;border-radius:50%;box-shadow:inset 0 0 0 1.2px var(--ui-tin-line);background:var(--ui-tin-card);color:var(--ui-tin-card)}.ui-tin__steps li[data-state="done"] .ui-tin__step-mark{background:var(--ui-tin-blue);box-shadow:none}.ui-tin__steps li[data-state="you"] .ui-tin__step-mark{background:color-mix(in srgb,var(--ui-tin-orange) 18%,var(--ui-tin-card));box-shadow:inset 0 0 0 1.5px var(--ui-tin-orange)}.ui-tin__steps li[data-state="now"] .ui-tin__step-mark{background:color-mix(in srgb,var(--ui-tin-blue) 18%,var(--ui-tin-card));box-shadow:inset 0 0 0 1.5px var(--ui-tin-blue)}.ui-tin__step-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tin__steps li:is([data-state="done"],[data-state="later"]) .ui-tin__step-label{color:var(--ui-tin-muted)}.ui-tin__step-ask{display:grid;place-items:center;width:18px;height:18px;margin-left:auto;padding:0;border-radius:3px;background:rgba(255,156,0,.16)!important;color:#cc4e00!important}.ui-tin__history{display:grid;gap:4px;margin:0;padding:0;list-style:none;color:var(--ui-tin-text)}.ui-tin__history li{position:relative;padding-left:16px;overflow-wrap:anywhere}.ui-tin__history li:before{content:"";position:absolute;top:8px;left:5px;width:4px;height:4px;border-radius:50%;background:var(--ui-tin-faint)}.ui-tin__history li:first-child{color:var(--ui-tin-ink)}.ui-tin__files{display:flex;flex-wrap:wrap;gap:6px}.ui-tin__files>button{display:flex;align-items:center;gap:6px;min-width:0;max-width:100%;height:26px;padding:3px 8px;border-radius:6px;font-size:12px;background:var(--ui-tin-fill)}.ui-tin__files>button>span:first-child{display:flex;color:#2989df}.ui-tin__files>button>span[data-kind="table"]{color:#44ad76}.ui-tin__files>button>span[data-kind="code"]{color:#ed9540}.ui-tin__files>button>span[data-kind="folder"]{color:#e8b000}.ui-tin__files>button>span:last-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tin__decided{display:grid;gap:0;margin:0 -10px;padding:2px 10px;list-style:none;border-radius:10px;background:var(--ui-tin-card);box-shadow:var(--ui-tin-shadow)}.ui-tin__decided li{display:flex;align-items:center;gap:10px;padding:8px 0}.ui-tin__decided li+li{border-top:.5px solid var(--ui-tin-line)}.ui-tin__decided li>svg{color:#5fc88a;flex:none}.ui-tin__decided li>span{display:grid;min-width:0}.ui-tin__decided strong{font-weight:400;line-height:20px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tin__decided small{font-size:12px;line-height:16px;color:var(--ui-tin-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ui-tin footer{display:flex;justify-content:flex-end;min-height:28px;margin:0 -4px 0 -8px}.ui-tin footer>button{display:flex;align-items:center;gap:4px;height:28px;padding:0 8px;border-radius:6px;font-size:12px;color:var(--ui-tin-faint)}.ui-tin footer>button:hover{background:var(--ui-tin-fill);color:var(--ui-tin-text)}.ui-tin footer>button svg{rotate:-90deg}.ui-tin__empty{min-height:240px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ui-tin-muted)}.ui-tin__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@container ui-tin (max-width:320px){.ui-tin__props>div{grid-template-columns:60px minmax(0,1fr)}.ui-tin__needs{gap:6px}.ui-tin__waiting{font-size:11px}}
@media(pointer:coarse){.ui-tin button{min-height:36px}.ui-tin__steps li{min-height:32px}.ui-tin__step-ask{min-width:32px}.ui-tin__files>button{height:32px}}
@media(prefers-reduced-motion:reduce){.ui-tin,.ui-tin *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
:where(.dark,[data-theme="dark"]) .ui-tin{--ui-tin-card:#1c1c1e;--ui-tin-ink:rgba(255,255,255,.9);--ui-tin-text:rgba(255,255,255,.62);--ui-tin-muted:rgba(255,255,255,.46);--ui-tin-faint:rgba(255,255,255,.3);--ui-tin-line:rgba(255,255,255,.08);--ui-tin-fill:rgba(255,255,255,.025);--ui-tin-focus:#4d8dff;--ui-tin-blue:#4fb0fe;--ui-tin-orange:#f2a15c}
:where(.dark,[data-theme="dark"]) .ui-tin__badge,:where(.dark,[data-theme="dark"]) .ui-tin__step-ask{background:rgba(251,106,0,.15)!important;color:#ffa057!important}
