export type ArtifactNumberFormat = "General" | "Number" | "Currency" | "Percent";
export type ArtifactTable = { kind: "table"; name: string; rows: string[][]; updated?: string; columnWidths?: number[]; boldCells?: string[]; formats?: Record<string, ArtifactNumberFormat> };
export type ArtifactDocument = { kind: "document"; name: string; content: string; html?: string; updated?: string };
export type ArtifactCode = { kind: "code"; name: string; content: string; language?: string; updated?: string };
export type ArtifactDirectory = { kind: "folder"; name: string; entries: ArtifactFolderEntry[]; updated?: string };
export type ArtifactImage = { kind: "image"; name: string; src: string; alt?: string; updated?: string };
export type ArtifactFile = ArtifactTable | ArtifactDocument | ArtifactCode | ArtifactDirectory | ArtifactImage;
export type ArtifactWorkspaceTab = { id: string; label: string; icon?: ReactNode; content: ReactNode };
export type ArtifactWorkspaceProps = {
  files?: ArtifactFile[];
  defaultFiles?: ArtifactFile[];
  onFilesChange?: (files: ArtifactFile[]) => void;
  openFiles?: string[];
  defaultOpenFiles?: string[];
  onOpenFilesChange?: (names: string[]) => void;
  activeFile?: string;
  defaultActiveFile?: string;
  onActiveFileChange?: (name: string) => void;
  onClose?: () => void;
  closeLabel?: string;
  onNewTab?: () => void;
  onOpenFile?: (name: string) => void;
  /** Additional tabs, such as a task detail view. File tabs remain open alongside them. */
  tabs?: ArtifactWorkspaceTab[];
  className?: string;
};

export const defaultArtifacts: ArtifactFile[] = [
  { kind: "table", name: "fabric-comparison.csv", updated: "Just now", rows: [
    ["Fabric", "Weight (gsm)", "Breathes", "Creases", "Price / m"],
    ["Linen", "150–190", "Best", "A lot", "€14"],
    ["Linen-cotton 55/45", "160–180", "Very well", "Some", "€11"],
    ["Cotton poplin", "110–130", "Well", "Little", "€8"],
    ["Cotton seersucker", "140–160", "Very well", "Hardly", "€10"],
  ] },
  { kind: "document", name: "sources.md", updated: "Just now", content: "# Sources\n\nSix pages the assistant read for this answer, with what it took from each.\n\n- Textile Exchange – Preferred Fiber Report: linen’s water and pesticide use\n- The Fabric Store – Linen weights explained: 150–190 gsm for shirts\n- Merchant & Mills – Linen-cotton blends: fewer creases, softer from the start\n- Hemp & Linen Institute – Moisture regain of flax vs. cotton\n- Permanent Style – Seersucker in summer tailoring\n- Reddit r/malefashionadvice – How linen shirts age after a summer" },
];

/** Tabbed, editable files with a spreadsheet, rich text documents, undo/redo and a file chooser. */
export function ArtifactWorkspace({ files: filesProp, defaultFiles = defaultArtifacts, onFilesChange, openFiles: openProp, defaultOpenFiles, onOpenFilesChange, activeFile: activeProp, defaultActiveFile, onActiveFileChange, onClose, closeLabel = "Close artifacts", onNewTab, onOpenFile, tabs: extraTabs = [], className }: ArtifactWorkspaceProps) {
  const [files, setFiles] = useControllable(filesProp, defaultFiles, onFilesChange);
  const [opened, setOpened] = useControllable(openProp, defaultOpenFiles ?? (filesProp ?? defaultFiles).map(file => file.name), onOpenFilesChange);
  const [active, setActive] = useControllable(activeProp, defaultActiveFile ?? defaultOpenFiles?.[0] ?? (filesProp ?? defaultFiles)[0]?.name ?? "", onActiveFileChange);
  const [query, setQuery] = useState("");
  const [historyVersion, setHistoryVersion] = useState(0);
  const histories = useRef<Record<string, { past: ArtifactFile[]; future: ArtifactFile[] }>>({});
  const tabs = useRef<HTMLDivElement>(null);
  const id = useId();
  const list = (Array.isArray(files) ? files : []).filter(Boolean);
  const names = opened.filter(name => list.some(file => file.name === name) || extraTabs.some(tab => tab.id === name));
  const currentName = names.includes(active) ? active : names[0] ?? "";
  const file = active === "__new" ? undefined : list.find(item => item.name === currentName);
  const extraTab = active === "__new" ? undefined : extraTabs.find(tab => tab.id === currentName);
  const history = file ? histories.current[file.name] : undefined;
  const update = (next: ArtifactFile, nextList = list) => {
    const old = list.find(item => item.name === next.name);
    if (!old || JSON.stringify(old) === JSON.stringify(next)) return;
    const history = histories.current[next.name] ??= { past: [], future: [] };
    history.past = [...history.past.slice(-49), old]; history.future = [];
    setFiles(nextList.map(item => item.name === next.name ? next : item)); setHistoryVersion(historyVersion + 1);
  };
  const updateDirectory = (directory: ArtifactDirectory, entries: ArtifactFolderEntry[]) => {
    const removed = directory.entries.filter(entry => !entries.some(next => next.name === entry.name));
    const added = entries.filter(entry => !directory.entries.some(previous => previous.name === entry.name));
    const [removedEntry] = removed, [addedEntry] = added;
    let nextList = list;
    if (directory.entries.length === entries.length && removed.length === 1 && added.length === 1 && removedEntry && addedEntry) {
      nextList = list.map(item => item.name === removedEntry.name ? { ...item, name: addedEntry.name } : item);
      setOpened(opened.map(name => name === removedEntry.name ? addedEntry.name : name));
    }
    update({ ...directory, entries }, nextList);
  };
  const travel = (direction: "undo" | "redo") => {
    if (!file) return;
    const history = histories.current[file.name]; if (!history) return;
    const source = direction === "undo" ? history.past : history.future;
    const previous = source.pop(); if (!previous) return;
    (direction === "undo" ? history.future : history.past).push(file);
    setFiles(list.map(item => item.name === file.name ? previous : item)); setHistoryVersion(historyVersion + 1);
  };
  const open = (name: string) => {
    if (!list.some(item => item.name === name)) {
      const source = list.find(item => item.name === name.replace(/ copy(?: \d+)?$/, ""));
      const entry = file?.kind === "folder" ? file.entries.find(entry => entry.name === name) : undefined;
      const next: ArtifactFile = source ? { ...source, name } : entry?.kind === "folder" ? { kind: "folder", name, entries: [] } : entry?.kind === "table" ? { kind: "table", name, rows: [[""]] } : entry?.kind === "code" ? { kind: "code", name, content: "" } : { kind: "document", name, content: `# ${name}\n\n` };
      setFiles([...list, next]);
    }
    if (!names.includes(name)) setOpened([...names, name]); setActive(name); onOpenFile?.(name);
  };
  const close = (name: string) => {
    const remaining = names.filter(item => item !== name); setOpened(remaining);
    const next = currentName === name ? remaining[Math.min(names.indexOf(name), remaining.length - 1)] : currentName;
    if (currentName === name) setActive(next ?? "__new");
    if (remaining.length && tabs.current?.contains(document.activeElement)) requestAnimationFrame(() => {
      const buttons = [...(tabs.current?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])];
      buttons.find(button => button.id === `${id}-${encodeURIComponent(next ?? "")}`)?.focus({ preventScroll: true });
    });
  };
  const create = (kind: "table" | "document") => {
    const extension = kind === "table" ? "csv" : "md";
    let index = 1; while (list.some(item => item.name === `Untitled ${index}.${extension}`)) index++;
    const name = `Untitled ${index}.${extension}`;
    const next: ArtifactFile = kind === "table" ? { kind, name, rows: [[""]], updated: "Just now" } : { kind, name, content: "# Untitled\n\n", updated: "Just now" };
    setFiles([...list, next]); setOpened([...names, name]); setActive(name);
  };
  const tabKey = (event: KeyboardEvent<HTMLButtonElement>, name: string) => {
    const index = names.indexOf(name);
    const next = event.key === "ArrowRight" ? (index + 1) % names.length : event.key === "ArrowLeft" ? (index - 1 + names.length) % names.length : event.key === "Home" ? 0 : event.key === "End" ? names.length - 1 : null;
    if (next !== null && names[next] !== undefined) { event.preventDefault(); setActive(names[next]); tabs.current?.querySelectorAll<HTMLButtonElement>('[role="tab"]')[next]?.focus(); }
    if (event.key === "Delete") { event.preventDefault(); close(name); }
  };
  return <section className={["ui-aw", className].filter(Boolean).join(" ")} aria-label="File workspace" onKeyDown={event => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "z" && !isEditing(event.target)) { event.preventDefault(); travel(event.shiftKey ? "redo" : "undo"); } }}>
    <style href="ui-artifact-workspace" precedence="default">{css}</style>
    <header className="ui-aw__bar"><div ref={tabs} className="ui-aw__tabs" role="tablist" aria-label="Open files">{names.map(name => <div className="ui-aw__tab-wrap" key={name} data-active={currentName === name && active !== "__new" || undefined}>
      <button type="button" role="tab" aria-selected={currentName === name && active !== "__new"} aria-controls={`${id}-pane`} id={`${id}-${encodeURIComponent(name)}`} tabIndex={currentName === name && active !== "__new" ? 0 : -1} className="ui-aw__tab" title={extraTabs.find(tab => tab.id === name)?.label ?? name} onClick={() => setActive(name)} onKeyDown={event => tabKey(event, name)}><span aria-hidden="true">{extraTabs.find(tab => tab.id === name)?.icon ?? <Icon name={list.find(item => item.name === name)?.kind === "table" ? "table" : "document"} size={14}/>}</span><span>{extraTabs.find(tab => tab.id === name)?.label ?? name}</span></button>
      <button type="button" className="ui-aw__tab-close" aria-label={`Close ${extraTabs.find(tab => tab.id === name)?.label ?? name}`} onClick={() => close(name)}><Icon name="close" size={10}/></button>
    </div>)}</div><button type="button" className="ui-aw__tool" aria-label="New tab" title="New tab" onClick={() => onNewTab ? onNewTab() : setActive("__new")}><Icon name="plus" size={16}/></button>{onClose && <button type="button" className="ui-aw__tool ui-aw__collapse" aria-label={closeLabel} onClick={onClose}><Icon name="panel"/></button>}</header>
    <div className="ui-aw__pane" id={`${id}-pane`} role="tabpanel" aria-labelledby={file || extraTab ? `${id}-${encodeURIComponent(currentName)}` : undefined} aria-label={file || extraTab ? undefined : "Open a file"}>
      {extraTab ? extraTab.content : file ? <><header className="ui-aw__heading"><span className="ui-aw__file-icon" data-kind={file.kind}><Icon name={file.kind === "table" ? "table" : file.kind === "folder" ? "folder" : file.kind === "image" ? "image" : "document"} size={16}/></span><span><strong title={file.name}>{file.name}</strong><small>{file.kind === "folder" ? `${(file.updated ?? "").replace(/\s*·\s*\d+\s+items?$/, "")}${file.updated ? " · " : ""}${file.entries.length} ${file.entries.length === 1 ? "item" : "items"}` : file.updated ?? "Just now"}</small></span></header>
        {file.kind === "folder" ? <ArtifactFolder name={file.name} entries={file.entries} onEntriesChange={entries => updateDirectory(file, entries)} onOpen={entry => open(entry.name)}/> : file.kind === "image" ? <ArtifactImageViewer key={file.name} src={file.src} name={file.name} alt={file.alt}/> : file.kind === "code" ? <WorkspaceCodeEditor file={file} onChange={update}/> : file.kind === "table" ? <SpreadsheetEditor key={file.name} file={file} onChange={update} onUndo={() => travel("undo")} onRedo={() => travel("redo")} canUndo={!!history?.past.length} canRedo={!!history?.future.length}/> : <DocumentEditor key={file.name} file={file} onChange={update} onUndo={() => travel("undo")} onRedo={() => travel("redo")} canUndo={!!history?.past.length} canRedo={!!history?.future.length}/>}
      </> : <div className="ui-aw__start"><Icon name="document" size={28}/><h2>What would you like to open?</h2><input value={query} onChange={event => setQuery(event.target.value)} aria-label="Find a file" placeholder="Search files…"/><div className="ui-aw__create"><button type="button" onClick={() => create("document")}><Icon name="document"/>New document</button><button type="button" onClick={() => create("table")}><Icon name="table"/>New spreadsheet</button></div><p className="ui-aw__start-label">Files in this conversation</p>{list.filter(item => item.name.toLocaleLowerCase().includes(query.toLocaleLowerCase())).map(item => <button type="button" className="ui-aw__file-row" key={item.name} onClick={() => open(item.name)}><Icon name={item.kind === "table" ? "table" : "document"}/><span>{item.name}</span><Icon name="arrow" size={13}/></button>)}</div>}
    </div>
  </section>;
}

function WorkspaceCodeEditor({ file, onChange }: { file: ArtifactCode; onChange: (file: ArtifactFile) => void }) {
  const [notice, setNotice] = useState("");
  const lines = useRef<HTMLPreElement>(null);
  const download = () => { const url = URL.createObjectURL(new Blob([file.content], { type: "text/plain" })); const link = document.createElement("a"); link.href = url; link.download = file.name; link.click(); URL.revokeObjectURL(url); };
  return <div className="ui-aw__code"><div className="ui-aw__toolbar"><span className="ui-aw__code-language">{file.language ?? "Plain text"}</span><button type="button" onClick={() => { navigator.clipboard?.writeText(file.content).then(() => setNotice("Copied")).catch(() => setNotice("Couldn't copy")); }}><Icon name="copy" size={13}/>Copy</button><button type="button" onClick={download}><Icon name="download" size={13}/>Download</button></div><div className="ui-aw__code-body"><pre ref={lines} aria-hidden="true">{file.content.split("\n").map((_, index) => index + 1).join("\n")}</pre><textarea aria-label={`${file.name}, code`} value={file.content} spellCheck={false} onScroll={event => { if (lines.current) lines.current.scrollTop = event.currentTarget.scrollTop; }} onChange={event => onChange({ ...file, content: event.target.value, updated: "Just now" })}/></div><span className="ui-aw__code-notice" role="status">{notice}</span></div>;
}

function WorkspaceToolbarButton({ icon, label, onClick, disabled, pressed }: { icon: IconName; label: string; onClick?: () => void; disabled?: boolean; pressed?: boolean }) {
  return <button type="button" className="ui-aw__tool" aria-label={label} title={label} disabled={disabled} aria-pressed={pressed} onMouseDown={event => event.preventDefault()} onClick={onClick}><Icon name={icon}/></button>;
}

function columnName(index: number): string { return index >= 26 ? columnName(Math.floor(index / 26) - 1) + String.fromCharCode(65 + index % 26) : String.fromCharCode(65 + index); }
function SpreadsheetEditor({ file, onChange, onUndo, onRedo, canUndo, canRedo }: { file: ArtifactTable; onChange: (file: ArtifactFile) => void; onUndo: () => void; onRedo: () => void; canUndo: boolean; canRedo: boolean }) {
  const [cell, setCell] = useState({ row: 1, column: 0 });
  const [editing, setEditing] = useState<"cell" | "formula" | false>(false), [draft, setDraft] = useState("");
  const [reference, setReference] = useState("A2");
  const [widths, setWidths] = useState<number[]>(file.columnWidths ?? []);
  const widthsRef = useRef(widths);
  const bold = file.boldCells ?? [];
  const [menu, setMenu] = useState<"format" | "delete" | null>(null);
  const root = useRef<HTMLDivElement>(null), grid = useRef<HTMLTableElement>(null), editInput = useRef<HTMLInputElement>(null), formatRef = useRef<HTMLButtonElement>(null), deleteRef = useRef<HTMLButtonElement>(null);
  const resizeCleanup = useRef<(() => void) | null>(null), id = useId();
  const rows = Array.isArray(file.rows) ? file.rows : [];
  const rowCount = Math.max(9, rows.length), columnCount = Math.max(7, ...rows.map(row => row.length));
  const value = String(rows[cell.row]?.[cell.column] ?? "");
  const address = `${columnName(cell.column)}${cell.row + 1}`;
  const format = file.formats?.[address] ?? "General";
  const setBold = (next: string[]) => onChange({ ...file, boldCells: next });
  const setFormat = (next: ArtifactNumberFormat) => onChange({ ...file, formats: { ...file.formats, [address]: next } });
  useEffect(() => { const next = file.columnWidths ?? []; widthsRef.current = next; setWidths(next); }, [file.columnWidths]);
  useEffect(() => { setReference(address); if (!editing) setDraft(value); }, [address, value, editing]);
  useEffect(() => { if (editing === "cell") { editInput.current?.focus(); editInput.current?.select(); } }, [editing]);
  useEffect(() => () => resizeCleanup.current?.(), []);
  const select = (row: number, column: number, focus = true) => {
    const next = { row: clamp(row, 0, rowCount - 1), column: clamp(column, 0, columnCount - 1) };
    setCell(next); setEditing(false);
    if (focus) grid.current?.querySelector<HTMLElement>(`[data-cell="${next.row}:${next.column}"]`)?.focus({ preventScroll: false });
  };
  const write = (text: string, row = cell.row, column = cell.column) => {
    const next = rows.map(row => [...row]); while (next.length <= row) next.push([]);
    const target = next[row]!; // The loop fills through the nonnegative selection row.
    while (target.length <= column) target.push(""); target[column] = text;
    onChange({ ...file, rows: next, updated: "Just now" });
  };
  const commit = () => { if (draft !== value) write(draft); setEditing(false); };
  const begin = (text = value) => { setDraft(text); setEditing("cell"); };
  const sort = (reverse: boolean) => {
    const [header = [], ...data] = rows;
    onChange({ ...file, rows: [header, ...data.sort((a, b) => String(a[cell.column] ?? "").localeCompare(String(b[cell.column] ?? ""), undefined, { numeric: true }) * (reverse ? -1 : 1))] });
  };
  const modify = (action: "row" | "column" | "delete-row" | "delete-column") => {
    const next = rows.map(row => [...row]);
    if (action === "row") { while (next.length < cell.row) next.push([]); next.splice(cell.row, 0, Array(columnCount).fill("")); }
    if (action === "column") next.forEach(row => row.splice(cell.column, 0, ""));
    if (action === "delete-row") next.splice(cell.row, 1);
    if (action === "delete-column") next.forEach(row => row.splice(cell.column, 1));
    onChange({ ...file, rows: next }); setMenu(null);
  };
  const key = (event: KeyboardEvent<HTMLTableCellElement>) => {
    if (editing || event.nativeEvent.isComposing) return;
    const next: [number, number] | null = event.key === "ArrowDown" ? [cell.row + 1, cell.column] : event.key === "ArrowUp" ? [cell.row - 1, cell.column] : event.key === "ArrowRight" || event.key === "Tab" && !event.shiftKey ? [cell.row, cell.column + 1] : event.key === "ArrowLeft" || event.key === "Tab" && event.shiftKey ? [cell.row, cell.column - 1] : event.key === "Home" ? [event.ctrlKey ? 0 : cell.row, 0] : event.key === "End" ? [event.ctrlKey ? rowCount - 1 : cell.row, columnCount - 1] : null;
    if (next) { event.preventDefault(); select(next[0], next[1]); }
    else if (event.key === "Enter" || event.key === "F2") { event.preventDefault(); begin(); }
    else if (event.key === "Delete" || event.key === "Backspace") { event.preventDefault(); write(""); }
    else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) { event.preventDefault(); begin(event.key); }
  };
  const startResize = (event: ReactPointerEvent<HTMLButtonElement>, column: number) => {
    event.preventDefault(); const target = event.currentTarget, x = event.clientX, start = widths[column] ?? (column === 0 ? 128 : column === 1 ? 102 : column >= 5 ? 70 : 80);
    target.setPointerCapture(event.pointerId);
    const move = (event: PointerEvent) => { const next = [...widthsRef.current]; next[column] = clamp(start + event.clientX - x, 55, 500); widthsRef.current = next; setWidths(next); };
    const stop = (event?: PointerEvent) => { target.removeEventListener("pointermove", move); target.removeEventListener("pointerup", stop); target.removeEventListener("pointercancel", stop); if (event?.type === "pointerup") onChange({ ...file, columnWidths: widthsRef.current }); resizeCleanup.current = null; };
    resizeCleanup.current?.(); resizeCleanup.current = stop; target.addEventListener("pointermove", move); target.addEventListener("pointerup", stop); target.addEventListener("pointercancel", stop);
  };
  const formatted = (text: string, address: string) => {
    const format = file.formats?.[address] ?? "General";
    const number = Number(text); if (!text.trim() || !Number.isFinite(number) || format === "General") return text;
    return format === "Percent" ? `${number * 100}%` : format === "Currency" ? new Intl.NumberFormat("en", { style: "currency", currency: "EUR" }).format(number) : number.toFixed(2);
  };
  return <div ref={root} className="ui-aw__sheet">
    <div className="ui-aw__toolbar" role="toolbar" aria-label="Spreadsheet tools"><WorkspaceToolbarButton icon="undo" label="Undo" disabled={!canUndo} onClick={onUndo}/><WorkspaceToolbarButton icon="redo" label="Redo" disabled={!canRedo} onClick={onRedo}/><span className="ui-aw__divider"/><WorkspaceToolbarButton icon="bold" label="Bold" pressed={bold.includes(address)} onClick={() => setBold(bold.includes(address) ? bold.filter(item => item !== address) : [...bold, address])}/><button ref={formatRef} type="button" className="ui-aw__format" aria-haspopup="menu" aria-expanded={menu === "format"} aria-controls={menu === "format" ? `${id}-menu` : undefined} onClick={() => setMenu(menu === "format" ? null : "format")}><span>Aa</span>{format}<Icon name="chevron" size={10}/></button><span className="ui-aw__divider"/><WorkspaceToolbarButton icon="sort" label={`Sort A to Z by ${columnName(cell.column)}`} onClick={() => sort(false)}/><WorkspaceToolbarButton icon="sort" label={`Sort Z to A by ${columnName(cell.column)}`} onClick={() => sort(true)}/><span className="ui-aw__divider"/><WorkspaceToolbarButton icon="row" label="Insert row above" onClick={() => modify("row")}/><WorkspaceToolbarButton icon="column" label="Insert column left" onClick={() => modify("column")}/><button ref={deleteRef} type="button" className="ui-aw__tool" aria-label="Delete" title="Delete" aria-haspopup="menu" aria-expanded={menu === "delete"} aria-controls={menu === "delete" ? `${id}-menu` : undefined} onClick={() => setMenu(menu === "delete" ? null : "delete")}><Icon name="trash"/></button></div>
    <div className="ui-aw__formula"><input aria-label="Cell reference – type one to go there" value={reference} onChange={event => setReference(event.target.value)} onBlur={() => setReference(address)} onKeyDown={event => { if (event.key !== "Enter") return; const match = /^([a-z]+)([1-9]\d*)$/i.exec(reference.trim()); if (match && match[1] && match[2]) { const column = [...match[1].toUpperCase()].reduce((total, letter) => total * 26 + letter.charCodeAt(0) - 64, 0) - 1; select(Number(match[2]) - 1, column); } else setReference(address); }}/><span aria-hidden="true">fx</span><input aria-label={`Contents of ${address}`} value={editing ? draft : value} onFocus={() => { setDraft(value); }} onChange={event => { setEditing("formula"); setDraft(event.target.value); }} onBlur={commit} onKeyDown={event => { if (event.key === "Enter") { event.preventDefault(); commit(); select(cell.row + 1, cell.column); } if (event.key === "Escape") { setDraft(value); setEditing(false); select(cell.row, cell.column); } }}/></div>
    <div className="ui-aw__grid-wrap"><table ref={grid} className="ui-aw__grid" role="grid" aria-label={file.name} aria-rowcount={rowCount + 1} aria-colcount={columnCount + 1}><colgroup><col style={{ width: 30 }}/>{Array.from({ length: columnCount }, (_, column) => <col key={column} style={{ width: widths[column] ?? (column === 0 ? 128 : column === 1 ? 102 : 80) }}/>)}</colgroup><thead><tr><th className="ui-aw__corner"/>{Array.from({ length: columnCount }, (_, column) => <th scope="col" key={column} data-selected={column === cell.column || undefined}>{columnName(column)}<button type="button" className="ui-aw__col-resize" aria-label={`Resize column ${columnName(column)}`} onPointerDown={event => startResize(event, column)} onKeyDown={event => { if (event.key === "ArrowLeft" || event.key === "ArrowRight") { event.preventDefault(); const next = [...widths]; next[column] = clamp((widths[column] ?? (column === 0 ? 128 : column === 1 ? 102 : column >= 5 ? 70 : 80)) + (event.key === "ArrowLeft" ? -10 : 10), 55, 500); widthsRef.current = next; setWidths(next); onChange({ ...file, columnWidths: next }); } }}/></th>)}</tr></thead><tbody>{Array.from({ length: rowCount }, (_, row) => <tr key={row}><th scope="row" data-selected={row === cell.row || undefined}>{row + 1}</th>{Array.from({ length: columnCount }, (_, column) => <td key={column} role="gridcell" aria-label={`${columnName(column)}${row + 1}${rows[row]?.[column] ? `: ${rows[row][column]}` : ""}`} aria-selected={cell.row === row && cell.column === column} tabIndex={cell.row === row && cell.column === column ? 0 : -1} data-cell={`${row}:${column}`} data-bold={row === 0 || bold.includes(`${columnName(column)}${row + 1}`) || undefined} onFocus={() => { if (row !== cell.row || column !== cell.column) { setCell({ row, column }); setEditing(false); } }} onPointerDown={event => { if (!(event.target instanceof HTMLInputElement)) event.currentTarget.focus(); }} onDoubleClick={() => begin()} onKeyDown={key} onCopy={event => { event.clipboardData.setData("text/plain", String(rows[row]?.[column] ?? "")); event.preventDefault(); }} onPaste={event => { event.preventDefault(); const next = rows.map(row => [...row]); const pasted = event.clipboardData.getData("text/plain").replace(/\r/g, "").replace(/\n$/, "").split("\n").map(line => line.split("\t")); pasted.forEach((line, offset) => { while (next.length <= row + offset) next.push([]); const target = next[row + offset]!; /* The loop fills through this nonnegative destination row. */ line.forEach((text, index) => { target[column + index] = text; }); }); onChange({ ...file, rows: next }); }}>
      {editing === "cell" && cell.row === row && cell.column === column ? <input ref={editInput} className="ui-aw__cell-input" aria-label={`Edit ${address}`} value={draft} onChange={event => setDraft(event.target.value)} onBlur={commit} onKeyDown={event => { event.stopPropagation(); if (event.key === "Enter" || event.key === "Tab") { event.preventDefault(); commit(); select(cell.row + (event.key === "Enter" ? event.shiftKey ? -1 : 1 : 0), cell.column + (event.key === "Tab" ? event.shiftKey ? -1 : 1 : 0)); } if (event.key === "Escape") { setEditing(false); setDraft(value); select(cell.row, cell.column); } }}/> : formatted(String(rows[row]?.[column] ?? ""), `${columnName(column)}${row + 1}`)}
    </td>)}</tr>)}</tbody></table></div>
    <div className="ui-aw__sheet-status" role="status" aria-live="polite">{editing ? `Editing ${address}` : ""}</div>
    {menu && <FloatingMenu anchor={menu === "format" ? formatRef : deleteRef} root={root} className="ui-aw__menu" id={`${id}-menu`} label={menu === "format" ? "Number format" : "Delete cells"} onClose={() => setMenu(null)}>{menu === "format" ? (["General", "Number", "Currency", "Percent"] as const).map(option => <button type="button" role="menuitemradio" aria-checked={format === option} key={option} onClick={() => { setFormat(option); setMenu(null); }}>{option}{format === option && <Icon name="check" size={13}/>}</button>) : <><button type="button" role="menuitem" onClick={() => modify("delete-row")}>Delete row {cell.row + 1}</button><button type="button" role="menuitem" onClick={() => modify("delete-column")}>Delete column {columnName(cell.column)}</button><button type="button" role="menuitem" onClick={() => { write(""); setMenu(null); }}>Clear cell</button></>}</FloatingMenu>}
  </div>;
}

function safeDocumentFragment(html: string): DocumentFragment {
  const parsed = new DOMParser().parseFromString(html, "text/html");
  const fragment = document.createDocumentFragment();
  const allowed = new Set(["P", "DIV", "BR", "H1", "H2", "H3", "B", "STRONG", "I", "EM", "U", "UL", "OL", "LI", "BLOCKQUOTE", "A", "CODE", "PRE"]);
  const copy = (source: Node, target: Node) => {
    if (source.nodeType === Node.TEXT_NODE) { target.appendChild(document.createTextNode(source.textContent ?? "")); return; }
    if (!(source instanceof Element) || ["SCRIPT", "STYLE", "IFRAME", "OBJECT", "SVG"].includes(source.tagName)) return;
    const element = document.createElement(allowed.has(source.tagName) ? source.tagName.toLowerCase() : "span");
    if (source.tagName === "A" && /^(https?:|mailto:|#)/i.test(source.getAttribute("href") ?? "")) { element.setAttribute("href", source.getAttribute("href")!); element.setAttribute("rel", "noopener noreferrer"); }
    source.childNodes.forEach(child => copy(child, element)); target.appendChild(element);
  };
  parsed.body.childNodes.forEach(child => copy(child, fragment)); return fragment;
}

function DocumentEditor({ file, onChange, onUndo, onRedo, canUndo, canRedo }: { file: ArtifactDocument; onChange: (file: ArtifactFile) => void; onUndo: () => void; onRedo: () => void; canUndo: boolean; canRedo: boolean }) {
  const editor = useRef<HTMLDivElement>(null), last = useRef("");
  const [link, setLink] = useState<string | null>(null), [style, setStyle] = useState("Text");
  const selection = useRef<Range | null>(null);
  useLayoutEffect(() => {
    const el = editor.current; if (!el) return;
    const key = file.html ?? file.content; if (key === last.current) return;
    last.current = key;
    if (file.html) { el.replaceChildren(safeDocumentFragment(file.html)); return; }
    const fragment = document.createDocumentFragment(); let list: HTMLUListElement | null = null;
    for (const line of file.content.split("\n")) {
      if (!line.trim()) { list = null; continue; }
      if (line.startsWith("- ")) { if (!list) { list = document.createElement("ul"); fragment.appendChild(list); } const item = document.createElement("li"); item.textContent = line.slice(2); list.appendChild(item); }
      else {
        list = null;
        const match = /^(#{1,3})\s+(.*)/.exec(line);
        // Both captures participate in every match; the heading text may be empty.
        const block = document.createElement(match ? `h${match[1]!.length}` : "p");
        block.textContent = match ? match[2]! : line;
        fragment.appendChild(block);
      }
    }
    if (!fragment.childNodes.length) fragment.appendChild(document.createElement("p")); el.replaceChildren(fragment);
  }, [file.name, file.content, file.html]);
  const emit = () => { const el = editor.current; if (!el) return; last.current = el.innerHTML; onChange({ ...file, content: el.innerText, html: el.innerHTML, updated: "Just now" }); };
  const format = (command: string, value?: string) => { editor.current?.focus(); document.execCommand(command, false, value); emit(); };
  const wordCount = file.content.trim().split(/\s+/).filter(Boolean).length;
  return <div className="ui-aw__document">
    <div className="ui-aw__toolbar" role="toolbar" aria-label="Document formatting"><WorkspaceToolbarButton icon="undo" label="Undo" disabled={!canUndo} onClick={onUndo}/><WorkspaceToolbarButton icon="redo" label="Redo" disabled={!canRedo} onClick={onRedo}/><span className="ui-aw__divider"/><select className="ui-aw__text-style" aria-label="Text style" value={style} onChange={event => { setStyle(event.target.value); format("formatBlock", event.target.value === "Text" ? "p" : event.target.value === "Heading 1" ? "h1" : "h2"); }}><option>Text</option><option>Heading 1</option><option>Heading 2</option></select><WorkspaceToolbarButton icon="bold" label="Bold" onClick={() => format("bold")}/><WorkspaceToolbarButton icon="italic" label="Italic" onClick={() => format("italic")}/><WorkspaceToolbarButton icon="underline" label="Underline" onClick={() => format("underline")}/><WorkspaceToolbarButton icon="link" label="Insert link" onClick={() => { const current = window.getSelection(); selection.current = current?.rangeCount ? current.getRangeAt(0).cloneRange() : null; setLink(""); }}/><WorkspaceToolbarButton icon="tasks" label="Bulleted list" onClick={() => format("insertUnorderedList")}/></div>
    {link !== null && <form className="ui-aw__link-form" onSubmit={event => { event.preventDefault(); if (/^(https?:\/\/|mailto:)/i.test(link)) { const current = window.getSelection(); editor.current?.focus(); if (selection.current && current) { current.removeAllRanges(); current.addRange(selection.current); } format("createLink", link); setLink(null); } }}><input autoFocus aria-label="Link URL" type="url" placeholder="https://…" value={link} onChange={event => setLink(event.target.value)} onKeyDown={event => { if (event.key === "Escape") { setLink(null); editor.current?.focus(); } }}/><button type="submit">Apply</button><button type="button" aria-label="Cancel link" onClick={() => setLink(null)}><Icon name="close" size={12}/></button></form>}
    <div ref={editor} className="ui-aw__doc" contentEditable suppressContentEditableWarning role="textbox" aria-multiline="true" aria-label={`${file.name}, document`} spellCheck onInput={emit} onPaste={event => { event.preventDefault(); document.execCommand("insertText", false, event.clipboardData.getData("text/plain")); emit(); }}/>
    <footer className="ui-aw__doc-status">{wordCount} words · {file.content.length} characters</footer>
  </div>;
}

/* ---------- Styles ---------- */
.ui-aw__code{display:flex;flex:1;min-height:0;flex-direction:column}.ui-aw__code .ui-aw__toolbar{gap:12px}.ui-aw__code-language{margin-right:auto;font-size:11px;color:var(--ui-aw-muted)}.ui-aw__code .ui-aw__toolbar button{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--ui-aw-muted);min-height:28px}.ui-aw__code-body{display:flex;flex:1;min-height:180px;border-top:.5px solid var(--ui-aw-line)}.ui-aw__code-body pre,.ui-aw__code-body textarea{font:12px/1.8 ui-monospace,"SF Mono",Menlo,monospace;tab-size:2;padding:12px;white-space:pre;margin:0}.ui-aw__code-body pre{color:var(--ui-aw-faint);background:var(--ui-aw-fill);text-align:right;overflow:hidden;width:44px;flex:none;font-variant-numeric:tabular-nums}.ui-aw__code-body textarea{background:none;resize:none;border:0;outline:none;flex:1;min-width:0;color:var(--ui-aw-ink);overflow:auto}.ui-aw__code-notice{font-size:11px;padding:4px 12px;color:var(--ui-aw-muted);min-height:22px}
.ui-aw{--ui-aw-card:#fff;--ui-aw-ink:rgba(0,0,0,.88);--ui-aw-text:rgba(0,0,0,.61);--ui-aw-muted:rgba(0,0,0,.45);--ui-aw-faint:rgba(0,0,0,.27);--ui-aw-line:rgba(0,0,0,.06);--ui-aw-fill:rgba(0,0,0,.025);--ui-aw-focus:rgba(0,96,226,.35);--ui-aw-selection:rgba(0,96,226,.1);--ui-aw-shadow:0 0 0 .5px rgba(0,0,0,.08),0 12px 28px -10px rgba(0,0,0,.16);display:flex;flex-direction:column;min-width:0;width:100%;height:100%;position:relative;background:var(--ui-aw-card);font:13px/1.5 "Inter","InterVariable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ui-aw-ink);container:ui-aw / inline-size;-webkit-font-smoothing:antialiased}
.ui-aw,.ui-aw *,.ui-aw *::before,.ui-aw *::after{box-sizing:border-box}.ui-aw :where(button,input,select){font:inherit;color:inherit}.ui-aw :where(button){border:0;background:none;cursor:pointer}.ui-aw button:disabled{opacity:.35;cursor:default}.ui-aw button:focus-visible,.ui-aw input:focus-visible,.ui-aw select:focus-visible,.ui-aw__doc:focus-visible{outline:2px solid var(--ui-aw-focus);outline-offset:-2px}.ui-aw button:active:not(:disabled){transform:scale(.97)}.ui-aw__bar{display:flex;align-items:center;gap:4px;min-height:48px;padding:6px;border-bottom:.5px solid var(--ui-aw-line);flex:none;background:var(--ui-aw-fill)}.ui-aw__tabs{display:flex;gap:4px;min-width:0;overflow:auto;scrollbar-width:none}.ui-aw__tab-wrap{display:flex;align-items:center;position:relative;border-radius:8px;min-width:0;flex-shrink:0;color:var(--ui-aw-muted)}.ui-aw__tab-wrap[data-active]{background:var(--ui-aw-card);box-shadow:0 0 0 .5px var(--ui-aw-line);color:var(--ui-aw-ink)}.ui-aw__tab{display:flex;align-items:center;gap:6px;min-width:0;max-width:166px;height:30px;padding:0 24px 0 9px;text-align:left;font-size:12px!important}.ui-aw__tab span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.ui-aw__tab-close{display:grid;place-items:center;position:absolute;right:4px;top:7px;width:16px;height:16px;border-radius:4px;color:var(--ui-aw-muted)!important}.ui-aw__tab-close:hover{background:var(--ui-aw-fill)}.ui-aw__collapse{margin-left:auto}.ui-aw__tool{display:inline-grid;place-items:center;flex:none;width:28px;height:28px;border-radius:5px;color:var(--ui-aw-muted)!important;padding:0}.ui-aw__tool:hover,.ui-aw__tool[aria-pressed="true"]{background:var(--ui-aw-fill)}.ui-aw__pane{display:flex;flex-direction:column;min-height:0;flex:1}.ui-aw__heading{display:flex;align-items:center;gap:10px;min-height:68px;padding:16px 18px 10px}.ui-aw__heading>span:last-child{display:flex;flex-direction:column;min-width:0}.ui-aw__heading strong{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ui-aw__heading small{font-size:11px;color:var(--ui-aw-muted)}.ui-aw__file-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--ui-aw-fill);color:#2989df}.ui-aw__file-icon[data-kind="table"]{color:#1a9a52}.ui-aw__sheet{display:flex;flex:1;min-height:0;flex-direction:column;position:relative}.ui-aw__toolbar{display:flex;align-items:center;gap:2px;min-height:36px;padding:0 12px 8px;flex:none;overflow-x:auto;scrollbar-width:none}.ui-aw__divider{width:1px;height:14px;flex:none;background:var(--ui-aw-line);margin-inline:3px}.ui-aw__format{display:flex;align-items:center;gap:5px;height:28px;white-space:nowrap;color:var(--ui-aw-text)!important;padding:0 4px}.ui-aw__format>span{color:var(--ui-aw-muted);font-size:12px}.ui-aw__formula{display:flex;align-items:center;gap:0;margin:10px 18px 10px;height:28px;flex:none;border:.5px solid var(--ui-aw-line);border-radius:5px;overflow:hidden}.ui-aw__formula input{border:0;outline:none;background:none;padding:0 8px;min-width:0;flex:1;font-size:12px}.ui-aw__formula input:first-child{width:62px;flex:none;text-align:center;font-variant-numeric:tabular-nums;border-right:.5px solid var(--ui-aw-line)}.ui-aw__formula>span{font-style:italic;font-size:12px;color:var(--ui-aw-faint);padding-left:8px}.ui-aw__grid-wrap{overflow:auto;min-height:0;overscroll-behavior:contain}.ui-aw__grid{border-collapse:separate;border-spacing:0;table-layout:fixed;width:max-content;min-width:100%;font-size:12px;line-height:1.35;white-space:nowrap}.ui-aw__grid th,.ui-aw__grid td{border-right:.5px solid var(--ui-aw-line);border-bottom:.5px solid var(--ui-aw-line);padding:4px 8px;height:26px;max-width:0;overflow:hidden;text-overflow:ellipsis;position:relative;font-weight:400}.ui-aw__grid thead th{position:sticky;top:0;z-index:2;height:26px;text-align:center;font-size:10px;color:var(--ui-aw-muted);background:var(--ui-aw-card)}.ui-aw__grid th:first-child{position:sticky;left:0;z-index:1;width:30px;text-align:center;padding-inline:4px;font-variant-numeric:tabular-nums;font-size:10px;color:var(--ui-aw-muted);background:var(--ui-aw-card)}.ui-aw__grid thead th:first-child{z-index:3}.ui-aw__grid [data-bold]{font-weight:500}.ui-aw__grid th[data-selected]{background:var(--ui-aw-selection);color:var(--ui-aw-ink)}.ui-aw__grid td[aria-selected="true"]{outline:2px solid var(--ui-aw-muted);outline-offset:-2px;overflow:visible;z-index:1}.ui-aw__grid td[aria-selected="true"]::after{content:"";position:absolute;right:-2px;bottom:-2px;width:5px;height:5px;background:var(--ui-aw-muted);border:1px solid var(--ui-aw-card)}.ui-aw__grid td:focus{outline:2px solid var(--ui-aw-muted);outline-offset:-2px}.ui-aw__cell-input{position:absolute;inset:0;width:100%;height:100%;background:var(--ui-aw-card);border:0;outline:2px solid var(--ui-aw-focus);padding:2px 8px}.ui-aw__col-resize{position:absolute;inset:0 -3px 0 auto;width:7px;cursor:col-resize!important;touch-action:none;padding:0}.ui-aw__col-resize:hover{background:var(--ui-aw-selection)}.ui-aw__sheet-status{margin-top:auto;padding:6px 16px;min-height:28px;color:var(--ui-aw-faint);font-size:10px;font-variant-numeric:tabular-nums}.ui-aw__document{display:flex;flex-direction:column;min-height:0;flex:1}.ui-aw__text-style{max-width:92px;height:28px;background:none;border:0;color:var(--ui-aw-muted)!important;cursor:pointer;font-size:12px!important}.ui-aw__doc{padding:8px 18px 20px;outline:none;overflow:auto;min-height:220px;font-size:13px;line-height:1.6;color:var(--ui-aw-text);overflow-wrap:anywhere}.ui-aw__doc h1,.ui-aw__doc h2,.ui-aw__doc h3{font-weight:500;color:var(--ui-aw-ink);margin:0 0 10px;line-height:1.4}.ui-aw__doc h1{font-size:20px}.ui-aw__doc h2{font-size:17px}.ui-aw__doc h3{font-size:15px}.ui-aw__doc p{margin:0 0 10px}.ui-aw__doc ul,.ui-aw__doc ol{padding-left:21px;margin:0 0 10px}.ui-aw__doc li{padding-left:0;margin-bottom:3px}.ui-aw__doc li::marker{color:var(--ui-aw-faint)}.ui-aw__doc b,.ui-aw__doc strong{font-weight:600}.ui-aw__doc a{color:inherit;text-decoration:underline;text-underline-offset:3px}.ui-aw__doc-status{padding:8px 18px;border-top:.5px solid var(--ui-aw-line);font-size:11px;letter-spacing:.025em;color:var(--ui-aw-faint);font-variant-numeric:tabular-nums}.ui-aw__link-form{display:flex;gap:6px;padding:6px 18px}.ui-aw__link-form input{min-width:0;flex:1;background:none;border:1px solid var(--ui-aw-line);border-radius:4px;padding:4px}.ui-aw__link-form button{font-size:12px;color:var(--ui-aw-text)}.ui-aw__menu{min-width:180px;padding:5px;overflow:auto;background:var(--ui-aw-card);box-shadow:var(--ui-aw-shadow);border-radius:9px;animation:ui-aw-in 200ms cubic-bezier(.22,1,.36,1)}.ui-aw__menu button{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:32px;width:100%;border-radius:5px;padding:6px 9px;text-align:left;font-size:12px}.ui-aw__menu button:hover{background:var(--ui-aw-fill)}.ui-aw__start{padding:32px 24px;overflow:auto;color:var(--ui-aw-muted)}.ui-aw__start h2{font-size:17px;font-weight:500;color:var(--ui-aw-ink)}.ui-aw__start>input{width:100%;background:none;border:1px solid var(--ui-aw-line);padding:9px 10px;border-radius:6px;margin-bottom:16px}.ui-aw__create{display:flex;gap:8px}.ui-aw__create button{display:flex;gap:6px;align-items:center;text-align:left;padding:8px;background:var(--ui-aw-fill);border-radius:7px;font-size:11px}.ui-aw__start-label{font-size:11px;margin-top:26px}.ui-aw__file-row{display:flex;align-items:center;gap:8px;width:100%;padding:9px 2px;text-align:left;font-size:12px!important}.ui-aw__file-row>span{min-width:0;overflow:hidden;text-overflow:ellipsis;flex:1}.ui-aw__file-row:hover{color:var(--ui-aw-ink)}
@keyframes ui-aw-in{from{opacity:0;transform:translateY(4px)}}
@container ui-aw (max-width:360px){.ui-aw__heading{padding-inline:12px}.ui-aw__toolbar{padding-inline:10px}.ui-aw__formula{margin-inline:12px}.ui-aw__doc{padding-inline:12px}.ui-aw__tab{max-width:140px}}
@media(pointer:coarse){.ui-aw__tool{width:34px;height:34px}.ui-aw__tab{height:34px}.ui-aw__tab-close{top:9px}.ui-aw__grid td{height:32px}.ui-aw__menu button{min-height:40px}.ui-aw__col-resize{width:11px}.ui-aw__formula input,.ui-aw__cell-input{font-size:16px}}
@media(prefers-reduced-motion:reduce){.ui-aw,.ui-aw *{animation:none!important;transition:none!important}}
:where(.dark,[data-theme="dark"]) .ui-aw{--ui-aw-card:#1c1c1e;--ui-aw-ink:rgba(255,255,255,.9);--ui-aw-text:rgba(255,255,255,.62);--ui-aw-muted:rgba(255,255,255,.46);--ui-aw-faint:rgba(255,255,255,.3);--ui-aw-line:rgba(255,255,255,.08);--ui-aw-fill:rgba(255,255,255,.025);--ui-aw-focus:rgba(77,141,255,.5);--ui-aw-selection:rgba(77,141,255,.16);--ui-aw-shadow:0 0 0 .5px rgba(255,255,255,.12),0 12px 28px -10px rgba(0,0,0,.6)}

.ui-aw__file-icon[data-kind="folder"]{color:#e8b000}.ui-aw__file-icon[data-kind="code"]{color:#ed9540}.ui-aw__file-icon[data-kind="image"]{color:#a651f0}
